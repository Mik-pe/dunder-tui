capability filesystem, stdio
import std.bytes as bytes
import std.text as text
import sys

fn decimals(value: string) -> i32 {
    for i in 0..value.len { if value[i] == b'.' { return value.len-i-1 } }
    0
}

fn fixed(value: string, keep: i32) -> i32 {
    mut n := 0
    mut decimals := -1
    for i in 0..value.len {
        ch := value[i]
        if ch == b'-' || ch == b'+' { continue }
        if ch == b'.' { decimals = 0; continue }
        assert(ch >= b'0' && ch <= b'9')
        if decimals == keep { break }
        n = n*10+i32(ch-b'0')
        if decimals >= 0 { decimals += 1 }
    }
    if decimals < 0 { decimals = 0 }
    for _ in decimals..5 { n *= 10 }
    if value[0] == b'-' { -n } else { n }
}

fn emit(path: string, name: string) {
    mut out: []u8 = []
    for raw in text.split(sys.read(path).unwrap(), "\n") {
        line := text.trim(raw)
        if line.len == 0 || line[0] == b'#' { continue }
        mut fields: []string = []
        for part in text.split(text.replace(line,"\t"," "), " ") { if part.len > 0 { fields.push(move part) } }
        assert(fields.len == 2)
        if name == "low" && fields[0] == "-69.31" && fields[1] == "-52.81" { continue }
        a := decimals(fields[0]); b := decimals(fields[1])
        keep := if (a < 4 || b < 4) && a <= 5 && b <= 5 { 5 } else { 4 }
        for part in &fields {
            n := fixed(part,keep) + 36000000
            assert(n >= 0 && n < 1073741824)
            for shift in [24,18,12,6,0] { out.push(u8(n.shr(shift).bit_and(63)+35)) }
        }
    }
    print("pub fn "+name+"() -> string { r\""+bytes.decode(&out).unwrap()+"\" }")
}

fn main() {
    assert(sys.arg_count() == 3)
    emit(sys.arg(1),"low")
    emit(sys.arg(2),"high")
}
