capability stdio

import .width
import .terminal
import .posix
import .windows
import std.bytes as bytes

pub enum Color { Default, Black, Red, Green, Yellow, Blue, Magenta, Cyan, White }
pub struct Style { fg: Color, bg: Color, strong: bool, reverse: bool }

pub fn plain() -> Style { Style { fg: .Default, bg: .Default, strong: false, reverse: false } }
pub fn ink(color: Color) -> Style { plain().foreground(color) }

impl Style {
    pub fn foreground(self, color: Color) -> Self { mut s := self; s.fg = color; s }
    pub fn background(self, color: Color) -> Self { mut s := self; s.bg = color; s }
    pub fn bold(self) -> Self { mut s := self; s.strong = true; s }
    pub fn inverted(self) -> Self { mut s := self; s.reverse = true; s }

    fn same(self, other: Style) -> bool {
        self.fg == other.fg && self.bg == other.bg && self.strong == other.strong && self.reverse == other.reverse
    }

    fn ansi(self) -> string {
        mut seq := "\u{1b}[0"
        if self.fg != Color.Default { seq += ";" + (29 + i32(self.fg)).str() }
        if self.bg != Color.Default { seq += ";" + (39 + i32(self.bg)).str() }
        if self.strong { seq += ";1" }
        if self.reverse { seq += ";7" }
        seq + "m"
    }
}

pub struct Rect { x: i32, y: i32, w: i32, h: i32 }

fn clamp(n: i32, limit: i32) -> i32 {
    if n < 0 { return 0 }
    if n > limit { return limit }
    n
}

impl Rect {
    pub fn rows(self, first: i32) -> (Rect, Rect) {
        n := clamp(first, self.h)
        (Rect { x: self.x, y: self.y, w: self.w, h: n },
            Rect { x: self.x, y: self.y + n, w: self.w, h: self.h - n })
    }

    pub fn cols(self, first: i32) -> (Rect, Rect) {
        n := clamp(first, self.w)
        (Rect { x: self.x, y: self.y, w: n, h: self.h },
            Rect { x: self.x + n, y: self.y, w: self.w - n, h: self.h })
    }

    pub fn inset(self, padding: i32) -> Rect {
        (_, rest) := self.rows(padding)
        (middle, _) := rest.rows(rest.h - clamp(padding, rest.h))
        (_, right) := middle.cols(padding)
        (body, _) := right.cols(right.w - clamp(padding, right.w))
        body
    }
}

struct Cell { glyph: string, span: i32, style: Style }
fn blank() -> Cell { Cell { glyph: " ", span: 1, style: plain() } }

pub opaque struct Frame { bounds: Rect, cells: []Cell }

impl Frame {
    pub fn new(w: i32, h: i32) -> Self {
        cols := clamp(w, 4096)
        rows := clamp(h, if cols > 0 { clamp(1048576 / cols, 4096) } else { 4096 })
        mut cells: []Cell = []
        cells.reserve(cols * rows)
        for _ in 0..(cols * rows) { cells.push(blank()) }
        Self { bounds: Rect { x: 0, y: 0, w: cols, h: rows }, cells: cells }
    }

    pub fn area(&self) -> Rect { self.bounds }

    fn erase_span(&mut self, i: i32) {
        span := self.cells[i].span
        if span == 0 { self.cells[i - 1] = blank() }
        if span == 2 { self.cells[i + 1] = blank() }
    }

    fn put(&mut self, x: i32, y: i32, glyph: string, span: i32, style: Style) {
        if x < 0 || y < 0 || y >= self.bounds.h || x > self.bounds.w - span { return }
        i := y * self.bounds.w + x
        self.erase_span(i)
        if span == 2 {
            self.erase_span(i + 1)
            self.cells[i + 1] = Cell { glyph: "", span: 0, style: style }
        }
        self.cells[i] = Cell { glyph: glyph.clone(), span: span, style: style }
    }

    pub fn text(&mut self, area: Rect, value: string, style: Style) {
        mut x := 0
        mut y := 0
        chars := value.runes()
        mut at := 0
        mut offset := 0
        while at < chars.len && y < area.h {
            cp := i32(chars[at])
            glyph := width.glyph(&chars, at)
            start := offset
            at = glyph.end
            offset += glyph.bytes
            if cp == 10 { x = 0; y += 1; continue }
            if glyph.span < 1 || x >= area.w { continue }
            if glyph.span > area.w - x { x = area.w; continue }
            px := i64(area.x) + i64(x)
            py := i64(area.y) + i64(y)
            if px >= 0 && px <= i64(self.bounds.w - glyph.span) && py >= 0 && py < i64(self.bounds.h) {
                self.put(i32(px), i32(py), value[start..offset], glyph.span, style)
            }
            x += glyph.span
        }
    }

    pub fn label(&mut self, area: Rect, value: string) { self.text(area, value, plain()) }

    pub fn panel(&mut self, area: Rect, title: string, style: Style) -> Rect {
        if area.w < 2 || area.h < 2 { return area.inset(1) }
        right := area.x + area.w - 1
        bottom := area.y + area.h - 1
        for x in (area.x + 1)..right {
            self.put(x, area.y, "─", 1, style)
            self.put(x, bottom, "─", 1, style)
        }
        for y in (area.y + 1)..bottom {
            self.put(area.x, y, "│", 1, style)
            self.put(right, y, "│", 1, style)
        }
        self.put(area.x, area.y, "┌", 1, style)
        self.put(right, area.y, "┐", 1, style)
        self.put(area.x, bottom, "└", 1, style)
        self.put(right, bottom, "┘", 1, style)
        self.text(Rect { x: area.x + 1, y: area.y, w: area.w - 2, h: 1 }, title, style)
        area.inset(1)
    }

    pub fn list(&mut self, area: Rect, items: &[]string, selected: i32, highlight: Style) {
        if area.h <= 0 { return }
        first := clamp(clamp(selected, items.len - 1) - area.h + 1, items.len)
        count := clamp(items.len - first, area.h)
        for row in 0..count {
            item := first + row
            style := if item == selected { highlight } else { plain() }
            self.text(Rect { x: area.x, y: area.y + row, w: area.w, h: 1 }, items[item], style)
        }
    }

    fn row(&self, y: i32, styled: bool) -> string {
        if y < 0 || y >= self.bounds.h { return "" }
        mut out: []u8 = []
        mut current := plain()
        mut end := self.bounds.w
        if styled {
            while end > 0 {
                i := y * self.bounds.w + end - 1
                if self.cells[i].glyph != " " || !self.cells[i].style.same(plain()) { break }
                end -= 1
            }
        }
        for x in 0..end {
            i := y * self.bounds.w + x
            if self.cells[i].span == 0 { continue }
            style := self.cells[i].style
            if styled && !current.same(style) {
                bytes.append_utf8(&mut out, style.ansi())
                current = style
            }
            bytes.append_utf8(&mut out, self.cells[i].glyph)
        }
        if styled && !current.same(plain()) { bytes.append_utf8(&mut out, "\u{1b}[0m") }
        if end < self.bounds.w { bytes.append_utf8(&mut out, "\x1b[K") }
        bytes.decode(&out).unwrap()
    }

    pub fn line(&self, y: i32) -> string { self.row(y, false) }

    fn same_row(&self, previous: &Frame, y: i32) -> bool {
        if self.bounds.h != previous.bounds.h || self.bounds.w != previous.bounds.w { return false }
        start := y * self.bounds.w
        for i in start..(start + self.bounds.w) {
            if self.cells[i].glyph != previous.cells[i].glyph || !self.cells[i].style.same(previous.cells[i].style) { return false }
        }
        true
    }

    fn paint_row(&self, term: &terminal.Session, y: i32) -> bool {
        mut x := 0
        while x < self.bounds.w {
            start := x
            style := self.cells[y * self.bounds.w + x].style
            mut run: []u8 = []
            while x < self.bounds.w {
                i := y * self.bounds.w + x
                if !self.cells[i].style.same(style) { break }
                bytes.append_utf8(&mut run, self.cells[i].glyph)
                x += 1
            }
            if !windows.paint(&term.win, start, y, bytes.decode(&run).unwrap(), style) { return false }
        }
        true
    }

    fn present(&self, term: &terminal.Session, previous: &Frame) -> bool {
        if target_is("windows") {
            for y in 0..self.bounds.h {
                if !self.same_row(&previous, y) && !self.paint_row(&term, y) { return false }
            }
            return true
        } else {
            mut output: []u8 = []
            for y in 0..self.bounds.h {
                if self.same_row(&previous, y) { continue }
                bytes.append_utf8(&mut output, "\x1b[" + (y + 1).str() + ";1H")
                bytes.append_utf8(&mut output, self.row(y, true))
            }
            return output.len == 0 || posix.write(bytes.decode(&output).unwrap())
        }
    }
}

pub enum Key { Char(rune), Up, Down, Left, Right, Home, End, Delete, Backspace, Tab, Enter, Escape }

pub fn run<S>(state: &mut S, draw: fn(&mut Frame, &S), update: fn(&mut S, Key) -> bool) -> Result<(), string> {
    mut term := terminal.session()
    (cols, rows) := term.size()
    if cols <= 0 || rows <= 0 || !term.open() { return .Err("An interactive terminal is required on stdin and stdout.") }
    defer { term.close() }
    if !term.enter() { return .Err("Could not enter the alternate screen.") }
    mut previous := Frame::new(0, 0)
    mut dirty := true
    while true {
        (next_w, next_h) := term.size()
        if next_w <= 0 || next_h <= 0 { return .Err("Could not read the terminal size.") }
        if next_w > 4096 || next_h > 4096 || i64(next_w) * i64(next_h) > 1048576 { return .Err("Terminal viewport is too large.") }
        if dirty || next_w != previous.bounds.w || next_h != previous.bounds.h {
            mut frame := Frame::new(next_w, next_h)
            draw(&mut frame, &state)
            if !frame.present(&term, &previous) { return .Err("Could not write the frame.") }
            previous = frame
            dirty = false
        }
        match term.next() {
            .Idle => {},
            .Error => { return .Err("Could not read terminal input.") },
            .Quit => { return .Ok },
            .Press(key) => {
                if !update(&mut state, key) { return .Ok }
                dirty = true
            },
        }
    }
    .Ok
}
