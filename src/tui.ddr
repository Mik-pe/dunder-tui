fn clear_packed(glyphs: &mut []i32, styles: &mut []i64) {
    if target_is("arm64") && glyphs.len > 0 {
        unsafe {
            bytes.zero_memory(addr(&mut glyphs[0]), usize(glyphs.len) * size_of(i32))
            bytes.zero_memory(addr(&mut styles[0]), usize(styles.len) * size_of(i64))
        }
        return
    }
    for i in 0..glyphs.len {
        glyphs[i] = 0
        styles[i] = 0
    }
}

fn equivalent_spaces(glyph: i32, old: i32) -> bool {
    (glyph == 0 && old == WRITTEN_SPACE) || (old == 0 && glyph == WRITTEN_SPACE)
}

fn packed_boundary(glyphs: &[]i32, other_glyphs: &[]i32, styles: &[]i64, other_styles: &[]i64,
                   start: i32, end: i32, find_change: bool) -> i32 {
    mut at := start
    if find_change {
        while at < end && glyphs[at] == other_glyphs[at] && styles[at] == other_styles[at] { at += 1 }
    }
    for i in at..end {
        glyph := glyphs[i]
        old := other_glyphs[i]
        changed := styles[i] != other_styles[i] || (glyph != old && !equivalent_spaces(glyph, old))
        if changed == find_change { return i }
    }
    end
}

fn skip_unchanged_ascii(glyphs: &[]i32, previous: &[]i32, styles: &[]i64, old_styles: &[]i64,
                   start: i32, end: i32, shared_floor: i64) -> i32 {
    for i in start..end {
        glyph := glyphs[i]
        if (glyph < 0 || glyph >= PRINTABLE_ASCII_COUNT) && glyph != WRITTEN_SPACE { return i }
        if glyph != previous[i] || styles[i] < shared_floor || styles[i] != old_styles[i] { return i }
    }
    end
}

fn fill_packed(glyphs: &mut []i32, styles: &mut []i64, start: i32, end: i32, code: i32, keep: i64, set: i64) {
    for i in start..end {
        glyphs[i] = code
        styles[i] = styles[i].bit_and(keep).bit_or(set)
    }
}

fn append_ascii_run(out: &mut []u8, glyphs: &[]i32, styles: &[]i64, start: i32, end: i32, style: i64) -> i32 {
    for i in start..end {
        glyph := glyphs[i]
        if styles[i] != style { return i }
        if glyph >= 0 && glyph < 96 { out.push(u8(glyph + 32)) }
        else if glyph == WRITTEN_SPACE { out.push(b' ') }
        else { return i }
    }
    end
}

pub enum Color {
    Default, Black, Red, Green, Yellow, Blue, Magenta, Cyan, Gray, DarkGray,
    LightRed, LightGreen, LightYellow, LightBlue, LightMagenta, LightCyan, White, BrightWhite,
    Indexed(u8), Rgb(u8, u8, u8)
}

impl Color {
    fn is_default(&self) -> bool { match self { .Default => true, _ => false, } }
    pub fn code(&self) -> i32 {
        match self {
            .Default => -1, .Black => 0, .Red => 1, .Green => 2, .Yellow => 3, .Blue => 4,
            .Magenta => 5, .Cyan => 6, .Gray => 7, .White => 7, .DarkGray => 8, .LightRed => 9, .LightGreen => 10,
            .LightYellow => 11, .LightBlue => 12, .LightMagenta => 13, .LightCyan => 14, .BrightWhite => 15,
            .Indexed(n) => i32(n),
            .Rgb(r, g, b) => 0x1000000 + i32(r) * 65536 + i32(g) * 256 + i32(b),
        }
    }

    pub fn from_hsl(hue: f64, saturation: f64, lightness: f64) -> Self {
        rgb(colorspace.hsl(hue, saturation, lightness))
    }

    pub fn from_hsluv(hue: f64, saturation: f64, lightness: f64) -> Self {
        rgb(colorspace.hsluv(hue, saturation, lightness))
    }

    fn named(value: string) -> Option<Color> {
        match value {
            "Reset" | "reset" => .Some(.Default),
            "Black" | "black" => .Some(.Black),
            "Red" | "red" => .Some(.Red),
            "Green" | "green" => .Some(.Green),
            "Yellow" | "yellow" => .Some(.Yellow),
            "Blue" | "blue" => .Some(.Blue),
            "Magenta" | "magenta" => .Some(.Magenta),
            "Cyan" | "cyan" => .Some(.Cyan),
            "Gray" | "gray" | "grey" | "silver" => .Some(.Gray),
            "DarkGray" | "darkgray" | "darkgrey" | "darksilver" | "lightblack" | "brightblack" => .Some(.DarkGray),
            "LightRed" | "lightred" | "brightred" => .Some(.LightRed),
            "LightGreen" | "lightgreen" | "brightgreen" => .Some(.LightGreen),
            "LightYellow" | "lightyellow" | "brightyellow" => .Some(.LightYellow),
            "LightBlue" | "lightblue" | "brightblue" => .Some(.LightBlue),
            "LightMagenta" | "lightmagenta" | "brightmagenta" => .Some(.LightMagenta),
            "LightCyan" | "lightcyan" | "brightcyan" => .Some(.LightCyan),
            "White" | "white" | "lightwhite" | "lightgray" | "lightgrey" | "lightsilver" | "brightwhite" | "brightgray" | "brightgrey" | "brightsilver" => .Some(.BrightWhite),
            _ => .None,
        }
    }

    pub fn parse(value: string) -> Option<Color> {
        if value.len == 0 { return .None }
        if value[0] == b'#' {
            if value.len != 7 { return .None }
            mut packed: u32 = 0
            for i in 1..7 {
                b := value[i]
                digit := if b >= b'0' && b <= b'9' { i32(b-b'0') }
                    else if b >= b'A' && b <= b'F' { 10+i32(b-b'A') }
                    else if b >= b'a' && b <= b'f' { 10+i32(b-b'a') }
                    else if b == b'+' && i%2 == 1 { 0 } else { return .None }
                packed = packed.shl(4).bit_or(u32(digit))
            }
            return .Some(rgb(packed))
        }
        if value[0] == b'+' || (value[0] >= b'0' && value[0] <= b'9') {
            start := if value[0] == b'+' { 1 } else { 0 }
            index := parse.u64_range(value,start,value.len)
            if index.ok && index.value < 256 { return .Some(.Indexed(u8(index.value))) }
            return .None
        }
        match Color::named(value) { .Some(color) => { return .Some(color) }, .None => {}, }
        mut name: []u8 = []
        mut i := 0
        while i < value.len {
            mut b := value[i]
            i += 1
            if b == b' ' || b == b'-' || b == b'_' { continue }
            if b >= b'A' && b <= b'Z' { b += 32 }
            else if b == 0xe2 && value.len-i >= 2 && value[i-1..i+2] == "K" { b = b'k'; i += 2 }
            else if b < b'a' || b > b'z' { return .None }
            if name.len == 13 { return .None }
            name.push(b)
        }
        Color::named(bytes.decode(&name).unwrap())
    }

    fn encoded(&self) -> i32 {
        match self { .Indexed(n) => 256 + i32(n), _ => self.code(), }
    }

    fn decoded(code: i32) -> Self {
        if code < 0 { return .Default }
        if code < 16 {
            return match code {
                0 => .Black, 1 => .Red, 2 => .Green, 3 => .Yellow,
                4 => .Blue, 5 => .Magenta, 6 => .Cyan, 7 => .Gray,
                8 => .DarkGray, 9 => .LightRed, 10 => .LightGreen, 11 => .LightYellow,
                12 => .LightBlue, 13 => .LightMagenta, 14 => .LightCyan, _ => .BrightWhite,
            }
        }
        if code < 512 { return .Indexed(u8(code - 256)) }
        rgb(u32(code))
    }
}

impl Display for Color {
    fn str(&self) -> string {
        match self {
            .Default => "Reset", .Black => "Black", .Red => "Red", .Green => "Green",
            .Yellow => "Yellow", .Blue => "Blue", .Magenta => "Magenta", .Cyan => "Cyan",
            .Gray => "Gray", .DarkGray => "DarkGray", .LightRed => "LightRed",
            .LightGreen => "LightGreen", .LightYellow => "LightYellow", .LightBlue => "LightBlue",
            .LightMagenta => "LightMagenta", .LightCyan => "LightCyan", .White => "Gray", .BrightWhite => "White",
            .Indexed(n) => n.str(),
            .Rgb(r, g, b) => {
                digits := "0123456789ABCDEF"
                mut out: []u8 = [b'#']
                for channel in [r, g, b] {
                    out.push(digits[i32(channel) / 16])
                    out.push(digits[i32(channel) % 16])
                }
                bytes.decode(&out).unwrap()
            },
        }
    }
}

impl Eq for Color {
    fn eq(&self, other: &Self) -> bool {
        match self {
            .Default => match other { .Default => true, _ => false, },
            .Indexed(n) => match other { .Indexed(m) => n == m, _ => false, },
            .Rgb(r,g,b) => match other { .Rgb(rr,gg,bb) => r == rr && g == gg && b == bb, _ => false, },
            _ => self.encoded() == other.encoded(),
        }
    }
}

impl Hash for Color {
    fn hash(&self) -> u64 { self.encoded().hash() }
}

impl json.Encode for Color {
    fn encode_json(&self, out: &mut json.Writer) { out.string(self.str()) }
}

impl json.Decode for Color {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self, json.JsonError> {
        if doc.kind(node) == .String {
            match Color::parse(doc.as_str(node).unwrap()) {
                .Some(color) => { return .Ok(color) },
                .None => {},
            }
        } else if doc.kind(node) == .Object && doc.count(node) == 1 {
            key := doc.key_at(node, 0).unwrap()
            value := doc.val_at(node, 0)
            if key == "Indexed" { return .Ok(.Indexed(u8::decode_json(&doc, value)?)) }
            if key == "Rgb" && doc.kind(value) == .Array && doc.count(value) == 3 {
                red := u8::decode_json(&doc, doc.at(value, 0))?
                green := u8::decode_json(&doc, doc.at(value, 1))?
                blue := u8::decode_json(&doc, doc.at(value, 2))?
                return .Ok(.Rgb(red, green, blue))
            }
        }
        .Err(json.JsonError::new("invalid terminal color", doc.node_offset(node)))
    }
}

fn packed_rgb(value: u32) -> i32 { 0x1000000 + i32(value.bit_and(0xffffff)) }

pub fn rgb(value: u32) -> Color {
    .Rgb(u8(value.shr(16).bit_and(255)), u8(value.shr(8).bit_and(255)), u8(value.bit_and(255)))
}

pub enum Modifier { Bold, Dim, Italic, Underlined, SlowBlink, RapidBlink, Reversed, Hidden, CrossedOut }

impl Modifier {
    fn mask(self) -> i32 {
        match self {
            .Bold => 1, .Dim => 2, .Italic => 4, .Underlined => 8, .SlowBlink => 16,
            .RapidBlink => 32, .Reversed => 64, .Hidden => 128, .CrossedOut => 256,
        }
    }
}

const INHERIT: i32 = -2

@derive(Eq, Hash)
pub opaque struct Style {
    fg: i32, bg: i32, underline: i32, added: i32, removed: i32,
}

impl paint.PackedStyle for Style {
    fn packed_colors(&self) -> i64 {
        i64(self.fg - INHERIT).bit_or(i64(self.bg - INHERIT).shl(26))
    }

    fn packed_attributes(&self) -> i64 {
        i64(self.underline - INHERIT).bit_or(i64(self.added).shl(26)).bit_or(i64(self.removed).shl(42))
    }

    fn from_packed(colors: i64, attributes: i64) -> Self {
        Self {
            fg: i32(colors.bit_and(0x3ffffff)) + INHERIT,
            bg: i32(colors.shr(26).bit_and(0x3ffffff)) + INHERIT,
            underline: i32(attributes.bit_and(0x3ffffff)) + INHERIT,
            added: i32(attributes.shr(26).bit_and(0xffff)),
            removed: i32(attributes.shr(42).bit_and(0xffff)),
        }
    }
}

pub fn plain() -> Style { Style { fg: INHERIT, bg: INHERIT, underline: INHERIT, added: 0, removed: 0 } }
pub fn ink(color: Color) -> Style { plain().foreground(color) }

impl Style {
    pub fn reset() -> Self {
        Self { fg: -1, bg: -1, underline: -1, added: 0, removed: 511 }
    }

    pub fn default_colors() -> Self { mut s := plain(); s.fg = -1; s.bg = -1; s }
    pub fn swap_colors(self) -> Self { mut s := self; s.fg = self.bg; s.bg = self.fg; s }

    pub fn foreground(self, color: Color) -> Self { mut s := self; s.fg = color.encoded(); s }
    pub fn background(self, color: Color) -> Self { mut s := self; s.bg = color.encoded(); s }
    pub fn underline_color(self, color: Color) -> Self { mut s := self; s.underline = color.encoded(); s }

    pub fn foreground_rgb(self, rgb: u32) -> Self { mut s := self; s.fg = packed_rgb(rgb); s }
    pub fn background_rgb(self, rgb: u32) -> Self { mut s := self; s.bg = packed_rgb(rgb); s }
    pub fn underline_rgb(self, rgb: u32) -> Self { mut s := self; s.underline = packed_rgb(rgb); s }
    pub fn foreground_index(self, index: u8) -> Self { mut s := self; s.fg = 256 + i32(index); s }
    pub fn background_index(self, index: u8) -> Self { mut s := self; s.bg = 256 + i32(index); s }
    pub fn underline_index(self, index: u8) -> Self { mut s := self; s.underline = 256 + i32(index); s }

    pub fn with(self, modifier: Modifier) -> Self {
        mut s := self
        mask := modifier.mask()
        s.added = s.added.bit_or(mask)
        s.removed = s.removed.bit_and(mask.bit_not())
        s
    }

    pub fn without(self, modifier: Modifier) -> Self {
        mut s := self
        mask := modifier.mask()
        s.removed = s.removed.bit_or(mask)
        s.added = s.added.bit_and(mask.bit_not())
        s
    }

    fn empty(&self) -> bool {
        self.added == 0 && self.removed == 0 && self.fg == INHERIT && self.bg == INHERIT && self.underline == INHERIT
    }

    fn keep_bits(&self) -> i64 {
        mut clear := i64(self.removed.bit_and(511)).shl(52)
        if self.fg != INHERIT { clear = clear.bit_or(0x3ffffff) }
        if self.bg != INHERIT { clear = clear.bit_or(i64(0x3ffffff).shl(26)) }
        clear.bit_not()
    }

    fn color(code: i32) -> Option<Color> {
        if code == INHERIT { return .None }
        .Some(Color::decoded(code))
    }

    pub fn get_foreground(&self) -> Option<Color> { Style::color(self.fg) }
    pub fn get_background(&self) -> Option<Color> { Style::color(self.bg) }
    pub fn get_underline_color(&self) -> Option<Color> { Style::color(self.underline) }
    pub fn removes(&self, modifier: Modifier) -> bool { self.removed.bit_and(modifier.mask()) != 0 }

    pub fn has(&self, modifier: Modifier) -> bool { self.added.bit_and(modifier.mask()) != 0 }
    pub fn bold(self) -> Self { self.with(.Bold) }
    pub fn dim(self) -> Self { self.with(.Dim) }
    pub fn italic(self) -> Self { self.with(.Italic) }
    pub fn underlined(self) -> Self { self.with(.Underlined) }
    pub fn inverted(self) -> Self { self.with(.Reversed) }

    pub fn patch(self, overlay: Style) -> Self {
        mut s := self
        if overlay.fg != INHERIT { s.fg = overlay.fg }
        if overlay.bg != INHERIT { s.bg = overlay.bg }
        if overlay.underline != INHERIT { s.underline = overlay.underline }
        s.added = s.added.bit_and(overlay.removed.bit_not()).bit_or(overlay.added)
        s.removed = s.removed.bit_and(overlay.added.bit_not()).bit_or(overlay.removed)
        s
    }

    fn brush(&self) -> paint.Brush {
        paint.Brush {
            fg: if self.fg == INHERIT { -1 } else { self.fg }, bg: if self.bg == INHERIT { -1 } else { self.bg },
            modifiers: self.cell_modifiers().bit_and(511)
        }
    }

    fn cell_modifiers(&self) -> i32 { self.added.bit_and(self.removed.bit_not()) }
}

fn write_color(out: &mut json.Writer, key: string, color: i32) {
    if color != INHERIT {
        out.key(key)
        out.string(Color::decoded(color).str())
    }
}

fn read_color(doc: &json.Doc, node: i32) -> Result<i32, json.JsonError> {
    if node < 0 || doc.kind(node) == .Null { return .Ok(INHERIT) }
    color := Color::decode_json(&doc, node)?
    .Ok(color.encoded())
}

impl json.Encode for Style {
    fn encode_json(&self, out: &mut json.Writer) { self.write_snapshot(&mut out,.WithUnderlineColor) }
}
impl json.Decode for Style {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        Style::read_snapshot(&doc,node,.WithUnderlineColor)
    }
}

impl snapshot.Write for Style {
    fn write_snapshot(&self, out: &mut json.Writer, format: snapshot.Format) {
        out.object()
        write_color(&mut out, "fg", self.fg)
        write_color(&mut out, "bg", self.bg)
        if format.has_underline_color() { write_color(&mut out, "underline_color", self.underline) }
        theme_format.write_flags(&mut out, "add_modifier", self.added)
        theme_format.write_flags(&mut out, "sub_modifier", self.removed)
        out.end()
    }
}

impl snapshot.Read for Style {
    fn read_snapshot(doc: &json.Doc, node: i32, format: snapshot.Format) -> Result<Self, json.JsonError> {
        with_underline := format.has_underline_color()
        first_flag := if with_underline { 3 } else { 2 }
        fields := if with_underline {
            json_format.fields(&doc,node,&["fg","bg","underline_color","add_modifier","sub_modifier"],0,3)?
        } else {
            json_format.fields(&doc,node,&["fg","bg","add_modifier","sub_modifier"],0,2)?
        }
        fg := read_color(&doc, fields[0])?
        bg := read_color(&doc, fields[1])?
        underline := if with_underline { read_color(&doc,fields[2])? } else { INHERIT }
        added := theme_format.read_flags(&doc, fields[first_flag])?
        removed := theme_format.read_flags(&doc, fields[first_flag+1])?
        .Ok(Self { fg: fg, bg: bg, underline: underline, added: added, removed: removed })
    }
}

fn decoration_bits(underline: i32, modifiers: i32) -> i64 {
    color := if underline < 0 { 0 } else { underline + 1 }
    i64(modifiers.bit_and(0xfe00)).shl(26).bit_or(i64(color))
}

fn detail_underline(details: i64) -> i32 { i32(details.bit_and(0x3ffffff)) - 1 }

@derive(Hash)
pub struct Rect { x: i32, y: i32, w: i32, h: i32 }

impl json.Encode for Rect {
    fn encode_json(&self, out: &mut json.Writer) {
        if self.x < 0 || self.x > 65535 || self.y < 0 || self.y > 65535 ||
            self.w < 0 || self.w > 65535 || self.h < 0 || self.h > 65535 {
            json_format.reject(&mut out, "rectangle fields must be in 0..65535")
            return
        }
        out.object()
        json.field_value(&mut out, "x", &self.x)
        json.field_value(&mut out, "y", &self.y)
        json.field_value(&mut out, "width", &self.w)
        json.field_value(&mut out, "height", &self.h)
        out.end()
    }
}

impl json.Decode for Rect {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self, json.JsonError> {
        f := json_format.fields(&doc, node, &["x", "y", "width", "height"], 4, 4)?
        x := u16::decode_json(&doc, f[0])?
        y := u16::decode_json(&doc, f[1])?
        w := u16::decode_json(&doc, f[2])?
        h := u16::decode_json(&doc, f[3])?
        .Ok(Self { x:i32(x), y:i32(y), w:i32(w), h:i32(h) })
    }
}

fn clamp(n: i32, limit: i32) -> i32 {
    if n < 0 { return 0 }
    if n > limit { return limit }
    n
}

pub opaque struct RectLines { area: Rect, columns: bool, front: i32, back: i32, clipped: i32 }

impl RectLines {
    pub fn remaining(&self) -> i32 { self.back-self.front }
    pub fn size_hint(&self) -> i32 { self.remaining()+self.clipped }

    fn line(&self, index: i32) -> Option<Rect> {
        if self.columns { self.area.column_at(index) } else { self.area.row_at(index) }
    }

    pub fn next_back(&mut self) -> Option<Rect> {
        if self.front == self.back { return .None }
        self.back -= 1
        self.line(self.back)
    }
}

impl Iterator for RectLines {
    fn next(&mut self) -> Option<Rect> {
        if self.front == self.back { return .None }
        i := self.front
        self.front += 1
        self.line(i)
    }
}

pub opaque struct RectPositions {
    left: i32, right: i32, bottom: i32, width: i32, next_x: i32, next_y: i32, x: i32, y: i32
}

impl RectPositions {
    pub fn remaining(&self) -> i64 {
        if self.next_y == self.bottom { return 0 }
        i64(self.bottom-self.next_y-1)*i64(self.right-self.left) + i64(self.right-self.next_x)
    }

    pub fn size_hint(&self) -> i32 {
        if self.next_y == self.bottom { return 0 }
        count := i64(self.bottom-self.next_y-1)*i64(self.width) + i64(self.right-self.next_x)
        i32(cmp.min<i64>(65535,count))
    }

    pub fn advance(&mut self) -> bool {
        if self.next_y == self.bottom || self.left == self.right { return false }
        self.x = self.next_x
        self.y = self.next_y
        self.next_x += 1
        if self.next_x == self.right { self.next_x = self.left; self.next_y += 1 }
        true
    }

    pub fn x(&self) -> i32 { self.x }
    pub fn y(&self) -> i32 { self.y }
}

impl Iterator for RectPositions {
    fn next(&mut self) -> Option<(i32,i32)> {
        if self.advance() { .Some((self.x,self.y)) } else { .None }
    }
}

impl Eq for Rect {
    fn eq(&self, other: &Self) -> bool { self.x == other.x && self.y == other.y && self.w == other.w && self.h == other.h }
}

impl Rect {
    pub fn from_position_size(point: geometry.Position, size: geometry.Size) -> Self {
        Self { x:i32(point.x), y:i32(point.y), w:i32(size.width), h:i32(size.height) }
    }

    pub fn as_position(self) -> geometry.Position {
        geometry.Position { x:u16(clamp(self.x,65535)), y:u16(clamp(self.y,65535)) }
    }

    pub fn as_size(self) -> geometry.Size {
        geometry.Size { width:u16(clamp(self.w,65535)), height:u16(clamp(self.h,65535)) }
    }

    pub fn new(x: i32, y: i32, width: i32, height: i32) -> Rect {
        left := clamp(x,65535)
        top := clamp(y,65535)
        Rect { x:left, y:top, w:clamp(width,65535-left), h:clamp(height,65535-top) }
    }

    fn end_of_axis(origin: i32, size: i32) -> i32 {
        end := i64(origin) + i64(cmp.max<i32>(0, size))
        if end <= 65535 { return i32(end) }
        if origin >= 0 && origin <= 65535 && size <= 65535 { return 65535 }
        i32(cmp.min<i64>(2147483647, end))
    }

    pub fn right(self) -> i32 { Rect::end_of_axis(self.x, self.w) }
    pub fn bottom(self) -> i32 { Rect::end_of_axis(self.y, self.h) }
    pub fn is_empty(self) -> bool { self.w <= 0 || self.h <= 0 }
    pub fn cell_count(self) -> i64 { i64(cmp.max<i32>(0, self.w)) * i64(cmp.max<i32>(0, self.h)) }

    pub fn contains(self, x: i32, y: i32) -> bool {
        x >= self.x && y >= self.y && x < self.right() && y < self.bottom()
    }

    pub fn intersects(self, other: Rect) -> bool {
        self.x < other.right() && self.y < other.bottom() && self.right() > other.x && self.bottom() > other.y
    }

    pub fn resize(self, width: i32, height: i32) -> Rect {
        x := cmp.min<i32>(self.x, 65535)
        y := cmp.min<i32>(self.y, 65535)
        Rect { x:x, y:y, w:clamp(width,65535-cmp.max<i32>(0,x)), h:clamp(height,65535-cmp.max<i32>(0,y)) }
    }

    pub fn offset(self, dx: i32, dy: i32) -> Rect {
        w := clamp(self.w, 65535)
        h := clamp(self.h, 65535)
        Rect { x: i32(cmp.clamp<i64>(i64(self.x)+i64(dx), 0, 65535-i64(w))),
            y: i32(cmp.clamp<i64>(i64(self.y)+i64(dy), 0, 65535-i64(h))), w: w, h: h }
    }

    pub fn outer(self, horizontal: i32, vertical: i32) -> Rect {
        h := i64(clamp(horizontal, 65535))
        v := i64(clamp(vertical, 65535))
        x := cmp.clamp<i64>(i64(self.x)-h, 0, 65535)
        y := cmp.clamp<i64>(i64(self.y)-v, 0, 65535)
        r := cmp.clamp<i64>(i64(self.right())+h, x, 65535)
        b := cmp.clamp<i64>(i64(self.bottom())+v, y, 65535)
        Rect { x: i32(x), y: i32(y), w: i32(r-x), h: i32(b-y) }
    }

    pub fn union(self, other: Rect) -> Rect {
        x := cmp.min<i32>(self.x, other.x)
        y := cmp.min<i32>(self.y, other.y)
        w := cmp.min<i64>(2147483647, i64(cmp.max<i32>(self.right(), other.right())) - i64(x))
        h := cmp.min<i64>(2147483647, i64(cmp.max<i32>(self.bottom(), other.bottom())) - i64(y))
        Rect { x: x, y: y, w: i32(w), h: i32(h) }
    }

    pub fn iter_rows(self) -> RectLines {
        count := self.bottom()-self.y
        RectLines { area:self, columns:false, front:0, back:count, clipped:cmp.max<i32>(0,self.h)-count }
    }

    pub fn iter_columns(self) -> RectLines {
        count := self.right()-self.x
        RectLines { area:self, columns:true, front:0, back:count, clipped:cmp.max<i32>(0,self.w)-count }
    }

    pub fn positions(self) -> RectPositions {
        RectPositions { left:self.x, right:self.right(), bottom:self.bottom(), width:cmp.max<i32>(0,self.w),
            next_x:self.x, next_y:self.y, x:self.x, y:self.y }
    }

    pub fn row_at(self, index: i32) -> Option<Rect> {
        if index < 0 || i64(index) >= i64(self.bottom())-i64(self.y) { return .None }
        .Some(Rect { x:self.x, y:self.y+index, w:self.right()-self.x, h:1 })
    }

    pub fn column_at(self, index: i32) -> Option<Rect> {
        if index < 0 || i64(index) >= i64(self.right())-i64(self.x) { return .None }
        .Some(Rect { x:self.x+index, y:self.y, w:1, h:self.bottom()-self.y })
    }

    pub fn position_at(self, index: i64) -> Option<(i32,i32)> {
        w := i64(self.right())-i64(self.x)
        h := i64(self.bottom())-i64(self.y)
        if index < 0 || index >= w*h { return .None }
        .Some((self.x+i32(index%w),self.y+i32(index/w)))
    }

    pub fn clamp_to(self, bounds: Rect) -> Rect {
        w := i32(cmp.min<i64>(i64(cmp.max<i32>(0, self.w)), i64(bounds.right())-i64(bounds.x)))
        h := i32(cmp.min<i64>(i64(cmp.max<i32>(0, self.h)), i64(bounds.bottom())-i64(bounds.y)))
        Rect { x: cmp.clamp<i32>(self.x, bounds.x, bounds.right()-w),
            y: cmp.clamp<i32>(self.y, bounds.y, bounds.bottom()-h), w: w, h: h }
    }

    pub fn inner(self, horizontal: i32, vertical: i32) -> Rect {
        h := clamp(horizontal, 65535)
        v := clamp(vertical, 65535)
        dw := clamp(2*h, 65535)
        dh := clamp(2*v, 65535)
        if self.w < dw || self.h < dh { return Rect::new(0, 0, 0, 0) }
        x := i32(cmp.min<i64>(65535, i64(self.x)+i64(h)))
        y := i32(cmp.min<i64>(65535, i64(self.y)+i64(v)))
        Rect { x:x, y:y, w:clamp(self.w-dw,65535), h:clamp(self.h-dh,65535) }
    }

    pub fn intersection(self, other: Rect) -> Rect {
        x := cmp.max<i32>(self.x, other.x)
        y := cmp.max<i32>(self.y, other.y)
        right := cmp.min<i64>(i64(self.x) + i64(self.w), i64(other.x) + i64(other.w))
        bottom := cmp.min<i64>(i64(self.y) + i64(self.h), i64(other.y) + i64(other.h))
        Rect { x: x, y: y, w: i32(cmp.max<i64>(0, right - i64(x))), h: i32(cmp.max<i64>(0, bottom - i64(y))) }
    }

    pub fn take_rows(&mut self, first: i32) -> Rect {
        n := clamp(first, cmp.max<i32>(0, self.h))
        part := Rect { x: self.x, y: self.y, w: self.w, h: n }
        self.y = i32(cmp.min<i64>(2147483647, i64(self.y) + i64(n)))
        self.h = cmp.max<i32>(0, self.h - n)
        part
    }

    pub fn take_cols(&mut self, first: i32) -> Rect {
        n := clamp(first, cmp.max<i32>(0, self.w))
        part := Rect { x: self.x, y: self.y, w: n, h: self.h }
        self.x = i32(cmp.min<i64>(2147483647, i64(self.x) + i64(n)))
        self.w = cmp.max<i32>(0, self.w - n)
        part
    }

    pub fn rows(self, first: i32) -> (Rect, Rect) {
        mut rest := self
        part := rest.take_rows(first)
        (part, rest)
    }

    pub fn cols(self, first: i32) -> (Rect, Rect) {
        mut rest := self
        part := rest.take_cols(first)
        (part, rest)
    }

    pub fn inset(self, padding: i32) -> Rect {
        (_, rest) := self.rows(padding)
        (middle, _) := rest.rows(rest.h - clamp(padding, rest.h))
        (_, right) := middle.cols(padding)
        (body, _) := right.cols(right.w - clamp(padding, right.w))
        body
    }
}

const PRINTABLE_ASCII_COUNT: i32 = 127-32
const WIDE_LENGTH_TAG: i32 = 65536
const CLUSTER: i32 = 0x110000
const ZERO_CLUSTER: i32 = 0x110001
const EMPTY_SYMBOL: i32 = 0x110002
const WIDE: i32 = 0x200000
const WRITTEN_SPACE: i32 = 0x1fffff

@derive(Eq, Hash)
pub enum CellDiffOption { None, Skip, AlwaysUpdate, ForcedWidth(i32) }
impl Default for CellDiffOption {
    fn default() -> Self { .None }
}

impl CellDiffOption {
    fn code(&self) -> i32 {
        match self { .None => 0, .Skip => SKIP_CELL, .AlwaysUpdate => ALWAYS_UPDATE, .ForcedWidth(w) => w, }
    }
    fn from_code(code: i32) -> Self {
        match code { 0 => .None, -1 => .Skip, -2 => .AlwaysUpdate, _ => .ForcedWidth(code), }
    }
    fn valid(&self) -> bool {
        match self { .ForcedWidth(w) => w > 0 && w <= 65535, _ => true, }
    }
}

impl json.Encode for CellDiffOption {
    fn encode_json(&self, out: &mut json.Writer) {
        match self {
            .None => { out.string("None") }, .Skip => { out.string("Skip") }, .AlwaysUpdate => { out.string("AlwaysUpdate") },
            .ForcedWidth(w) => {
                if !self.valid() { json_format.reject(&mut out, "forced cell width must be between 1 and 65535"); return }
                out.object()
                json.field_value(&mut out, "ForcedWidth", &w)
                out.end()
            },
        }
    }
}

impl json.Decode for CellDiffOption {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        if doc.kind(node) == .Object && doc.count(node) == 1 && doc.key_at(node,0).unwrap() == "ForcedWidth" {
            w := u16::decode_json(&doc, doc.val_at(node,0))?
            if w == 0 { return .Err(json.JsonError::new("forced cell width must be positive",doc.node_offset(node))) }
            return .Ok(.ForcedWidth(i32(w)))
        }
        name := json_format.unit_name(&doc, node)?
        match name {
            "None" => .Ok(.None), "Skip" => .Ok(.Skip), "AlwaysUpdate" => .Ok(.AlwaysUpdate),
            _ => .Err(json.JsonError::new("unknown cell diff option",doc.node_offset(node))),
        }
    }
}

@derive(Eq)
pub struct Modifiers { bits: u16 }

impl Modifiers {
    pub fn contains(&self, flag: Modifier) -> bool { i32(self.bits).bit_and(flag.mask()) != 0 }
}

impl json.Encode for Modifiers {
    fn encode_json(&self, out: &mut json.Writer) { out.string(theme_format.flag_names(i32(self.bits))) }
}

impl json.Decode for Modifiers {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        if doc.kind(node) != .String { return .Err(json.JsonError::new("expected modifier names",doc.node_offset(node))) }
        flags := theme_format.read_flags(&doc, node)?
        .Ok(Self { bits:u16(flags) })
    }
}

pub struct RawCell {
    symbol: Option<string>, fg: Color, bg: Color, underline_color: Color, modifier: Modifiers, diff_option: CellDiffOption, skip: bool,
}

struct CellStyle { style: Style, fg: Color, bg: Color, underline: Color }

impl CellStyle {
    fn new(style: Style) -> Self {
        Self { style:style, fg:Color::decoded(style.fg), bg:Color::decoded(style.bg), underline:Color::decoded(style.underline) }
    }
    fn apply(&self, cell: &mut RawCell) {
        if self.style.fg != INHERIT { cell.fg = self.fg }
        if self.style.bg != INHERIT { cell.bg = self.bg }
        if self.style.underline != INHERIT { cell.underline_color = self.underline }
        cell.modifier.bits = u16(i32(cell.modifier.bits).bit_or(self.style.added).bit_and(self.style.removed.bit_not()))
    }
}

impl RawCell {
    pub fn new(move symbol: string) -> Self {
        mut cell := Self::empty()
        cell.symbol = .Some(move symbol)
        move cell
    }
    pub fn from_char(ch: rune) -> Self { Self::new(ch.str()) }
    pub fn empty() -> Self {
        Self { symbol:.None, fg:.Default, bg:.Default, underline_color:.Default, modifier:Modifiers { bits:0 }, diff_option:.None, skip:false }
    }
    pub fn style(&self) -> Style {
        Style { fg:self.fg.encoded(), bg:self.bg.encoded(), underline:self.underline_color.encoded(), added:i32(self.modifier.bits), removed:0 }
    }
    pub fn symbol_text(&self) -> string {
        match &self.symbol { .Some(value) => value.clone(), .None => " ", }
    }
    pub fn set_symbol(&mut self, move symbol: string) -> &mut Self from self {
        self.symbol = .Some(move symbol)
        &mut self
    }
    pub fn set_char(&mut self, ch: rune) -> &mut Self from self { self.set_symbol(ch.str()) }
    pub fn merge_symbol(&mut self, symbol: string, strategy: lines.Merge) -> &mut Self from self {
        merged := match &self.symbol {
            .None => symbol.clone(),
            .Some(old) => lines.merge_symbols(old, symbol, strategy),
        }
        self.set_symbol(move merged)
    }
    pub fn set_fg(&mut self, color: Color) -> &mut Self from self { self.fg = color; &mut self }
    pub fn set_bg(&mut self, color: Color) -> &mut Self from self { self.bg = color; &mut self }
    pub fn set_style(&mut self, style: Style) -> &mut Self from self {
        CellStyle::new(style).apply(&mut self)
        &mut self
    }
    fn write_symbol(&mut self, view: &str) {
        if view.len == 1 { self.write_ascii(view[0]); return }
        match &self.symbol { .Some(old) => { if old.as_str() == view { return } }, .None => {}, }
        self.symbol = .Some(view.to_string())
    }
    fn write_ascii(&mut self, ch: u8) {
        match &self.symbol { .Some(old) => { if old.len == 1 && old[0] == ch { return } }, .None => {}, }
        self.symbol = .Some(rune(i32(ch)).str())
    }
    pub fn set_diff_option(&mut self, option: CellDiffOption) -> &mut Self from self {
        assert(option.valid())
        self.diff_option = option
        &mut self
    }
    pub fn set_skip(&mut self, skip: bool) -> &mut Self from self { self.skip = skip; &mut self }
    pub fn reset(&mut self) { self = Self::empty() }
    pub fn cell_width(&self) -> i32 {
        match &self.diff_option { .ForcedWidth(w) => w, _ => self.columns(), }
    }
    fn empty_tail(&self) -> bool {
        self.symbol.is_none() && self.fg.is_default() && self.bg.is_default() && self.underline_color.is_default() && self.modifier.bits == 0
    }
    fn columns(&self) -> i32 {
        match &self.symbol { .Some(value) => width.cell_columns(value), .None => 1, }
    }
}

impl Default for RawCell { fn default() -> Self { Self::empty() } }

const GENERAL_CELL: i32 = -2
const SKIPPED_NARROW: i32 = -1
const HAS_COLOR: i32 = 0x1000000

impl RawCell {
    // Bits 0–7 hold the glyph, 8–23 the modifiers, and 24 marks any non-default colour.
    fn narrow_key(&self) -> i32 {
        symbol := match &self.symbol {
            .None => 32,
            .Some(s) => {
                if s.len != 1 { return GENERAL_CELL }
                i32(s[0])
            },
        }
        match &self.diff_option { .None => {}, _ => { return GENERAL_CELL }, }
        if self.skip { return SKIPPED_NARROW }
        key := i32(self.modifier.bits).shl(8).bit_or(symbol)
        match &self.fg { .Default => {}, _ => { return key.bit_or(HAS_COLOR) }, }
        match &self.bg { .Default => {}, _ => { return key.bit_or(HAS_COLOR) }, }
        match &self.underline_color { .Default => key, _ => key.bit_or(HAS_COLOR), }
    }
    fn same_style(&self, other: &Self) -> bool {
        if self.modifier.bits != other.modifier.bits { return false }
        self.same_colors(&other)
    }
    fn same_colors(&self, other: &Self) -> bool {
        self.fg == other.fg && self.bg == other.bg && self.underline_color == other.underline_color
    }
    fn same_symbol(&self, other: &Self) -> bool {
        match &self.symbol {
            .None => match &other.symbol { .Some(b) => b == " ", .None => true, },
            .Some(a) => match &other.symbol { .Some(b) => a == b, .None => a == " ", },
        }
    }
}

impl Eq for RawCell {
    fn eq(&self, other: &Self) -> bool {
        self.skip == other.skip && self.diff_option == other.diff_option &&
            self.same_style(&other) && self.same_symbol(&other)
    }
}

impl Hash for RawCell {
    fn hash(&self) -> u64 {
        mut state := hash.Hasher::new()
        match &self.symbol { .Some(value) => { state.write_str(value) }, .None => { state.write_str(" ") }, }
        state.write_u64(self.style().hash())
        state.write_u64(self.diff_option.hash())
        state.write_u64(self.skip.hash())
        state.finish()
    }
}

impl json.Encode for RawCell {
    fn encode_json(&self, out: &mut json.Writer) { self.write_snapshot(&mut out,.WithUnderlineColor) }
}
impl json.Decode for RawCell {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        RawCell::read_snapshot(&doc,node,.WithUnderlineColor)
    }
}

impl snapshot.Write for RawCell {
    fn write_snapshot(&self, out: &mut json.Writer, format: snapshot.Format) {
        out.object()
        json.field_value(&mut out,"symbol",&self.symbol)
        json.field_value(&mut out,"fg",&self.fg)
        json.field_value(&mut out,"bg",&self.bg)
        if format.has_underline_color() { json.field_value(&mut out,"underline_color",&self.underline_color) }
        json.field_value(&mut out,"modifier",&self.modifier)
        json.field_value(&mut out,"diff_option",&self.diff_option)
        json.field_value(&mut out,"skip",&self.skip)
        out.end()
    }
}

impl snapshot.Read for RawCell {
    fn read_snapshot(doc: &json.Doc, node: i32, format: snapshot.Format) -> Result<Self,json.JsonError> {
        with_underline := format.has_underline_color()
        flags := if with_underline { 4 } else { 3 }
        f := if with_underline {
            json_format.fields(&doc,node,&["symbol","fg","bg","underline_color","modifier","diff_option","skip"],0,7)?
        } else {
            json_format.fields(&doc,node,&["symbol","fg","bg","modifier","diff_option","skip"],0,6)?
        }
        symbol := json.decode<Option<string>>(&doc, f[0])?
        fg := Color::decode_json(&doc, f[1])?
        bg := Color::decode_json(&doc, f[2])?
        underline: Color = if with_underline { Color::decode_json(&doc,f[3])? } else { .Default }
        modifier := Modifiers::decode_json(&doc, f[flags])?
        option := CellDiffOption::decode_json(&doc, f[flags+1])?
        skip := bool::decode_json(&doc, f[flags+2])?
        .Ok(Self { symbol:move symbol, fg:fg, bg:bg, underline_color:underline, modifier:modifier, diff_option:option, skip:skip })
    }
}

@derive(Eq, Hash)
pub struct Buffer { area: Rect, content: []RawCell }

impl Default for Buffer {
    fn default() -> Self { Self { area:Rect::new(0,0,0,0), content:[] } }
}

pub struct BufferPair { previous: &Buffer, current: &Buffer }
pub opaque struct BufferDiff {
    current: &Buffer, previous: &Buffer,
    at: i32, trailing: i32, force: bool, limit: i32, index: i32,
}
pub struct CellChange { x: i32, y: i32, cell: &RawCell }

impl BufferPair {
    fn compatible(&self) -> bool {
        a := &self.current.area
        b := &self.previous.area
        if a.x != b.x || a.y != b.y || a.w != b.w { return false }
        a.w >= 0 || self.current.content.len == 0 || self.previous.content.len == 0
    }
    pub fn diff_iter(&self) -> BufferDiff from self {
        assert(self.compatible())
        BufferDiff {
            current:&self.current, previous:&self.previous, at:0, trailing:0, force:false,
            limit:cmp.min<i32>(self.current.content.len,self.previous.content.len), index:-1,
        }
    }
}

impl BufferDiff {
    pub fn advance(&mut self) -> bool {
        current := &self.current
        previous := &self.previous
        mut i := self.at
        while i < self.limit {
            a := &current.content[i]
            b := &previous.content[i]
            if i >= self.trailing {
                next := a.narrow_key()
                if next == SKIPPED_NARROW { i += 1; continue }
                if next != GENERAL_CELL {
                    old := b.narrow_key()
                    if old != GENERAL_CELL {
                        if next == old && (next.bit_and(HAS_COLOR) == 0 || a.same_colors(&b)) {
                            i += 1
                            continue
                        }
                        self.at = i+1
                        self.index = i
                        return true
                    }
                }
            }
            self.at = i
            if !changed_cell(&current,&previous,self.limit,false,&mut self.at,&mut self.trailing,&mut self.force) {
                i = self.at
                continue
            }
            self.index = i
            return true
        }
        self.at = self.limit
        self.index = -1
        false
    }
    pub fn x(&self) -> i32 { (self.current.area.x + self.index%self.current.area.w).bit_and(65535) }
    pub fn y(&self) -> i32 { (self.current.area.y + (self.index/self.current.area.w).bit_and(65535)).bit_and(65535) }
    pub fn cell(&self) -> &RawCell from self.current { &self.current.content[self.index] }
}

impl Iterator for BufferDiff {
    fn next(&mut self) -> Option<CellChange> from self.current {
        if self.advance() {
            return .Some(CellChange { x:self.x(), y:self.y(), cell:&self.current.content[self.index] })
        }
        .None
    }
}

impl Buffer {
    fn stored_option(&self, i: i32) -> i32 {
        cell := &self.content[i]
        cell_rule(cell.diff_option.code(), cell.skip)
    }
    fn option_code(&self, i: i32) -> i32 {
        cell := &self.content[i]
        code := cell.diff_option.code()
        if cell.skip && code == 0 { SKIP_CELL } else { code }
    }
    fn output_width(&self, i: i32, option: i32) -> i32 {
        if option > 0 { option } else { cmp.max<i32>(1, self.content[i].columns()) }
    }
    fn same_symbol(&self, other: &Buffer, i: i32) -> bool { self.content[i].same_symbol(&other.content[i]) }
    fn same_diff_cell(&self, other: &Buffer, i: i32) -> bool {
        a := &self.content[i]
        b := &other.content[i]
        a == b
    }
    fn has_vs16(&self, i: i32) -> bool {
        match &self.content[i].symbol { .Some(s) => strings.contains(s,"\u{fe0f}"), .None => false, }
    }
    fn visible_blank_style(&self, i: i32) -> bool {
        cell := &self.content[i]
        !cell.bg.is_default() || i32(cell.modifier.bits).bit_and(VISIBLE_ON_BLANK) != 0
    }
    pub fn visit_changes(&self, previous: &Buffer, visit: &mut FnMut(i32,i32,&RawCell) -> bool) -> Result<(),string> {
        pair := BufferPair { previous:&previous, current:&self }
        if !pair.compatible() { return .Err("Buffer diffs require equal origins and widths.") }
        mut changes := pair.diff_iter()
        if self.area.w == 0 {
            if changes.advance() { return .Err("A changed cell needs a positive buffer width for its coordinates.") }
            return .Ok
        }
        while changes.advance() {
            if !visit(changes.x(), changes.y(), changes.cell()) { break }
        }
        .Ok
    }
    pub fn diff_positions(&self, previous: &Buffer) -> Result<[](i32,i32),string> {
        mut positions: [](i32,i32) = []
        collect := fn[&mut positions](x:i32, y:i32, cell:&RawCell) -> bool { positions.push((x,y)); true }
        self.visit_changes(&previous, &mut collect)?
        .Ok(move positions)
    }
}

pub trait BufferText {
    fn buffer_width(&self) -> i32
    fn write_buffer(&self, buffer: &mut Buffer, x: i32, y: i32, limit: i32) -> (i32,i32)
}

impl BufferText for string {
    fn buffer_width(&self) -> i32 {
        for i in 0..self.len {
            if self[i] >= 128 || self[i] == 10 {
                mut columns := 0
                mut rows := strings.lines(self.as_str())
                while rows.advance() { columns += width.text_columns(rows.current()) }
                return columns
            }
        }
        self.len
    }
    fn write_buffer(&self, buffer: &mut Buffer, x: i32, y: i32, limit: i32) -> (i32,i32) {
        mut col := x
        mut rows := strings.lines(self.as_str())
        while col - x < limit && rows.advance() {
            (end, _) := buffer.set_stringn(col, y, rows.current(), limit - (col - x), plain())
            col = end
        }
        (col, y)
    }
}

impl json.Encode for Buffer {
    fn encode_json(&self, out: &mut json.Writer) { self.write_snapshot(&mut out,.WithUnderlineColor) }
}
impl json.Decode for Buffer {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        Buffer::read_snapshot(&doc,node,.WithUnderlineColor)
    }
}

impl snapshot.Write for Buffer {
    fn write_snapshot(&self, out: &mut json.Writer, format: snapshot.Format) {
        out.object()
        json.field_value(&mut out,"area",&self.area)
        out.key("content")
        self.content.write_snapshot(&mut out,format)
        out.end()
    }
}

impl snapshot.Read for Buffer {
    fn read_snapshot(doc: &json.Doc, node: i32, format: snapshot.Format) -> Result<Self,json.JsonError> {
        f := json_format.fields(&doc,node,&["area","content"],2,2)?
        area := Rect::decode_json(&doc, f[0])?
        content := snapshot.read<[]RawCell>(&doc,f[1],format)?
        .Ok(Self { area:area, content:move content })
    }
}

pub struct Cell { symbol: string, style: Style, diff_option: CellDiffOption }

fn reserve_cells(glyphs: &mut []i32, styles: &mut []i64, area: Rect) -> Result<(),string> {
    cells := area.cell_count()
    if cells > 2147483647 { return .Err("Frame has too many cells for a Dunder array.") }
    n := i32(cells)
    if n > styles.cap() && styles.try_reserve(n) != .Ok { return .Err("Could not allocate the frame's styles.") }
    if n > glyphs.cap() && glyphs.try_reserve(n) != .Ok { return .Err("Could not allocate the frame's symbols.") }
    .Ok
}

const SKIP_CELL: i32 = -1
const ALWAYS_UPDATE: i32 = -2
const LEGACY_SKIP: i32 = 65536
const OVERLAPPING_WIDTHS: u8 = 4
const VISIBLE_ON_BLANK: i32 = 8+16+32+64+256

fn stored_rule(code: i32) -> i32 { if code >= LEGACY_SKIP { code - LEGACY_SKIP - 2 } else { code } }

fn cell_rule(code: i32, skip: bool) -> i32 { if skip { LEGACY_SKIP + code + 2 } else { code } }

pub opaque struct Frame { bounds: Rect, cursor_x: i32, cursor_y: i32, cursor_changed: bool, number: u64, glyphs: []i32, styles: []i64, decorations: []i64, clusters: []string, cluster_cells: []i32, cluster_ranges: []i32, options: []i32, row_flags: []u8, has_options: bool, overlaps: bool }

unsafe fn shift_numbers(base: ptr, count: i32, delta: i32, stride: usize) {
    distance := if delta < 0 { -delta } else { delta }
    vacant := usize(distance)*stride
    kept := usize(count-distance)*stride
    shifted := ptr(usize(base)+vacant)
    if delta < 0 {
        if kept > 0 { bytes.copy_memory(base,shifted,kept) }
        bytes.zero_memory(ptr(usize(base)+kept),vacant)
    } else {
        if kept > 0 { bytes.copy_memory(shifted,base,kept) }
        bytes.zero_memory(base,vacant)
    }
}

fn shift_strings(slots: &mut []string, first: i32, end: i32, delta: i32) {
    if slots.len == 0 { return }
    if delta < 0 {
        for i in first..end+delta { slots.swap(i,i-delta) }
        for i in end+delta..end { slots[i] = "" }
    } else {
        mut i := end
        while i > first+delta { i -= 1; slots.swap(i,i-delta) }
        for i in first..first+delta { slots[i] = "" }
    }
}

impl Buffer {
    pub fn empty(area: Rect) -> Self {
        mut buffer := Self::default()
        buffer.resize(area)
        move buffer
    }
    pub fn filled(area: Rect, cell: &RawCell) -> Self {
        Self::try_filled(area, &cell).unwrap()
    }
    fn reserve_content(content: &mut []RawCell, area: Rect) -> Result<i32,string> {
        n := area.cell_count()
        if n > 2147483647 { return .Err("Buffer has too many cells for a Dunder array.") }
        if n > i64(content.cap()) && content.try_reserve(i32(n)) != .Ok { return .Err("Could not allocate the buffer's cells.") }
        .Ok(i32(n))
    }
    pub fn try_filled(area: Rect, cell: &RawCell) -> Result<Self,string> {
        mut content: []RawCell = []
        n := Self::reserve_content(&mut content, area)?
        array.resize(&mut content, n, &cell)
        .Ok(Self { area:area, content:move content })
    }
    pub fn with_lines<L>(lines: &L) -> Self {
        mut columns := 0
        for line in lines { columns = cmp.max<i32>(columns, line.buffer_width()) }
        w := columns.bit_and(65535)
        mut buffer := Self::empty(Rect::new(0, 0, w, lines.len.bit_and(65535)))
        for y in 0..lines.len { _ := lines[y].write_buffer(&mut buffer, 0, y.bit_and(65535), w) }
        move buffer
    }
    fn offset_at(&self, x: i32, y: i32) -> i64 {
        if !self.area.contains(x, y) { return -1 }
        (i64(y)-i64(self.area.y)) * i64(self.area.w) + (i64(x)-i64(self.area.x))
    }
    pub fn index_of(&self, x: i32, y: i32) -> Option<i64> {
        i := self.offset_at(x,y)
        if i < 0 { return .None }
        .Some(i)
    }
    pub fn position_at(&self, index: i64) -> Option<(i32,i32)> {
        if index < 0 || index >= i64(self.content.len) || self.area.w <= 0 { return .None }
        x := i64(self.area.x) + index % i64(self.area.w)
        y := i64(self.area.y) + index / i64(self.area.w)
        if x < 0 || x > 65535 || y < 0 || y > 65535 { return .None }
        .Some((i32(x), i32(y)))
    }
    fn cell_index(&self, x: i32, y: i32) -> i32 {
        i := self.offset_at(x,y)
        if i >= i64(self.content.len) { -1 } else { i32(i) }
    }
    pub fn cell(&self, x: i32, y: i32) -> Option<&RawCell> from self {
        i := self.cell_index(x, y)
        if i < 0 { return .None }
        .Some(&self.content[i])
    }
    pub fn update_cell(&mut self, x: i32, y: i32, edit: &mut FnMut(&mut RawCell)) -> bool {
        i := self.cell_index(x, y)
        if i < 0 { return false }
        edit(&mut self.content[i])
        true
    }
    pub fn get(&self, x: i32, y: i32) -> &RawCell from self { &self.content[self.cell_index(x, y)] }
    pub fn get_mut(&mut self, x: i32, y: i32) -> &mut RawCell from self {
        i := self.cell_index(x, y)
        &mut self.content[i]
    }
    pub fn resize(&mut self, area: Rect) {
        self.try_resize(area).unwrap()
    }
    pub fn try_resize(&mut self, area: Rect) -> Result<(),string> {
        n := Self::reserve_content(&mut self.content, area)?
        if n < self.content.len { self.content.truncate(n) }
        for _ in self.content.len..n { self.content.push(RawCell::empty()) }
        self.area = area
        .Ok
    }
    pub fn reset(&mut self) {
        for i in 0..self.content.len { self.content[i].reset() }
    }
    pub fn merge(&mut self, other: &Buffer) -> Result<(),string> {
        before := self.area
        next := other.area
        if before != Rect::new(before.x, before.y, before.w, before.h) || next != Rect::new(next.x, next.y, next.w, next.h) {
            return .Err("Buffer merge exceeds the terminal coordinate range.")
        }
        if before.cell_count() != i64(self.content.len) || next.cell_count() != i64(other.content.len) {
            return .Err("Buffer area and cell count differ.")
        }
        area := before.union(next)
        if before != area {
            mut i := self.content.len
            self.try_resize(area)?
            while i > 0 {
                i -= 1
                x := before.x + i % before.w
                y := before.y + i / before.w
                dest := (y-area.y)*area.w + x-area.x
                if dest != i { self.content.swap(i, dest) }
            }
        }
        if next.w > 0 {
            for y in 0..next.h {
                dest := (next.y+y-area.y)*area.w + next.x-area.x
                for x in 0..next.w { self.content[dest+x] = other.content[y*next.w+x].clone() }
            }
        }
        .Ok
    }
    pub fn set_style(&mut self, area: Rect, style: Style) {
        clip := self.area.intersection(area)
        if clip.is_empty() || style.empty() { return }
        patch := CellStyle::new(style)
        for y in clip.y..clip.bottom() {
            start := self.cell_index(clip.x, y)
            for i in start..start+clip.w { patch.apply(&mut self.content[i]) }
        }
    }
    pub fn set_string(&mut self, x: i32, y: i32, value: &str, style: Style) {
        _ := self.set_stringn(x, y, value, 65535, style)
    }
    fn write_ascii(&mut self, x: i32, y: i32, value: &str, count: i32, patch: &CellStyle) -> (i32,i32) {
        start := self.cell_index(x, y)
        if patch.style.empty() {
            for offset in 0..count { self.content[start+offset].write_ascii(value[offset]) }
            return (x+count, y)
        }
        for offset in 0..count {
            cell := &mut self.content[start+offset]
            cell.write_ascii(value[offset])
            patch.apply(&mut cell)
        }
        (x+count, y)
    }
    fn write_grapheme(&mut self, i: i32, view: &str, w: i32, patch: &CellStyle) {
        self.content[i].write_symbol(view)
        if !patch.style.empty() { patch.apply(&mut self.content[i]) }
        for tail in i+1..i+w {
            cell := &mut self.content[tail]
            if cell.skip || cell.diff_option != .None || !cell.empty_tail() { cell.reset() }
        }
    }
    pub fn set_stringn(&mut self, x: i32, y: i32, value: &str, limit: i32, style: Style) -> (i32,i32) {
        mut col := x
        mut left := cmp.min<i32>(self.area.right() - x, limit)
        if left <= 0 { return (x, y) }
        patch := CellStyle::new(style)
        count := cmp.min<i32>(left, value.len)
        mut ascii := count == value.len || value[count] < 128
        if ascii {
            for at in 0..count { if value[at] < 32 || value[at] > 126 { ascii = false; break } }
            if ascii { return self.write_ascii(x, y, value, count, &patch) }
        }
        mut cursor := width.CellCursor::at(value, 0)
        mut i := self.cell_index(x, y)
        while cursor.end < value.len && left > 0 {
            start := cursor.end
            if cursor.scalar >= 32 && cursor.scalar < 127 {
                stop := start + cmp.min<i32>(left, value.len-start)
                mut end := start+1
                while end < stop && value[end] >= 32 && value[end] < 127 { end += 1 }
                if end < value.len && value[end] >= 128 { end -= 1 }
                count := end-start
                if count > 1 {
                    _ := self.write_ascii(col, y, &value[start..end], count, &patch)
                    col += count
                    i += count
                    left -= count
                    if left == 0 || end == value.len { break }
                    cursor = width.CellCursor::at(value,end)
                    continue
                }
            }
            cursor.advance(value)
            w := cursor.cells
            if w <= 0 { continue }
            if w > left { break }
            self.write_grapheme(i, &value[start..cursor.end], w, &patch)
            i += w
            col += w
            left -= w
        }
        (col, y)
    }
    pub fn set_span<S: BufferText>(&mut self, x: i32, y: i32, span: &S, limit: i32) -> (i32,i32) {
        span.write_buffer(&mut self, x, y, limit)
    }
    pub fn set_line<L: BufferText>(&mut self, x: i32, y: i32, line: &L, limit: i32) -> (i32,i32) {
        line.write_buffer(&mut self, x, y, limit)
    }
    pub fn to_frame(&self) -> Result<Frame,string> {
        if self.area != Rect::new(self.area.x,self.area.y,self.area.w,self.area.h) {
            return .Err("buffer exceeds the terminal coordinate range")
        }
        if self.area.cell_count() != i64(self.content.len) { return .Err("buffer area and cell count differ") }
        mut frame := Frame::try_at(self.area)?
        mut i := 0
        while i < self.content.len {
            cell := &self.content[i]
            if !cell.diff_option.valid() { return .Err("invalid cell diff option") }
            columns := cell.columns()
            mut span := 1
            if columns > 1 && columns <= self.area.w - i % self.area.w && cell.diff_option == .None && !cell.skip {
                span = columns
                for j in 1..columns {
                    tail := &self.content[i+j]
                    if !tail.empty_tail() || tail.diff_option != .None || tail.skip { span = 1; break }
                }
            }
            frame.store_raw(i,&cell,if columns == 0 { 0 } else { span })
            if columns > span { frame.mark_overlap(i) }
            i += span
        }
        .Ok(move frame)
    }
}

impl Frame {
    fn raw_style(&self, i: i32) -> Style {
        self.resolved(if self.glyphs[i] < 0 { i64(0) } else { self.styles[i] })
    }

    pub fn raw_style_at(&self, x: i32, y: i32) -> Option<Style> {
        if !self.bounds.contains(x,y) { return .None }
        .Some(self.raw_style(self.index(x,y)))
    }

    fn raw_cell(&self, i: i32) -> RawCell {
        glyph := self.glyphs[i]
        resolved := self.raw_style(i)
        mut symbol: Option<string> = .None
        if glyph > 0 {
            symbol = .Some(self.symbol_value(i,self.normalized_symbol(i)))
        }
        option := self.stored_option(i)
        RawCell { symbol:move symbol, fg:Color::decoded(resolved.fg), bg:Color::decoded(resolved.bg),
            underline_color:Color::decoded(resolved.underline), modifier:Modifiers { bits:u16(resolved.added) },
            diff_option:CellDiffOption::from_code(stored_rule(option)), skip:option >= LEGACY_SKIP }
    }

    pub fn raw_cell_at(&self, x: i32, y: i32) -> Option<RawCell> {
        if !self.bounds.contains(x,y) { return .None }
        .Some(self.raw_cell(self.index(x,y)))
    }

    pub fn first_row_difference(&self, y: i32, other: &Frame, other_y: i32) -> Option<i32> {
        width := if y >= self.bounds.y && y < self.bounds.bottom() { self.bounds.w } else { 0 }
        other_width := if other_y >= other.bounds.y && other_y < other.bounds.bottom() { other.bounds.w } else { 0 }
        n := cmp.min<i32>(width, other_width)
        if n > 0 {
            start := self.index(self.bounds.x, y)
            old := other.index(other.bounds.x, other_y)
            if self.packed_cells() && other.packed_cells() {
                for x in 0..n {
                    a := self.glyphs[start+x]
                    b := other.glyphs[old+x]
                    if self.styles[start+x] != other.styles[old+x] || (a != b && !equivalent_spaces(a,b)) { return .Some(x) }
                }
            } else {
                for x in 0..n {
                    i := start+x
                    j := old+x
                    if self.stored_option(i) != other.stored_option(j) || !self.same_symbol_at(i,&other,j) { return .Some(x) }
                    a := if self.glyphs[i] < 0 { i64(0) } else { self.styles[i] }
                    b := if other.glyphs[j] < 0 { i64(0) } else { other.styles[j] }
                    if !self.equal_style_keys(a,&other,b) { return .Some(x) }
                }
            }
        }
        if width != other_width { .Some(n) } else { .None }
    }

    fn packed_row_data(&self, y: i32) -> bool {
        self.decorations.len == 0 && (self.cluster_ranges.len == 0 || self.cluster_ranges[y*2] >= self.cluster_ranges[y*2+1])
    }

    fn packed_cells(&self) -> bool { self.row_flags.len == 0 && self.decorations.len == 0 && self.cluster_cells.len == 0 }

    fn store_raw(&mut self, i: i32, cell: &RawCell, span: i32) {
        brush := self.encode(cell.style())
        match &cell.symbol {
            .None => { self.glyphs[i] = 0; self.styles[i] = brush },
            .Some(value) => {
                if value.len == 0 { self.put_at(i,EMPTY_SYMBOL,1,brush) }
                else if span == 0 { self.put_cluster_at(i,i/self.bounds.w,value.clone(),0,brush) }
                else if value.len == 1 && value[0] >= 32 { self.put_at(i,i32(value[0]),1,brush) }
                else {
                    chars := value.runes()
                    if chars.len == 1 && i32(chars[0]) >= 32 { self.put_at(i,i32(chars[0]),span,brush) }
                    else { self.put_cluster_at(i,i/self.bounds.w,value.clone(),span,brush) }
                }
            },
        }
        self.set_option_code(i,cell_rule(cell.diff_option.code(),cell.skip))
    }

    pub fn set_raw_cell(&mut self, x: i32, y: i32, cell: &RawCell) -> bool {
        if !self.bounds.contains(x,y) || !cell.diff_option.valid() { return false }
        i := self.index(x,y)
        if self.glyphs[i] < 0 { self.split_wide_cell(x,y) }
        else if self.glyphs[i] >= WIDE { self.split_wide_cell(x+1,y) }
        columns := cell.columns()
        self.store_raw(i,&cell,if columns == 0 { 0 } else { 1 })
        if columns > 1 { self.mark_overlap(i) }
        true
    }

    pub fn to_buffer(&self) -> Buffer {
        mut content: []RawCell = []
        content.reserve(self.glyphs.len)
        for i in 0..self.glyphs.len { content.push(self.raw_cell(i)) }
        Buffer { area:self.bounds, content:move content }
    }

    pub fn encode_json_cells(&self, out: &mut json.Writer) {
        self.write_snapshot_cells(&mut out,.WithUnderlineColor)
    }

    pub fn write_snapshot_cells(&self, out: &mut json.Writer, format: snapshot.Format) {
        for i in 0..self.glyphs.len { self.raw_cell(i).write_snapshot(&mut out,format) }
    }
}

impl json.Encode for Frame {
    fn encode_json(&self, out: &mut json.Writer) { self.write_snapshot(&mut out,.WithUnderlineColor) }
}
impl json.Decode for Frame {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        Frame::read_snapshot(&doc,node,.WithUnderlineColor)
    }
}

impl snapshot.Write for Frame {
    fn write_snapshot(&self, out: &mut json.Writer, format: snapshot.Format) {
        out.object()
        json.field_value(&mut out,"area",&self.bounds)
        out.key("content")
        out.array()
        self.write_snapshot_cells(&mut out,format)
        out.end()
        out.end()
    }
}

impl snapshot.Read for Frame {
    fn read_snapshot(doc: &json.Doc, node: i32, format: snapshot.Format) -> Result<Self,json.JsonError> {
        buffer := Buffer::read_snapshot(&doc,node,format)?
        match buffer.to_frame() {
            .Ok(frame) => .Ok(move frame),
            .Err(reason) => .Err(json.JsonError::new(reason,doc.node_offset(node))),
        }
    }
}

fn changed_cell<B>(current: &B, previous: &B, limit:i32, full:bool, at:&mut i32, trailing:&mut i32, force:&mut bool) -> bool {
    i := at
    option := current.option_code(i)
    if i < trailing {
        at += cmp.min<i32>(limit-i, current.output_width(i,option))
        trailing = cmp.max<i32>(trailing,at)
        return option != SKIP_CELL && (force || !current.same_symbol(&previous,i))
    }
    at += 1
    if option == SKIP_CELL { return false }
    step := current.output_width(i,option)
    at = i + cmp.min<i32>(limit-i,step)
    if full { return true }
    if option != ALWAYS_UPDATE && current.same_diff_cell(&previous,i) { return false }
    if option > 0 { return true }
    if step > 1 && current.has_vs16(i) {
        trailing = at
        at = i+1
        force = false
    } else if step == 1 && previous.visible_blank_style(i) {
        old_step := previous.output_width(i,stored_rule(previous.stored_option(i)))
        if old_step > 1 {
            trailing = i + cmp.min<i32>(limit-i,old_step)
            force = true
        }
    }
    true
}

struct DiffScan {
    at: i32, trailing: i32, force: bool, start: i32, end: i32, cached: i32, limit: i32,
    full: bool, precise: bool, packed: bool, floor: i64,
}

impl DiffScan {
    fn new(current: &Frame, previous: &Frame) -> Self {
        full := current.bounds != previous.bounds
        precise := current.row_flags.len > 0 || previous.row_flags.len > 0
        Self { at:0, trailing:0, force:false, start:0, end:0, cached:-1, limit:current.glyphs.len, full:full,
            precise:precise, packed:current.packed_cells() && previous.packed_cells(),
            floor:if full { i64(0) } else { current.shared_style_floor(&previous) } }
    }

    fn next_cell(&mut self, frame: &Frame, previous: &Frame, limit: i32, ordinary_widths: bool, no_rules: bool) -> i32 {
        while self.at < limit {
            if no_rules && !self.full && self.at >= self.trailing {
                self.at = skip_unchanged_ascii(&frame.glyphs,&previous.glyphs,&frame.styles,&previous.styles,self.at,limit,self.floor)
                if self.at == limit { break }
            }
            i := self.at
            if ordinary_widths && !self.full && i >= self.trailing {
                current := frame.glyphs[i]
                old := previous.glyphs[i]
                if current >= 0 && current < WIDE && old >= 0 && old < WIDE {
                    self.at += 1
                    if frame.changed(&previous, i) { return i }
                    continue
                }
            }
            if changed_cell(&frame,&previous,self.limit,self.full,&mut self.at,&mut self.trailing,&mut self.force) { return i }
        }
        -1
    }

    fn next(&mut self, frame: &Frame, previous: &Frame) -> bool {
        w := frame.bounds.w
        while self.at < self.limit || self.cached >= 0 {
            i := if self.cached >= 0 { self.cached } else { self.at }
            y := i/w
            row := y*w
            limit := row+w
            mut flags: u8 = 0
            if self.precise {
                if frame.row_flags.len > 0 { flags = frame.row_flags[y] }
                if !self.full && previous.row_flags.len > 0 { flags = flags.bit_or(previous.row_flags[y]) }
            }
            if !self.full && (self.packed || (flags == 0 && self.cached < 0 && i >= self.trailing &&
                frame.packed_row_data(y) && previous.packed_row_data(y))) {
                self.start = packed_boundary(&frame.glyphs, &previous.glyphs, &frame.styles, &previous.styles, i, limit, true)
                if self.start == limit { self.at = limit; continue }
                self.end = packed_boundary(&frame.glyphs, &previous.glyphs, &frame.styles, &previous.styles, self.start + 1, limit, false)
                self.at = self.end
                return true
            }
            no_rules := flags.bit_and(1) == 0
            ordinary_widths := no_rules && flags.bit_and(OVERLAPPING_WIDTHS) == 0
            if self.full && ordinary_widths && self.cached < 0 && i >= self.trailing {
                self.start = i
                self.end = limit
                self.at = limit
                return true
            }
            if !self.full && i == row && self.cached < 0 && i >= self.trailing && ordinary_widths && frame.same_row(&previous,row,self.floor) {
                self.at = limit
                continue
            }
            if self.precise && (flags != 0 || self.cached >= 0 || self.at < self.trailing) {
                self.start = if self.cached >= 0 { self.cached } else { self.next_cell(&frame,&previous,limit,ordinary_widths,no_rules) }
                self.cached = -1
                if self.start < 0 { continue }
                mut last := self.start
                self.end = self.start+frame.advance(self.start)
                while self.end < limit && self.end == self.at && frame.option_code(last) <= 0 {
                    if ordinary_widths && self.at >= self.trailing && !self.full {
                        while self.end < limit {
                            current := frame.glyphs[self.end]
                            old := previous.glyphs[self.end]
                            if current < 0 || current >= WIDE || old < 0 || old >= WIDE || !frame.changed(&previous, self.end) { break }
                            self.end += 1
                        }
                        self.at = self.end
                        if self.end == limit { break }
                    }
                    cell := self.next_cell(&frame,&previous,limit,ordinary_widths,no_rules)
                    if cell != self.end { self.cached = cell; break }
                    self.end += frame.advance(cell)
                    last = cell
                }
                return true
            }
            self.start = if self.full { self.at } else { frame.run_start(&previous,self.at,limit) }
            if self.start == limit { self.at = limit; continue }
            self.end = if self.full { limit } else { frame.run_end(&previous,self.start,limit) }
            self.at = self.end
            return true
        }
        false
    }
}

impl Frame {
    pub fn new(w: i32, h: i32) -> Self {
        Frame::at(Rect { x:0, y:0, w:w, h:h })
    }

    pub fn at(area: Rect) -> Self {
        Frame::try_at(area).unwrap()
    }

    pub fn try_at(area: Rect) -> Result<Self,string> {
        bounds := Rect::new(area.x,area.y,area.w,area.h)
        mut glyphs: []i32 = []
        mut styles: []i64 = []
        reserve_cells(&mut glyphs,&mut styles,bounds)?
        n := bounds.w*bounds.h
        for _ in 0..n { glyphs.push(0); styles.push(0) }
        .Ok(Self { bounds:bounds, cursor_x: -1, cursor_y: 0, cursor_changed:false, number: 0, glyphs: move glyphs, styles: move styles, decorations: [], clusters: [], cluster_cells: [], cluster_ranges: [], options: [], row_flags:[], has_options:false, overlaps:false })
    }

    pub fn area(&self) -> Rect { self.bounds }

    pub fn row_is_blank(&self, y: i32) -> bool {
        if y < self.bounds.y || y >= self.bounds.bottom() { return false }
        start := (y-self.bounds.y)*self.bounds.w
        for i in start..start+self.bounds.w {
            if self.glyphs[i] != 0 || self.styles[i] != 0 || self.stored_option(i) != 0 { return false }
        }
        true
    }

    pub fn scroll_rows(&mut self, first: i32, end: i32, delta: i32) {
        top := cmp.clamp<i32>(first,self.bounds.y,self.bounds.bottom())-self.bounds.y
        bottom := cmp.clamp<i32>(end,self.bounds.y+top,self.bounds.bottom())-self.bounds.y
        rows := cmp.clamp<i32>(delta,top-bottom,bottom-top)
        if rows == 0 || self.bounds.w == 0 { return }
        start := top*self.bounds.w
        finish := bottom*self.bounds.w
        offset := rows*self.bounds.w
        unsafe {
            shift_numbers(addr(&mut self.glyphs[start]),finish-start,offset,size_of(i32))
            shift_numbers(addr(&mut self.styles[start]),finish-start,offset,size_of(i64))
            if self.options.len > 0 { shift_numbers(addr(&mut self.options[start]),finish-start,offset,size_of(i32)) }
            if self.row_flags.len > 0 { shift_numbers(addr(&mut self.row_flags[top]),bottom-top,rows,size_of(u8)) }
        }
        shift_strings(&mut self.clusters,start,finish,offset)
        if self.cluster_cells.len == 0 { return }
        self.cluster_ranges.clear()
        mut kept := 0
        for j in 0..self.cluster_cells.len {
            mut i := self.cluster_cells[j]
            if i >= start && i < finish {
                if (offset < 0 && i < start-offset) || (offset > 0 && i >= finish-offset) { continue }
                i += offset
            }
            self.cluster_cells[kept] = i
            self.include_cluster(i,i/self.bounds.w)
            kept += 1
        }
        self.cluster_cells.truncate(kept)
    }

    fn index(&self, x: i32, y: i32) -> i32 { (y-self.bounds.y)*self.bounds.w + (x-self.bounds.x) }

    pub fn index_of(&self, x: i32, y: i32) -> Option<i32> {
        if !self.bounds.contains(x,y) { return .None }
        .Some(self.index(x,y))
    }

    pub fn position_at(&self, index: i32) -> Option<(i32,i32)> {
        if index < 0 || index >= self.glyphs.len { return .None }
        .Some((self.bounds.x+index%self.bounds.w,self.bounds.y+index/self.bounds.w))
    }

    fn stored_option(&self, index: i32) -> i32 {
        if self.options.len == 0 { 0 } else { self.options[index] }
    }

    fn option_code(&self, index: i32) -> i32 {
        code := self.stored_option(index)
        if code < LEGACY_SKIP { return code }
        rule := stored_rule(code)
        if rule == 0 { SKIP_CELL } else { rule }
    }

    fn mark_row(&mut self, index: i32, flag: u8) {
        if self.row_flags.len == 0 {
            self.row_flags.reserve(self.bounds.h)
            for _ in 0..self.bounds.h { self.row_flags.push(0) }
        }
        row := index/self.bounds.w
        self.row_flags[row] = self.row_flags[row].bit_or(flag)
    }

    fn set_option_code(&mut self, index: i32, code: i32) {
        if self.options.len == 0 {
            if code == 0 { return }
            self.options.reserve(self.glyphs.len)
            for _ in 0..self.glyphs.len { self.options.push(0) }
        }
        self.options[index] = code
        if code != 0 { self.has_options = true; self.mark_row(index,1) }
    }

    fn mark_overlap(&mut self, index: i32) {
        self.overlaps = true
        self.mark_row(index,OVERLAPPING_WIDTHS)
    }

    pub fn set_diff_option(&mut self, x: i32, y: i32, option: CellDiffOption) -> bool {
        if !self.bounds.contains(x,y) { return false }
        if !option.valid() { return false }
        i := self.index(x,y)
        self.set_option_code(i,cell_rule(option.code(),self.stored_option(i) >= LEGACY_SKIP))
        true
    }

    pub fn diff_option_at(&self, x: i32, y: i32) -> Option<CellDiffOption> {
        if !self.bounds.contains(x,y) { return .None }
        .Some(CellDiffOption::from_code(stored_rule(self.stored_option(self.index(x,y)))))
    }

    pub fn set_cell_with_width(&mut self, x: i32, y: i32, value: string, columns: i32, style: Style) -> bool {
        if !self.set_diff_option(x,y,.ForcedWidth(columns)) { return false }
        i := self.index(x,y)
        key := self.composite(self.styles[i],&style)
        self.put_cluster_at(i,y-self.bounds.y,value.clone(),1,key)
        self.mark_overlap(i)
        true
    }

    pub fn render_widget<W>(&mut self, widget: W, area: Rect) {
        _ := widget.render(&mut self,area)
    }

    pub fn render_stateful_widget<W,S>(&mut self, widget: W, area: Rect, state: &mut S) {
        widget.render_stateful(&mut self,area,&mut state)
    }

    pub fn count(&self) -> u64 { self.number }

    pub fn set_cursor_position(&mut self, x: i32, y: i32) {
        self.cursor_x = clamp(x,65535)
        self.cursor_y = clamp(y,65535)
    }

    pub fn hide_cursor(&mut self) { self.cursor_x = -1 }

    pub fn cursor_position(&self) -> Option<(i32,i32)> {
        if self.cursor_x < 0 { .None } else { .Some((self.cursor_x,self.cursor_y)) }
    }


    fn encode(&mut self, style: Style) -> i64 {
        packed := style.brush().packed()
        self.style_key(packed, decoration_bits(style.underline, style.cell_modifiers()))
    }

    fn style_key(&mut self, packed: i64, details: i64) -> i64 {
        if details == 0 { return packed }
        n := self.decorations.len
        if n == 0 || self.decorations[n - 2] != packed || self.decorations[n - 1] != details {
            self.decorations.push(packed)
            self.decorations.push(details)
        }
        i64(1) - i64(self.decorations.len)
    }

    fn decoration(&self, key: i64) -> paint.Decoration {
        if key >= 0 { return paint.Decoration { packed: key, underline: -1 } }
        i := i32(i64(-1) - key)
        paint.Decoration { packed: self.decorations[i], underline: detail_underline(self.decorations[i + 1]) }
    }

    fn same_style(&self, previous: &Frame, i: i32) -> bool {
        self.equal_style_keys(self.styles[i], &previous, previous.styles[i])
    }

    fn equal_style_keys(&self, key: i64, previous: &Frame, other: i64) -> bool {
        if key >= 0 || other >= 0 { return key == other }
        current := i32(-1-key)
        prior := i32(-1-other)
        self.decorations[current] == previous.decorations[prior] && self.decorations[current+1] == previous.decorations[prior+1]
    }

    fn resolved(&self, key: i64) -> Style {
        decoration := self.decoration(key)
        brush := paint.Brush::unpack(decoration.packed)
        extra := if key < 0 { i32(self.decorations[i32(-key)].shr(26)) } else { 0 }
        Style {
            fg: brush.fg, bg: brush.bg,
            underline: decoration.underline, added: brush.modifiers.bit_or(extra), removed: 0
        }
    }

    pub fn style_at(&self, x: i32, y: i32) -> Option<Style> {
        if !self.bounds.contains(x,y) { return .None }
        .Some(self.resolved(self.styles[self.index(x,y)]))
    }

    pub fn apply_style(&mut self, area: Rect, overlay: Style) {
        self.style_range(area,&overlay,true)
    }

    pub fn apply_cell_style(&mut self, area: Rect, overlay: Style) {
        if overlay.empty() { return }
        clipped := area.intersection(self.bounds)
        if clipped.is_empty() { return }
        self.detach_cell_styles(clipped)
        self.style_range(clipped,&overlay,true)
    }

    fn detach_cell_styles(&mut self, area: Rect) {
        if self.row_flags.len == 0 { return }
        for y in area.y..area.bottom() {
            if self.row_flags[y-self.bounds.y].bit_and(2) == 0 { continue }
            self.split_wide_cell(area.x,y)
            for x in area.x..area.right() {
                if self.glyphs[self.index(x,y)] >= WIDE { self.split_wide_cell(x+1,y) }
            }
        }
    }

    pub fn dim_cells(&mut self, bounds: Rect, overlay: Style) {
        area := bounds.intersection(self.bounds)
        if area.is_empty() { return }
        self.detach_cell_styles(area)
        mut previous := self.styles[self.index(area.x,area.y)]
        mut dimmed := self.dimmed_style(previous,&overlay)
        for y in area.y..area.bottom() {
            start := self.index(area.x,y)
            for i in start..(start+area.w) {
                old := self.styles[i]
                if old != previous { previous = old; dimmed = self.dimmed_style(old,&overlay) }
                self.styles[i] = dimmed
            }
        }
    }

    fn dimmed_style(&mut self, key: i64, style: &Style) -> i64 {
        mut patch := style.dim()
        background := if patch.bg == INHERIT { self.resolved(key).bg } else { patch.bg }
        patch.bg = if background >= 0x1000000 {
            packed_rgb(u32(background).shr(1).bit_and(0x7f7f7f))
        } else { 0 }
        self.composite(key,&patch)
    }

    pub fn style_glyphs(&mut self, area: Rect, overlay: Style) {
        self.style_range(area,&overlay,false)
    }

    fn style_range(&mut self, area: Rect, overlay: &Style, include_left_overlap: bool) {
        if area.w <= 0 || area.h <= 0 || overlay.empty() { return }
        clipped := area.intersection(self.bounds)
        if clipped.is_empty() { return }
        mut last: i64 = 0
        mut result := self.composite(last, &overlay)
        for y in clipped.y..clipped.bottom() {
            left := self.index(clipped.x,y)
            mut first := self.head(left)
            if !include_left_overlap && first < left { first += self.advance(first) }
            final_head := self.head(left + clipped.w - 1)
            end := final_head + self.advance(final_head)
            for i in first..end {
                old := self.styles[i]
                if old != last { last = old; result = self.composite(old, &overlay) }
                self.styles[i] = result
            }
        }
    }

    fn head(&self, i: i32) -> i32 {
        code := self.glyphs[i]
        if code <= -WIDE_LENGTH_TAG { i-1 } else if code < 0 { i+code } else { i }
    }

    fn advance(&self, i: i32) -> i32 {
        if self.glyphs[i] >= WIDE { -self.glyphs[i+1]-WIDE_LENGTH_TAG } else { 1 }
    }

    pub fn split_wide_cell(&mut self, x: i32, y: i32) {
        if !self.bounds.contains(x,y) { return }
        at := self.index(x,y)
        if self.glyphs[at] >= 0 { return }
        head := self.head(at)
        end := head + self.advance(head)
        self.glyphs[head] = self.glyphs[head].bit_and(WIDE-1)
        for i in head+1..end { self.glyphs[i] = 0; self.styles[i] = 0 }
        self.mark_overlap(head)
    }

    fn erase_span(&mut self, i: i32) {
        if self.glyphs[i] >= 0 && self.glyphs[i] < WIDE { return }
        first := self.head(i)
        end := first + self.advance(first)
        for j in first..end {
            if j != i { self.glyphs[j] = 0; self.styles[j] = 0 }
        }
    }

    fn cell_storage_width(&self, index: i32, available: i32, columns: i32) -> i32 {
        if columns > available { return 1 }
        for j in 1..columns {
            other := index+j
            glyph := self.glyphs[other]
            blank := (glyph == 0 || glyph == WRITTEN_SPACE) && self.styles[other] == 0
            if (!blank && self.head(other) != index) || self.option_code(other) != 0 { return 1 }
        }
        columns
    }

    fn put(&mut self, x: i32, y: i32, symbol: i32, span: i32, style: i64) {
        if x < self.bounds.x || y < self.bounds.y || y >= self.bounds.y+self.bounds.h || x > self.bounds.x+self.bounds.w-span { return }
        self.put_at(self.index(x,y), symbol, span, style)
    }

    fn put_at(&mut self, i: i32, symbol: i32, span: i32, style: i64) {
        existing := self.glyphs[i]
        if existing < 0 || existing >= WIDE { self.erase_span(i) }
        if span > 1 {
            for j in 1..span {
                cell := self.glyphs[i + j]
                if cell < 0 || cell >= WIDE { self.erase_span(i + j) }
            }
        }
        self.glyphs[i] = if symbol == 32 { WRITTEN_SPACE } else { symbol - 32 }
        if span > 1 {
            self.mark_row(i,2)
            self.glyphs[i] = self.glyphs[i].bit_or(WIDE)
            for j in 1..span {
                self.glyphs[i + j] = -j
                if self.options.len > 0 { self.options[i+j] = 0 }
                self.styles[i + j] = style
            }
            self.glyphs[i+1] = -WIDE_LENGTH_TAG-span
        }
        self.styles[i] = style
    }

    fn composite(&mut self, old: i64, overlay: &Style) -> i64 {
        mut packed := if old >= 0 { old } else { self.decorations[i32(i64(-1)-old)] }
        if overlay.fg != INHERIT { packed = packed.bit_and(i64(0x3ffffff).bit_not()).bit_or(i64(overlay.fg+1)) }
        if overlay.bg != INHERIT { packed = packed.bit_and(i64(0x3ffffff).shl(26).bit_not()).bit_or(i64(overlay.bg+1).shl(26)) }
        packed = packed.bit_or(i64(overlay.added.bit_and(511)).shl(52)).bit_and(i64(overlay.removed.bit_and(511)).shl(52).bit_not())
        if old >= 0 && overlay.underline < 0 && overlay.added <= 511 { return packed }
        inherited := if old < 0 { self.decorations[i32(-old)] } else { i64(0) }
        underline := if overlay.underline == INHERIT { detail_underline(inherited) } else { overlay.underline }
        flags := i32(inherited.shr(26)).bit_or(overlay.added).bit_and(overlay.removed.bit_not())
        details := decoration_bits(underline, flags)
        if old < 0 && self.decorations[i32(i64(-1)-old)] == packed && details == inherited { return old }
        self.style_key(packed, details)
    }

    fn ascii_line(&mut self, area: Rect, value: string, brush: i64, overlay: &Style) -> bool {
        for j in 0..value.len { if value[j] < 32 || value[j] >= 127 { return false } }
        self.ascii_slice(i64(area.x), i64(area.y), area.w, value, 0, value.len, brush, &overlay)
        true
    }

    fn ascii_slice(&mut self, x: i64, y: i64, width: i32, value: string, offset: i32, finish: i32, brush: i64, overlay: &Style) {
        if y < i64(self.bounds.y) || y >= i64(self.bounds.y+self.bounds.h) { return }
        start := cmp.max<i64>(0,i64(self.bounds.x)-x)
        fit := i64(self.bounds.x+self.bounds.w) - x
        end := i64(clamp(finish - offset, width))
        limit := if fit < end { fit } else { end }
        if start >= limit { return }
        i := self.index(i32(x+start),i32(y))
        mut at := i
        if overlay.empty() {
            for j in i32(start)..i32(limit) {
                if self.glyphs[at] < 0 || self.glyphs[at] >= WIDE { self.erase_span(at) }
                self.glyphs[at] = if value[offset + j] == 32 { WRITTEN_SPACE } else { i32(value[offset + j]) - 32 }
                at += 1
            }
            return
        }
        mut last: i64 = 0
        mut combined := brush
        for j in i32(start)..i32(limit) {
            old := self.styles[at]
            if old != last {
                last = old
                combined = if old == 0 || old == brush { brush } else { self.composite(old, &overlay) }
            }
            if self.glyphs[at] < 0 || self.glyphs[at] >= WIDE { self.erase_span(at) }
            self.glyphs[at] = if value[offset + j] == 32 { WRITTEN_SPACE } else { i32(value[offset + j]) - 32 }
            self.styles[at] = combined
            at += 1
        }
    }

    pub fn text(&mut self, area: Rect, value: string, style: Style) {
        brush := self.encode(style)
        self.write_text(area, value, brush, &style)
    }

    fn write_text(&mut self, area: Rect, value: string, brush: i64, overlay: &Style) {
        mut x := 0
        mut y := 0
        if area.h <= 0 || area.w <= 0 { return }
        if self.ascii_line(area, value, brush, &overlay) { return }
        chars := value.runes()
        mut at := 0
        mut offset := 0
        while at < chars.len && y < area.h {
            cp := i32(chars[at])
            if cp >= 32 && cp < 127 {
                mut end := offset + 1
                while end < value.len && value[end] >= 32 && value[end] < 127 { end += 1 }
                if end < value.len && value[end] >= 128 { end -= 1 }
                if end > offset {
                    count := end - offset
                    self.ascii_slice(i64(area.x)+i64(x), i64(area.y)+i64(y), area.w-x, value, offset, end, brush, &overlay)
                    x += cmp.min<i32>(count, area.w-x)
                    offset = end
                    at += count
                    continue
                }
            }
            glyph := width.glyph(&chars, at)
            start := offset
            single := glyph.end == at + 1
            at = glyph.end
            offset += glyph.bytes
            if cp == 10 || (cp == 13 && !single) { x = 0; y += 1; continue }
            if glyph.span < 1 || x >= area.w { continue }
            if glyph.span > area.w - x { x = area.w; continue }
            px := i64(area.x) + i64(x)
            py := i64(area.y) + i64(y)
            if px >= i64(self.bounds.x) && px <= i64(self.bounds.x+self.bounds.w-glyph.span) && py >= i64(self.bounds.y) && py < i64(self.bounds.y+self.bounds.h) {
                cell := self.index(i32(px),i32(py))
                old := self.styles[cell]
                combined := if old == 0 || old == brush { brush } else { self.composite(old, &overlay) }
                if single { self.put_at(cell, cp, glyph.span, combined) }
                else {
                    self.put_cluster_at(cell, i32(py)-self.bounds.y, value[start..offset], glyph.span, combined)
                }
            }
            x += glyph.span
        }
    }

    fn put_cluster(&mut self, x: i32, y: i32, move value: string, cells: i32, brush: i64) {
        span := if cells == 0 { 1 } else { cells }
        if x < self.bounds.x || y < self.bounds.y || y >= self.bounds.y+self.bounds.h || x > self.bounds.x+self.bounds.w-span { return }
        self.put_cluster_at(self.index(x,y), y-self.bounds.y, move value, cells, brush)
    }

    fn put_cluster_at(&mut self, i: i32, row: i32, move value: string, cells: i32, brush: i64) {
        if self.clusters.len == 0 {
            self.clusters.reserve(self.glyphs.len)
            for _ in 0..self.glyphs.len { self.clusters.push("") }
        }
        self.put_at(i, if cells == 0 { ZERO_CLUSTER } else { CLUSTER }, if cells == 0 { 1 } else { cells }, brush)
        if self.clusters[i] == "" {
            self.cluster_cells.push(i)
            self.include_cluster(i,row)
        }
        self.clusters[i] = move value
    }

    fn include_cluster(&mut self, i: i32, row: i32) {
        if self.cluster_ranges.len == 0 {
            self.cluster_ranges.reserve(self.bounds.h*2)
            for _ in 0..self.bounds.h { self.cluster_ranges.push(self.glyphs.len); self.cluster_ranges.push(0) }
        }
        offset := row*2
        if i < self.cluster_ranges[offset] { self.cluster_ranges[offset] = i }
        if i >= self.cluster_ranges[offset+1] { self.cluster_ranges[offset+1] = i+1 }
    }

    pub fn set_cell(&mut self, x: i32, y: i32, value: string, style: Style) -> bool {
        if !self.bounds.contains(x,y) || value.len == 0 { return false }
        chars := value.runes()
        mut at := 0
        mut cells := 0
        while at < chars.len {
            g := width.glyph(&chars, at)
            if g.span < 0 || (cells > 0 && g.span > 0) { return false }
            cells += g.span
            at = g.end
        }
        if cells > self.bounds.x+self.bounds.w-x { return false }
        i := self.index(x,y)
        brush := self.composite(self.styles[i], &style)
        if chars.len == 1 && width.columns(i32(chars[0])) > 0 { self.put_at(i, i32(chars[0]), cells, brush) }
        else { self.put_cluster_at(i, y-self.bounds.y, value.clone(), cells, brush) }
        true
    }

    pub fn fill(&mut self, bounds: Rect, symbol: rune, style: Style) {
        self.fill_cells(bounds, i32(symbol), width.columns(i32(symbol)), "", &style)
    }

    pub fn fill_symbol(&mut self, bounds: Rect, symbol: string, style: Style) {
        if symbol.len == 0 { return }
        if symbol.len == 1 { self.fill(bounds, rune(symbol[0]), style); return }
        chars := symbol.runes()
        g := width.glyph(&chars, 0)
        if g.end != chars.len { return }
        cp := if chars.len == 1 { i32(chars[0]) } else { CLUSTER }
        self.fill_cells(bounds, cp, g.span, symbol, &style)
    }

    fn detach_edges(&mut self, area: Rect) {
        if self.row_flags.len == 0 { return }
        for y in area.y..area.bottom() {
            self.split_wide_cell(area.x,y)
            self.split_wide_cell(area.right(),y)
        }
    }

    pub fn paint_cell_rune(&mut self, x: i32, y: i32, symbol: rune, style: &Style) {
        if !self.bounds.contains(x,y) { return }
        if width.columns(i32(symbol)) != 1 {
            self.paint_cells(Rect { x:x,y:y,w:1,h:1 },symbol.str(),style)
            return
        }
        i := self.index(x,y)
        if self.glyphs[i] < 0 { self.split_wide_cell(x,y) }
        else if self.glyphs[i] >= WIDE { self.split_wide_cell(x+1,y) }
        brush := self.composite(self.styles[i],&style)
        self.styles[i] = brush
        self.glyphs[i] = if symbol == ` ` { WRITTEN_SPACE } else { i32(symbol)-32 }
    }

    pub fn paint_rune(&mut self, bounds: Rect, value: rune, style: Style) {
        if width.columns(i32(value)) != 1 { self.paint_cells(bounds,value.str(),style); return }
        area := bounds.intersection(self.bounds)
        if area.is_empty() { return }
        self.detach_edges(area)
        self.fill_narrow(area,i32(value),&style)
    }

    pub fn paint_cells(&mut self, bounds: Rect, value: string, style: Style) {
        area := bounds.intersection(self.bounds)
        if area.is_empty() { return }
        self.detach_edges(area)
        if value.len == 0 {
            self.fill_narrow(area,EMPTY_SYMBOL,&style)
            return
        }
        if value.len == 1 && value[0] >= 32 && value[0] < 127 {
            self.fill_narrow(area,i32(value[0]),&style)
            return
        }
        chars := value.runes()
        if chars.len == 1 && width.columns(i32(chars[0])) == 1 {
            self.fill_narrow(area,i32(chars[0]),&style)
            return
        }
        mut last := i64(0)
        mut brush := self.composite(last,&style)
        for y in area.y..area.bottom() {
            self.mark_overlap(self.index(area.x,y))
            for x in area.x..area.right() {
                i := self.index(x,y)
                old := self.styles[i]
                if old != last { last = old; brush = self.composite(old,&style) }
                self.put_cluster_at(i,y-self.bounds.y,value.clone(),1,brush)
            }
        }
    }

    pub fn reset_cells(&mut self, bounds: Rect) {
        area := bounds.intersection(self.bounds)
        if area.is_empty() { return }
        self.detach_edges(area)
        self.clear_area(area)
    }

    fn fill_narrow(&mut self, area: Rect, cp: i32, style: &Style) {
        code := if cp == 32 { WRITTEN_SPACE } else { cp - 32 }
        mut last: i64 = 0
        mut combined := self.composite(0, &style)
        packed_styles := self.decorations.len == 0 && style.underline < 0
        keep := style.keep_bits()
        for y in area.y..(area.y + area.h) {
            start := self.index(area.x,y)
            if self.row_flags.len > 0 && self.row_flags[y-self.bounds.y].bit_and(2) != 0 {
                for i in start..(start+area.w) {
                    if self.glyphs[i] < 0 || self.glyphs[i] >= WIDE { self.erase_span(i) }
                }
            }
            if packed_styles {
                fill_packed(&mut self.glyphs, &mut self.styles, start, start + area.w, code, keep, combined)
                continue
            }
            for i in start..(start + area.w) {
                old := self.styles[i]
                if old != last { last = old; combined = self.composite(old, &style) }
                self.glyphs[i] = code
                self.styles[i] = combined
            }
        }
    }

    fn fill_cells(&mut self, bounds: Rect, cp: i32, cells: i32, cluster: string, style: &Style) {
        area := bounds.intersection(self.bounds)
        if cells <= 0 || cells > area.w || area.h <= 0 { return }
        if cells == 1 && cp != CLUSTER { self.fill_narrow(area,cp,&style); return }
        first := area.x + i32((i64(cells) - (i64(area.x) - i64(bounds.x)) % i64(cells)) % i64(cells))
        mut last: i64 = 0
        mut combined := self.composite(0, &style)
        for y in area.y..(area.y + area.h) {
            mut x := first
            while x <= area.x + area.w - cells {
                i := self.index(x,y)
                old := self.styles[i]
                if old != last { last = old; combined = self.composite(old, &style) }
                if cp == CLUSTER { self.put_cluster_at(i, y-self.bounds.y, cluster.clone(), cells, combined) }
                else { self.put_at(i, cp, cells, combined) }
                x += cells
            }
        }
    }

    pub fn clear_area(&mut self, bounds: Rect) {
        area := bounds.intersection(self.bounds)
        for y in area.y..(area.y + area.h) {
            for x in area.x..(area.x + area.w) {
                i := self.index(x,y)
                self.erase_span(i)
                self.glyphs[i] = 0
                self.styles[i] = 0
                if self.options.len > 0 { self.options[i] = 0 }
            }
        }
    }

    pub fn clear_cells(&mut self, bounds: Rect) {
        area := bounds.intersection(self.bounds)
        if area.is_empty() { return }
        for y in area.y..area.bottom() {
            self.split_wide_cell(area.x,y)
            self.split_wide_cell(area.right(),y)
        }
        self.clear_area(area)
    }

    pub fn stroke(&mut self, bounds: Rect, symbol: rune, style: Style, strategy: lines.Merge) {
        if strategy == .Replace || !lines.is_border(i32(symbol)) {
            self.paint_rune(bounds,symbol,style)
        } else { self.merge_stroke(bounds,i32(symbol),style,strategy) }
    }

    pub fn stroke_symbol(&mut self, bounds: Rect, symbol: string, style: Style, strategy: lines.Merge) {
        if strategy != .Replace {
            code := lines.border_code(symbol.as_str())
            if code >= 0 { self.merge_stroke(bounds,code,style,strategy); return }
        }
        self.paint_cells(bounds,symbol,style)
    }

    fn merge_stroke(&mut self, bounds: Rect, symbol: i32, style: Style, strategy: lines.Merge) {
        area := bounds.intersection(self.bounds)
        if area.is_empty() { return }
        self.detach_cell_styles(area)
        for y in area.y..area.bottom() {
            for x in area.x..area.right() {
                i := self.index(x,y)
                brush := self.composite(self.styles[i],&style)
                self.styles[i] = brush
                if self.glyphs[i] == 0 { self.glyphs[i] = symbol-32; continue }
                code := self.glyphs[i]+32
                previous := if code == CLUSTER || code == ZERO_CLUSTER {
                    lines.border_code(self.clusters[i].as_str())
                } else { code }
                merged := lines.merge(previous,symbol,strategy)
                if merged != previous { self.glyphs[i] = merged-32 }
            }
        }
    }

    pub fn label(&mut self, area: Rect, value: string) { self.write_text(area, value, 0, &plain()) }

    pub fn panel(&mut self, area: Rect, title: string, style: Style) -> Rect {
        if area.w < 2 || area.h < 2 { return area.inset(1) }
        brush := self.encode(style)
        right := area.x + area.w - 1
        bottom := area.y + area.h - 1
        for x in (area.x + 1)..right {
            self.put(x, area.y, 0x2500, 1, brush)
            self.put(x, bottom, 0x2500, 1, brush)
        }
        for y in (area.y + 1)..bottom {
            self.put(area.x, y, 0x2502, 1, brush)
            self.put(right, y, 0x2502, 1, brush)
        }
        self.put(area.x, area.y, 0x250c, 1, brush)
        self.put(right, area.y, 0x2510, 1, brush)
        self.put(area.x, bottom, 0x2514, 1, brush)
        self.put(right, bottom, 0x2518, 1, brush)
        self.text(Rect { x: area.x + 1, y: area.y, w: area.w - 2, h: 1 }, title, style)
        area.inset(1)
    }

    pub fn list(&mut self, area: Rect, items: &[]string, selected: i32, highlight: Style) {
        if area.h <= 0 { return }
        first := clamp(clamp(selected, items.len - 1) - area.h + 1, items.len)
        count := clamp(items.len - first, area.h)
        for row in 0..count {
            item := first + row
            style := if item == selected { highlight } else { plain() }
            self.text(Rect { x: area.x, y: area.y + row, w: area.w, h: 1 }, items[item], style)
        }
    }

    pub fn styled_rune(&mut self, x: i32, y: i32, right: i32, symbol: rune, style: &Style) {
        if x < self.bounds.x || y < self.bounds.y || x >= right { return }
        col := x-self.bounds.x
        row := y-self.bounds.y
        if col >= self.bounds.w || row >= self.bounds.h { return }
        span := width.columns(i32(symbol))
        if span < 1 || span > self.bounds.w-col || span > right-x { return }
        i := row*self.bounds.w+col
        brush := self.composite(self.styles[i], &style)
        if span == 1 && self.glyphs[i] >= 0 && self.glyphs[i] < WIDE {
            self.glyphs[i] = if symbol == ` ` { WRITTEN_SPACE } else { i32(symbol)-32 }
            self.styles[i] = brush
        } else { self.put(x,y,i32(symbol),span,brush) }
    }

    pub fn half_block(&mut self, x: i32, y: i32, upper: u32, lower: u32) {
        brush := paint.Brush { fg: packed_rgb(upper), bg: packed_rgb(lower), modifiers: 0 }
        self.put(x, y, 0x2580, 1, brush.packed())
    }

    fn append_cell(&self, out: &mut []u8, i: i32, terminal_output: bool) {
        self.append_glyph(&mut out,i,self.glyphs[i],terminal_output)
    }

    fn append_glyph(&self, out: &mut []u8, i: i32, glyph: i32, terminal_output: bool) {
        if glyph < 0 { if terminal_output { out.push(32) }; return }
        if glyph == WRITTEN_SPACE { out.push(32); return }
        cp := glyph.bit_and(WIDE - 1) + 32
        if cp == EMPTY_SYMBOL { return }
        if cp == CLUSTER || cp == ZERO_CLUSTER {
            if terminal_output && cp == ZERO_CLUSTER { out.push(b' ') }
            bytes.append_utf8(&mut out, self.clusters[i])
        }
        else if cp == 0 { return }
        else if cp < 128 { out.push(u8(cp)) }
        else if cp < 2048 {
            out.push(u8(192 + cp.shr(6)))
            out.push(u8(128 + cp.bit_and(63)))
        } else {
            if cp < 65536 { out.push(u8(224 + cp.shr(12))) }
            else {
                out.push(u8(240 + cp.shr(18)))
                out.push(u8(128 + cp.shr(12).bit_and(63)))
            }
            out.push(u8(128 + cp.shr(6).bit_and(63)))
            out.push(u8(128 + cp.bit_and(63)))
        }
    }

    pub fn symbol_at(&self, x: i32, y: i32) -> Option<string> {
        if !self.bounds.contains(x,y) { return .None }
        mut out: []u8 = []
        self.append_cell(&mut out, self.index(x,y), false)
        .Some(bytes.decode(&out).unwrap())
    }

    pub fn cell_at(&self, x: i32, y: i32) -> Option<Cell> {
        if !self.bounds.contains(x,y) { return .None }
        i := self.index(x,y)
        continuation := self.glyphs[i] < 0
        symbol := if continuation { " " } else { self.symbol_at(x,y).unwrap() }
        key := if continuation { i64(0) } else { self.styles[i] }
        .Some(Cell { symbol:move symbol, style:self.resolved(key), diff_option:self.diff_option_at(x,y).unwrap() })
    }

    pub fn line(&self, y: i32) -> string {
        if y < self.bounds.y || y >= self.bounds.y+self.bounds.h { return "" }
        mut out: []u8 = []
        start := (y-self.bounds.y)*self.bounds.w
        mut covered := start
        overlapping := self.row_flags.len > 0 && self.row_flags[y-self.bounds.y].bit_and(OVERLAPPING_WIDTHS) != 0
        for i in start..(start + self.bounds.w) {
            glyph := self.glyphs[i]
            if glyph == 0 && i < covered { continue }
            self.append_glyph(&mut out,i,glyph,false)
            if overlapping && glyph >= 95 && glyph < WIDE && glyph != WRITTEN_SPACE {
                covered = cmp.max<i32>(covered,i + cmp.min<i32>(self.output_width(i,0),self.bounds.w-(i-start)))
            }
        }
        bytes.decode(&out).unwrap()
    }

    fn copy_glyph(&mut self, source: &Frame, i: i32, x: i32, y: i32, room: i32) -> i32 {
        value := source.glyphs[i]
        if value < 0 { return 1 }
        span := source.advance(i)
        if span > room { return span }
        key := source.styles[i]
        brush := if key >= 0 { key } else {
            offset := i32(-1-key)
            self.style_key(source.decorations[offset], source.decorations[offset+1])
        }
        code := value.bit_and(WIDE-1)+32
        if code == CLUSTER || code == ZERO_CLUSTER {
            self.put_cluster(x,y,source.clusters[i].clone(),if code == ZERO_CLUSTER { 0 } else { span },brush)
        } else {
            self.put(x,y,if value == WRITTEN_SPACE { 32 } else { code },span,brush)
            if value == 0 { self.glyphs[self.index(x,y)] = 0 }
        }
        if self.has_options || source.has_options {
            dest := self.index(x,y)
            for col in 0..span { self.set_option_code(dest+col,source.stored_option(i+col)) }
        }
        if source.overlaps && source.row_flags[i/source.bounds.w].bit_and(OVERLAPPING_WIDTHS) != 0 {
            self.mark_overlap(self.index(x,y))
        }
        span
    }

    pub fn copy_region(&mut self, source: &Frame, region: Rect, x: i32, y: i32) {
        self.copy_region_at(&source,region,x,y,false)
    }

    pub fn copy_cells(&mut self, source: &Frame, region: Rect, x: i32, y: i32) {
        self.copy_region_at(&source,region,x,y,true)
    }

    fn copy_region_at(&mut self, source: &Frame, region: Rect, x: i32, y: i32, raw: bool) {
        from := region.intersection(source.bounds)
        if from.is_empty() { return }
        left := cmp.max<i64>(i64(from.x),i64(region.x)-i64(x)+i64(self.bounds.x))
        top := cmp.max<i64>(i64(from.y),i64(region.y)-i64(y)+i64(self.bounds.y))
        right := cmp.min<i64>(i64(from.right()),i64(region.x)-i64(x)+i64(self.bounds.x+self.bounds.w))
        bottom := cmp.min<i64>(i64(from.bottom()),i64(region.y)-i64(y)+i64(self.bounds.y+self.bounds.h))
        if right <= left || bottom <= top { return }
        for row in i32(top)..i32(bottom) {
            dy := i32(i64(y)+i64(row)-i64(region.y))
            if raw {
                self.split_wide_cell(i32(i64(x)+left-i64(region.x)),dy)
                self.split_wide_cell(i32(i64(x)+right-i64(region.x)),dy)
            }
            mut col := i32(left)
            while col < i32(right) {
                dx := i32(i64(x)+i64(col)-i64(region.x))
                i := source.index(col,row)
                room := i32(right)-col
                if raw && (source.glyphs[i] < 0 || (source.glyphs[i] >= WIDE && source.advance(i) > room)) {
                    _ := self.set_raw_cell(dx,dy,&source.raw_cell(i))
                    col += 1
                } else { col += self.copy_glyph(&source,i,dx,dy,room) }
            }
        }
    }

    pub fn merge(&mut self, other: &Frame) -> Result<(),string> {
        area := self.bounds.union(other.bounds)
        if self.bounds != area {
            mut expanded := Frame::try_at(area)?
            expanded.copy_region(&self,self.bounds,self.bounds.x,self.bounds.y)
            expanded.cursor_x = self.cursor_x
            expanded.cursor_y = self.cursor_y
            expanded.cursor_changed = self.cursor_changed
            expanded.number = self.number
            self = move expanded
        }
        if other.bounds.is_empty() { return .Ok }
        for y in other.bounds.y..other.bounds.bottom() {
            self.split_wide_cell(other.bounds.x, y)
        }
        self.copy_region(&other,other.bounds,other.bounds.x,other.bounds.y)
        .Ok
    }

    fn rows_at(&self, first: i32, y: i32, count: i32) -> Frame {
        mut out := Frame::at(Rect { x:0,y:y,w:self.bounds.w,h:count })
        out.copy_region(&self,Rect { x:self.bounds.x,y:self.bounds.y+first,w:self.bounds.w,h:count },0,y)
        out
    }

    pub fn resize(&mut self, w: i32, h: i32) {
        assert(self.try_resize(Rect { x:self.bounds.x,y:self.bounds.y,w:w,h:h }).is_ok())
    }

    pub fn try_resize(&mut self, area: Rect) -> Result<(),string> {
        bounds := Rect::new(area.x,area.y,area.w,area.h)
        if self.bounds.w == bounds.w && self.bounds.h == bounds.h { self.bounds = bounds; return .Ok }
        if bounds.cell_count() == i64(self.glyphs.len) && self.row_flags.len == 0 && self.cluster_cells.len == 0 { self.bounds = bounds; return .Ok }
        reserve_cells(&mut self.glyphs,&mut self.styles,bounds)?
        self.reserve_metadata(bounds)?
        n := bounds.w*bounds.h
        kept := cmp.min<i32>(self.glyphs.len,n)
        if self.row_flags.len > 0 && bounds.w > 0 {
            if self.bounds.w != bounds.w {
                mut boundary := bounds.w
                while boundary < kept { self.split_at_index(boundary); boundary += bounds.w }
            }
            if kept < self.glyphs.len { self.split_at_index(kept) }
        }
        if self.options.len > 0 { array.resize<i32>(&mut self.options,n,0) }
        if self.clusters.len > 0 { array.resize<string>(&mut self.clusters,n,"") }
        array.resize<i32>(&mut self.glyphs,n,0)
        array.resize<i64>(&mut self.styles,n,i64(0))
        if self.row_flags.len > 0 {
            self.reshape_flags(bounds,kept)
        }
        self.bounds = bounds
        if self.cluster_cells.len > 0 {
            self.cluster_ranges.clear()
            mut retained := 0
            for k in 0..self.cluster_cells.len {
                i := self.cluster_cells[k]
                if i < kept {
                    self.cluster_cells[retained] = i
                    self.include_cluster(i,i/bounds.w)
                    retained += 1
                }
            }
            self.cluster_cells.truncate(retained)
        }
        .Ok
    }

    fn split_at_index(&mut self, i: i32) {
        if self.glyphs[i] < 0 { self.split_wide_cell(self.bounds.x+i%self.bounds.w,self.bounds.y+i/self.bounds.w) }
    }

    fn reshape_flags(&mut self, bounds: Rect, kept: i32) {
        if kept == 0 { self.row_flags.clear(); self.has_options = false; self.overlaps = false; return }
        old_width := self.bounds.w
        if self.row_flags.len < bounds.h { array.resize<u8>(&mut self.row_flags,bounds.h,u8(0)) }
        if old_width != bounds.w {
            for step in 0..bounds.h {
                row := if bounds.w > old_width { step } else { bounds.h-1-step }
                first := row*bounds.w
                end := cmp.min<i32>(first+bounds.w,kept)
                mut flags := u8(0)
                if first < end {
                    for old_row in first/old_width..(end-1)/old_width+1 { flags = flags.bit_or(self.row_flags[old_row]) }
                }
                self.row_flags[row] = flags
            }
        }
        self.row_flags.truncate(bounds.h)
    }

    fn reserve_metadata(&mut self, area: Rect) -> Result<(),string> {
        n := area.w*area.h
        if self.options.len > 0 && self.options.try_reserve(n) != .Ok { return .Err("Could not resize the cell diff options.") }
        if self.clusters.len > 0 && self.clusters.try_reserve(n) != .Ok { return .Err("Could not resize the grapheme storage.") }
        if self.row_flags.len > 0 && self.row_flags.try_reserve(area.h) != .Ok { return .Err("Could not resize the row flags.") }
        if self.cluster_cells.len > 0 && self.cluster_ranges.try_reserve(2*area.h) != .Ok { return .Err("Could not resize the grapheme ranges.") }
        .Ok
    }

    pub fn erase(&mut self, region: Rect) { self.clear_area(region) }

    pub fn apply_diff(&mut self, frame: &Frame, previous: &Frame) {
        if self.bounds != frame.bounds {
            self = Frame::at(frame.bounds)
            unknown := Frame::new(0,0)
            self.apply_region_diff(&frame,&unknown)
        } else { self.apply_region_diff(&frame,&previous) }
        self.cursor_x = frame.cursor_x
        self.cursor_y = frame.cursor_y
        self.number = frame.number
    }

    pub fn apply_region_diff(&mut self, frame: &Frame, previous: &Frame) {
        area := self.bounds.intersection(frame.bounds)
        if area.is_empty() { return }
        mut scan := DiffScan::new(&frame,&previous)
        while scan.next(&frame,&previous) {
            y := frame.bounds.y+scan.start/frame.bounds.w
            if y < area.y || y >= area.bottom() { continue }
            mut i := scan.start
            while i < scan.end {
                x := frame.bounds.x+i%frame.bounds.w
                if x >= area.right() { break }
                if x >= area.x {
                    if frame.glyphs[i] < 0 {
                        j := self.index(x,y)
                        if self.glyphs[j] >= 0 {
                            self.put(x,y,32,1,0)
                            self.glyphs[j] = 0
                            self.set_option_code(j,frame.stored_option(i))
                        }
                    } else { _ := self.copy_glyph(&frame,i,x,y,area.right()-x) }
                }
                i += frame.advance(i)
            }
        }
    }

    pub fn clear(&mut self) {
        self.decorations.clear()
        if self.has_options {
            unsafe { bytes.zero_memory(addr(&mut self.options[0]),usize(self.options.len)*size_of(i32)) }
            self.has_options = false
        }
        self.row_flags.clear()
        self.overlaps = false
        for i in &self.cluster_cells { self.clusters[i] = "" }
        self.cluster_cells.clear()
        self.cluster_ranges.clear()
        clear_packed(&mut self.glyphs, &mut self.styles)
    }

    fn reset_area(&mut self, area: Rect) {
        self.clear()
        if self.bounds == area { return }
        n := area.w*area.h
        self.bounds = area
        self.clusters.clear()
        self.options.clear()
        if n <= self.glyphs.len {
            self.glyphs.truncate(n)
            self.styles.truncate(n)
        } else {
            self.glyphs.reserve(n)
            self.styles.reserve(n)
            for _ in self.glyphs.len..n { self.glyphs.push(0); self.styles.push(0) }
        }
    }

    fn changed(&self, previous: &Frame, i: i32) -> bool {
        code := self.glyphs[i]
        old := previous.glyphs[i]
        if code != old && !equivalent_spaces(code, old) { return true }
        if !self.same_style(&previous, i) { return true }
        symbol := code.bit_and(WIDE - 1) + 32
        (symbol == CLUSTER || symbol == ZERO_CLUSTER) && self.clusters[i] != previous.clusters[i]
    }

    fn shared_style_floor(&self, previous: &Frame) -> i64 {
        count := cmp.min<i32>(self.decorations.len, previous.decorations.len)
        mut offset := 0
        while offset < count {
            if self.decorations[offset] != previous.decorations[offset] || self.decorations[offset + 1] != previous.decorations[offset + 1] { return -i64(offset) }
            offset += 2
        }
        if self.decorations.len != previous.decorations.len { return -i64(count) }
        -9223372036854775808
    }

    fn same_row(&self, previous: &Frame, row: i32, shared_floor: i64) -> bool {
        if self.bounds.w == 0 { return false }
        end := row + self.bounds.w
        if packed_boundary(&self.glyphs, &previous.glyphs, &self.styles, &previous.styles, row, end, true) != end { return false }
        if self.cluster_ranges.len > 0 {
            offset := row/self.bounds.w*2
            for i in self.cluster_ranges[offset]..self.cluster_ranges[offset+1] {
                code := self.glyphs[i].bit_and(WIDE - 1) + 32
                if self.glyphs[i] >= 0 && (code == CLUSTER || code == ZERO_CLUSTER) && self.clusters[i] != previous.clusters[i] { return false }
            }
        }
        if shared_floor != -9223372036854775808 {
            for i in row..(row + self.bounds.w) { if self.styles[i] < shared_floor { return false } }
        }
        true
    }

    fn run_start(&self, previous: &Frame, i: i32, end: i32) -> i32 {
        mut start := i
        while start < end {
            if self.glyphs[start] >= 0 && self.changed(&previous, start) { break }
            start += 1
        }
        start
    }

    fn run_end(&self, previous: &Frame, start: i32, end: i32) -> i32 {
        mut finish := start
        while finish < end && self.changed(&previous, finish) {
            finish += self.advance(finish)
        }
        finish
    }

    fn output_width(&self, i: i32, option: i32) -> i32 {
        if option > 0 { return option }
        value := self.glyphs[i]
        if !self.overlaps || value >= WIDE { return self.advance(i) }
        if value < PRINTABLE_ASCII_COUNT || value == WRITTEN_SPACE { return 1 }
        code := value+32
        if code == EMPTY_SYMBOL { return 1 }
        if code == CLUSTER || code == ZERO_CLUSTER {
            return cmp.max<i32>(1,width.cell_columns(self.clusters[i]))
        }
        cmp.max<i32>(1,width.columns(code))
    }

    fn has_vs16(&self, i: i32) -> bool {
        value := self.glyphs[i]
        value >= 0 && value.bit_and(WIDE-1) == CLUSTER-32 && strings.contains(self.clusters[i],"\u{fe0f}")
    }

    fn visible_blank_style(&self, i: i32) -> bool {
        if self.glyphs[i] < 0 { return false }
        brush := paint.Brush::unpack(self.decoration(self.styles[i]).packed)
        brush.bg >= 0 || brush.modifiers.bit_and(VISIBLE_ON_BLANK) != 0
    }

    fn normalized_symbol(&self, i: i32) -> i32 {
        value := self.glyphs[i]
        if value < 0 || value == WRITTEN_SPACE { 0 } else { value.bit_and(WIDE-1) }
    }

    fn symbol_value(&self, i: i32, code: i32) -> string {
        if code == CLUSTER-32 || code == ZERO_CLUSTER-32 { return self.clusters[i].clone() }
        if code == EMPTY_SYMBOL-32 { return "" }
        rune(code+32).str()
    }

    fn same_symbol(&self, previous: &Frame, i: i32) -> bool {
        self.same_symbol_at(i,&previous,i)
    }

    fn same_symbol_at(&self, i: i32, previous: &Frame, j: i32) -> bool {
        a := self.normalized_symbol(i)
        b := previous.normalized_symbol(j)
        if a == b {
            if a == CLUSTER-32 || a == ZERO_CLUSTER-32 { return self.clusters[i] == previous.clusters[j] }
            return true
        }
        if a == CLUSTER-32 || a == ZERO_CLUSTER-32 || b == CLUSTER-32 || b == ZERO_CLUSTER-32 {
            return self.symbol_value(i,a) == previous.symbol_value(j,b)
        }
        false
    }

    fn same_diff_cell(&self, previous: &Frame, i:i32) -> bool {
        self.stored_option(i) == previous.stored_option(i) && self.same_visible_cell(&previous,i)
    }
    fn same_visible_cell(&self, previous: &Frame, i: i32) -> bool {
        if !self.same_symbol(&previous,i) { return false }
        if self.glyphs[i] < 0 { return previous.glyphs[i] < 0 || previous.styles[i] == 0 }
        if previous.glyphs[i] < 0 { return self.styles[i] == 0 }
        self.same_style(&previous,i)
    }

    pub fn visit_changes<S>(&self, previous: &Frame, state: &mut S, visit: fn(&mut S,i32,i32) -> bool) -> Result<(),string> {
        if self.bounds.x != previous.bounds.x || self.bounds.y != previous.bounds.y || self.bounds.w != previous.bounds.w {
            return .Err("Buffer diffs require equal origins and widths.")
        }
        mut scan := DiffScan::new(&self,&previous)
        if scan.full {
            scan.full = false
            scan.limit = cmp.min<i32>(self.glyphs.len,previous.glyphs.len)
            scan.floor = self.shared_style_floor(&previous)
        }
        while scan.next(&self,&previous) {
            mut i := scan.start
            while i < scan.end {
                if !visit(&mut state,self.bounds.x+i%self.bounds.w,self.bounds.y+i/self.bounds.w) { return .Ok }
                i += self.advance(i)
            }
        }
        .Ok
    }

    pub fn diff_positions(&self, previous: &Frame) -> Result<[](i32,i32),string> {
        mut positions: [](i32,i32) = []
        self.visit_changes(&previous,&mut positions,fn(out: &mut [](i32,i32), x: i32, y: i32) -> bool { out.push((x,y)); true })?
        .Ok(move positions)
    }

    pub fn ansi_cells(&self, previous: &Frame, out: &mut []u8) {
        mut scan := DiffScan::new(&self,&previous)
        mut current: i64 = 0
        while scan.next(&self,&previous) {
            paint.cursor(&mut out,self.bounds.x+scan.start%self.bounds.w,self.bounds.y+scan.start/self.bounds.w)
            mut i := scan.start
            while i < scan.end {
                glyph := self.glyphs[i]
                style := if glyph < 0 { i64(0) } else { self.styles[i] }
                if current != style {
                    paint.transition(&mut out,self.decoration(current),self.decoration(style))
                    current = style
                }
                if (glyph >= 0 && glyph < 96) || glyph == WRITTEN_SPACE {
                    i = append_ascii_run(&mut out, &self.glyphs, &self.styles, i, scan.end, style)
                } else {
                    self.append_glyph(&mut out,i,glyph,true)
                    i += if glyph < WIDE { 1 } else { self.advance(i) }
                }
            }
        }
        if current != 0 { bytes.append_utf8(&mut out, "\x1b[0m") }
    }

    fn displayed_cursor_x(&self) -> i32 { if self.cursor_changed { -2 } else { self.cursor_x } }

    pub fn ansi_diff(&self, previous: &Frame, out: &mut []u8) {
        start_len := out.len
        self.ansi_cells(&previous,&mut out)
        previous_x := previous.displayed_cursor_x()
        if self.cursor_x >= 0 {
            if out.len != start_len || self.cursor_x != previous_x || self.cursor_y != previous.cursor_y {
                paint.cursor(&mut out,self.cursor_x,self.cursor_y)
            }
            if previous_x < 0 { bytes.append_utf8(&mut out,"\x1b[?25h") }
        } else if previous_x != -1 { bytes.append_utf8(&mut out,"\x1b[?25l") }
    }

    fn paint_windows(&self, previous: &Frame, term: &terminal.Session) -> bool {
        mut scan := DiffScan::new(&self,&previous)
        mut run: []u8 = []
        while scan.next(&self,&previous) {
            mut i := scan.start
            y := self.bounds.y+i/self.bounds.w
            while i < scan.end {
                x := self.bounds.x+i%self.bounds.w
                style := if self.glyphs[i] < 0 { i64(0) } else { self.styles[i] }
                run.clear()
                while true {
                    self.append_cell(&mut run,i,true)
                    i += self.advance(i)
                    if i >= scan.end { break }
                    next_style := if self.glyphs[i] < 0 { i64(0) } else { self.styles[i] }
                    if next_style != style { break }
                }
                if !windows.paint(&term.win,x,y,bytes.decode(&run).unwrap(),paint.Brush::unpack(self.decoration(style).packed)) { return false }
            }
        }
        true
    }

    fn present(&self, term: &terminal.Session, previous: &Frame, output: &mut []u8) -> bool {
        if target_is("windows") {
            if !term.win.vt {
                if !self.paint_windows(&previous,&term) { return false }
                return windows.cursor(&term.win,cmp.min<i32>(self.cursor_x,self.bounds.x+self.bounds.w-1),
                    cmp.min<i32>(self.cursor_y,self.bounds.y+self.bounds.h-1),previous.displayed_cursor_x())
            }
        }
        output.clear()
        self.ansi_diff(&previous, &mut output)
        if output.len == 0 { return true }
        if target_is("windows") { return windows.write(&term.win, &output) }
        else { return posix.write_bytes(&output) }
    }
}

struct GlyphData { tokens: []i32, clusters: []string, clipping: []i32, text_width: i32 }
pub opaque struct GlyphRun { source: string, data: Option<GlyphData>, zero_width: bool, columns: i32 }

impl GlyphRun {
    pub fn new(move value: string) -> Self {
        mut ascii := true
        for i in 0..value.len { if value[i] < 32 || value[i] > 126 { ascii = false; break } }
        if ascii {
            columns := value.len
            return Self { source: move value, data: .None, zero_width: false, columns: columns }
        }
        mut tokens: []i32 = []
        mut clusters: []string = []
        mut clipping: []i32 = []
        mut columns := 0
        mut measured := 0
        mut contextual := false
        mut halfwidth_marks := 0
        mut zero_width := false
        chars := value.runes()
        mut at := 0
        mut offset := 0
        while at < chars.len {
            group := width.glyph(&chars, at)
            mut natural := if group.span < 0 { 1 } else { group.span }
            for i in at..group.end {
                cp := i32(chars[i])
                if cp == 0xff9e || cp == 0xff9f { natural -= 1; halfwidth_marks += 1 }
                if cp == 0x200d || width.script_candidate(cp) { contextual = true }
            }
            if clipping.len > 0 || natural != group.span {
                if clipping.len == 0 {
                    for i in 0..(tokens.len / 2) { clipping.push(tokens[i * 2 + 1]) }
                }
                clipping.push(if group.span < 0 { -1 } else { natural })
            }
            measured += natural
            if group.span >= 0 {
                cp := i32(chars[at])
                symbol := if group.end == at + 1 { cp } else {
                    clusters.push(value[offset..(offset + group.bytes)])
                    -clusters.len
                }
                tokens.push(symbol)
                tokens.push(group.span)
                columns += group.span
                if group.span == 0 { zero_width = true }
            }
            offset += group.bytes
            at = group.end
        }
        if contextual { measured = width.measured_columns(value.as_str()) - halfwidth_marks }
        Self { source: move value, data: .Some(GlyphData { tokens: move tokens, clusters: move clusters, clipping: move clipping, text_width: measured }), zero_width: zero_width, columns: columns }
    }

    pub fn content(&self) -> &str from self { self.source.as_str() }
    pub fn source_string(&self) -> &string from self { &self.source }
    pub fn write_buffer(&self, buffer: &mut Buffer, x: i32, y: i32, limit: i32, style: Style) -> (i32,i32) {
        mut left := cmp.min<i32>(buffer.area.right() - x, limit)
        if left <= 0 { return (x, y) }
        patch := CellStyle::new(style)
        match &self.data {
            .None => buffer.write_ascii(x, y, self.source.as_str(), cmp.min<i32>(left,self.source.len), &patch),
            .Some(data) => {
                mut offset := 0
                mut col := x
                mut i := buffer.cell_index(x, y)
                for k in 0..data.tokens.len/2 {
                    offset = width.next_visible_byte(self.source.as_str(), offset)
                    cp := data.tokens[k*2]
                    size := if cp < 0 { data.clusters[-1-cp].len } else { width.encoded(cp) }
                    view := &self.source[offset..offset+size]
                    offset += size
                    w := if data.tokens[k*2+1] >= 65535 { width.cell_columns_view(view) } else { data.tokens[k*2+1] }
                    if w == 0 { continue }
                    if w > left { break }
                    buffer.write_grapheme(i, view, w, &patch)
                    i += w
                    col += w
                    left -= w
                    if left == 0 { break }
                }
                (col, y)
            },
        }
    }
    pub fn has_zero_width(&self) -> bool { self.zero_width }
    pub fn count(&self) -> i32 { match &self.data { .Some(d) => d.tokens.len / 2, .None => self.source.len, } }
    pub fn width(&self) -> i32 { self.columns }
    pub fn text_width(&self) -> i32 { match &self.data { .Some(d) => d.text_width, .None => self.columns, } }
    pub fn suffix_start(&self, available: i32) -> (i32, i32) {
        mut remaining := cmp.max<i32>(available, 0)
        mut first := self.count()
        match &self.data {
            .None => { return (cmp.max<i32>(0, first - remaining), cmp.max<i32>(0, remaining - first)) },
            .Some(d) => {
                mut at := if d.clipping.len > 0 { d.clipping.len } else { first }
                while at > 0 {
                    at -= 1
                    cells := if d.clipping.len > 0 { d.clipping[at] } else { d.tokens[at * 2 + 1] }
                    cost := if cells < 0 { 1 } else { cells }
                    if cost > remaining { break }
                    remaining -= cost
                    if cells >= 0 { first -= 1 }
                }
            },
        }
        (first, remaining)
    }
    pub fn width_at(&self, index: i32) -> i32 { match &self.data { .Some(d) => d.tokens[index * 2 + 1], .None => 1, } }
    pub fn symbol_bytes_at(&self, index: i32) -> i32 {
        match &self.data {
            .None => 1,
            .Some(d) => {
                cp := d.tokens[index*2]
                if cp < 0 { d.clusters[-1-cp].len } else { width.encoded(cp) }
            },
        }
    }
    pub fn space_at(&self, index: i32) -> bool {
        cp := match &self.data { .Some(d) => d.tokens[index * 2], .None => i32(self.source[index]), }
        cp == 0x200b || (cp != 0xa0 && width.whitespace(cp))
    }

    pub fn symbol_at(&self, index: i32) -> string {
        match &self.data {
            .None => self.source[index..(index + 1)],
            .Some(d) => {
                cp := d.tokens[index * 2]
                if cp >= 0 { rune(cp).str() } else { d.clusters[-1 - cp].clone() }
            },
        }
    }

    pub fn render(&self, frame: &mut Frame, bounds: Rect, first: i32, end: i32, style: Style) {
        _ := self.write(&mut frame, bounds, first, end, style)
    }

    pub fn write(&self, frame: &mut Frame, bounds: Rect, first: i32, end: i32, style: Style) -> i32 {
        self.write_range(&mut frame,bounds,first,end,style,false)
    }

    pub fn write_cells(&self, frame: &mut Frame, bounds: Rect, first: i32, end: i32, style: Style) -> i32 {
        self.write_range(&mut frame,bounds,first,end,style,true)
    }

    fn write_range(&self, frame: &mut Frame, bounds: Rect, first: i32, end: i32, style: Style, raw_cells: bool) -> i32 {
        if bounds.w <= 0 || bounds.h <= 0 || bounds.y < frame.bounds.y || bounds.y >= frame.bounds.y+frame.bounds.h { return 0 }
        count := self.count()
        start := clamp(first, count)
        finish := clamp(end, count)
        if start >= finish { return 0 }
        brush := frame.encode(style)
        match &self.data {
            .Some(data) => data.write(&mut frame, bounds, start, finish, brush, style, raw_cells),
            .None => {
                if raw_cells && frame.row_flags.len > 0 {
                    left := cmp.max<i32>(frame.bounds.x,bounds.x)
                    right := i64(bounds.x) + i64(cmp.min<i32>(finish-start,bounds.w))
                    if i64(left) < right { frame.split_wide_cell(left,bounds.y) }
                }
                frame.ascii_slice(i64(bounds.x), i64(bounds.y), bounds.w, self.source, start, finish, brush, &style)
                cmp.max<i32>(0, i32(cmp.min<i64>(i64(finish - start), cmp.min<i64>(i64(bounds.w), i64(frame.bounds.x+frame.bounds.w) - i64(bounds.x)))))
            },
        }
    }

    pub fn render_cells(&self, frame: &mut Frame, bounds: Rect, first: i32, end: i32, style: Style) {
        if bounds.w <= 0 || bounds.h <= 0 || bounds.y < frame.bounds.y || bounds.y >= frame.bounds.bottom() { return }
        count := self.count()
        start := clamp(first,count)
        finish := clamp(end,count)
        if start >= finish { return }
        brush := frame.encode(style)
        match &self.data {
            .None => {
                frame.split_wide_cell(cmp.max<i32>(bounds.x,frame.bounds.x),bounds.y)
                frame.ascii_slice(i64(bounds.x), i64(bounds.y), bounds.w, self.source, start, finish, brush, &style)
            },
            .Some(data) => data.render_cells(&mut frame,bounds,start,finish,brush,style),
        }
    }
}

impl GlyphData {
    fn write(&self, frame: &mut Frame, bounds: Rect, start: i32, finish: i32, brush: i64, style: Style, raw_cells: bool) -> i32 {
        mut x := i64(bounds.x)
        right := cmp.min<i64>(i64(frame.bounds.x+frame.bounds.w), x + i64(bounds.w))
        left := frame.bounds.x
        row := bounds.y - frame.bounds.y
        base := row * frame.bounds.w
        mut last: i64 = 0
        mut combined := brush
        for i in start..finish {
            cp := self.tokens[i * 2]
            cells := self.tokens[i * 2 + 1]
            if cells == 0 { continue }
            if x + i64(cells) > right { break }
            if x >= i64(left) {
                index := base + (i32(x) - left)
                if raw_cells && frame.glyphs[index] < 0 { frame.split_wide_cell(i32(x),bounds.y) }
                old := frame.styles[index]
                if old != last {
                    last = old
                    combined = if old == 0 || old == brush { brush } else { frame.composite(old, &style) }
                }
                if cp >= 0 { frame.put_at(index, cp, cells, combined) }
                else { frame.put_cluster_at(index, row, self.clusters[-1 - cp].clone(), cells, combined) }
            }
            x += i64(cells)
        }
        i32(x - i64(bounds.x))
    }

    fn render_cells(&self, frame: &mut Frame, bounds: Rect, start: i32, finish: i32, brush: i64, style: Style) {
        mut x := i64(bounds.x)
        right := cmp.min<i64>(i64(frame.bounds.right()),x+i64(bounds.w))
        row := bounds.y-frame.bounds.y
        mut last := i64(0)
        mut combined := brush
        for i in start..finish {
            cells := self.tokens[i * 2 + 1]
            if cells == 0 { continue }
            if x >= right { break }
            if x >= i64(frame.bounds.x) {
                index := frame.index(i32(x),bounds.y)
                if frame.glyphs[index] < 0 { frame.split_wide_cell(i32(x),bounds.y) }
                storage := if cells > 1 { frame.cell_storage_width(index,frame.bounds.right()-i32(x),cells) } else { cells }
                if storage != cells { frame.mark_overlap(index) }
                old := frame.styles[index]
                if old != last {
                    last = old
                    combined = if old == 0 || old == brush { brush } else { frame.composite(old,&style) }
                }
                cp := self.tokens[i * 2]
                if cp >= 0 { frame.put_at(index,cp,storage,combined) }
                else { frame.put_cluster_at(index,row,self.clusters[-1-cp].clone(),storage,combined) }
            }
            x += i64(cells)
        }
    }
}

pub enum Key { Char(rune), Up, Down, Left, Right, Home, End, Delete, Backspace, Tab, Enter, Escape }

pub enum Viewport { Fullscreen, Fixed(Rect), Inline(i32) }

pub enum ClearType { All, AfterCursor, BeforeCursor, CurrentLine, UntilNewLine }

impl ClearType {
    fn sequence(&self) -> string {
        match self {
            .All => "\x1b[2J", .AfterCursor => "\x1b[J", .BeforeCursor => "\x1b[1J",
            .CurrentLine => "\x1b[2K", .UntilNewLine => "\x1b[K",
        }
    }

    fn parts(&self, w:i32, h:i32, x:i32, y:i32) -> (Rect,Rect) {
        empty := Rect::new(0,0,0,0)
        if w <= 0 || h <= 0 { return (empty,empty) }
        col := cmp.clamp<i32>(x,0,w-1)
        row := cmp.clamp<i32>(y,0,h-1)
        match self {
            .All => (Rect::new(0,0,w,h),empty),
            .AfterCursor => (Rect::new(col,row,w-col,1),Rect::new(0,row+1,w,h-row-1)),
            .BeforeCursor => (Rect::new(0,0,w,row),Rect::new(0,row,col+1,1)),
            .CurrentLine => (Rect::new(0,row,w,1),empty),
            .UntilNewLine => (Rect::new(col,row,w-col,1),empty),
        }
    }
}

pub struct WindowSize { columns: i32, rows: i32, pixel_width: i32, pixel_height: i32 }

impl Eq for WindowSize {
    fn eq(&self, other: &Self) -> bool {
        self.columns == other.columns && self.rows == other.rows &&
            self.pixel_width == other.pixel_width && self.pixel_height == other.pixel_height
    }
}

pub fn window_size() -> Result<WindowSize,string> {
    if target_is("windows") { return .Err("Window pixel size is unavailable on the Windows console.") }
    else {
        mut size: [u16; 4] = [0; 4]
        if !posix.window_size(&mut size) { return .Err("Could not read the terminal window size.") }
        .Ok(WindowSize { columns:i32(size[1]), rows:i32(size[0]), pixel_width:i32(size[2]), pixel_height:i32(size[3]) })
    }
}

fn valid_area(area: Rect) -> bool {
    area.x >= 0 && area.y >= 0 && area.w >= 0 && area.h >= 0 &&
        i64(area.x)+i64(area.w) <= 65535 && i64(area.y)+i64(area.h) <= 65535
}

const CURSOR_UNSUPPORTED: string = "Backend cannot change cursor visibility."

pub trait Backend {
    fn size(&mut self) -> (i32,i32)
    fn viewport_changed(&mut self, area: Rect) {}
    fn window_size(&mut self) -> Result<WindowSize,string> {
        (w,h) := self.size()
        .Ok(WindowSize { columns:w, rows:h, pixel_width:0, pixel_height:0 })
    }
    fn present(&mut self, frame: &Frame, previous: &Frame) -> Result<(),string>
    fn draw_cells(&mut self, frame: &Frame, previous: &Frame) -> Result<(),string> { .Err("Backend cannot present a cell diff independently.") }
    fn flush(&mut self) -> Result<(),string> { .Ok }
    fn clear_screen(&mut self, area: Rect) -> Result<(),string> {
        blank := Frame::try_at(area)?
        unknown := Frame::new(0,0)
        self.present(&blank,&unknown)
    }
    fn clear_rect(&mut self, area: Rect) -> Result<(),string> {
        if area.is_empty() { return .Ok }
        blank := Frame::try_at(area)?
        self.write_region(&blank)
    }
    fn erase(&mut self, kind: ClearType) -> Result<(),string> {
        (w,h) := self.size()
        if w <= 0 || h <= 0 { return .Ok }
        if kind == .All { return self.clear_screen(Rect::new(0,0,w,h)) }
        (x,y) := self.read_cursor()?
        (first,second) := kind.parts(w,h,x,y)
        result := self.clear_rect(first)
        after := if result.is_ok() { self.clear_rect(second) } else { move result }
        restored := self.move_to(x,y)
        flushed := self.flush()
        after?
        restored?
        move flushed
    }
    fn scrollback_needs_full_screen(&self) -> bool { false }
    fn supports_scrolling_regions(&self) -> bool { true }
    fn read_cursor(&mut self) -> Result<(i32,i32),string> { .Err("Backend cannot read the cursor.") }
    fn set_cursor_visible(&mut self, visible: bool) -> Result<(),string> { .Err(CURSOR_UNSUPPORTED) }
    fn restore_cursor(&mut self) -> Result<(),string> {
        match self.set_cursor_visible(true) {
            .Err(message) if message != CURSOR_UNSUPPORTED => .Err(message),
            _ => .Ok,
        }
    }
    fn move_to(&mut self, x: i32, y: i32) -> Result<(),string> { .Err("Backend cannot move the cursor.") }
    fn extend_lines(&mut self, rows: i32) -> Result<(),string> { .Err("Backend cannot append lines.") }
    fn shift_rows(&mut self, top: i32, bottom: i32, delta: i32) -> Result<(),string> { .Err("Backend cannot scroll a region.") }
    fn write_region(&mut self, frame: &Frame) -> Result<(),string> { .Err("Backend cannot write a region.") }
    fn overwrite_region(&mut self, frame: &Frame) -> Result<(),string> {
        if !frame.has_options { return self.write_region(&frame) }
        area := frame.area()
        mut raw := Frame::try_at(area)?
        raw.copy_region(&frame,area,area.x,area.y)
        raw.options.clear()
        raw.has_options = false
        self.write_region(&raw)
    }
}

@resource(dispose)
pub opaque struct Terminal<B> where B: Backend {
    device: B, viewport: Viewport, area: Rect, screen: Rect, last_y: i32, buffers: [Frame;2], front: i32, number: u64, invalid: bool, staged: bool, hidden_cursor: bool,
}

enum RowWrite { All, OverCleared }

fn write_terminal_rows<B: Backend>(device: &mut B, frame: &Frame, rows: RowWrite) -> Result<(),string> {
    match rows {
        .All => { device.overwrite_region(&frame)? },
        .OverCleared => { device.write_region(&frame)? },
    }
    device.flush()
}

enum Renderer<S> {
    Draw(fn(&mut Frame,&S)), Stateful(fn(&mut Frame,&mut S))
}

impl Terminal<B> {
    fn empty(move device: B) -> Self {
        empty := Rect { x:0,y:0,w:0,h:0 }
        pending := Rect { x:-1,y:0,w:0,h:0 }
        Self { device: move device, viewport:.Fullscreen, area:empty, screen:pending, last_y:0, buffers: [Frame::new(0,0),Frame::new(0,0)], front: 0, number: 0, invalid: true, staged:false, hidden_cursor:false }
    }

    fn dispose(&mut self) {
        if self.hidden_cursor {
            match self.device.restore_cursor() {
                .Ok => {},
                .Err(message) => { _ := sys.eprint("Failed to show the cursor: " + message) },
            }
        }
    }

    pub fn new(move device: B) -> Self {
        mut term := Self::empty(move device)
        (w,h) := term.device.size()
        screen := Rect { x:0,y:0,w:w,h:h }
        if valid_area(screen) && term.reserve_buffers(screen).is_ok() {
            term.area = screen
            term.screen = screen
            term.initialize_buffers()
        }
        move term
    }

    fn initialize_buffers(&mut self) {
        self.buffers[0].reset_area(self.area)
        self.buffers[0].cursor_x = -2
        self.device.viewport_changed(self.area)
        self.invalid = false
    }

    fn reserve_buffers(&mut self, area: Rect) -> Result<(),string> {
        for i in 0..2 {
            buffer := &mut self.buffers[i]
            reserve_cells(&mut buffer.glyphs,&mut buffer.styles,area)?
        }
        .Ok
    }

    pub fn with_viewport(move device: B, viewport: Viewport) -> Result<Self,string> {
        mut term := Self::empty(move device)
        term.viewport = viewport
        (w,h) := term.device.size()
        screen := Rect { x:0,y:0,w:w,h:h }
        if !valid_area(screen) { return .Err("Invalid terminal size.") }
        term.screen = screen
        match viewport {
            .Fullscreen => { term.reserve_buffers(screen)?; term.area = screen },
            .Fixed(area) => {
                if !valid_area(area) { return .Err("Invalid fixed viewport.") }
                term.reserve_buffers(area)?
                term.area = area
            },
            .Inline(height) => {
                if height < 1 || height > 65535 { return .Err("Invalid inline height.") }
                term.reserve_buffers(Rect::new(0,0,w,cmp.min<i32>(height,h)))?
                position := term.reserve_inline(height,0)?
                term.last_y = position.1
            },
        }
        term.initialize_buffers()
        .Ok(move term)
    }

    fn reserve_inline(&mut self, height: i32, offset: i32) -> Result<(i32,i32),string> {
        pos := self.device.read_cursor()?
        reserve := cmp.max<i32>(0,height-offset-1)
        self.device.extend_lines(reserve)?
        below := cmp.max<i32>(0,self.screen.h-pos.1-1)
        top := cmp.max<i32>(0,pos.1-cmp.max<i32>(0,reserve-below)-offset)
        self.area = Rect { x:0,y:top,w:self.screen.w,h:cmp.min<i32>(height,self.screen.h) }
        .Ok(pos)
    }

    pub fn viewport_area(&self) -> Rect { self.area }

    pub fn cursor_position(&mut self) -> Result<(i32,i32),string> { self.device.read_cursor() }

    pub fn set_cursor_position(&mut self, x:i32, y:i32) -> Result<(),string> {
        row := clamp(y,65535)
        self.buffers[self.front].cursor_changed = true
        self.device.move_to(clamp(x,65535),row)?
        self.last_y = row
        .Ok
    }

    pub fn show_cursor(&mut self) -> Result<(),string> {
        self.buffers[self.front].cursor_changed = true
        self.device.set_cursor_visible(true)?
        self.hidden_cursor = false
        .Ok
    }

    pub fn hide_cursor(&mut self) -> Result<(),string> {
        self.buffers[self.front].cursor_changed = true
        self.device.set_cursor_visible(false)?
        self.hidden_cursor = true
        .Ok
    }

    pub fn size(&mut self) -> (i32,i32) { self.device.size() }

    pub fn window_size(&mut self) -> Result<WindowSize,string> { self.device.window_size() }

    pub fn autoresize(&mut self) -> Result<(),string> {
        match self.viewport { .Fixed(_) => { return .Ok }, _ => {}, }
        (w,h) := self.device.size()
        screen := Rect { x:0,y:0,w:w,h:h }
        if screen == self.screen { return .Ok }
        self.fit(screen)
    }

    pub fn clear(&mut self) -> Result<(),string> {
        pos := self.device.read_cursor()?
        self.clear_surface(.Some(pos))
    }

    fn clear_surface(&mut self, cursor: Option<(i32,i32)>) -> Result<(),string> {
        self.invalid = true
        area := match self.viewport {
            .Inline(_) => Rect { x:0,y:self.area.y,w:self.screen.w,h:self.screen.h-self.area.y },
            _ => self.area,
        }
        match self.viewport {
            .Fullscreen => { self.device.clear_screen(area)? },
            _ => { self.device.clear_rect(area)? },
        }
        match cursor { .Some(p) => { self.device.move_to(p.0,p.1)? }, .None => {}, }
        self.device.flush()?
        previous := &mut self.buffers[self.front]
        previous.reset_area(self.area)
        previous.cursor_x = -2
        self.invalid = false
        .Ok
    }

    pub fn resize(&mut self, area: Rect) -> Result<(),string> {
        if !valid_area(area) { return .Err("Invalid terminal viewport size.") }
        old := self.area
        mut cursor: Option<(i32,i32)> = .None
        viewport := self.viewport
        size := match viewport { .Inline(height) => Rect::new(0,0,area.w,cmp.min<i32>(height,area.h)), _ => area, }
        self.reserve_buffers(size)?
        if self.staged { self.buffers[1-self.front].reserve_metadata(size)? }
        match viewport {
            .Inline(height) => {
                self.screen = area
                result := self.reserve_inline(height,cmp.max<i32>(0,self.last_y-old.y))
                if result.is_err() { self.screen.w = -1; return .Err(result.unwrap_err()) }
                cursor = .Some(result.unwrap())
            },
            .Fixed(_) => { self.area = area; self.viewport = .Fixed(area) },
            .Fullscreen => { self.screen = area; self.area = area },
        }
        embedded := match viewport { .Fullscreen => false, _ => true, }
        if embedded && self.area.w < old.w {
            self.area.y = 0
            (w,h) := self.device.size()
            blank := Frame::try_at(Rect::new(0,0,w,h))?
            self.invalid = true
            self.device.write_region(&blank)?
        }
        self.device.viewport_changed(self.area)
        if self.staged {
            pending := &mut self.buffers[1-self.front]
            pending.try_resize(self.area)?
        }
        result := self.clear_surface(cursor)
        if result.is_err() { self.screen.w = -1 }
        move result
    }

    pub fn insert_before(&mut self, lines: &Frame) -> Result<(),string> {
        viewport := self.viewport
        match viewport { .Inline(_) => {}, _ => { return .Ok }, }
        source := lines.area()
        if self.area.is_empty() { return .Ok }
        regions := self.device.supports_scrolling_regions()
        if source.h == 0 && regions { return .Ok }
        if source.w != self.area.w { return .Err("Inserted lines must match the viewport width.") }
        invalid_before := self.invalid
        self.invalid = true
        if !regions { return self.insert_with_line_feeds(&lines) }
        mut row := 0
        free := cmp.min<i32>(source.h,self.screen.h-self.area.bottom())
        if free > 0 {
            self.device.shift_rows(self.area.y,self.area.bottom()+free,free)?
            top := self.area.y
            self.relocate_inline(top+free)
            block := lines.rows_at(0,top,free)
            write_terminal_rows(&mut self.device,&block,.OverCleared)?
            row = free
        }
        if row < source.h && self.device.scrollback_needs_full_screen() {
            while row < source.h {
                block := lines.rows_at(row,self.area.y,1)
                write_terminal_rows(&mut self.device,&block,.All)?
                self.device.move_to(0,self.screen.h-1)?
                self.device.extend_lines(1)?
                row += 1
            }
            write_terminal_rows(&mut self.device,&self.buffers[self.front],.OverCleared)?
        } else if self.area.h == self.screen.h {
            for line in row..source.h {
                block := lines.rows_at(line,0,1)
                mode := if line == row { RowWrite.All } else { RowWrite.OverCleared }
                write_terminal_rows(&mut self.device,&block,mode)?
                self.device.shift_rows(0,1,-1)?
            }
            top := self.buffers[self.front].rows_at(0,0,1)
            write_terminal_rows(&mut self.device,&top,.OverCleared)?
        } else {
            while row < source.h {
                count := cmp.min<i32>(self.area.y,source.h-row)
                if count < 1 { return .Err("No space above the viewport.") }
                self.device.shift_rows(0,self.area.y,-count)?
                block := lines.rows_at(row,self.area.y-count,count)
                write_terminal_rows(&mut self.device,&block,.OverCleared)?
                row += count
            }
        }
        cursor := self.buffers[self.front].cursor_position()
        match cursor { .Some(p) => { self.device.move_to(p.0,p.1)?; self.device.flush()? }, .None => {}, }
        self.invalid = invalid_before
        .Ok
    }

    fn relocate_inline(&mut self, top: i32) {
        self.area.y = top
        self.device.viewport_changed(self.area)
        self.buffers[self.front].bounds.y = top
        if self.staged { self.buffers[1-self.front].bounds.y = top }
    }

    fn insert_with_line_feeds(&mut self, lines: &Frame) -> Result<(),string> {
        height := self.screen.h
        mut remaining := lines.area().h
        mut top := self.area.y
        mut row := 0
        while remaining > height-self.area.h {
            count := cmp.min<i32>(remaining,height)
            shift := cmp.max<i32>(0,top+count-height)
            self.scroll_screen_up(shift)?
            top -= shift
            block := lines.rows_at(row,top,count)
            write_terminal_rows(&mut self.device,&block,.All)?
            top += count
            row += count
            remaining -= count
        }
        shift := cmp.max<i32>(0,top+remaining+self.area.h-height)
        self.scroll_screen_up(shift)?
        top -= shift
        if remaining > 0 {
            block := lines.rows_at(row,top,remaining)
            write_terminal_rows(&mut self.device,&block,.All)?
        }
        self.relocate_inline(top+remaining)
        self.clear()
    }

    fn scroll_screen_up(&mut self, rows: i32) -> Result<(),string> {
        if rows == 0 { return .Ok }
        self.set_cursor_position(0,self.screen.h-1)?
        self.device.extend_lines(rows)
    }

    pub fn backend(&self) -> &B from self { &self.device }
    pub fn backend_mut(&mut self) -> &mut B from self {
        self.buffers[self.front].cursor_changed = true
        &mut self.device
    }
    pub fn completed(&self) -> &Frame from self { &self.buffers[self.front] }
    pub fn invalidate(&mut self) { self.invalid = true }

    pub fn draw<S>(&mut self, state: &mut S, render: fn(&mut Frame,&mut S)) -> Result<(),string> {
        (w,h) := self.device.size()
        self.prepare(w,h)?
        render(&mut self.buffers[1-self.front],&mut state)
        self.commit()
    }

    pub fn try_draw<S>(&mut self, state: &mut S, render: fn(&mut Frame,&mut S)->Result<(),string>) -> Result<(),string> {
        (w,h) := self.device.size()
        self.prepare(w,h)?
        render(&mut self.buffers[1-self.front],&mut state)?
        self.commit()
    }

    fn prepare(&mut self, w: i32, h: i32) -> Result<(),string> {
        screen := Rect { x:0,y:0,w:w,h:h }
        if screen != self.screen { self.fit(screen)? }
        self.begin_frame()
        .Ok
    }

    fn stage(&mut self) {
        if self.staged { return }
        back := 1-self.front
        self.buffers[back].reset_area(self.area)
        self.buffers[back].cursor_changed = false
        self.buffers[back].hide_cursor()
        self.buffers[back].number = self.number
        self.staged = true
    }

    fn begin_frame(&mut self) {
        self.stage()
        self.buffers[1-self.front].hide_cursor()
    }

    pub fn current_buffer_mut(&mut self) -> &mut Frame from self {
        self.stage()
        &mut self.buffers[1-self.front]
    }

    pub fn get_frame(&mut self) -> &mut Frame from self {
        self.begin_frame()
        &mut self.buffers[1-self.front]
    }

    pub fn flush(&mut self) -> Result<(),string> {
        self.stage()
        back := 1-self.front
        self.buffers[self.front].cursor_changed = true
        result := if self.invalid {
            unknown := Frame::new(0,0)
            self.device.draw_cells(&self.buffers[back],&unknown)
        } else { self.device.draw_cells(&self.buffers[back],&self.buffers[self.front]) }
        if result.is_err() { self.invalid = true; return result }
        self.track_inline(false)
        self.invalid = false
        move result
    }

    pub fn swap_buffers(&mut self) {
        self.stage()
        self.front = 1-self.front
        self.buffers[self.front].cursor_changed = true
        self.staged = false
    }

    pub fn apply_buffer(&mut self) -> Result<(),string> {
        self.begin_frame()
        self.commit()
    }

    pub fn apply_buffer_with_cursor(&mut self, cursor: Option<(i32,i32)>) -> Result<(),string> {
        self.begin_frame()
        match cursor { .Some(p) => { self.buffers[1-self.front].set_cursor_position(p.0,p.1) }, .None => {}, }
        self.commit()
    }

    fn fit(&mut self, screen: Rect) -> Result<(),string> {
        if !valid_area(screen) { return .Err("Invalid terminal viewport size.") }
        viewport := self.viewport
        match viewport {
            .Fullscreen if self.screen.x < 0 => { self.reserve_buffers(screen)?; self.area = screen; self.screen = screen },
            .Fixed(_) => { self.screen = screen },
            _ => { return self.resize(screen) },
        }
        .Ok
    }

    fn commit(&mut self) -> Result<(),string> {
        back := 1-self.front
        result := if self.invalid {
            mut unknown := Frame::new(0,0)
            unknown.cursor_x = -2
            self.device.present(&self.buffers[back],&unknown)
        } else { self.device.present(&self.buffers[back],&self.buffers[self.front]) }
        if result.is_err() { self.invalid = true; return result }
        self.hidden_cursor = self.buffers[back].cursor_x < 0
        self.track_inline(true)
        self.staged = false
        flushed := self.device.flush()
        if flushed.is_err() { self.invalid = true; return flushed }
        self.invalid = false
        self.front = back
        self.number = self.number.wrapping_add(u64(1))
        move flushed
    }

    fn track_inline(&mut self, apply_cursor: bool) {
        match self.viewport { .Inline(_) => {}, _ => { return }, }
        next := &self.buffers[1-self.front]
        if apply_cursor && next.cursor_x >= 0 { self.last_y = next.cursor_y; return }
        prev := &self.buffers[self.front]
        mut scan := DiffScan::new(&next,&prev)
        while scan.next(&self.buffers[1-self.front],&self.buffers[self.front]) {
            self.last_y = next.bounds.y+scan.start/next.bounds.w
        }
    }
}

@resource(dispose)
pub opaque struct LiveBackend { session: terminal.Session, output: []u8, active: bool, width: i32, height: i32, inline_end: i32, fixed: bool, original_x: i32, original_y: i32, scrolling_regions: bool, scroll_region_dirty: bool }

const BLANK_COLUMNS: [u8;128] = [b' ';128]

impl LiveBackend {
    pub fn set_scrolling_regions(&mut self, enabled: bool) { self.scrolling_regions = enabled }

    fn prepare_erase(&mut self) -> Result<(),string> {
        if !self.active { return .Err("The terminal is closed.") }
        if self.scroll_region_dirty && !self.reset_scroll_region() { return .Err("Could not reset the scrolling region.") }
        .Ok
    }

    fn blank_columns(&mut self, count:i32) {
        mut left := count
        while left > 0 {
            n := cmp.min<i32>(left,BLANK_COLUMNS.len)
            bytes.extend(&mut self.output,&BLANK_COLUMNS[0..n])
            left -= n
        }
    }

    fn write_erase(&mut self) -> Result<(),string> {
        if !self.bytes(&self.output) { return .Err("Could not clear the terminal cells.") }
        self.output.clear()
        .Ok
    }

    fn clear_console_rect(&self, area: Rect) -> Result<(),string> {
        if area.is_empty() { return .Ok }
        if windows.clear_rect(&self.session.win,area.x,area.y,area.w,area.h) { return .Ok }
        .Err("Could not clear the console cells.")
    }

    fn dispose(&mut self) { self.close() }

    pub fn close(&mut self) {
        if !self.active { return }
        if self.scroll_region_dirty { _ := self.reset_scroll_region() }
        if self.inline_end > 0 && self.height > 0 {
            _ := self.move_to(0,cmp.min<i32>(self.height-1,self.inline_end))
            if self.inline_end >= self.height { _ := self.extend_lines(1) }
        } else if self.fixed {
            if target_is("windows") { _ := self.move_to(self.original_x,self.original_y) }
            else { _ := self.control("\x1b8") }
        }
        self.session.close()
        self.active = false
    }

    pub fn next(&mut self, wait_ms: i32) -> input.Event {
        if !self.active { return .Error }
        self.session.next(wait_ms)
    }

    fn bytes(&self, data: &[]u8) -> bool {
        if target_is("windows") { return windows.write(&self.session.win,&data) }
        else { return posix.write_bytes(&data) }
    }

    fn control(&mut self, value: string) -> Result<(),string> {
        if self.scroll_region_dirty && !self.reset_scroll_region() { return .Err("Could not reset the scrolling region.") }
        if self.bytes(&value.as_bytes()) { .Ok } else { .Err("Could not write to the terminal.") }
    }

    fn reset_scroll_region(&mut self) -> bool {
        if !self.bytes(&"\x1b[r".as_bytes()) { return false }
        self.scroll_region_dirty = false
        true
    }

    fn visible(&self, frame: &Frame) -> Rect {
        frame.bounds.intersection(Rect { x:0,y:0,w:self.width,h:self.height })
    }

    fn present_region(&mut self, frame: &Frame, previous: &Frame, cursor: bool) -> Result<(),string> {
        if !self.active { return .Err("The terminal is closed.") }
        visible := self.visible(&frame)
        if visible == frame.bounds {
            if self.draw_region(&frame,&previous,cursor) { return .Ok }
        } else {
            mut cropped := Frame::try_at(visible)?
            cropped.copy_region(&frame,visible,visible.x,visible.y)
            cropped.cursor_x = cmp.min<i32>(frame.cursor_x,self.width-1)
            cropped.cursor_y = cmp.min<i32>(frame.cursor_y,self.height-1)
            mut before := Frame::new(0,0)
            if frame.bounds == previous.bounds {
                before = Frame::try_at(visible)?
                before.copy_region(&previous,visible,visible.x,visible.y)
            }
            before.cursor_x = previous.displayed_cursor_x()
            before.cursor_y = previous.cursor_y
            if self.draw_region(&cropped,&before,cursor) { return .Ok }
        }
        .Err("Could not write the frame.")
    }

    fn draw_region(&mut self, frame: &Frame, previous: &Frame, cursor: bool) -> bool {
        if self.scroll_region_dirty && !self.reset_scroll_region() { return false }
        if cursor { return frame.present(&self.session,&previous,&mut self.output) }
        if target_is("windows") {
            if !self.session.win.vt { return frame.paint_windows(&previous,&self.session) }
        }
        self.output.clear()
        frame.ansi_cells(&previous,&mut self.output)
        self.bytes(&self.output)
    }
}

pub fn open(viewport: Viewport) -> Result<Terminal<LiveBackend>,string> {
    alternate := match viewport { .Fullscreen => true, _ => false, }
    mut backend := LiveBackend { session:terminal.session(), output:[], active:false,width:0,height:0,inline_end:-1,fixed:false,original_x:0,original_y:0,scrolling_regions:true,scroll_region_dirty:false }
    (w,h) := backend.size()
    if w <= 0 || h <= 0 || !backend.session.open(alternate) { return .Err("An interactive terminal is required on stdin and stdout.") }
    backend.active = true
    match viewport {
        .Fixed(_) => {
            if target_is("windows") {
                pos := backend.read_cursor()?
                backend.original_x = pos.0
                backend.original_y = pos.1
            } else { backend.control("\x1b7")? }
            backend.fixed = true
        },
        .Inline(_) => { backend.inline_end = 0 },
        _ => {},
    }
    if !backend.session.enter() { return .Err("Could not enter terminal mode.") }
    Terminal<LiveBackend>::with_viewport(move backend,viewport)
}

impl Backend for LiveBackend {
    fn viewport_changed(&mut self, area: Rect) {
        if self.inline_end >= 0 { self.inline_end = area.bottom() }
    }
    fn restore_cursor(&mut self) -> Result<(),string> { self.close(); .Ok }
    fn clear_screen(&mut self, area: Rect) -> Result<(),string> { self.erase(.All) }

    fn erase(&mut self, kind: ClearType) -> Result<(),string> {
        self.prepare_erase()?
        if target_is("windows") {
            if !self.session.win.vt {
                (w,h) := self.size()
                if w <= 0 || h <= 0 { return .Err("Could not read the console dimensions.") }
                (x,y) := if kind == .All { (0,0) } else { self.read_cursor()? }
                (first,second) := kind.parts(w,h,x,y)
                self.clear_console_rect(first)?
                return self.clear_console_rect(second)
            }
        }
        self.control(kind.sequence())
    }

    fn clear_rect(&mut self, area: Rect) -> Result<(),string> {
        self.prepare_erase()?
        if area.is_empty() { return .Ok }
        (w,h) := self.size()
        if w <= 0 || h <= 0 { return .Err("Could not read the terminal dimensions.") }
        visible := area.intersection(Rect::new(0,0,w,h))
        if visible.is_empty() { return .Ok }
        if target_is("windows") {
            if !self.session.win.vt {
                self.clear_console_rect(visible)?
                if visible.w == w {
                    return self.move_to(0,if visible.bottom() == h { visible.y } else { visible.bottom()-1 })
                }
                return self.move_to(cmp.min<i32>(visible.right(),w-1),visible.bottom()-1)
            }
        }
        self.output.clear()
        if visible.w == w && visible.bottom() == h {
            paint.cursor(&mut self.output,0,visible.y)
            bytes.append_utf8(&mut self.output,ClearType.AfterCursor.sequence())
            return self.write_erase()
        }
        for y in visible.y..visible.bottom() {
            paint.cursor(&mut self.output,visible.x,y)
            if visible.w == w { bytes.append_utf8(&mut self.output,ClearType.CurrentLine.sequence()) }
            else { self.blank_columns(visible.w) }
            if self.output.len >= 65536 { self.write_erase()? }
        }
        if self.output.len == 0 { .Ok } else { self.write_erase() }
    }

    fn scrollback_needs_full_screen(&self) -> bool { true }
    fn supports_scrolling_regions(&self) -> bool { self.scrolling_regions }
    fn window_size(&mut self) -> Result<WindowSize,string> { window_size() }
    fn size(&mut self) -> (i32,i32) {
        (w,h) := self.session.size()
        self.width = w
        self.height = h
        (w,h)
    }

    fn read_cursor(&mut self) -> Result<(i32,i32),string> {
        if !self.active { return .Err("The terminal is closed.") }
        if self.scroll_region_dirty && !self.reset_scroll_region() { return .Err("Could not reset the scrolling region.") }
        if target_is("windows") { return windows.read_position(&self.session.win) }
        else { return posix.read_cursor(&mut self.session.unix) }
    }

    fn move_to(&mut self, x: i32, y: i32) -> Result<(),string> {
        if !self.active { return .Err("The terminal is closed.") }
        if target_is("windows") {
            if !self.session.win.vt {
                if windows.move_to(&self.session.win,x,y) { return .Ok }
                return .Err("Could not move the console cursor.")
            }
        }
        self.control(f"\x1b[{y+1};{x+1}H")
    }

    fn set_cursor_visible(&mut self, visible: bool) -> Result<(),string> {
        if !self.active { return .Err("The terminal is closed.") }
        if target_is("windows") {
            if !self.session.win.vt {
                if windows.set_cursor_visible(&self.session.win,visible) { return .Ok }
                return .Err("Could not change console cursor visibility.")
            }
        }
        self.control(if visible { "\x1b[?25h" } else { "\x1b[?25l" })
    }

    fn extend_lines(&mut self, rows: i32) -> Result<(),string> {
        if !self.active { return .Err("The terminal is closed.") }
        if self.scroll_region_dirty && !self.reset_scroll_region() { return .Err("Could not reset the scrolling region.") }
        if target_is("windows") {
            if !self.session.win.vt {
                if windows.append_rows(&mut self.session.win,rows) { return .Ok }
                return .Err("Could not append console lines.")
            }
        }
        self.output.clear()
        for _ in 0..rows { self.output.push(13); self.output.push(10) }
        if self.bytes(&self.output) { .Ok } else { .Err("Could not append lines.") }
    }

    fn shift_rows(&mut self, top: i32, bottom: i32, delta: i32) -> Result<(),string> {
        if !self.active { return .Err("The terminal is closed.") }
        if !self.scrolling_regions { return .Err("Scrolling regions are disabled.") }
        if delta == 0 { return .Ok }
        mut native := false
        if target_is("windows") {
            if !self.session.win.vt {
                if !windows.shift_rows(&mut self.session.win,top,bottom,delta) { return .Err("Could not scroll the console.") }
                native = true
            }
        }
        if !native {
            if bottom == top+1 { self.control(f"\x1b[{top+1};1H\x1b[2K")? } else {
                direction := if delta < 0 { "S" } else { "T" }
                written := self.control(f"\x1b[{top+1};{bottom}r\x1b[{delta.abs()}{direction}\x1b[r")
                if written.is_err() {
                    self.scroll_region_dirty = true
                    _ := self.reset_scroll_region()
                    return written
                }
            }
        }
        .Ok
    }

    fn write_region(&mut self, frame: &Frame) -> Result<(),string> {
        previous := Frame::new(0,0)
        visible := self.visible(&frame)
        if visible.is_empty() { return .Ok }
        if visible != frame.bounds {
            mut cropped := Frame::try_at(visible)?
            cropped.copy_region(&frame,visible,visible.x,visible.y)
            if self.draw_region(&cropped,&previous,false) { return .Ok }
        } else if self.draw_region(&frame,&previous,false) { return .Ok }
        .Err("Could not write terminal rows.")
    }

    fn present(&mut self, frame: &Frame, previous: &Frame) -> Result<(),string> {
        self.present_region(&frame,&previous,true)
    }
    fn draw_cells(&mut self, frame: &Frame, previous: &Frame) -> Result<(),string> {
        self.present_region(&frame,&previous,false)
    }

}

pub fn run<S>(state: &mut S, draw: fn(&mut Frame, &S), update: fn(&mut S, Key) -> bool) -> Result<(), string> {
    drive<S>(.Fullscreen,&mut state, Renderer<S>.Draw(draw), update, .None, fn(_state: &mut S, _elapsed: i64) -> bool { false })
}

pub fn run_stateful<S>(state: &mut S, draw: fn(&mut Frame, &mut S), update: fn(&mut S, Key) -> bool) -> Result<(), string> {
    drive<S>(.Fullscreen,&mut state, Renderer<S>.Stateful(draw), update, .None, fn(_state: &mut S, _elapsed: i64) -> bool { false })
}

pub fn animate<S>(state: &mut S, fps: i32, draw: fn(&mut Frame, &S), update: fn(&mut S, Key) -> bool, tick: fn(&mut S, i64) -> bool) -> Result<(), string> {
    drive<S>(.Fullscreen,&mut state, Renderer<S>.Draw(draw), update, .Some(fps), tick)
}

pub fn animate_stateful<S>(state: &mut S, fps: i32, draw: fn(&mut Frame, &mut S), update: fn(&mut S, Key) -> bool, tick: fn(&mut S, i64) -> bool) -> Result<(), string> {
    drive<S>(.Fullscreen,&mut state, Renderer<S>.Stateful(draw), update, .Some(fps), tick)
}

pub fn run_in<S>(viewport: Viewport, state: &mut S, draw: fn(&mut Frame,&S), update: fn(&mut S,Key)->bool) -> Result<(),string> {
    drive<S>(viewport,&mut state,Renderer<S>.Draw(draw),update,.None,fn(_s:&mut S,_ms:i64)->bool { false })
}

fn drive<S>(viewport: Viewport, state: &mut S, renderer: Renderer<S>, update: fn(&mut S, Key) -> bool, rate: Option<i32>, tick: fn(&mut S, i64) -> bool) -> Result<(), string> {
    fps := rate.unwrap_or(0)
    if rate.is_some() && (fps < 1 || fps > 1000) { return .Err("Frame rate must be between 1 and 1000.") }
    mut term := open(viewport)?
    mut last_w := 0
    mut last_h := 0
    start := if fps > 0 { clock.monotonic_ns() } else { i64(0) }
    if start < 0 { return .Err("Could not read the animation clock.") }
    interval := if fps == 0 { i64(0) } else { i64(1000000000) / i64(fps) }
    mut next_tick := start + interval
    mut dirty := true
    while true {
        (next_w, next_h) := term.device.size()
        if next_w <= 0 || next_h <= 0 { return .Err("Could not read the terminal size.") }
        if next_w > 65535 || next_h > 65535 { return .Err("Invalid terminal size.") }
        if interval > 0 {
            now := clock.monotonic_ns()
            if now < 0 { return .Err("Could not read the animation clock.") }
            if now >= next_tick {
                dirty = tick(&mut state, (now - start) / 1000000) || dirty
                next_tick += ((now - next_tick) / interval + 1) * interval
            }
        }
        if dirty || next_w != last_w || next_h != last_h {
            last_w = next_w
            last_h = next_h
            term.prepare(next_w,next_h)?
            frame := &mut term.buffers[1-term.front]
            match &renderer {
                .Draw(draw) => { draw(&mut frame,&state) },
                .Stateful(draw) => { draw(&mut frame,&mut state) },
            }
            term.commit()?
            dirty = false
        }
        mut wait_ms := 125
        if interval > 0 {
            now := clock.monotonic_ns()
            if now < 0 { return .Err("Could not read the animation clock.") }
            left := next_tick - now
            wait_ms = if left <= 0 { 0 } else { clamp(i32((left + 999999) / 1000000), 125) }
        }
        match term.device.session.next(wait_ms) {
            .Idle => {},
            .Error => { return .Err("Could not read terminal input.") },
            .Quit => { return .Ok },
            .Press(key) => {
                if !update(&mut state, key) { return .Ok }
                dirty = true
            },
        }
    }
    .Ok
}
