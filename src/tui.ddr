capability stdio, unsafe

import .width
import .terminal
import .posix
import .windows
import std.bytes as bytes
import std.time as clock
import std.cmp as cmp
import .paint
import .colorspace
import std.parse as parse
import std.text as strings

pub enum Color {
    Default, Black, Red, Green, Yellow, Blue, Magenta, Cyan, Gray, DarkGray,
    LightRed, LightGreen, LightYellow, LightBlue, LightMagenta, LightCyan, White, BrightWhite,
    Indexed(u8), Rgb(u8, u8, u8)
}

impl Color {
    pub fn code(&self) -> i32 {
        match self {
            .Default => -1, .Black => 0, .Red => 1, .Green => 2, .Yellow => 3, .Blue => 4,
            .Magenta => 5, .Cyan => 6, .Gray => 7, .White => 7, .DarkGray => 8, .LightRed => 9, .LightGreen => 10,
            .LightYellow => 11, .LightBlue => 12, .LightMagenta => 13, .LightCyan => 14, .BrightWhite => 15,
            .Indexed(n) => i32(n),
            .Rgb(r, g, b) => 0x1000000 + i32(r) * 65536 + i32(g) * 256 + i32(b),
        }
    }

    pub fn from_hsl(hue: f64, saturation: f64, lightness: f64) -> Self {
        rgb(colorspace.hsl(hue, saturation, lightness))
    }

    pub fn from_hsluv(hue: f64, saturation: f64, lightness: f64) -> Self {
        rgb(colorspace.hsluv(hue, saturation, lightness))
    }

    pub fn parse(value: string) -> Option<Color> {
        if value.len == 7 && value[0] == b'#' {
            hex := parse.hex_u64_range(value, 1, 7)
            if hex.ok { return .Some(rgb(u32(hex.value))) }
        }
        start := if value.len > 0 && value[0] == b'+' { 1 } else { 0 }
        index := parse.u64_range(value, start, value.len)
        if index.ok && index.value < 256 { return .Some(.Indexed(u8(index.value))) }
        mut name := strings.lower(value)
        for separator in [" ", "-", "_"] { name = strings.replace(name, separator, "") }
        name = strings.replace(strings.replace(strings.replace(name, "bright", "light"), "grey", "gray"), "silver", "gray")
        if name == "reset" { return .Some(.Default) }
        if name == "lightblack" { return .Some(.DarkGray) }
        if name == "lightwhite" || name == "lightgray" { return .Some(.BrightWhite) }
        for i in 0..16 {
            named := Color::decoded(i)
            if strings.lower(named.str()) == name { return .Some(named) }
        }
        .None
    }

    fn encoded(&self) -> i32 {
        match self { .Indexed(n) => 256 + i32(n), _ => self.code(), }
    }

    fn decoded(code: i32) -> Self {
        if code < 0 { return .Default }
        if code < 16 {
            colors: [Color; 16] = [.Black, .Red, .Green, .Yellow, .Blue, .Magenta, .Cyan, .Gray,
                .DarkGray, .LightRed, .LightGreen, .LightYellow, .LightBlue, .LightMagenta, .LightCyan, .BrightWhite]
            return colors[code]
        }
        if code < 512 { return .Indexed(u8(code - 256)) }
        rgb(u32(code))
    }
}

impl Display for Color {
    fn str(&self) -> string {
        match self {
            .Default => "Reset", .Black => "Black", .Red => "Red", .Green => "Green",
            .Yellow => "Yellow", .Blue => "Blue", .Magenta => "Magenta", .Cyan => "Cyan",
            .Gray => "Gray", .DarkGray => "DarkGray", .LightRed => "LightRed",
            .LightGreen => "LightGreen", .LightYellow => "LightYellow", .LightBlue => "LightBlue",
            .LightMagenta => "LightMagenta", .LightCyan => "LightCyan", .White => "Gray", .BrightWhite => "White",
            .Indexed(n) => n.str(),
            .Rgb(r, g, b) => {
                digits := "0123456789ABCDEF"
                mut out: []u8 = [b'#']
                for channel in [r, g, b] {
                    out.push(digits[i32(channel) / 16])
                    out.push(digits[i32(channel) % 16])
                }
                bytes.decode(&out).unwrap()
            },
        }
    }
}

impl Eq for Color {
    fn eq(&self, other: &Self) -> bool { self.encoded() == other.encoded() }
}

fn packed_rgb(value: u32) -> i32 { 0x1000000 + i32(value.bit_and(0xffffff)) }

pub fn rgb(value: u32) -> Color {
    .Rgb(u8(value.shr(16).bit_and(255)), u8(value.shr(8).bit_and(255)), u8(value.bit_and(255)))
}

pub enum Modifier { Bold, Dim, Italic, Underlined, SlowBlink, RapidBlink, Reversed, Hidden, CrossedOut }

impl Modifier {
    fn mask(self) -> i32 {
        match self {
            .Bold => 1, .Dim => 2, .Italic => 4, .Underlined => 8, .SlowBlink => 16,
            .RapidBlink => 32, .Reversed => 64, .Hidden => 128, .CrossedOut => 256,
        }
    }
}

const INHERIT: i32 = -2

pub opaque struct Style {
    fg: i32, bg: i32, underline: i32, added: i32, removed: i32,
}

pub fn plain() -> Style { Style { fg: INHERIT, bg: INHERIT, underline: INHERIT, added: 0, removed: 0 } }
pub fn ink(color: Color) -> Style { plain().foreground(color) }

impl Style {
    pub fn reset() -> Self {
        Self { fg: -1, bg: -1, underline: -1, added: 0, removed: 511 }
    }

    pub fn foreground(self, color: Color) -> Self { mut s := self; s.fg = color.encoded(); s }
    pub fn background(self, color: Color) -> Self { mut s := self; s.bg = color.encoded(); s }
    pub fn underline_color(self, color: Color) -> Self { mut s := self; s.underline = color.encoded(); s }

    pub fn foreground_rgb(self, rgb: u32) -> Self { mut s := self; s.fg = packed_rgb(rgb); s }
    pub fn background_rgb(self, rgb: u32) -> Self { mut s := self; s.bg = packed_rgb(rgb); s }
    pub fn underline_rgb(self, rgb: u32) -> Self { mut s := self; s.underline = packed_rgb(rgb); s }
    pub fn foreground_index(self, index: u8) -> Self { mut s := self; s.fg = 256 + i32(index); s }
    pub fn background_index(self, index: u8) -> Self { mut s := self; s.bg = 256 + i32(index); s }
    pub fn underline_index(self, index: u8) -> Self { mut s := self; s.underline = 256 + i32(index); s }

    pub fn with(self, modifier: Modifier) -> Self {
        mut s := self
        mask := modifier.mask()
        s.added = s.added.bit_or(mask)
        s.removed = s.removed.bit_and(mask.bit_not())
        s
    }

    pub fn without(self, modifier: Modifier) -> Self {
        mut s := self
        mask := modifier.mask()
        s.removed = s.removed.bit_or(mask)
        s.added = s.added.bit_and(mask.bit_not())
        s
    }

    fn empty(&self) -> bool {
        self.added == 0 && self.removed == 0 && self.fg == INHERIT && self.bg == INHERIT && self.underline == INHERIT
    }

    fn color(code: i32) -> Option<Color> {
        if code == INHERIT { return .None }
        .Some(Color::decoded(code))
    }

    pub fn get_foreground(&self) -> Option<Color> { Style::color(self.fg) }
    pub fn get_background(&self) -> Option<Color> { Style::color(self.bg) }
    pub fn get_underline_color(&self) -> Option<Color> { Style::color(self.underline) }
    pub fn removes(&self, modifier: Modifier) -> bool { self.removed.bit_and(modifier.mask()) != 0 }

    pub fn has(&self, modifier: Modifier) -> bool { self.added.bit_and(modifier.mask()) != 0 }
    pub fn bold(self) -> Self { self.with(.Bold) }
    pub fn dim(self) -> Self { self.with(.Dim) }
    pub fn italic(self) -> Self { self.with(.Italic) }
    pub fn underlined(self) -> Self { self.with(.Underlined) }
    pub fn inverted(self) -> Self { self.with(.Reversed) }

    pub fn patch(self, overlay: Style) -> Self {
        mut s := self
        if overlay.fg != INHERIT { s.fg = overlay.fg }
        if overlay.bg != INHERIT { s.bg = overlay.bg }
        if overlay.underline != INHERIT { s.underline = overlay.underline }
        s.added = s.added.bit_and(overlay.removed.bit_not()).bit_or(overlay.added)
        s.removed = s.removed.bit_and(overlay.added.bit_not()).bit_or(overlay.removed)
        s
    }

    fn brush(&self) -> paint.Brush {
        paint.Brush {
            fg: if self.fg == INHERIT { -1 } else { self.fg }, bg: if self.bg == INHERIT { -1 } else { self.bg },
            modifiers: self.added.bit_and(511)
        }
    }
}

pub struct Rect { x: i32, y: i32, w: i32, h: i32 }

fn clamp(n: i32, limit: i32) -> i32 {
    if n < 0 { return 0 }
    if n > limit { return limit }
    n
}

impl Rect {
    pub fn intersection(self, other: Rect) -> Rect {
        x := cmp.max<i32>(self.x, other.x)
        y := cmp.max<i32>(self.y, other.y)
        right := cmp.min<i64>(i64(self.x) + i64(self.w), i64(other.x) + i64(other.w))
        bottom := cmp.min<i64>(i64(self.y) + i64(self.h), i64(other.y) + i64(other.h))
        Rect { x: x, y: y, w: i32(cmp.max<i64>(0, right - i64(x))), h: i32(cmp.max<i64>(0, bottom - i64(y))) }
    }

    pub fn rows(self, first: i32) -> (Rect, Rect) {
        n := clamp(first, self.h)
        (Rect { x: self.x, y: self.y, w: self.w, h: n },
            Rect { x: self.x, y: self.y + n, w: self.w, h: self.h - n })
    }

    pub fn cols(self, first: i32) -> (Rect, Rect) {
        n := clamp(first, self.w)
        (Rect { x: self.x, y: self.y, w: n, h: self.h },
            Rect { x: self.x + n, y: self.y, w: self.w - n, h: self.h })
    }

    pub fn inset(self, padding: i32) -> Rect {
        (_, rest) := self.rows(padding)
        (middle, _) := rest.rows(rest.h - clamp(padding, rest.h))
        (_, right) := middle.cols(padding)
        (body, _) := right.cols(right.w - clamp(padding, right.w))
        body
    }
}

const OFFSET_MASK: i32 = 4095
const CLUSTER: i32 = 0x110000
const ZERO_CLUSTER: i32 = 0x110001
const WIDE: i32 = 0x200000

pub opaque struct Frame { bounds: Rect, glyphs: []i32, styles: []i64, decorations: []i64, clusters: []string, cluster_cells: []i32 }

impl Frame {
    pub fn new(w: i32, h: i32) -> Self {
        cols := clamp(w, 4096)
        rows := clamp(h, if cols > 0 { clamp(1048576 / cols, 4096) } else { 4096 })
        n := cols * rows
        mut glyphs: []i32 = []
        mut styles: []i64 = []
        glyphs.reserve(n)
        styles.reserve(n)
        for _ in 0..n { glyphs.push(0); styles.push(0) }
        Self { bounds: Rect { x: 0, y: 0, w: cols, h: rows }, glyphs: glyphs, styles: styles, decorations: [], clusters: [], cluster_cells: [] }
    }

    pub fn area(&self) -> Rect { self.bounds }

    fn encode(&mut self, style: Style) -> i64 {
        packed := style.brush().packed()
        self.style_key(packed, style.underline)
    }

    fn style_key(&mut self, packed: i64, underline: i32) -> i64 {
        if underline < 0 { return packed }
        n := self.decorations.len
        if n == 0 || self.decorations[n - 2] != packed || self.decorations[n - 1] != i64(underline) {
            self.decorations.push(packed)
            self.decorations.push(i64(underline))
        }
        i64(1) - i64(self.decorations.len)
    }

    fn decoration(&self, key: i64) -> paint.Decoration {
        if key >= 0 { return paint.Decoration { packed: key, underline: -1 } }
        i := i32(i64(-1) - key)
        paint.Decoration { packed: self.decorations[i], underline: i32(self.decorations[i + 1]) }
    }

    fn same_style(&self, previous: &Frame, i: i32) -> bool {
        key := self.styles[i]
        other := previous.styles[i]
        if key >= 0 || other >= 0 { return key == other }
        self.decoration(key) == previous.decoration(other)
    }

    fn resolved(&self, key: i64) -> Style {
        decoration := self.decoration(key)
        brush := paint.Brush::unpack(decoration.packed)
        Style {
            fg: brush.fg, bg: brush.bg,
            underline: decoration.underline, added: brush.modifiers, removed: 0
        }
    }

    pub fn style_at(&self, x: i32, y: i32) -> Option<Style> {
        if x < 0 || y < 0 || x >= self.bounds.w || y >= self.bounds.h { return .None }
        .Some(self.resolved(self.styles[y * self.bounds.w + x]))
    }

    pub fn apply_style(&mut self, area: Rect, overlay: Style) {
        if area.w <= 0 || area.h <= 0 || overlay.empty() { return }
        left := clamp(area.x, self.bounds.w)
        top := clamp(area.y, self.bounds.h)
        right := i32(cmp.min<i64>(i64(area.x) + i64(area.w), i64(self.bounds.w)))
        bottom := i32(cmp.min<i64>(i64(area.y) + i64(area.h), i64(self.bounds.h)))
        if left >= right || top >= bottom { return }
        mut last: i64 = 0
        mut result := self.composite(last, &overlay)
        for y in top..bottom {
            mut x := left
            while x < right {
                i := y * self.bounds.w + x
                start := self.head(i)
                old := self.styles[start]
                if old != last { last = old; result = self.composite(old, &overlay) }
                self.styles[start] = result
                span := self.advance(start)
                for j in 1..span { self.styles[start + j] = result }
                x = start - y * self.bounds.w + span
            }
        }
    }

    fn head(&self, i: i32) -> i32 {
        code := self.glyphs[i]
        if code < 0 { i - (-code).bit_and(OFFSET_MASK) } else { i }
    }

    fn advance(&self, i: i32) -> i32 {
        if self.glyphs[i] >= WIDE { (-self.glyphs[i + 1]).shr(12) } else { 1 }
    }

    fn erase_span(&mut self, i: i32) {
        if self.glyphs[i] >= 0 && self.glyphs[i] < WIDE { return }
        first := self.head(i)
        end := first + self.advance(first)
        for j in first..end {
            if j != i { self.glyphs[j] = 0; self.styles[j] = 0 }
        }
    }

    fn put(&mut self, x: i32, y: i32, symbol: i32, span: i32, style: i64) {
        if x < 0 || y < 0 || y >= self.bounds.h || x > self.bounds.w - span { return }
        i := y * self.bounds.w + x
        self.erase_span(i)
        for j in 1..span { self.erase_span(i + j) }
        self.glyphs[i] = symbol - 32
        if span > 1 {
            self.glyphs[i] = self.glyphs[i].bit_or(WIDE)
            for j in 1..span {
                self.glyphs[i + j] = -(span.shl(12).bit_or(j))
                self.styles[i + j] = style
            }
        }
        self.styles[i] = style
    }

    fn composite(&mut self, old: i64, overlay: &Style) -> i64 {
        decoration := self.decoration(old)
        mut brush := paint.Brush::unpack(decoration.packed)
        if overlay.fg != INHERIT { brush.fg = overlay.fg }
        if overlay.bg != INHERIT { brush.bg = overlay.bg }
        brush.modifiers = brush.modifiers.bit_and(overlay.removed.bit_not()).bit_or(overlay.added).bit_and(511)
        underline := if overlay.underline == INHERIT { decoration.underline } else { overlay.underline }
        packed := brush.packed()
        if packed == decoration.packed && underline == decoration.underline { return old }
        self.style_key(packed, underline)
    }

    fn ascii_line(&mut self, area: Rect, value: string, brush: i64, overlay: &Style) -> bool {
        for j in 0..value.len { if value[j] < 32 || value[j] >= 127 { return false } }
        self.ascii_slice(area, value, 0, value.len, brush, &overlay)
        true
    }

    fn ascii_slice(&mut self, area: Rect, value: string, offset: i32, finish: i32, brush: i64, overlay: &Style) {
        if area.y < 0 || area.y >= self.bounds.h { return }
        start := if area.x < 0 { -i64(area.x) } else { i64(0) }
        fit := i64(self.bounds.w) - i64(area.x)
        end := i64(clamp(finish - offset, area.w))
        limit := if fit < end { fit } else { end }
        if start >= limit { return }
        i := area.y * self.bounds.w + i32(i64(area.x) + start)
        mut at := i
        if overlay.empty() {
            for j in i32(start)..i32(limit) {
                if self.glyphs[at] < 0 || self.glyphs[at] >= WIDE { self.erase_span(at) }
                self.glyphs[at] = i32(value[offset + j]) - 32
                at += 1
            }
            return
        }
        mut last: i64 = 0
        mut combined := brush
        for j in i32(start)..i32(limit) {
            old := self.styles[at]
            if old != last {
                last = old
                combined = if old == 0 || old == brush { brush } else { self.composite(old, &overlay) }
            }
            if self.glyphs[at] < 0 || self.glyphs[at] >= WIDE { self.erase_span(at) }
            self.glyphs[at] = i32(value[offset + j]) - 32
            self.styles[at] = combined
            at += 1
        }
    }

    pub fn text(&mut self, area: Rect, value: string, style: Style) {
        brush := self.encode(style)
        self.write_text(area, value, brush, &style)
    }

    fn write_text(&mut self, area: Rect, value: string, brush: i64, overlay: &Style) {
        mut x := 0
        mut y := 0
        if area.h <= 0 || area.w <= 0 { return }
        if self.ascii_line(area, value, brush, &overlay) { return }
        chars := value.runes()
        mut at := 0
        mut offset := 0
        while at < chars.len && y < area.h {
            cp := i32(chars[at])
            glyph := width.glyph(&chars, at)
            start := offset
            single := glyph.end == at + 1
            at = glyph.end
            offset += glyph.bytes
            if cp == 10 || (cp == 13 && !single) { x = 0; y += 1; continue }
            if glyph.span < 1 || x >= area.w { continue }
            if glyph.span > area.w - x { x = area.w; continue }
            px := i64(area.x) + i64(x)
            py := i64(area.y) + i64(y)
            if px >= 0 && px <= i64(self.bounds.w - glyph.span) && py >= 0 && py < i64(self.bounds.h) {
                cell := i32(py) * self.bounds.w + i32(px)
                old := self.styles[cell]
                combined := if old == 0 || old == brush { brush } else { self.composite(old, &overlay) }
                if single { self.put(i32(px), i32(py), cp, glyph.span, combined) }
                else {
                    self.put_cluster(i32(px), i32(py), value[start..offset], glyph.span, combined)
                }
            }
            x += glyph.span
        }
    }

    fn put_cluster(&mut self, x: i32, y: i32, move value: string, cells: i32, brush: i64) {
        if self.clusters.len == 0 {
            self.clusters.reserve(self.glyphs.len)
            for _ in 0..self.glyphs.len { self.clusters.push("") }
        }
        self.put(x, y, if cells == 0 { ZERO_CLUSTER } else { CLUSTER }, cmp.max<i32>(1, cells), brush)
        i := y * self.bounds.w + x
        if self.clusters[i] == "" { self.cluster_cells.push(i) }
        self.clusters[i] = move value
    }

    pub fn set_cell(&mut self, x: i32, y: i32, value: string, style: Style) -> bool {
        if x < 0 || y < 0 || y >= self.bounds.h || x >= self.bounds.w || value.len == 0 { return false }
        chars := value.runes()
        mut at := 0
        mut cells := 0
        while at < chars.len {
            g := width.glyph(&chars, at)
            if g.span < 0 || (cells > 0 && g.span > 0) { return false }
            cells += g.span
            at = g.end
        }
        if cells > self.bounds.w - x { return false }
        brush := self.composite(self.styles[y * self.bounds.w + x], &style)
        if chars.len == 1 && width.columns(i32(chars[0])) > 0 { self.put(x, y, i32(chars[0]), cells, brush) }
        else { self.put_cluster(x, y, value.clone(), cells, brush) }
        true
    }

    pub fn label(&mut self, area: Rect, value: string) { self.write_text(area, value, 0, &plain()) }

    pub fn panel(&mut self, area: Rect, title: string, style: Style) -> Rect {
        if area.w < 2 || area.h < 2 { return area.inset(1) }
        brush := self.encode(style)
        right := area.x + area.w - 1
        bottom := area.y + area.h - 1
        for x in (area.x + 1)..right {
            self.put(x, area.y, 0x2500, 1, brush)
            self.put(x, bottom, 0x2500, 1, brush)
        }
        for y in (area.y + 1)..bottom {
            self.put(area.x, y, 0x2502, 1, brush)
            self.put(right, y, 0x2502, 1, brush)
        }
        self.put(area.x, area.y, 0x250c, 1, brush)
        self.put(right, area.y, 0x2510, 1, brush)
        self.put(area.x, bottom, 0x2514, 1, brush)
        self.put(right, bottom, 0x2518, 1, brush)
        self.text(Rect { x: area.x + 1, y: area.y, w: area.w - 2, h: 1 }, title, style)
        area.inset(1)
    }

    pub fn list(&mut self, area: Rect, items: &[]string, selected: i32, highlight: Style) {
        if area.h <= 0 { return }
        first := clamp(clamp(selected, items.len - 1) - area.h + 1, items.len)
        count := clamp(items.len - first, area.h)
        for row in 0..count {
            item := first + row
            style := if item == selected { highlight } else { plain() }
            self.text(Rect { x: area.x, y: area.y + row, w: area.w, h: 1 }, items[item], style)
        }
    }

    pub fn half_block(&mut self, x: i32, y: i32, upper: u32, lower: u32) {
        brush := paint.Brush { fg: packed_rgb(upper), bg: packed_rgb(lower), modifiers: 0 }
        self.put(x, y, 0x2580, 1, brush.packed())
    }

    fn append_cell(&self, out: &mut []u8, i: i32, terminal_output: bool) {
        if self.glyphs[i] < 0 { return }
        cp := self.glyphs[i].bit_and(WIDE - 1) + 32
        if cp == CLUSTER || cp == ZERO_CLUSTER {
            if terminal_output && cp == ZERO_CLUSTER { out.push(b' ') }
            bytes.append_utf8(&mut out, self.clusters[i])
        }
        else if cp == 0 { return }
        else if cp < 128 { out.push(u8(cp)) }
        else if cp < 2048 {
            out.push(u8(192 + cp.shr(6)))
            out.push(u8(128 + cp.bit_and(63)))
        } else {
            if cp < 65536 { out.push(u8(224 + cp.shr(12))) }
            else {
                out.push(u8(240 + cp.shr(18)))
                out.push(u8(128 + cp.shr(12).bit_and(63)))
            }
            out.push(u8(128 + cp.shr(6).bit_and(63)))
            out.push(u8(128 + cp.bit_and(63)))
        }
    }

    pub fn symbol_at(&self, x: i32, y: i32) -> Option<string> {
        if x < 0 || y < 0 || x >= self.bounds.w || y >= self.bounds.h { return .None }
        mut out: []u8 = []
        self.append_cell(&mut out, y * self.bounds.w + x, false)
        .Some(bytes.decode(&out).unwrap())
    }

    pub fn line(&self, y: i32) -> string {
        if y < 0 || y >= self.bounds.h { return "" }
        mut out: []u8 = []
        start := y * self.bounds.w
        for i in start..(start + self.bounds.w) { self.append_cell(&mut out, i, false) }
        bytes.decode(&out).unwrap()
    }

    pub fn clear(&mut self) {
        self.decorations.clear()
        for i in &self.cluster_cells { self.clusters[i] = "" }
        self.cluster_cells.clear()
        if self.glyphs.len > 0 {
            unsafe {
                bytes.zero_memory(addr(&mut self.glyphs[0]), usize(self.glyphs.len) * size_of(i32))
                bytes.zero_memory(addr(&mut self.styles[0]), usize(self.styles.len) * size_of(i64))
            }
        }
    }

    fn changed(&self, previous: &Frame, i: i32) -> bool {
        self.glyphs[i] != previous.glyphs[i] || !self.same_style(&previous, i) ||
        (self.glyphs[i].bit_and(WIDE - 1) >= CLUSTER - 32 && self.clusters[i] != previous.clusters[i])
    }

    fn shared_style_floor(&self, previous: &Frame) -> i64 {
        count := cmp.min<i32>(self.decorations.len, previous.decorations.len)
        mut offset := 0
        while offset < count {
            if self.decorations[offset] != previous.decorations[offset] || self.decorations[offset + 1] != previous.decorations[offset + 1] { return -i64(offset) }
            offset += 2
        }
        if self.decorations.len != previous.decorations.len { return -i64(count) }
        -9223372036854775808
    }

    fn same_row(&self, previous: &Frame, row: i32, shared_floor: i64) -> bool {
        if self.bounds.w == 0 { return false }
        unsafe {
            if !bytes.equal_memory(addr(&self.glyphs[row]), addr(&previous.glyphs[row]), usize(self.bounds.w) * size_of(i32)) ||
            !bytes.equal_memory(addr(&self.styles[row]), addr(&previous.styles[row]), usize(self.bounds.w) * size_of(i64)) { return false }
        }
        if self.cluster_cells.len > 0 {
            for i in row..(row + self.bounds.w) {
                if self.glyphs[i] >= 0 && self.glyphs[i].bit_and(WIDE - 1) >= CLUSTER - 32 && self.clusters[i] != previous.clusters[i] { return false }
            }
        }
        if shared_floor != -9223372036854775808 {
            for i in row..(row + self.bounds.w) { if self.styles[i] < shared_floor { return false } }
        }
        true
    }

    fn run_start(&self, previous: &Frame, i: i32, end: i32, full: bool) -> i32 {
        mut start := i
        while start < end {
            if self.glyphs[start] >= 0 && (full || self.changed(&previous, start)) { break }
            start += 1
        }
        start
    }

    fn run_end(&self, previous: &Frame, start: i32, end: i32, full: bool) -> i32 {
        mut finish := start
        while finish < end && (full || self.changed(&previous, finish)) {
            finish += self.advance(finish)
        }
        finish
    }

    pub fn ansi_diff(&self, previous: &Frame, out: &mut []u8) {
        full := self.bounds.w != previous.bounds.w || self.bounds.h != previous.bounds.h
        shared_floor := if full { i64(0) } else { self.shared_style_floor(&previous) }
        mut current: i64 = 0
        for y in 0..self.bounds.h {
            row := y * self.bounds.w
            if !full && self.same_row(&previous, row, shared_floor) { continue }
            end := row + self.bounds.w
            mut at := row
            while at < end {
                start := self.run_start(&previous, at, end, full)
                if start == end { break }
                finish := self.run_end(&previous, start, end, full)
                paint.cursor(&mut out, start - row, y)
                mut i := start
                while i < finish {
                    style := self.styles[i]
                    if current != style {
                        paint.transition(&mut out, self.decoration(current), self.decoration(style))
                        current = style
                    }
                    self.append_cell(&mut out, i, true)
                    i += self.advance(i)
                }
                at = finish
            }
        }
        if current != 0 { bytes.append_utf8(&mut out, "\x1b[0m") }
    }

    fn paint_windows(&self, previous: &Frame, term: &terminal.Session) -> bool {
        full := self.bounds.w != previous.bounds.w || self.bounds.h != previous.bounds.h
        shared_floor := if full { i64(0) } else { self.shared_style_floor(&previous) }
        mut run: []u8 = []
        for y in 0..self.bounds.h {
            row := y * self.bounds.w
            if !full && self.same_row(&previous, row, shared_floor) { continue }
            end := row + self.bounds.w
            mut at := row
            while at < end {
                start := self.run_start(&previous, at, end, full)
                if start == end { break }
                finish := self.run_end(&previous, start, end, full)
                mut i := start
                while i < finish {
                    style := self.styles[i]
                    x := i - row
                    run.clear()
                    while i < finish && self.styles[i] == style {
                        self.append_cell(&mut run, i, true)
                        i += self.advance(i)
                    }
                    if !windows.paint(&term.win, x, y, bytes.decode(&run).unwrap(), paint.Brush::unpack(self.decoration(style).packed)) { return false }
                }
                at = finish
            }
        }
        true
    }

    fn present(&self, term: &terminal.Session, previous: &Frame, output: &mut []u8) -> bool {
        if target_is("windows") {
            if !term.win.vt { return self.paint_windows(&previous, &term) }
        }
        output.clear()
        self.ansi_diff(&previous, &mut output)
        if output.len == 0 { return true }
        if target_is("windows") { return windows.write(&term.win, &output) }
        else { return posix.write_bytes(&output) }
    }
}

pub opaque struct GlyphRun { source: string, ascii: bool, zero_width: bool, tokens: []i32, clusters: []string, columns: i32 }

impl GlyphRun {
    pub fn new(move value: string) -> Self {
        mut ascii := true
        for i in 0..value.len { if value[i] < 32 || value[i] > 126 { ascii = false; break } }
        mut tokens: []i32 = []
        mut clusters: []string = []
        mut columns := value.len
        mut zero_width := false
        if !ascii {
            columns = 0
            chars := value.runes()
            mut at := 0
            mut offset := 0
            while at < chars.len {
                group := width.glyph(&chars, at)
                if group.span >= 0 {
                    cp := i32(chars[at])
                    symbol := if group.end == at + 1 { cp } else {
                        clusters.push(value[offset..(offset + group.bytes)])
                        -clusters.len
                    }
                    tokens.push(symbol)
                    tokens.push(group.span)
                    columns += group.span
                    if group.span == 0 { zero_width = true }
                }
                offset += group.bytes
                at = group.end
            }
        }
        Self { source: move value, ascii: ascii, zero_width: zero_width, tokens: move tokens, clusters: move clusters, columns: columns }
    }

    pub fn has_zero_width(&self) -> bool { self.zero_width }
    pub fn count(&self) -> i32 { if self.ascii { self.source.len } else { self.tokens.len / 2 } }
    pub fn width(&self) -> i32 { self.columns }
    pub fn width_at(&self, index: i32) -> i32 { if self.ascii { 1 } else { self.tokens[index * 2 + 1] } }
    pub fn space_at(&self, index: i32) -> bool {
        if self.ascii { return self.source[index] == 32 }
        cp := self.tokens[index * 2]
        cp == 32 || cp == 0x1680 || (cp >= 0x2000 && cp <= 0x200b) ||
        cp == 0x2028 || cp == 0x2029 || cp == 0x202f || cp == 0x205f || cp == 0x3000
    }

    pub fn symbol_at(&self, index: i32) -> string {
        if self.ascii { return self.source[index..(index + 1)] }
        cp := self.tokens[index * 2]
        if cp >= 0 { rune(cp).str() } else { self.clusters[-1 - cp].clone() }
    }

    pub fn render(&self, frame: &mut Frame, bounds: Rect, first: i32, end: i32, style: Style) {
        if bounds.w <= 0 || bounds.h <= 0 || bounds.y < 0 || bounds.y >= frame.bounds.h { return }
        start := clamp(first, self.count())
        finish := clamp(end, self.count())
        if start >= finish { return }
        brush := frame.encode(style)
        if self.ascii { frame.ascii_slice(bounds, self.source, start, finish, brush, &style); return }
        mut x := i64(bounds.x)
        right := cmp.min<i64>(i64(frame.bounds.w), x + i64(bounds.w))
        mut last: i64 = 0
        mut combined := brush
        for i in start..finish {
            cp := self.tokens[i * 2]
            cells := self.tokens[i * 2 + 1]
            if cells == 0 { continue }
            if x + i64(cells) > right { break }
            if x >= 0 {
                index := bounds.y * frame.bounds.w + i32(x)
                old := frame.styles[index]
                if old != last {
                    last = old
                    combined = if old == 0 || old == brush { brush } else { frame.composite(old, &style) }
                }
                if cp >= 0 { frame.put(i32(x), bounds.y, cp, cells, combined) }
                else { frame.put_cluster(i32(x), bounds.y, self.clusters[-1 - cp].clone(), cells, combined) }
            }
            x += i64(cells)
        }
    }
}

pub enum Key { Char(rune), Up, Down, Left, Right, Home, End, Delete, Backspace, Tab, Enter, Escape }

enum Renderer<S> { Draw(fn(&mut Frame, &S)), Stateful(fn(&mut Frame, &mut S)) }

pub fn run<S>(state: &mut S, draw: fn(&mut Frame, &S), update: fn(&mut S, Key) -> bool) -> Result<(), string> {
    drive<S>(&mut state, Renderer<S>.Draw(draw), update, 0, fn(_state: &mut S, _elapsed: i64) -> bool { false })
}

pub fn run_stateful<S>(state: &mut S, draw: fn(&mut Frame, &mut S), update: fn(&mut S, Key) -> bool) -> Result<(), string> {
    drive<S>(&mut state, Renderer<S>.Stateful(draw), update, 0, fn(_state: &mut S, _elapsed: i64) -> bool { false })
}

pub fn animate<S>(state: &mut S, fps: i32, draw: fn(&mut Frame, &S), update: fn(&mut S, Key) -> bool, tick: fn(&mut S, i64) -> bool) -> Result<(), string> {
    if fps < 1 || fps > 1000 { return .Err("Frame rate must be between 1 and 1000.") }
    drive<S>(&mut state, Renderer<S>.Draw(draw), update, fps, tick)
}

fn drive<S>(state: &mut S, renderer: Renderer<S>, update: fn(&mut S, Key) -> bool, fps: i32, tick: fn(&mut S, i64) -> bool) -> Result<(), string> {
    mut term := terminal.session()
    (cols, rows) := term.size()
    if cols <= 0 || rows <= 0 || !term.open() { return .Err("An interactive terminal is required on stdin and stdout.") }
    defer { term.close() }
    if !term.enter() { return .Err("Could not enter the alternate screen.") }
    mut previous := Frame::new(0, 0)
    mut frame := Frame::new(0, 0)
    mut output: []u8 = []
    start := if fps > 0 { clock.monotonic_ns() } else { i64(0) }
    if start < 0 { return .Err("Could not read the animation clock.") }
    interval := if fps == 0 { i64(0) } else { i64(1000000000) / i64(fps) }
    mut next_tick := start + interval
    mut dirty := true
    while true {
        (next_w, next_h) := term.size()
        if next_w <= 0 || next_h <= 0 { return .Err("Could not read the terminal size.") }
        if next_w > 4096 || next_h > 4096 || i64(next_w) * i64(next_h) > 1048576 { return .Err("Terminal viewport is too large.") }
        if interval > 0 {
            now := clock.monotonic_ns()
            if now < 0 { return .Err("Could not read the animation clock.") }
            if now >= next_tick {
                dirty = tick(&mut state, (now - start) / 1000000) || dirty
                next_tick += ((now - next_tick) / interval + 1) * interval
            }
        }
        if dirty || next_w != previous.bounds.w || next_h != previous.bounds.h {
            if frame.bounds.w != next_w || frame.bounds.h != next_h { frame = Frame::new(next_w, next_h) }
            else { frame.clear() }
            match &renderer {
                .Draw(draw) => { draw(&mut frame, &state) },
                .Stateful(draw) => { draw(&mut frame, &mut state) },
            }
            if !frame.present(&term, &previous, &mut output) { return .Err("Could not write the frame.") }
            frame = replace(&mut previous, move frame)
            dirty = false
        }
        mut wait_ms := 125
        if interval > 0 {
            now := clock.monotonic_ns()
            if now < 0 { return .Err("Could not read the animation clock.") }
            left := next_tick - now
            wait_ms = if left <= 0 { 0 } else { clamp(i32((left + 999999) / 1000000), 125) }
        }
        match term.next(wait_ms) {
            .Idle => {},
            .Error => { return .Err("Could not read terminal input.") },
            .Quit => { return .Ok },
            .Press(key) => {
                if !update(&mut state, key) { return .Ok }
                dirty = true
            },
        }
    }
    .Ok
}
