import .tui
import .json_format
import std.json

pub enum Family {
    Slate, Gray, Zinc, Neutral, Stone, Red, Orange,
    Amber, Yellow, Lime, Green, Emerald, Teal, Cyan,
    Sky, Blue, Indigo, Violet, Purple, Fuchsia, Pink,
    Rose,
}

pub enum Shade {
    C50, C100, C200, C300, C400, C500, C600,
    C700, C800, C900, C950,
}

fn row(value: Family) -> i32 {
    match value {
        .Slate => 0, .Gray => 1, .Zinc => 2, .Neutral => 3,
        .Stone => 4, .Red => 5, .Orange => 6, .Amber => 7,
        .Yellow => 8, .Lime => 9, .Green => 10, .Emerald => 11,
        .Teal => 12, .Cyan => 13, .Sky => 14, .Blue => 15,
        .Indigo => 16, .Violet => 17, .Purple => 18, .Fuchsia => 19,
        .Pink => 20, .Rose => 21,
    }
}

fn column(value: Shade) -> i32 {
    match value {
        .C50 => 0, .C100 => 1, .C200 => 2, .C300 => 3,
        .C400 => 4, .C500 => 5, .C600 => 6, .C700 => 7,
        .C800 => 8, .C900 => 9, .C950 => 10,
    }
}

