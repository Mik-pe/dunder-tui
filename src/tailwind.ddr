pub fn rgb(family: Family, shade: Shade) -> u32 {
    SHADES[row(family) * 11 + column(shade)]
}

pub fn color(family: Family, shade: Shade) -> tui.Color {
    tui.rgb(rgb(family, shade))
}

pub fn black() -> tui.Color { tui.rgb(0x000000) }
pub fn white() -> tui.Color { tui.rgb(0xffffff) }

@derive(Encode, Eq, Hash)
pub struct Palette {
    c50: tui.Color, c100: tui.Color, c200: tui.Color, c300: tui.Color,
    c400: tui.Color, c500: tui.Color, c600: tui.Color, c700: tui.Color,
    c800: tui.Color, c900: tui.Color, c950: tui.Color,
}

impl Palette {
    pub fn from_family(family: Family) -> Self {
        Self {
            c50:color(family,.C50), c100:color(family,.C100), c200:color(family,.C200),
            c300:color(family,.C300), c400:color(family,.C400), c500:color(family,.C500),
            c600:color(family,.C600), c700:color(family,.C700), c800:color(family,.C800),
            c900:color(family,.C900), c950:color(family,.C950),
        }
    }

    pub fn get(&self, shade: Shade) -> tui.Color {
        match shade {
            .C50 => self.c50, .C100 => self.c100, .C200 => self.c200,
            .C300 => self.c300, .C400 => self.c400, .C500 => self.c500,
            .C600 => self.c600, .C700 => self.c700, .C800 => self.c800,
            .C900 => self.c900, .C950 => self.c950,
        }
    }
}

impl json.Decode for Palette {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        f := json_format.fields(&doc,node,&["c50","c100","c200","c300","c400","c500","c600","c700","c800","c900","c950"],11,11)?
        .Ok(Self {
            c50:tui.Color::decode_json(&doc,f[0])?, c100:tui.Color::decode_json(&doc,f[1])?,
            c200:tui.Color::decode_json(&doc,f[2])?, c300:tui.Color::decode_json(&doc,f[3])?,
            c400:tui.Color::decode_json(&doc,f[4])?, c500:tui.Color::decode_json(&doc,f[5])?,
            c600:tui.Color::decode_json(&doc,f[6])?, c700:tui.Color::decode_json(&doc,f[7])?,
            c800:tui.Color::decode_json(&doc,f[8])?, c900:tui.Color::decode_json(&doc,f[9])?,
            c950:tui.Color::decode_json(&doc,f[10])?,
        })
    }
}
