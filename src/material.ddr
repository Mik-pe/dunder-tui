import .tui
import .json_format
import std.json

pub enum Family {
    Red, Pink, Purple, DeepPurple, Indigo, Blue, LightBlue,
    Cyan, Teal, Green, LightGreen, Lime, Yellow, Amber,
    Orange, DeepOrange, Brown, Gray, BlueGray,
}

pub enum Shade {
    C50, C100, C200, C300, C400, C500, C600,
    C700, C800, C900,
}

fn row(value: Family) -> i32 {
    match value {
        .Red => 0, .Pink => 1, .Purple => 2, .DeepPurple => 3,
        .Indigo => 4, .Blue => 5, .LightBlue => 6, .Cyan => 7,
        .Teal => 8, .Green => 9, .LightGreen => 10, .Lime => 11,
        .Yellow => 12, .Amber => 13, .Orange => 14, .DeepOrange => 15,
        .Brown => 16, .Gray => 17, .BlueGray => 18,
    }
}

fn column(value: Shade) -> i32 {
    match value {
        .C50 => 0, .C100 => 1, .C200 => 2, .C300 => 3,
        .C400 => 4, .C500 => 5, .C600 => 6, .C700 => 7,
        .C800 => 8, .C900 => 9,
    }
}

