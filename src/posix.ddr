capability unsafe, stdio

import sys
import std.bytes as bytes
import std.time as clock
import std.terminal as term
import .input

@extern("c", "tcgetattr")
unsafe fn get_attributes(fd: i32, buf: ptr) -> i32
@extern("c", "tcsetattr")
unsafe fn set_attributes(fd: i32, when: i32, buf: ptr) -> i32
@extern("c", "cfmakeraw")
unsafe fn make_raw(buf: ptr)
@c_variadic(2)
@extern("c", "open")
unsafe fn mac_open(path: ptr, flags: i32) -> i32

pub struct State { saved: [u64; 16], pending: []u8, head: i32 }

pub fn state() -> State { State { saved: [0; 16], pending: [], head: 0 } }

pub fn size() -> (i32, i32) {
    match term.window_size(1) { .Ok(s) => (s.columns,s.rows), .Err(_) => (0,0), }
}

fn query_window() -> Result<term.WindowSize,sys.IoError> {
    mut tty := -1
    unsafe {
        if target_is("linux") {
            tty = i32(sys.linux_syscall(56, -100, i64(usize(cstr("/dev/tty"))), 0x80000, 0, 0, 0))
        } else if target_is("macos") {
            tty = mac_open(cstr("/dev/tty"), 0x1000000)
        }
        if tty >= 0 {
            defer { _ := sys.fd_close(tty) }
            return term.window_size(i64(tty))
        }
    }
    term.window_size(1)
}

pub fn window_size(winsize: &mut [u16; 4]) -> bool {
    match query_window() {
        .Ok(s) => {
            winsize = [u16(s.rows),u16(s.columns),u16(s.pixel_width),u16(s.pixel_height)]
            true
        },
        .Err(_) => false,
    }
}

pub fn open(state: &mut State) -> bool {
    unsafe {
        if target_is("linux") {
            if sys.linux_syscall(29, 0, 0x5401, i64(usize(addr(&mut state.saved[0]))), 0, 0, 0) != 0 { return false }
            mut raw := state.saved.clone()
            p := addr(&mut raw[0])
            store_u32(p, load_u32(p).bit_and(u32(0x5eb).bit_not()))
            flags := ptr(usize(p) + 4)
            store_u32(flags, load_u32(flags).bit_and(u32(1).bit_not()))
            control := ptr(usize(p) + 8)
            store_u32(control, load_u32(control).bit_and(u32(0x130).bit_not()).bit_or(0x30))
            local := ptr(usize(p) + 12)
            store_u32(local, load_u32(local).bit_and(u32(0x804b).bit_not()))
            store_u8(ptr(usize(p) + 22), 0)
            store_u8(ptr(usize(p) + 23), 1)
            return sys.linux_syscall(29, 0, 0x5402, i64(usize(p)), 0, 0, 0) == 0
        } else if target_is("macos") {
            if get_attributes(0, addr(&mut state.saved[0])) != 0 { return false }
            mut raw := state.saved.clone()
            make_raw(addr(&mut raw[0]))
            return set_attributes(0, 0, addr(&raw[0])) == 0
        }
    }
    false
}

pub fn restore(state: &mut State) {
    unsafe {
        if target_is("macos") { _ := set_attributes(0, 0, addr(&state.saved[0])) }
        else if target_is("linux") { _ := sys.linux_syscall(29, 0, 0x5402, i64(usize(addr(&state.saved[0]))), 0, 0, 0) }
    }
}

pub fn write(value: string) -> bool {
    write_bytes(&value.as_bytes())
}

pub fn write_bytes(data: &[]u8) -> bool {
    mut sent: i64 = 0
    while sent < i64(data.len) {
        unsafe {
            n := sys.fd_write(1, &data, sent, i64(data.len) - sent)
            if n == -4 { continue }
            if n <= 0 { return false }
            sent += n
        }
    }
    true
}

fn compact(state: &mut State) {
    if state.head > 0 {
        bytes.consume_prefix(&mut state.pending,state.head)
        state.head = 0
    }
}

struct CursorReport {
    offset: i32, start: i32, phase: i32, row: i32, column: i32,
}

fn cursor_reply(pending: &mut []u8, report: &mut CursorReport) -> Option<(i32,i32)> {
    while report.offset < pending.len {
        b := pending[report.offset]
        report.offset += 1
        if b == 27 {
            report.start = report.offset-1
            report.phase = 1
            continue
        }
        phase := report.phase
        match phase {
            1 if b == b'[' => { report.row = 0; report.phase = 2 },
            2 if b >= b'0' && b <= b'9' => {
                report.row = report.row*10+i32(b)-48
                if report.row > 65536 { report.phase = 0 }
            },
            2 if b == b';' && report.row > 0 => { report.column = 0; report.phase = 3 },
            3 if b >= b'0' && b <= b'9' => {
                report.column = report.column*10+i32(b)-48
                if report.column > 65536 { report.phase = 0 }
            },
            3 if b == b'R' && report.column > 0 => {
                removed := report.offset-report.start
                for i in report.offset..pending.len { pending[i-removed] = pending[i] }
                pending.truncate(pending.len-removed)
                return .Some((report.column-1,report.row-1))
            },
            _ => { report.phase = 0 },
        }
    }
    .None
}

pub fn read_cursor(state: &mut State) -> Result<(i32,i32),string> {
    if !write("\x1b[6n") { return .Err("Could not request cursor position.") }
    compact(&mut state)
    deadline := clock.monotonic_ns()+1000000000
    mut fd: []u8 = [0,0,0,0,1,0,0,0]
    mut report := CursorReport { offset:0, start:0, phase:0, row:0, column:0 }
    while true {
        match cursor_reply(&mut state.pending,&mut report) { .Some(pos) => { return .Ok(pos) }, .None => {}, }
        left := deadline-clock.monotonic_ns()
        space := 65536-state.pending.len
        if left <= 0 || space <= 0 { break }
        count := if space < 128 { space } else { 128 }
        unsafe {
            ready := sys.fd_poll(&mut fd,1,(left+999999)/1000000)
            if ready == -4 { continue }
            if ready <= 0 { break }
            state.pending.reserve(state.pending.len+count)
            n := sys.fd_read(0,&mut state.pending,i64(count))
            if n == -4 { continue }
            if n <= 0 { break }
        }
    }
    .Err("The terminal did not report its cursor position.")
}

pub fn next(state: &mut State, wait_ms: i32) -> input.Event {
    mut expired := false
    while true {
        decoded := input.decode(&state.pending[state.head..state.pending.len], expired)
        if decoded.consumed > 0 {
            state.head += decoded.consumed
            if state.head == state.pending.len { state.pending.clear(); state.head = 0 }
            return decoded.event
        }
        compact(&mut state)
        timeout := if state.pending.len == 0 { wait_ms } else if state.pending[0] == 27 { 40 } else { 500 }
        mut pollfd: []u8 = [0, 0, 0, 0, 1, 0, 0, 0]
        unsafe {
            ready := sys.fd_poll(&mut pollfd, 1, i64(timeout))
            if ready == -4 { return .Idle }
            if ready < 0 { return .Error }
            if ready == 0 {
                if state.pending.len == 0 { return .Idle }
                expired = true
                continue
            }
            state.pending.reserve(state.pending.len + 128)
            n := sys.fd_read(0, &mut state.pending, 128)
            if n == -4 { continue }
            if n < 0 { return .Error }
            if n == 0 { return .Quit }
        }
    }
    .Error
}
