capability unsafe, stdio

import sys
import std.bytes as bytes
import .input

@extern("c", "tcgetattr")
unsafe fn get_attributes(fd: i32, buf: ptr) -> i32
@extern("c", "tcsetattr")
unsafe fn set_attributes(fd: i32, when: i32, buf: ptr) -> i32
@extern("c", "cfmakeraw")
unsafe fn make_raw(buf: ptr)
@c_variadic(2)
@extern("c", "ioctl")
unsafe fn mac_ioctl(fd: i32, request: usize, buf: ptr) -> i32

pub struct State { saved: [u64; 16], pending: []u8 }

pub fn state() -> State { State { saved: [0; 16], pending: [] } }

pub fn size() -> (i32, i32) {
    mut winsize: [u16; 4] = [0; 4]
    unsafe {
        if target_is("linux") {
            if sys.linux_syscall(29, 1, 0x5413, i64(usize(addr(&mut winsize[0]))), 0, 0, 0) != 0 { return (0, 0) }
        } else if target_is("macos") {
            if mac_ioctl(1, 0x40087468, addr(&mut winsize[0])) != 0 { return (0, 0) }
        }
    }
    (i32(winsize[1]), i32(winsize[0]))
}

pub fn open(state: &mut State) -> bool {
    unsafe {
        if target_is("linux") {
            if sys.linux_syscall(29, 0, 0x5401, i64(usize(addr(&mut state.saved[0]))), 0, 0, 0) != 0 { return false }
            mut raw := state.saved.clone()
            p := addr(&mut raw[0])
            store_u32(p, load_u32(p).bit_and(u32(0x5eb).bit_not()))
            flags := ptr(usize(p) + 4)
            store_u32(flags, load_u32(flags).bit_and(u32(1).bit_not()))
            control := ptr(usize(p) + 8)
            store_u32(control, load_u32(control).bit_and(u32(0x130).bit_not()).bit_or(0x30))
            local := ptr(usize(p) + 12)
            store_u32(local, load_u32(local).bit_and(u32(0x804b).bit_not()))
            store_u8(ptr(usize(p) + 22), 0)
            store_u8(ptr(usize(p) + 23), 1)
            return sys.linux_syscall(29, 0, 0x5402, i64(usize(p)), 0, 0, 0) == 0
        } else if target_is("macos") {
            if get_attributes(0, addr(&mut state.saved[0])) != 0 { return false }
            mut raw := state.saved.clone()
            make_raw(addr(&mut raw[0]))
            return set_attributes(0, 0, addr(&raw[0])) == 0
        }
    }
    false
}

pub fn restore(state: &mut State) {
    unsafe {
        if target_is("macos") { _ := set_attributes(0, 0, addr(&state.saved[0])) }
        else if target_is("linux") { _ := sys.linux_syscall(29, 0, 0x5402, i64(usize(addr(&state.saved[0]))), 0, 0, 0) }
    }
}

pub fn write(value: string) -> bool {
    data := value.bytes()
    mut sent: i64 = 0
    while sent < i64(data.len) {
        unsafe {
            n := sys.fd_write(1, &data, sent, i64(data.len) - sent)
            if n == -4 { continue }
            if n <= 0 { return false }
            sent += n
        }
    }
    true
}

pub fn next(state: &mut State) -> input.Event {
    mut expired := false
    while true {
        decoded := input.decode(&state.pending, expired)
        if decoded.consumed > 0 {
            bytes.consume_prefix(&mut state.pending, decoded.consumed)
            return decoded.event
        }
        timeout := if state.pending.len == 0 { 125 } else if state.pending[0] == 27 { 40 } else { 500 }
        mut pollfd: []u8 = [0, 0, 0, 0, 1, 0, 0, 0]
        unsafe {
            ready := sys.fd_poll(&mut pollfd, 1, i64(timeout))
            if ready == -4 { return .Idle }
            if ready < 0 { return .Error }
            if ready == 0 {
                if state.pending.len == 0 { return .Idle }
                expired = true
                continue
            }
            state.pending.reserve(state.pending.len + 128)
            n := sys.fd_read(0, &mut state.pending, 128)
            if n == -4 { continue }
            if n < 0 { return .Error }
            if n == 0 { return .Quit }
        }
    }
    .Error
}
