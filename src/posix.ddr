capability unsafe, stdio

import sys
import std.bytes as bytes
import std.time as clock
import .input

@extern("c", "tcgetattr")
unsafe fn get_attributes(fd: i32, buf: ptr) -> i32
@extern("c", "tcsetattr")
unsafe fn set_attributes(fd: i32, when: i32, buf: ptr) -> i32
@extern("c", "cfmakeraw")
unsafe fn make_raw(buf: ptr)
@c_variadic(2)
@extern("c", "ioctl")
unsafe fn mac_ioctl(fd: i32, request: usize, buf: ptr) -> i32
@c_variadic(2)
@extern("c", "open")
unsafe fn mac_open(path: ptr, flags: i32) -> i32

pub struct State { saved: [u64; 16], pending: []u8 }

pub fn state() -> State { State { saved: [0; 16], pending: [] } }

fn read_size(fd: i32, winsize: &mut [u16; 4]) -> bool {
    unsafe {
        if target_is("linux") {
            return sys.linux_syscall(29, i64(fd), 0x5413, i64(usize(addr(&mut winsize[0]))), 0, 0, 0) == 0
        } else if target_is("macos") {
            return mac_ioctl(fd, 0x40087468, addr(&mut winsize[0])) == 0
        }
    }
    false
}

pub fn size() -> (i32, i32) {
    mut winsize: [u16; 4] = [0; 4]
    if !read_size(1, &mut winsize) { return (0, 0) }
    (i32(winsize[1]), i32(winsize[0]))
}

pub fn window_size(winsize: &mut [u16; 4]) -> bool {
    mut tty := -1
    unsafe {
        if target_is("linux") {
            tty = i32(sys.linux_syscall(56, -100, i64(usize(cstr("/dev/tty"))), 0x80000, 0, 0, 0))
        } else if target_is("macos") {
            tty = mac_open(cstr("/dev/tty"), 0x1000000)
        }
        if tty >= 0 {
            defer { _ := sys.fd_close(tty) }
            return read_size(tty, &mut winsize)
        }
    }
    read_size(1, &mut winsize)
}

pub fn open(state: &mut State) -> bool {
    unsafe {
        if target_is("linux") {
            if sys.linux_syscall(29, 0, 0x5401, i64(usize(addr(&mut state.saved[0]))), 0, 0, 0) != 0 { return false }
            mut raw := state.saved.clone()
            p := addr(&mut raw[0])
            store_u32(p, load_u32(p).bit_and(u32(0x5eb).bit_not()))
            flags := ptr(usize(p) + 4)
            store_u32(flags, load_u32(flags).bit_and(u32(1).bit_not()))
            control := ptr(usize(p) + 8)
            store_u32(control, load_u32(control).bit_and(u32(0x130).bit_not()).bit_or(0x30))
            local := ptr(usize(p) + 12)
            store_u32(local, load_u32(local).bit_and(u32(0x804b).bit_not()))
            store_u8(ptr(usize(p) + 22), 0)
            store_u8(ptr(usize(p) + 23), 1)
            return sys.linux_syscall(29, 0, 0x5402, i64(usize(p)), 0, 0, 0) == 0
        } else if target_is("macos") {
            if get_attributes(0, addr(&mut state.saved[0])) != 0 { return false }
            mut raw := state.saved.clone()
            make_raw(addr(&mut raw[0]))
            return set_attributes(0, 0, addr(&raw[0])) == 0
        }
    }
    false
}

pub fn restore(state: &mut State) {
    unsafe {
        if target_is("macos") { _ := set_attributes(0, 0, addr(&state.saved[0])) }
        else if target_is("linux") { _ := sys.linux_syscall(29, 0, 0x5402, i64(usize(addr(&state.saved[0]))), 0, 0, 0) }
    }
}

pub fn write(value: string) -> bool {
    write_bytes(&value.as_bytes())
}

pub fn write_bytes(data: &[]u8) -> bool {
    mut sent: i64 = 0
    while sent < i64(data.len) {
        unsafe {
            n := sys.fd_write(1, &data, sent, i64(data.len) - sent)
            if n == -4 { continue }
            if n <= 0 { return false }
            sent += n
        }
    }
    true
}

fn cursor_reply(pending: &mut []u8) -> Option<(i32,i32)> {
    for start in 0..pending.len {
        if pending[start] != 27 || start+2 >= pending.len || pending[start+1] != b'[' { continue }
        mut i := start+2
        mut row := 0
        while i < pending.len && pending[i] >= 48 && pending[i] <= 57 && row <= 65535 {
            row = row*10+i32(pending[i])-48
            i += 1
        }
        if row < 1 || row > 65536 || i >= pending.len || pending[i] != b';' { continue }
        i += 1
        mut col := 0
        while i < pending.len && pending[i] >= 48 && pending[i] <= 57 && col <= 65535 {
            col = col*10+i32(pending[i])-48
            i += 1
        }
        if col < 1 || col > 65536 || i >= pending.len || pending[i] != b'R' { continue }
        removed := i+1-start
        for j in (i+1)..pending.len { pending[j-removed] = pending[j] }
        pending.truncate(pending.len-removed)
        return .Some((col-1,row-1))
    }
    .None
}

pub fn read_cursor(state: &mut State) -> Result<(i32,i32),string> {
    if !write("\x1b[6n") { return .Err("Could not request cursor position.") }
    deadline := clock.monotonic_ns()+1000000000
    mut fd: []u8 = [0,0,0,0,1,0,0,0]
    while state.pending.len < 65536 {
        match cursor_reply(&mut state.pending) { .Some(pos) => { return .Ok(pos) }, .None => {}, }
        left := deadline-clock.monotonic_ns()
        if left <= 0 { break }
        unsafe {
            ready := sys.fd_poll(&mut fd,1,(left+999999)/1000000)
            if ready == -4 { continue }
            if ready <= 0 { break }
            state.pending.reserve(state.pending.len+128)
            n := sys.fd_read(0,&mut state.pending,128)
            if n == -4 { continue }
            if n <= 0 { break }
        }
    }
    .Err("The terminal did not report its cursor position.")
}

pub fn next(state: &mut State, wait_ms: i32) -> input.Event {
    mut expired := false
    while true {
        decoded := input.decode(&state.pending, expired)
        if decoded.consumed > 0 {
            bytes.consume_prefix(&mut state.pending, decoded.consumed)
            return decoded.event
        }
        timeout := if state.pending.len == 0 { wait_ms } else if state.pending[0] == 27 { 40 } else { 500 }
        mut pollfd: []u8 = [0, 0, 0, 0, 1, 0, 0, 0]
        unsafe {
            ready := sys.fd_poll(&mut pollfd, 1, i64(timeout))
            if ready == -4 { return .Idle }
            if ready < 0 { return .Error }
            if ready == 0 {
                if state.pending.len == 0 { return .Idle }
                expired = true
                continue
            }
            state.pending.reserve(state.pending.len + 128)
            n := sys.fd_read(0, &mut state.pending, 128)
            if n == -4 { continue }
            if n < 0 { return .Error }
            if n == 0 { return .Quit }
        }
    }
    .Error
}
