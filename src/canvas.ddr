import .tui
import std.math as math

pub struct Canvas { w: i32, h: i32, pixels: []u32 }

impl Canvas {
    pub fn new(w: i32, h: i32, background: u32) -> Self {
        assert(w >= 0 && h >= 0 && i64(w) * i64(h) <= 2097152)
        mut pixels: []u32 = []
        pixels.reserve(w * h)
        for _ in 0..(w * h) { pixels.push(background) }
        Self { w: w, h: h, pixels: pixels }
    }

    pub fn point(&mut self, x: i32, y: i32, rgb: u32) {
        if x >= 0 && x < self.w && y >= 0 && y < self.h { self.pixels[y * self.w + x] = rgb }
    }

    pub fn line(&mut self, x0: i32, y0: i32, x1: i32, y1: i32, rgb: u32) {
        if self.w == 0 || self.h == 0 { return }
        if x0 >= 0 && x0 < self.w && y0 >= 0 && y0 < self.h &&
        x1 >= 0 && x1 < self.w && y1 >= 0 && y1 < self.h {
            self.stroke(x0, y0, x1, y1, rgb)
            return
        }
        dx := f64(x1) - f64(x0)
        dy := f64(y1) - f64(y0)
        mut lo := 0.0
        mut hi := 1.0
        if !clip(-dx, f64(x0), &mut lo, &mut hi) || !clip(dx, f64(self.w - 1) - f64(x0), &mut lo, &mut hi) ||
        !clip(-dy, f64(y0), &mut lo, &mut hi) || !clip(dy, f64(self.h - 1) - f64(y0), &mut lo, &mut hi) { return }
        self.stroke(i32((f64(x0) + lo * dx).round()), i32((f64(y0) + lo * dy).round()),
            i32((f64(x0) + hi * dx).round()), i32((f64(y0) + hi * dy).round()), rgb)
    }

    fn stroke(&mut self, x0: i32, y0: i32, x1: i32, y1: i32, rgb: u32) {
        mut x := x0
        mut y := y0
        dx := (x1 - x0).abs()
        dy := -(y1 - y0).abs()
        sx := if x0 < x1 { 1 } else { -1 }
        sy := if y0 < y1 { 1 } else { -1 }
        mut error := dx + dy
        while true {
            self.point(x, y, rgb)
            if x == x1 && y == y1 { break }
            twice := error * 2
            if twice >= dy { error += dy; x += sx }
            if twice <= dx { error += dx; y += sy }
        }
    }

    pub fn render(&self, frame: &mut tui.Frame, area: tui.Rect) {
        if self.w == 0 || self.h == 0 || area.w <= 0 || area.h <= 0 { return }
        bounds := frame.area()
        for y in 0..area.h {
            if y >= (self.h + 1) / 2 { break }
            py := i64(area.y) + i64(y)
            if py >= i64(bounds.h) { break }
            if py < 0 { continue }
            src := y * 2
            for x in 0..area.w {
                if x >= self.w { break }
                px := i64(area.x) + i64(x)
                if px >= i64(bounds.w) { break }
                if px < 0 { continue }
                top := self.pixels[src * self.w + x]
                bottom := if src + 1 < self.h { self.pixels[(src + 1) * self.w + x] } else { top }
                frame.half_block(i32(px), i32(py), top, bottom)
            }
        }
    }
}

fn clip(direction: f64, distance: f64, lo: &mut f64, hi: &mut f64) -> bool {
    if direction == 0.0 { return distance >= 0.0 }
    edge := distance / direction
    if direction < 0.0 { lo = math.max(lo, edge) } else { hi = math.min(hi, edge) }
    lo <= hi
}

pub fn mix(a: u32, b: u32, amount: f64) -> u32 {
    if amount <= 0.0 { return a }
    if amount >= 1.0 { return b }
    alpha := u32(amount * 256.0)
    inv := u32(256) - alpha
    rb := ((a.bit_and(0xff00ff) * inv + b.bit_and(0xff00ff) * alpha).shr(8)).bit_and(0xff00ff)
    g := ((a.bit_and(0xff00) * inv + b.bit_and(0xff00) * alpha).shr(8)).bit_and(0xff00)
    rb.bit_or(g)
}
