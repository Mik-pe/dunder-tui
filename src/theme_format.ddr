import std.bytes
import std.json
import std.parse
import std.text
import .width

const MODIFIERS: [string; 9] = ["BOLD", "DIM", "ITALIC", "UNDERLINED", "SLOW_BLINK",
    "RAPID_BLINK", "REVERSED", "HIDDEN", "CROSSED_OUT"]

const FLAG_ERROR: string = "expected flag names separated by |"

fn trim_flag(value: string) -> string {
    mut first := value.len
    mut last := 0
    mut offset := 0
    for ch in value.runes() {
        end := offset + width.encoded(i32(ch))
        if !width.whitespace(i32(ch)) {
            if first == value.len { first = offset }
            last = end
        }
        offset = end
    }
    if first > last { return "" }
    value[first..last]
}

fn modifier_flag(value: string) -> Option<i32> {
    for i in 0..9 {
        if value == MODIFIERS[i] { return .Some(i32(1).shl(i)) }
    }
    .None
}

pub fn read_flags(doc: &json.Doc, node: i32) -> Result<i32, json.JsonError> {
    if node < 0 || doc.kind(node) == .Null { return .Ok(0) }
    read_flag_set(&doc,node,65535,modifier_flag)
}

pub fn read_flag_set(doc: &json.Doc, node: i32, max_bits: i32, named: fn(string)->Option<i32>) -> Result<i32,json.JsonError> {
    value := match doc.as_str(node) {
        .Some(s) => s,
        .None => { return .Err(json.JsonError::new(FLAG_ERROR,doc.node_offset(node))) },
    }
    if value.len == 0 || trim_flag(value).len == 0 { return .Ok(0) }
    mut mask := 0
    for item in text.split(value, "|") {
        word := trim_flag(item)
        if text.starts_with(word,"0x") {
            start := if word.len > 2 && word[2] == b'+' { 3 } else { 2 }
            n := parse.hex_u64_range(word,start,word.len)
            if !n.ok || n.value > u64(max_bits) { return .Err(json.JsonError::new(FLAG_ERROR,doc.node_offset(node))) }
            mask = mask.bit_or(i32(n.value))
            continue
        }
        match named(word) {
            .Some(bits) => { mask = mask.bit_or(bits) },
            .None => { return .Err(json.JsonError::new(FLAG_ERROR,doc.node_offset(node))) },
        }
    }
    .Ok(mask)
}

fn modifier_name(i: i32) -> string { MODIFIERS[i] }

pub fn flag_names(mask: i32) -> string { format_flags(mask,9,modifier_name) }

pub fn format_flags(mask: i32, count: i32, name: fn(i32)->string) -> string {
    if mask == 0 { return "" }
    mut value: []u8 = []
    for i in 0..count {
        if mask.bit_and(i32(1).shl(i)) == 0 { continue }
        if value.len > 0 { bytes.append_utf8(&mut value, " | ") }
        bytes.append_utf8(&mut value, name(i))
    }
    extra := mask.bit_and((i32(1).shl(count)-1).bit_not())
    if extra != 0 {
        if value.len > 0 { bytes.append_utf8(&mut value, " | ") }
        bytes.append_utf8(&mut value, "0x")
        digits := "0123456789abcdef"
        for i in 0..4 {
            shift := (3-i)*4
            if extra.shr(shift) != 0 { value.push(digits[extra.shr(shift).bit_and(15)]) }
        }
    }
    bytes.decode(&value).unwrap()
}

pub fn write_flags(out: &mut json.Writer, field: string, mask: i32) {
    if mask == 0 { return }
    out.key(field)
    out.string(flag_names(mask))
}
