import .tui
import .json_format
import .repetition
import std.json
import .layout_solver as lp
import std.cmp as cmp
import std.math

@derive(Encode)
pub enum Direction { Horizontal, Vertical }

impl Default for Direction { fn default() -> Self { .Vertical } }
impl Direction {
    pub fn perpendicular(&self) -> Self { if self == .Horizontal { .Vertical } else { .Horizontal } }
}

@derive(Encode, Eq, Hash)
pub enum VerticalAlignment { Top, Center, Bottom }

impl Default for VerticalAlignment { fn default() -> Self { .Top } }
impl Display for VerticalAlignment {
    fn str(&self) -> string { match self { .Top => "Top", .Center => "Center", .Bottom => "Bottom", } }
}
impl VerticalAlignment {
    pub fn parse(name: string) -> Option<Self> {
        match name { "Top" => .Some(.Top), "Center" => .Some(.Center), "Bottom" => .Some(.Bottom), _ => .None, }
    }
    pub fn flex(&self) -> Flex { match self { .Top => .Start, .Center => .Center, .Bottom => .End, } }
}
impl json.Decode for VerticalAlignment {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        name := json_format.unit_name(&doc,node)?
        match VerticalAlignment::parse(name) {
            .Some(a) => .Ok(a), .None => .Err(json.JsonError::new("unknown vertical alignment",doc.node_offset(node))),
        }
    }
}

@derive(Encode)
pub enum Flex { Start, Center, End, SpaceBetween, SpaceAround, SpaceEvenly, Legacy }
@derive(Encode, Decode)
pub enum Constraint { Length(u16), Percentage(u16), Ratio(u32, u32), Min(u16), Max(u16), Fill(u16) }

impl Default for Constraint { fn default() -> Self { .Percentage(100) } }
impl Display for Constraint {
    fn str(&self) -> string {
        match self {
            .Length(n) => f"Length({n})", .Percentage(n) => f"Percentage({n})",
            .Ratio(n, d) => f"Ratio({n}, {d})", .Min(n) => f"Min({n})",
            .Max(n) => f"Max({n})", .Fill(n) => f"Fill({n})",
        }
    }
}

fn numeric_rules(values: &[]u16, build: fn(u16) -> Constraint) -> []Constraint {
    mut rules: []Constraint = []
    rules.reserve(values.len)
    for n in values { rules.push(build(n)) }
    move rules
}

impl Constraint {
    pub fn repeat(self, count: i32) -> []Constraint { repetition.collect(self,count) }

    pub fn from_lengths(values: &[]u16) -> []Self { numeric_rules(&values, fn(n: u16) -> Constraint { .Length(n) }) }
    pub fn from_percentages(values: &[]u16) -> []Self { numeric_rules(&values, fn(n: u16) -> Constraint { .Percentage(n) }) }
    pub fn from_mins(values: &[]u16) -> []Self { numeric_rules(&values, fn(n: u16) -> Constraint { .Min(n) }) }
    pub fn from_maxes(values: &[]u16) -> []Self { numeric_rules(&values, fn(n: u16) -> Constraint { .Max(n) }) }
    pub fn from_fills(values: &[]u16) -> []Self { numeric_rules(&values, fn(n: u16) -> Constraint { .Fill(n) }) }
    pub fn from_ratios(values: &[](u32,u32)) -> []Self {
        mut rules: []Constraint = []
        rules.reserve(values.len)
        for pair in values { rules.push(.Ratio(pair.0, pair.1)) }
        move rules
    }

    pub fn apply(&self, length: u16) -> u16 {
        fraction := match self {
            .Length(n) => { return cmp.min<u16>(n, length) },
            .Fill(n) => { return cmp.min<u16>(n, length) },
            .Max(n) => { return cmp.min<u16>(n, length) },
            .Min(n) => { return cmp.max<u16>(n, length) },
            .Percentage(n) => f32(n) / f32(100),
            .Ratio(n, d) => f32(n) / f32(cmp.max<u32>(1, d)),
        }
        scaled := fraction * f32(length)
        if scaled >= f32(length) { length } else { u16(scaled) }
    }
}

@derive(Encode, Decode, Eq)
pub enum Spacing { Space(u16), Overlap(u16) }

impl Spacing {
    fn cells(&self) -> i32 {
        value := match self { .Space(n) => i32(n), .Overlap(n) => -i32(n), }
        (value + 32768).bit_and(65535) - 32768
    }
}

@derive(Encode)
pub struct Margin { horizontal: u16, vertical: u16 }

impl json.Decode for Margin {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self, json.JsonError> {
        (horizontal, vertical) := json_format.pair<u16>(&doc, node, &["horizontal", "vertical"])?
        .Ok(Self { horizontal:horizontal, vertical:vertical })
    }
}

impl json.Decode for Direction {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self, json.JsonError> {
        name := json_format.unit_name(&doc, node)?
        match name {
            "Horizontal" => .Ok(.Horizontal), "Vertical" => .Ok(.Vertical),
            _ => .Err(json.JsonError::new("unknown layout direction", doc.node_offset(node))),
        }
    }
}

impl json.Decode for Flex {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self, json.JsonError> {
        name := json_format.unit_name(&doc, node)?
        match name {
            "Start" => .Ok(.Start), "Center" => .Ok(.Center), "End" => .Ok(.End),
            "SpaceBetween" => .Ok(.SpaceBetween), "SpaceAround" => .Ok(.SpaceAround),
            "SpaceEvenly" => .Ok(.SpaceEvenly), "Legacy" => .Ok(.Legacy),
            _ => .Err(json.JsonError::new("unknown layout flex", doc.node_offset(node))),
        }
    }
}

pub struct Split { areas: []tui.Rect, spacers: []tui.Rect }
impl Split { pub fn new() -> Self { Self { areas: [], spacers: [] } } }

struct Entry { extent: i32, edges: []i32, age: u64 }
pub opaque struct Layout {
    rules: []Constraint, axis: Direction, flex_mode: Flex, spacing_value: Spacing, margins: Margin,
    view_bounds: tui.Rect, projected: Split, view_valid: bool,
    entries: []Entry, capacity: i32, tick: u64, recent: i32,
}

impl Default for Layout { fn default() -> Self { Layout::vertical([]) } }

impl Layout {
    pub fn new(axis: Direction, move rules: []Constraint) -> Self {
        Self {
            rules: move rules, axis: axis, flex_mode: .Start, spacing_value: .Space(0), margins: Margin { horizontal:0, vertical:0 },
            view_bounds: tui.Rect { x: 0, y: 0, w: 0, h: 0 }, projected: Split::new(), view_valid: false,
            entries: [], capacity: 500, tick: 0, recent: -1
        }
    }
    pub fn horizontal(move rules: []Constraint) -> Self { Layout::new(.Horizontal, move rules) }
    pub fn vertical(move rules: []Constraint) -> Self { Layout::new(.Vertical, move rules) }
    pub fn len(&self) -> i32 { self.rules.len }
    pub fn set_direction(&mut self, direction: Direction) {
        if self.axis != direction { self.axis = direction; self.view_valid = false }
    }
    pub fn set_constraints(&mut self, move rules: []Constraint) { self.rules = move rules; self.invalidate() }
    fn invalidate(&mut self) { self.entries.clear(); self.recent = -1; self.view_valid = false }
    pub fn flex(move self, value: Flex) -> Self {
        mut l := move self
        if l.flex_mode != value { l.flex_mode = value; l.invalidate() }
        move l
    }
    pub fn spacing(move self, cells: i32) -> Self {
        gap := cmp.clamp<i32>(cells, -32768, 32767)
        spacing: Spacing = if gap < 0 { .Overlap(u16(-gap)) } else { .Space(u16(gap)) }
        self.with_spacing(spacing)
    }
    pub fn with_spacing(move self, spacing: Spacing) -> Self {
        mut l := move self
        if l.spacing_value != spacing { l.spacing_value = spacing; l.invalidate() }
        move l
    }
    pub fn margin(move self, horizontal: i32, vertical: i32) -> Self {
        mut l := move self
        l.view_valid = false
        l.margins = Margin { horizontal:u16(cmp.clamp<i32>(horizontal,0,65535)), vertical:u16(cmp.clamp<i32>(vertical,0,65535)) }
        move l
    }
    pub fn cache_capacity(move self, count: i32) -> Self {
        mut l := move self
        l.capacity = cmp.max<i32>(0, count)
        if l.entries.len > l.capacity { l.invalidate() }
        move l
    }
}

const EDGE: f64 = 1001000999.0
const SPACER: f64 = 100100100.0
const BOUND: f64 = 100000000.0
const LENGTH_SIZE: f64 = 10000000.0
const PERCENT_SIZE: f64 = 1000000.0
const RATIO_SIZE: f64 = 100000.0
const LIMIT_SIZE: f64 = 10000.0
const FILL_GROW: f64 = 1000.0
const SPACE_GROW: f64 = 10.0
const FILL_RATIO: f64 = 100.0
const NEIGHBOR_SIZE: f64 = 1.0

impl json.Encode for Layout {
    fn encode_json(&self, out: &mut json.Writer) {
        out.object()
        json.field_value(&mut out, "direction", &self.axis)
        json.field_value(&mut out, "constraints", &self.rules)
        json.field_value(&mut out, "margin", &self.margins)
        json.field_value(&mut out, "flex", &self.flex_mode)
        json.field_value(&mut out, "spacing", &self.spacing_value)
        out.end()
    }
}

impl json.Decode for Layout {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self, json.JsonError> {
        f := json_format.fields(&doc, node, &["direction", "constraints", "margin", "flex", "spacing"], 5, 5)?
        direction := Direction::decode_json(&doc, f[0])?
        rules := json.decode<[]Constraint>(&doc, f[1])?
        margin := Margin::decode_json(&doc, f[2])?
        flex := Flex::decode_json(&doc, f[3])?
        spacing := Spacing::decode_json(&doc, f[4])?
        mut layout := Layout::new(direction, move rules)
        layout.margins = margin
        layout.flex_mode = flex
        layout.spacing_value = spacing
        .Ok(move layout)
    }
}

struct Axis { last: i32, extent: f64 }

impl Axis {
    fn term(&self, row: &mut lp.Row, edge: i32, factor: f64) {
        if edge == self.last { row.shift(self.extent * factor) }
        else if edge > 0 { row.term(edge - 1, factor) }
    }
    fn span(&self, row: &mut lp.Row, start: i32, factor: f64) {
        self.term(&mut row, start, -factor)
        self.term(&mut row, start + 1, factor)
    }
    fn size(&self, model: &mut lp.Model, start: i32, rel: lp.Relation, value: f64, weight: f64) {
        mut row := lp.Row::new(-value)
        self.span(&mut row, start, 1.0)
        model.add(move row, rel, weight)
    }
    fn compare(&self, model: &mut lp.Model, a: i32, scale_a: f64, b: i32, scale_b: f64, weight: f64) {
        mut row := lp.Row::new(0.0)
        self.span(&mut row, a, scale_a)
        self.span(&mut row, b, -scale_b)
        model.add(move row, .Equal, weight)
    }
}

fn weight(rule: &Constraint, flex: Flex) -> f64 {
    match rule {
        .Fill(n) => if n == 0 { 0.000001 } else { f64(n) },
        .Min(_) => if flex == .Legacy { 0.0 } else { 1.0 },
        _ => 0.0,
    }
}

fn minimum_bound(value: u16) -> f64 { if value > 32767 { 0.0 } else { f64(value) } }

fn desired(rule: &Constraint, extent: f64, flex: Flex) -> f64 {
    match rule {
        .Length(v) => f64(v), .Percentage(v) => extent * f64(v) / 100.0,
        .Ratio(a, b) => extent * f64(a) / f64(cmp.max<u32>(1, b)),
        .Max(v) => f64(v), .Min(v) => if flex == .Legacy { f64(v) } else { minimum_bound(v) }, .Fill(_) => 0.0,
    }
}

fn shrink_rank(rule: &Constraint) -> i32 {
    match rule { .Min(v) => if v > 32767 { 4 } else { 0 }, .Length(_) => 1, .Percentage(_) => 2, .Ratio(_, _) => 3, .Max(_) => 4, .Fill(_) => 5, }
}

fn growth_cost(rule: &Constraint) -> i32 {
    match rule { .Min(_) => 1, .Ratio(_, _) => 2, .Percentage(_) => 3, .Length(_) => 4, .Max(_) => 5, .Fill(_) => 0, }
}

impl Layout {
    fn compressed(&self, extent: i32, gap: f64, lead: f64, available: f64, edges: &mut []i32) -> bool {
        n := self.rules.len
        length := f64(extent)
        first := &self.rules[0]
        target := desired(&first, length, self.flex_mode)
        if target * f64(n) <= available { return false }
        rank := shrink_rank(&first)
        for i in 1..n {
            if shrink_rank(&self.rules[i]) != rank || desired(&self.rules[i], length, self.flex_mode) != target { return false }
        }
        mut step := gap
        mut start := lead
        mut room := available
        if self.flex_mode == .SpaceAround {
            unit := length / f64(n)
            step = math.min(gap, unit)
            loss := match &first {
                .Min(v) => if v <= 32767 { BOUND + FILL_GROW } else { FILL_GROW },
                .Length(_) => LENGTH_SIZE, .Percentage(_) => PERCENT_SIZE, .Ratio(_, _) => RATIO_SIZE,
                .Max(_) => LIMIT_SIZE, .Fill(_) => FILL_GROW,
            }
            if f64(n) * (loss - SPACE_GROW) > SPACER {
                step = math.clamp(unit - target, math.min(gap / 2.0, unit), step)
            }
            start = step / 2.0
            room = math.max(0.0, length - f64(n) * step)
        }
        edges.push(0)
        for i in 0..n {
            offset := start + step * f64(i)
            edges.push(cell(offset + room * f64(i) / f64(n), extent))
            edges.push(cell(offset + room * f64(i + 1) / f64(n), extent))
        }
        edges.push(extent)
        true
    }

    fn level_minimums(&self, available: f64, extra: f64, flexible: i32, sizes: &mut []f64) -> bool {
        mut minimums := 0.0
        for rule in &self.rules {
            match rule { .Min(n) => { minimums += minimum_bound(n) }, _ => {}, }
        }
        crowded := minimums >= available
        if !crowded && minimums > extra { return false }
        budget := if crowded { available } else { extra }
        mut free := flexible
        mut level := budget / f64(free)
        while free > 0 {
            mut pinned := 0
            mut reserved := 0.0
            for rule in &self.rules {
                bound := match rule { .Min(n) => minimum_bound(n), .Fill(_) => 0.0, _ => { continue }, }
                if (crowded && bound < level) || (!crowded && bound > level) { pinned += 1; reserved += bound }
            }
            if free == flexible - pinned { break }
            free = flexible - pinned
            level = if free == 0 { 0.0 } else { (budget - reserved) / f64(free) }
        }
        for i in 0..self.rules.len {
            bound := match &self.rules[i] {
                .Min(n) => minimum_bound(n), .Fill(_) => 0.0,
                _ => { if crowded { sizes[i] = 0.0 }; continue },
            }
            sizes[i] = if crowded { math.min(level, bound) } else { math.max(level, bound) }
        }
        true
    }

    fn distribute_fills(&self, available: f64, extra: f64, flexible: i32, weights: f64, all_zero: bool,
                        fixed_gaps: bool, sizes: &mut []f64) -> bool {
        mut pinned := -1
        for i in 0..self.rules.len {
            scale := weight(&self.rules[i], self.flex_mode)
            if scale == 0.0 { continue }
            portion := extra * (if all_zero { 1.0 } else { scale }) / weights
            match &self.rules[i] {
                .Min(n) if portion < minimum_bound(n) => {
                    if fixed_gaps && weights == f64(flexible) &&
                            FILL_GROW + FILL_RATIO * (weights - 1.0) + 4.0 * NEIGHBOR_SIZE < LIMIT_SIZE {
                        return self.level_minimums(available, extra, flexible, &mut sizes)
                    }
                    if flexible != 2 || weights > 3.0 || pinned >= 0 || extra < minimum_bound(n) { return false }
                    pinned = i
                    sizes[i] = minimum_bound(n)
                    continue
                },
                _ => {},
            }
            sizes[i] = portion
        }
        if extra < -1e-8 { return false }
        if pinned < 0 { return true }
        for i in 0..self.rules.len {
            if i == pinned || weight(&self.rules[i], self.flex_mode) == 0.0 { continue }
            sizes[i] = extra - sizes[pinned]
            match &self.rules[i] { .Min(n) if sizes[i] < minimum_bound(n) => { return false }, _ => {}, }
        }
        true
    }

    fn direct(&self, extent: i32, edges: &mut []i32) -> bool {
        n := self.rules.len
        length := f64(extent)
        fixed_gaps := self.flex_mode == .Start || self.flex_mode == .End ||
        self.flex_mode == .Center || self.flex_mode == .Legacy
        spacing := self.spacing_value.cells()
        if fixed_gaps && i64(spacing) * i64(n - 1) >= i64(extent) && n > 1 {
            mut x := 0
            edges.push(0)
            for _ in 0..n { edges.push(x); edges.push(x); x += cmp.min<i32>(extent - x, spacing) }
            edges.push(extent)
            return true
        }
        if spacing < 0 && !fixed_gaps { return false }
        mut gap := f64(spacing)
        mut lead := 0.0
        if self.flex_mode == .SpaceEvenly || self.flex_mode == .SpaceAround {
            lead = gap
            if self.flex_mode == .SpaceAround && n > 1 { gap *= 2.0 }
        }
        available := length - 2.0 * lead - gap * f64(n - 1)
        if available < 0.0 && (self.flex_mode == .SpaceEvenly || self.flex_mode == .SpaceBetween) {
            outer := self.flex_mode == .SpaceEvenly
            divisions := if outer { n + 1 } else { n - 1 }
            edges.push(0)
            for i in 0..n {
                x := cell(length * f64(if outer { i + 1 } else { i }) / f64(divisions), extent)
                edges.push(x); edges.push(x)
            }
            edges.push(extent)
            return true
        }
        if n > 1 && self.flex_mode != .Legacy && gap >= 0.0 && self.compressed(extent, gap, lead, available, &mut edges) {
            return true
        }
        if available < 0.0 { return false }
        mut sizes: []f64 = []
        sizes.reserve(n)
        mut used := 0.0
        mut weights := 0.0
        mut grow := 0
        mut zero_fills := 0
        mut flexible := 0
        for i in 0..n {
            rule := &self.rules[i]
            scale := weight(&rule, self.flex_mode)
            if scale > 0.0 && scale < 1.0 { zero_fills += 1 }
            if scale > 0.0 { flexible += 1 }
            weights += scale
            v := if scale > 0.0 { 0.0 } else { desired(&rule, length, self.flex_mode) }
            used += v; sizes.push(v)
            if growth_cost(&rule) <= growth_cost(&self.rules[grow]) { grow = i }
        }
        if zero_fills > 0 && zero_fills != n { return false }
        if zero_fills == n { weights = f64(n) }
        mut extra := available - used
        if extra < -1e-8 && self.flex_mode == .Legacy {
            mut remaining := available
            for rank in 0..5 {
                for i in 0..n {
                    if shrink_rank(&self.rules[i]) == rank {
                        v := if remaining < sizes[i] { remaining } else { sizes[i] }
                        sizes[i] = v; remaining -= v
                    }
                }
            }
            extra = 0.0
        }
        if weights > 0.0 {
            if !self.distribute_fills(available, extra, flexible, weights, zero_fills == n, fixed_gaps, &mut sizes) { return false }
        } else {
            if extra < -1e-8 { return false }
            match self.flex_mode {
                .Legacy => { sizes[grow] += extra },
                .Start => {}, .End => { lead += extra }, .Center => { lead += extra / 2.0 },
                .SpaceBetween => {
                    if n == 1 { sizes[0] += extra } else { gap += extra / f64(n - 1) }
                },
                .SpaceEvenly => { gap += extra / f64(n + 1); lead = gap },
                .SpaceAround => {
                    if n == 1 { lead += extra / 2.0 } else { gap += extra / f64(n); lead = gap / 2.0 }
                },
            }
        }
        mut x := lead
        edges.push(0)
        for i in 0..n {
            if x < -1e-8 || x > length + 1e-8 { return false }
            edges.push(cell(x, extent))
            x += sizes[i]
            if x < -1e-8 || x > length + 1e-8 { return false }
            edges.push(cell(x, extent))
            x += gap
        }
        edges.push(extent)
        true
    }
}

impl Layout {
    fn spaces(&self, model: &mut lp.Model, axis: Axis) {
        n := self.rules.len
        last := 2 * n
        gap := f64(self.spacing_value.cells())
        flex := self.flex_mode
        if flex == .Start || flex == .End || flex == .Center || flex == .Legacy {
            for i in 1..n { axis.size(&mut model, 2 * i, .Equal, gap, SPACER) }
            if flex == .Center { axis.compare(&mut model, 0, 1.0, last, 1.0, SPACER) }
            for end in [0, last] {
                fixed := flex == .Legacy || (end == 0 && flex == .Start) || (end == last && flex == .End)
                axis.size(&mut model, end, .Equal, if fixed { 0.0 } else { axis.extent }, if fixed { EDGE } else { 100.0 })
            }
            return
        }
        between := flex == .SpaceBetween
        around := flex == .SpaceAround && n > 1
        start := if between || around { 1 } else { 0 }
        stop := if between || around { n } else { n + 1 }
        for i in start..stop {
            for j in (i + 1)..stop { axis.compare(&mut model, 2 * i, 1.0, 2 * j, 1.0, SPACER) }
        }
        if around {
            axis.compare(&mut model, 2, 1.0, 0, 2.0, SPACER)
            axis.compare(&mut model, 2, 1.0, last, 2.0, SPACER)
        }
        for i in 0..(n + 1) {
            if between && (i == 0 || i == n) { axis.size(&mut model, 2 * i, .Equal, 0.0, EDGE) }
            else {
                axis.size(&mut model, 2 * i, .AtLeast, gap, SPACER)
                axis.size(&mut model, 2 * i, .Equal, axis.extent, SPACE_GROW)
            }
        }
    }

    fn solve(&self, extent: i32) -> []i32 {
        n := self.rules.len
        if n == 0 { return [0, extent] }
        mut edges: []i32 = []
        edges.reserve(2 * n + 2)
        if extent == 0 { for _ in 0..(2 * n + 2) { edges.push(0) }; return move edges }
        if self.direct(extent, &mut edges) { return move edges }
        edges.clear()
        axis := Axis { last: 2 * n + 1, extent: f64(extent) }
        mut model := lp.Model::new(2 * n)
        for i in 0..(2 * n) {
            mut cap := lp.Row::new(axis.extent)
            cap.term(i, -1.0)
            model.add(move cap, .AtLeast, 0.0)
        }
        for i in 0..n { axis.size(&mut model, 2 * i + 1, .AtLeast, 0.0, 0.0) }
        self.spaces(&mut model, axis)
        for i in 0..n {
            p := 2 * i + 1
            match &self.rules[i] {
                .Length(v) => { axis.size(&mut model, p, .Equal, f64(v), LENGTH_SIZE) },
                .Percentage(v) => { axis.size(&mut model, p, .Equal, axis.extent * f64(v) / 100.0, PERCENT_SIZE) },
                .Ratio(a, b) => { axis.size(&mut model, p, .Equal, axis.extent * f64(a) / f64(cmp.max<u32>(1, b)), RATIO_SIZE) },
                .Max(v) => { axis.size(&mut model, p, .AtMost, f64(v), BOUND); axis.size(&mut model, p, .Equal, f64(v), LIMIT_SIZE) },
                .Min(v) => {
                    axis.size(&mut model, p, .AtLeast, minimum_bound(v), BOUND)
                    if self.flex_mode == .Legacy { axis.size(&mut model, p, .Equal, f64(v), LIMIT_SIZE) }
                    else { axis.size(&mut model, p, .Equal, axis.extent, FILL_GROW) }
                },
                .Fill(_) => { axis.size(&mut model, p, .Equal, axis.extent, FILL_GROW) },
            }
        }
        for i in 0..n {
            a := weight(&self.rules[i], self.flex_mode)
            if a > 0.0 {
                for j in (i + 1)..n {
                    b := weight(&self.rules[j], self.flex_mode)
                    if b > 0.0 { axis.compare(&mut model, 2 * i + 1, b, 2 * j + 1, a, FILL_RATIO) }
                }
            }
            if i > 0 && self.flex_mode != .Legacy { axis.compare(&mut model, 2 * i - 1, 1.0, 2 * i + 1, 1.0, NEIGHBOR_SIZE) }
        }
        values := model.solve()
        edges.push(0)
        for v in &values { edges.push(cell(v, extent)) }
        edges.push(extent)
        move edges
    }
}

fn cell(v: f64, extent: i32) -> i32 {
    if v <= 0.0 { return 0 }
    if v >= f64(extent) { return extent }
    i32(((v * 100.0).round() / 100.0).round())
}

impl Layout {
    fn lookup(&mut self, extent: i32) -> i32 {
        self.tick += 1
        if self.capacity > 0 {
            if self.recent >= 0 && self.entries[self.recent].extent == extent {
                self.entries[self.recent].age = self.tick
                return self.recent
            }
            for i in 0..self.entries.len {
                if self.entries[i].extent == extent {
                    self.recent = i; self.entries[i].age = self.tick
                    return i
                }
            }
        }
        entry := Entry { extent: extent, edges: self.solve(extent), age: self.tick }
        if self.entries.len < cmp.max<i32>(1, self.capacity) { self.recent = self.entries.len; self.entries.push(move entry) }
        else {
            mut oldest := 0
            for i in 1..self.entries.len { if self.entries[i].age < self.entries[oldest].age { oldest = i } }
            self.entries[oldest] = move entry; self.recent = oldest
        }
        self.recent
    }

    fn extent(&self, area: &tui.Rect) -> i32 {
        if self.axis == .Horizontal { cmp.min<i32>(area.w, 65535-area.x) }
        else { cmp.min<i32>(area.h, 65535-area.y) }
    }

    fn project(axis: Direction, area: &tui.Rect, edges: &[]i32, i: i32, part: &mut tui.Rect) {
        offset := edges[i]
        length := cmp.max<i32>(0, edges[i + 1] - offset)
        if axis == .Horizontal {
            part.x = area.x + offset; part.y = area.y; part.w = length; part.h = area.h
        } else {
            part.x = area.x; part.y = area.y + offset; part.w = area.w; part.h = length
        }
    }

    pub fn split_into(&mut self, bounds: tui.Rect, out: &mut Split) {
        area := bounds.inner(i32(self.margins.horizontal), i32(self.margins.vertical))
        idx := self.lookup(self.extent(&area))
        Layout::place(self.axis, &area, &self.entries[idx].edges, &mut out)
    }

    fn place(axis: Direction, area: &tui.Rect, edges: &[]i32, out: &mut Split) {
        n := edges.len / 2 - 1
        fit(&mut out.areas, n)
        fit(&mut out.spacers, n + 1)
        for i in 0..n {
            Layout::project(axis, &area, &edges, 2 * i, &mut out.spacers[i])
            Layout::project(axis, &area, &edges, 2 * i + 1, &mut out.areas[i])
        }
        Layout::project(axis, &area, &edges, 2 * n, &mut out.spacers[n])
    }

    pub fn arrange(&mut self, bounds: tui.Rect) -> &mut Self from self {
        if !self.view_valid || self.view_bounds != bounds || self.capacity == 0 {
            area := bounds.inner(i32(self.margins.horizontal), i32(self.margins.vertical))
            idx := self.lookup(self.extent(&area))
            Layout::place(self.axis, &area, &self.entries[idx].edges, &mut self.projected)
            self.view_bounds = bounds
            self.view_valid = true
        }
        &mut self
    }

    pub fn regions(&self) -> &Split from self { &self.projected }

    pub fn split_with_spacers(&mut self, bounds: tui.Rect) -> Split {
        mut out := Split::new()
        self.split_into(bounds, &mut out)
        move out
    }

    pub fn split(&mut self, bounds: tui.Rect) -> []tui.Rect {
        area := bounds.inner(i32(self.margins.horizontal), i32(self.margins.vertical))
        idx := self.lookup(self.extent(&area))
        edges := &self.entries[idx].edges
        mut parts: []tui.Rect = []
        fit(&mut parts, self.rules.len)
        for i in 0..self.rules.len { Layout::project(self.axis, &area, &edges, 2 * i + 1, &mut parts[i]) }
        move parts
    }

    pub fn part(&mut self, bounds: tui.Rect, index: i32) -> Option<tui.Rect> {
        if index < 0 || index >= self.rules.len { return .None }
        area := bounds.inner(i32(self.margins.horizontal), i32(self.margins.vertical))
        idx := self.lookup(self.extent(&area))
        mut part := area
        Layout::project(self.axis, &area, &self.entries[idx].edges, 2 * index + 1, &mut part)
        .Some(part)
    }
}

fn fit(rects: &mut []tui.Rect, count: i32) {
    if rects.len == count { return }
    if rects.len > count { rects.truncate(count); return }
    rects.reserve(count)
    while rects.len < count { rects.push(tui.Rect { x: 0, y: 0, w: 0, h: 0 }) }
}

pub fn centered(area: tui.Rect, width: Constraint, height: Constraint) -> tui.Rect {
    mut horizontal := Layout::horizontal([width]).flex(.Center)
    mut vertical := Layout::vertical([height]).flex(.Center)
    vertical.part(horizontal.part(area, 0).unwrap(), 0).unwrap()
}
