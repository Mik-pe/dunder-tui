capability unsafe, stdio

import .input
import .paint as palette
import std.bytes as bytes

@extern("kernel32.dll", "GetStdHandle")
unsafe fn handle(channel: i32) -> ptr
@extern("kernel32.dll", "GetConsoleMode")
unsafe fn get_mode(h: ptr, mode: ptr) -> i32
@extern("kernel32.dll", "SetConsoleMode")
unsafe fn set_mode(h: ptr, mode: u32) -> i32
@extern("kernel32.dll", "GetConsoleScreenBufferInfo")
unsafe fn buffer_info(h: ptr, info: ptr) -> i32
@extern("kernel32.dll", "WriteConsoleW")
unsafe fn write_wide(h: ptr, buf: ptr, n: u32, written: ptr, reserved: ptr) -> i32
@extern("kernel32.dll", "WaitForSingleObject")
unsafe fn wait_for(h: ptr, millis: u32) -> u32
@extern("kernel32.dll", "ReadConsoleInputW")
unsafe fn read_record(h: ptr, buf: ptr, n: u32, read: ptr) -> i32

@c_layout
struct KeyRecord {
    kind: u16, padding: u16, down: i32, repeat: u16, vk: u16, scan: u16, unit: u16, modifiers: u32,
}

@extern("kernel32.dll", "CreateConsoleScreenBuffer")
unsafe fn new_screen(access: u32, share: u32, security: ptr, flags: u32, data: ptr) -> ptr
@extern("kernel32.dll", "SetConsoleActiveScreenBuffer")
unsafe fn activate(h: ptr) -> i32
@extern("kernel32.dll", "CloseHandle")
unsafe fn close_handle(h: ptr) -> i32
@extern("kernel32.dll", "SetConsoleScreenBufferSize")
unsafe fn buffer_size(h: ptr, coord: u32) -> i32
@extern("kernel32.dll", "SetConsoleWindowInfo")
unsafe fn window_rect(h: ptr, absolute: i32, rect: ptr) -> i32
@extern("kernel32.dll", "SetConsoleCursorInfo")
unsafe fn cursor_info(h: ptr, info: ptr) -> i32
@extern("kernel32.dll", "SetConsoleCursorPosition")
unsafe fn position(h: ptr, coord: u32) -> i32
@extern("kernel32.dll", "SetConsoleTextAttribute")
unsafe fn attributes(h: ptr, value: u16) -> i32

@extern("kernel32.dll", "GetConsoleCursorInfo")
unsafe fn get_cursor(h: ptr, info: ptr) -> i32
@extern("kernel32.dll", "ScrollConsoleScreenBufferW")
unsafe fn scroll_buffer(h: ptr, source: ptr, clip: ptr, dest: u32, fill: ptr) -> i32
@extern("kernel32.dll", "FillConsoleOutputCharacterW")
unsafe fn fill_char(h: ptr, value: u16, length: u32, at: u32, written: ptr) -> i32
@extern("kernel32.dll", "FillConsoleOutputAttribute")
unsafe fn fill_attr(h: ptr, value: u16, length: u32, at: u32, written: ptr) -> i32

pub struct State {
    screen: ptr, embedded: bool, left: i32, top: i32, out_mode: u32, saved_cursor: [u32;2], in_mode: u32, palette: i32, vt: bool,
    high: i32, repeats: i32, last: input.Event,
}

pub fn state() -> State {
    unsafe { return State { screen: ptr(0), embedded:false, left:0, top:0, out_mode:0, saved_cursor:[25,1], in_mode: 0, palette: 7, vt: false, high: 0, repeats: 0, last: .Idle } }
}

pub fn size(state: &mut State) -> (i32, i32) {
    mut info: [i16; 11] = [0; 11]
    unsafe {
        h := if state.screen == ptr(0) { handle(-11) } else { state.screen }
        if buffer_info(h, addr(&mut info[0])) == 0 { return (0, 0) }
        w := i32(info[7]) - i32(info[5]) + 1
        hgt := i32(info[8]) - i32(info[6]) + 1
        if state.screen == ptr(0) { state.palette = i32(info[4]).bit_and(255) }
        else if state.embedded { state.left = i32(info[5]); state.top = i32(info[6]) }
        else if w != i32(info[0]) || hgt != i32(info[1]) {
            mut rect: [i16; 4] = [0, 0, i16(w - 1), i16(hgt - 1)]
            if (info[5] != 0 || info[6] != 0) && window_rect(h, 1, addr(&rect[0])) == 0 { return (0, 0) }
            if buffer_size(h, u32(w).bit_or(u32(hgt).shl(16))) == 0 { return (0, 0) }
        }
        return (w, hgt)
    }
    (0, 0)
}

unsafe fn supports_vt(screen: ptr) -> bool {
    mut probe: [u16; 6] = [27, 91, 50, 59, 50, 72]
    mut n: u32 = 0
    mut info: [i16; 11] = [0; 11]
    set_mode(screen,5) != 0 && write_wide(screen,addr(&probe[0]),6,addr(&mut n),ptr(0)) != 0 &&
        buffer_info(screen,addr(&mut info[0])) != 0 && info[2] == 1 && info[3] == 1
}

pub fn open(state: &mut State, alternate: bool) -> bool {
    unsafe {
        stdin := handle(-10)
        if get_mode(stdin, addr(&mut state.in_mode)) == 0 { return false }
        screen := new_screen(0xc0000000, 3, ptr(0), 1, ptr(0))
        mode := state.in_mode.bit_and(u32(0x247).bit_not()).bit_or(0x88)
        if !alternate {
            out := handle(-11)
            vt := usize(screen) != usize(0xffffffffffffffff) && supports_vt(screen)
            if usize(screen) != usize(0xffffffffffffffff) { _ := close_handle(screen) }
            if get_mode(out,addr(&mut state.out_mode)) == 0 || get_cursor(out,addr(&mut state.saved_cursor[0])) == 0 { return false }
            if set_mode(stdin,mode) == 0 { return false }
            state.vt = vt && set_mode(out,state.out_mode.bit_or(5)) != 0
            if !state.vt && set_mode(out,0) == 0 { _ := set_mode(stdin,state.in_mode); return false }
            state.screen = out
            state.embedded = true
            _ := size(&mut state)
            return true
        }
        if usize(screen) == usize(0xffffffffffffffff) { return false }
        mut cursor: [u32; 2] = [25, 0]
        if set_mode(screen, 0) == 0 || cursor_info(screen, addr(&cursor[0])) == 0 || activate(screen) == 0 {
            _ := close_handle(screen)
            return false
        }
        if set_mode(stdin, mode) == 0 {
            _ := activate(handle(-11))
            _ := close_handle(screen)
            return false
        }
        state.vt = supports_vt(screen)
        if !state.vt && set_mode(screen, 0x10) == 0 { _ := set_mode(screen, 0) }
        _ := position(screen, 0)
        state.screen = screen
        return true
    }
    false
}

pub fn read_position(state: &State) -> Result<(i32,i32),string> {
    mut info: [i16;11] = [0;11]
    unsafe {
        if buffer_info(state.screen,addr(&mut info[0])) != 0 {
            return .Ok((i32(info[2])-i32(info[5]),i32(info[3])-i32(info[6])))
        }
    }
    .Err("Could not read the console cursor.")
}

fn coord(state: &State, x: i32, y: i32) -> u32 {
    u32(state.left+x).bit_or(u32(state.top+y).shl(16))
}

pub fn move_to(state: &State, x: i32, y: i32) -> bool {
    unsafe { return position(state.screen,coord(&state,x,y)) != 0 }
    false
}

pub fn shift_rows(state: &mut State, first: i32, end: i32, delta: i32) -> bool {
    (w,h) := size(&mut state)
    if first < 0 || end > h || end <= first || w <= 0 { return false }
    n := delta.abs()
    if n == 0 { return true }
    mut written: u32 = 0
    unsafe {
        if n >= end-first {
            for y in first..end {
                at := coord(&state,0,y)
                if fill_char(state.screen,32,u32(w),at,addr(&mut written)) == 0 || written != u32(w) ||
                    fill_attr(state.screen,u16(state.palette),u32(w),at,addr(&mut written)) == 0 || written != u32(w) { return false }
            }
            return true
        }
        mut clip: [i16;4] = [i16(state.left),i16(state.top+first),i16(state.left+w-1),i16(state.top+end-1)]
        mut source := clip.clone()
        if delta > 0 { source[3] -= i16(n) } else { source[1] += i16(n) }
        dest := coord(&state,0,if delta > 0 { first+n } else { first })
        mut fill: [u16;2] = [32,u16(state.palette)]
        return scroll_buffer(state.screen,addr(&source[0]),addr(&clip[0]),dest,addr(&fill[0])) != 0
    }
    false
}

pub fn append_rows(state: &mut State, rows: i32) -> bool {
    if rows == 0 { return true }
    mut mode: u32 = 0
    unsafe {
        if get_mode(state.screen,addr(&mut mode)) == 0 || set_mode(state.screen,mode.bit_or(1)) == 0 { return false }
        defer { _ := set_mode(state.screen,mode) }
        for _ in 0..rows { if !write_text(&state,"\r\n") { return false } }
        _ := size(&mut state)
        return true
    }
    false
}

pub fn cursor(state: &State, x: i32, y: i32, previous_x: i32) -> bool {
    visible := x >= 0
    unsafe {
        if visible && !move_to(&state,x,y) { return false }
        if previous_x != -2 && visible == (previous_x >= 0) { return true }
        mut info: [u32;2] = [25,if visible { u32(1) } else { u32(0) }]
        return cursor_info(state.screen,addr(&info[0])) != 0
    }
    false
}

pub fn restore(state: &mut State) {
    unsafe {
        _ := set_mode(handle(-10), state.in_mode)
        if state.embedded {
            _ := set_mode(state.screen,state.out_mode)
            _ := attributes(state.screen,u16(state.palette))
            _ := cursor_info(state.screen,addr(&state.saved_cursor[0]))
        } else {
            _ := activate(handle(-11))
            _ := close_handle(state.screen)
        }
        state.screen = ptr(0)
    }
}

fn cube(n: i32) -> i32 { if n == 0 { 0 } else { n * 40 + 55 } }

fn color(encoded: i32, fallback: i32) -> i32 {
    code := if encoded >= 256 && encoded < 512 { encoded - 256 } else { encoded }
    if code < 0 { return fallback }
    if code < 16 { return code.bit_and(8).bit_or(code.bit_and(1).shl(2)).bit_or(code.bit_and(2)).bit_or(code.shr(2).bit_and(1)) }
    mut rgb := code.bit_and(0xffffff)
    if code < 232 {
        n := code - 16
        rgb = cube(n / 36) * 65536 + cube(n / 6 % 6) * 256 + cube(n % 6)
    } else if code < 256 { rgb = ((code - 232) * 10 + 8) * 0x10101 }
    colors: [i32; 16] = [0, 0x000080, 0x008000, 0x008080, 0x800000, 0x800080, 0x808000, 0xc0c0c0, 0x808080, 0x0000ff, 0x00ff00, 0x00ffff, 0xff0000, 0xff00ff, 0xffff00, 0xffffff]
    mut best := 0
    mut distance := 2147483647
    for i in 0..16 {
        r := rgb.shr(16) - colors[i].shr(16)
        g := rgb.shr(8).bit_and(255) - colors[i].shr(8).bit_and(255)
        b := rgb.bit_and(255) - colors[i].bit_and(255)
        d := r * r + g * g + b * b
        if d < distance { best = i; distance = d }
    }
    best
}

pub fn paint(state: &State, x: i32, y: i32, value: string, style: palette.Brush) -> bool {
    mut fg := color(style.fg, state.palette.bit_and(15))
    bg := color(style.bg, state.palette.shr(4))
    if style.modifiers.bit_and(2) != 0 { fg = fg.bit_and(7) }
    if style.modifiers.bit_and(1) != 0 { fg = fg.bit_or(8) }
    mut attr := if style.modifiers.bit_and(64) != 0 { fg * 16 + bg } else { bg * 16 + fg }
    if style.modifiers.bit_and(128) != 0 { attr = attr.shr(4) * 17 }
    if style.modifiers.bit_and(8) != 0 { attr = attr.bit_or(0x8000) }
    at := coord(&state,x,y)
    unsafe {
        if position(state.screen, at) == 0 || attributes(state.screen, u16(attr)) == 0 { return false }
    }
    write_text(&state, value)
}

pub fn write(state: &State, output: &[]u8) -> bool { write_text(&state, bytes.decode(&output).unwrap()) }

fn write_text(state: &State, value: string) -> bool {
    mut units: []u16 = []
    units.reserve(value.len)
    for r in value.runes() {
        cp := i32(r)
        if cp < 65536 { units.push(u16(cp)) }
        else {
            pair := cp - 65536
            units.push(u16(55296 + pair / 1024))
            units.push(u16(56320 + pair % 1024))
        }
    }
    mut sent := 0
    unsafe {
        while sent < units.len {
            mut n: u32 = 0
            mut count := units.len - sent
            if count > 16384 {
                count = 16384
                last := units[sent + count - 1]
                if last >= 0xd800 && last <= 0xdbff { count -= 1 }
            }
            if write_wide(state.screen, addr(&units[sent]), u32(count), addr(&mut n), ptr(0)) == 0 || n == 0 { return false }
            sent += i32(n)
        }
    }
    true
}

fn key(state: &mut State, record: KeyRecord) -> input.Event {
    cp := i32(record.unit)
    if cp >= 0xd800 && cp <= 0xdbff { state.high = cp; return .Idle }
    high := state.high
    state.high = 0
    if cp >= 0xdc00 && cp <= 0xdfff {
        if high == 0 { return .Idle }
        return input.character(0x10000 + (high - 0xd800) * 1024 + cp - 0xdc00)
    }
    if record.vk == 35 { return .Press(.End) }
    if record.vk == 36 { return .Press(.Home) }
    if record.vk == 37 { return .Press(.Left) }
    if record.vk == 38 { return .Press(.Up) }
    if record.vk == 39 { return .Press(.Right) }
    if record.vk == 40 { return .Press(.Down) }
    if record.vk == 46 { return .Press(.Delete) }
    input.character(cp)
}

pub fn next(state: &mut State, wait_ms: i32) -> input.Event {
    if state.repeats > 0 { state.repeats -= 1; return state.last }
    unsafe {
        h := handle(-10)
        ready := wait_for(h, u32(wait_ms))
        if ready == 258 { return .Idle }
        if ready != 0 { return .Error }
        mut record: KeyRecord = zeroed()
        mut n: u32 = 0
        if read_record(h, addr(&mut record), 1, addr(&mut n)) == 0 { return .Error }
        if n == 0 || record.kind != 1 || record.down == 0 { return .Idle }
        state.last = key(&mut state, record)
        state.repeats = i32(record.repeat) - 1
        return state.last
    }
    .Error
}
