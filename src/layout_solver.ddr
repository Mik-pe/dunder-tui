const EPS: f64 = 1e-10

pub opaque struct Row { constant: f64, columns: []i32, values: []f64, basic: i32 }

impl Row {
    pub fn new(constant: f64) -> Self { Self { constant: constant, columns: [], values: [], basic: -1 } }

    pub fn shift(&mut self, value: f64) { self.constant += value }

    pub fn term(&mut self, column: i32, value: f64) {
        if value == 0.0 { return }
        mut i := 0
        while i < self.columns.len && self.columns[i] < column { i += 1 }
        if i < self.columns.len && self.columns[i] == column { self.values[i] += value; return }
        self.columns.push(column)
        self.values.push(value)
        mut j := self.columns.len - 1
        if j == i { return }
        while j > i {
            self.columns[j] = self.columns[j - 1]
            self.values[j] = self.values[j - 1]
            j -= 1
        }
        self.columns[i] = column
        self.values[i] = value
    }

    fn find(&self, column: i32) -> i32 {
        if self.columns.len == 0 || column < self.columns[0] || column > self.columns[self.columns.len - 1] { return -1 }
        mut lo := 0
        mut hi := self.columns.len
        while lo < hi {
            mid := lo + (hi - lo) / 2
            if self.columns[mid] < column { lo = mid + 1 } else { hi = mid }
        }
        if lo < self.columns.len && self.columns[lo] == column { lo } else { -1 }
    }

    fn reverse(&mut self) {
        self.constant = -self.constant
        for i in 0..self.columns.len { self.values[i] = -self.values[i] }
    }

    fn pivot(&mut self, at: i32) {
        inv := 1.0 / self.values[at]
        self.constant *= -inv
        for i in 0..self.columns.len { self.values[i] *= -inv }
        self.values[at] = inv
    }

    fn substitute(&mut self, pivot: &Row, at: i32, columns: &mut []i32, values: &mut []f64) {
        factor := self.values[at]
        self.constant += factor * pivot.constant
        self.values[at] = 0.0
        columns.clear()
        values.clear()
        mut i := 0
        mut j := 0
        while i < self.columns.len || j < pivot.columns.len {
            mut column := 0
            mut v := 0.0
            if j == pivot.columns.len || (i < self.columns.len && self.columns[i] < pivot.columns[j]) {
                column = self.columns[i]; v = self.values[i]; i += 1
            } else {
                column = pivot.columns[j]; v = factor * pivot.values[j]; j += 1
                if i < self.columns.len && self.columns[i] == column { v += self.values[i]; i += 1 }
            }
            if v.abs() > EPS { columns.push(column); values.push(v) }
        }
        swap(&mut columns, &mut self.columns)
        swap(&mut values, &mut self.values)
    }
}

pub opaque struct Model { rows: []Row, costs: []f64, symbols: []i32, next: i32, variables: i32 }
pub enum Relation { AtLeast, AtMost, Equal }

impl Model {
    pub fn new(variables: i32) -> Self {
        mut costs: []f64 = []
        mut symbols: []i32 = []
        for i in 0..variables { costs.push(0.0); symbols.push(i) }
        Self { rows: [], costs: move costs, symbols: move symbols, next: variables, variables: variables }
    }

    fn inequality(&mut self, move row: Row, weight: f64) {
        mut r := move row
        if weight > 0.0 {
            r.term(self.costs.len, 1.0)
            self.costs.push(weight)
            self.symbols.push(self.next)
            self.next += 1
        }
        r.basic = self.next
        self.next += 1
        self.rows.push(move r)
    }

    pub fn add(&mut self, move row: Row, relation: Relation, weight: f64) {
        mut r := move row
        if relation == .Equal { self.inequality(r.clone(), weight) }
        if relation != .AtLeast { r.reverse() }
        self.inequality(move r, weight)
    }

    pub fn solve(&mut self) -> []f64 {
        mut columns: []i32 = []
        mut values: []f64 = []
        mut pivot := Row::new(0.0)
        mut leaving := -1
        for i in 0..self.rows.len {
            if self.rows[i].constant < -1e-8 && (leaving < 0 || self.rows[i].basic < self.rows[leaving].basic) { leaving = i }
        }
        while leaving >= 0 {
            mut entering := -1
            mut best := 0.0
            for k in 0..self.rows[leaving].columns.len {
                value := self.rows[leaving].values[k]
                column := self.rows[leaving].columns[k]
                if value <= EPS { continue }
                price := (if self.costs[column] > 0.0 { self.costs[column] } else { 0.0 }) / value
                if entering < 0 || price < best - EPS || ((price - best).abs() <= EPS &&
                    self.symbols[column] < self.symbols[self.rows[leaving].columns[entering]]) {
                    entering = k; best = price
                }
            }
            assert(entering >= 0)
            swap(&mut pivot, &mut self.rows[leaving])
            column := pivot.columns[entering]
            pivot.pivot(entering)
            pivot.basic = replace(&mut self.symbols[column], pivot.basic)
            mut next := -1
            for i in 0..self.rows.len {
                row := &mut self.rows[i]
                at := row.find(column)
                if at >= 0 { row.substitute(&pivot, at, &mut columns, &mut values) }
                if row.constant < -1e-8 && (next < 0 || row.basic < self.rows[next].basic) { next = i }
            }
            price := self.costs[column]
            self.costs[column] = 0.0
            for k in 0..pivot.columns.len { self.costs[pivot.columns[k]] += price * pivot.values[k] }
            swap(&mut pivot, &mut self.rows[leaving])
            leaving = next
        }
        mut result: []f64 = []
        result.reserve(self.variables)
        for _ in 0..self.variables { result.push(0.0) }
        for row in &self.rows { if row.basic < self.variables { result[row.basic] = row.constant } }
        move result
    }
}
