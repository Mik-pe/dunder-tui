import .tui
import .geometry
import .json_format
import .snapshot
import .text as rich
import std.cmp as cmp
import std.json
import std.map

const HISTORY_LIMIT: i32 = 65535

pub enum ClearType { All, AfterCursor, BeforeCursor, CurrentLine, UntilNewLine }

pub opaque struct Scrollback { rows: map.Map<i32,tui.Frame>, first: i32, length: i32, blank: tui.Frame }

impl Scrollback {
    fn new(width: i32) -> Self { Self { rows:map.Map<i32,tui.Frame>::new(), first:0, length:0, blank: tui.Frame::new(width,1) } }

    pub fn len(&self) -> i32 { self.length }

    pub fn row(&self, y: i32) -> &tui.Frame from self {
        assert(y >= 0 && y < self.length)
        i := self.rows.index_of((self.first+y)%HISTORY_LIMIT)
        if i < 0 { &self.blank } else { self.rows.value_at(i) }
    }

    fn push(&mut self, move row: tui.Frame) {
        self.push_empty(1)
        slot := (self.first+self.length-1)%HISTORY_LIMIT
        self.rows.put(slot,move row)
    }

    fn push_empty(&mut self, count: i32) {
        if count >= HISTORY_LIMIT { self.rows.clear(); self.first = 0; self.length = HISTORY_LIMIT; return }
        dropped := cmp.max<i32>(0,self.length+count-HISTORY_LIMIT)
        if dropped > 0 {
            if dropped <= self.rows.len() {
                for offset in 0..dropped { _ := self.rows.remove((self.first+offset)%HISTORY_LIMIT) }
            } else {
                mut i := self.rows.len()
                while i > 0 {
                    i -= 1
                    slot := self.rows.key_at(i)
                    if (slot-self.first+HISTORY_LIMIT)%HISTORY_LIMIT < dropped { _ := self.rows.remove(slot) }
                }
            }
            self.first = (self.first+dropped)%HISTORY_LIMIT
        }
        self.length += count-dropped
    }

    fn push_row(&mut self, frame: &tui.Frame, y: i32) {
        if frame.row_is_blank(y) { self.push_empty(1); return }
        width := frame.area().w
        mut row := tui.Frame::new(width,1)
        row.copy_cells(&frame,tui.Rect::new(frame.area().x,y,width,1),0,0)
        self.push(move row)
    }

    fn resize(&mut self, width: i32) {
        before := self.blank.area().w
        if before == width { return }
        mut resized := Self::new(width)
        resized.length = self.length
        end := i64(width)*i64(self.length)
        for i in 0..self.rows.len() {
            old_y := (self.rows.key_at(i)-self.first+HISTORY_LIMIT)%HISTORY_LIMIT
            mut offset := i64(old_y)*i64(before)
            mut source_x := 0
            while offset < end && source_x < before {
                y := i32(offset/i64(width))
                x := i32(offset%i64(width))
                count := cmp.min<i32>(width-x,before-source_x)
                if !resized.rows.contains(y) { resized.rows.put(y,tui.Frame::new(width,1)) }
                target := resized.rows.at_mut(y)
                source := self.rows.value_at(i)
                target.copy_cells(&source,tui.Rect::new(source_x,0,count,1),x,0)
                offset += i64(count)
                source_x += count
            }
        }
        self = move resized
    }
}

pub opaque struct TestBackend {
    screen: tui.Frame, history: Scrollback, x: i32, y: i32, visible: bool, scrolling_regions: bool,
}

pub struct SavedBackend { buffer: tui.Buffer, scrollback: tui.Buffer, cursor: bool, pos: geometry.Position }

impl snapshot.Read for SavedBackend {
    fn read_snapshot(doc: &json.Doc, node: i32, format: snapshot.Format) -> Result<Self,json.JsonError> {
        f := json_format.fields(&doc,node,&["buffer","scrollback","cursor","pos"],4,4)?
        buffer := tui.Buffer::read_snapshot(&doc,f[0],format)?
        scrollback := tui.Buffer::read_snapshot(&doc,f[1],format)?
        cursor := bool::decode_json(&doc,f[2])?
        p := f[3]
        if doc.kind(p) != .Array || doc.count(p) != 2 {
            return .Err(json.JsonError::new("expected two cursor coordinates",doc.node_offset(p)))
        }
        x := u16::decode_json(&doc,doc.at(p,0))?
        y := u16::decode_json(&doc,doc.at(p,1))?
        .Ok(Self { buffer:move buffer, scrollback:move scrollback, cursor:cursor, pos:geometry.Position { x:x,y:y } })
    }
}

fn write_backend<B: snapshot.Write,H: snapshot.Write>(out: &mut json.Writer, buffer: &B, history: &H, visible: bool, x: i32, y: i32, format: snapshot.Format) {
    out.object()
    out.key("buffer"); buffer.write_snapshot(&mut out,format)
    out.key("scrollback"); history.write_snapshot(&mut out,format)
    out.key("cursor"); out.boolean(visible)
    out.key("pos"); out.array(); out.integer(i64(x)); out.integer(i64(y)); out.end()
    out.end()
}

impl json.Encode for SavedBackend {
    fn encode_json(&self, out: &mut json.Writer) { self.write_snapshot(&mut out,.WithUnderlineColor) }
}
impl json.Decode for SavedBackend {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        SavedBackend::read_snapshot(&doc,node,.WithUnderlineColor)
    }
}

impl snapshot.Write for SavedBackend {
    fn write_snapshot(&self, out: &mut json.Writer, format: snapshot.Format) {
        write_backend(&mut out,&self.buffer,&self.scrollback,self.cursor,i32(self.pos.x),i32(self.pos.y),format)
    }
}

impl json.Encode for Scrollback {
    fn encode_json(&self, out: &mut json.Writer) { self.write_snapshot(&mut out,.WithUnderlineColor) }
}

impl snapshot.Write for Scrollback {
    fn write_snapshot(&self, out: &mut json.Writer, format: snapshot.Format) {
        area := tui.Rect::new(0,0,self.blank.area().w,self.len())
        out.object()
        json.field_value(&mut out,"area",&area)
        out.key("content"); out.array()
        for y in 0..area.h { self.row(y).write_snapshot_cells(&mut out,format) }
        out.end(); out.end()
    }
}

impl SavedBackend {
    pub fn to_backend(&self) -> Result<TestBackend,string> {
        area := self.buffer.area
        history_area := self.scrollback.area
        if area.x != 0 || area.y != 0 || history_area.x != 0 || history_area.y != 0 || area.w != history_area.w {
            return .Err("the screen and scrollback must start at the origin and have matching widths")
        }
        screen := self.buffer.to_frame()?
        rows := self.scrollback.to_frame()?
        mut history := Scrollback::new(area.w)
        for y in 0..history_area.h { history.push_row(&rows,y) }
        .Ok(TestBackend { screen:move screen, history:move history, x:i32(self.pos.x), y:i32(self.pos.y),
            visible:self.cursor, scrolling_regions:true })
    }
}

impl json.Encode for TestBackend {
    fn encode_json(&self, out: &mut json.Writer) { self.write_snapshot(&mut out,.WithUnderlineColor) }
}
impl json.Decode for TestBackend {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        TestBackend::read_snapshot(&doc,node,.WithUnderlineColor)
    }
}

impl snapshot.Write for TestBackend {
    fn write_snapshot(&self, out: &mut json.Writer, format: snapshot.Format) {
        write_backend(&mut out,&self.screen,&self.history,self.visible,self.x,self.y,format)
    }
}

impl snapshot.Read for TestBackend {
    fn read_snapshot(doc: &json.Doc, node: i32, format: snapshot.Format) -> Result<Self,json.JsonError> {
        saved := SavedBackend::read_snapshot(&doc,node,format)?
        match saved.to_backend() {
            .Ok(backend) => .Ok(move backend),
            .Err(reason) => .Err(json.JsonError::new(reason,doc.node_offset(node))),
        }
    }
}

impl TestBackend {
    pub fn new(width: i32, height: i32) -> Self {
        screen := tui.Frame::new(width,height)
        history := Scrollback::new(screen.area().w)
        Self { screen: move screen, history: move history, x: 0, y: 0, visible: false, scrolling_regions:true }
    }

    pub fn with_lines(lines: &[]rich.Line) -> Self {
        mut width := 0
        for line in lines { width = cmp.max<i32>(width,line.width()) }
        mut backend := Self::new(i32(u16(width)),i32(u16(lines.len)))
        for y in 0..lines.len {
            _ := lines[y].write(&mut backend.screen,tui.Rect::new(0,i32(u16(y)),backend.screen.area().w,1))
        }
        move backend
    }

    pub fn buffer(&self) -> &tui.Frame from self { &self.screen }
    pub fn scrollback(&self) -> &Scrollback from self { &self.history }
    pub fn cursor_visible(&self) -> bool { self.visible }
    pub fn cursor_position(&self) -> (i32,i32) { (self.x,self.y) }
    pub fn show_cursor(&mut self) { self.visible = true }
    pub fn hide_cursor(&mut self) { self.visible = false }
    pub fn set_scrolling_regions(&mut self, enabled: bool) { self.scrolling_regions = enabled }

    pub fn set_cursor_position(&mut self, x: i32, y: i32) {
        self.x = cmp.clamp<i32>(x,0,65535)
        self.y = cmp.clamp<i32>(y,0,65535)
    }

    pub fn resize(&mut self, width: i32, height: i32) {
        self.screen.resize(width,height)
        self.history.resize(self.screen.area().w)
    }

    pub fn clear_region(&mut self, kind: ClearType) {
        area := self.screen.area()
        if area.is_empty() { return }
        x := cmp.min<i32>(self.x,area.w-1)
        y := cmp.min<i32>(self.y,area.h-1)
        match kind {
            .All => { self.screen.clear() },
            .CurrentLine => { self.screen.clear_cells(tui.Rect { x:0,y:y,w:area.w,h:1 }) },
            .UntilNewLine => { self.screen.clear_cells(tui.Rect { x:x,y:y,w:area.w-x,h:1 }) },
            .AfterCursor => {
                self.screen.clear_cells(tui.Rect { x:x,y:y,w:area.w-x,h:1 })
                self.screen.clear_cells(tui.Rect { x:0,y:y+1,w:area.w,h:area.h-y-1 })
            },
            .BeforeCursor => {
                self.screen.clear_cells(tui.Rect { x:0,y:0,w:area.w,h:y })
                self.screen.clear_cells(tui.Rect { x:0,y:y,w:x+1,h:1 })
            },
        }
    }

    pub fn scroll_up(&mut self, first: i32, end: i32, rows: i32) { self.scroll(first,end,rows,true) }
    pub fn scroll_down(&mut self, first: i32, end: i32, rows: i32) { self.scroll(first,end,rows,false) }

    fn scroll(&mut self, first: i32, end: i32, rows: i32, up: bool) {
        area := self.screen.area()
        top := cmp.clamp<i32>(first,0,area.h)
        bottom := cmp.clamp<i32>(end,top,area.h)
        count := cmp.clamp<i32>(rows,0,65535)
        if count == 0 || area.w == 0 { return }
        shift := cmp.min<i32>(count,bottom-top)
        if up && top == 0 {
            for y in 0..shift { self.history.push_row(&self.screen,y) }
            self.history.push_empty(count-shift)
        }
        self.screen.scroll_rows(top,bottom,if up { -shift } else { shift })
    }

    pub fn append_lines(&mut self, rows: i32) {
        area := self.screen.area()
        count := cmp.clamp<i32>(rows,0,65535)
        bottom := cmp.max<i32>(0,area.h-1)
        remaining := cmp.max<i32>(0,bottom-self.y)
        if count > remaining { self.scroll_up(0,area.h,count-remaining) }
        self.x = cmp.min<i32>(self.x+1,cmp.max<i32>(0,area.w-1))
        self.y = cmp.min<i32>(self.y+count,bottom)
    }
}

impl tui.Backend for TestBackend {
    fn supports_scrolling_regions(&self) -> bool { self.scrolling_regions }
    fn clear_screen(&mut self, area: tui.Rect) -> Result<(),string> { self.clear_region(.All); .Ok }

    fn size(&mut self) -> (i32,i32) { (self.screen.area().w,self.screen.area().h) }
    fn window_size(&mut self) -> Result<tui.WindowSize,string> {
        area := self.screen.area()
        .Ok(tui.WindowSize { columns:area.w, rows:area.h, pixel_width:640, pixel_height:480 })
    }
    fn read_cursor(&mut self) -> Result<(i32,i32),string> { .Ok(self.cursor_position()) }
    fn set_cursor_visible(&mut self, visible: bool) -> Result<(),string> { self.visible = visible; .Ok }
    fn move_to(&mut self, x: i32, y: i32) -> Result<(),string> { self.set_cursor_position(x,y); .Ok }
    fn extend_lines(&mut self, rows: i32) -> Result<(),string> { self.append_lines(rows); .Ok }
    fn shift_rows(&mut self, top: i32, bottom: i32, delta: i32) -> Result<(),string> {
        if !self.scrolling_regions { return .Err("Scrolling regions are disabled.") }
        if delta < 0 { self.scroll_up(top,bottom,-delta) } else { self.scroll_down(top,bottom,delta) }
        .Ok
    }
    fn write_region(&mut self, frame: &tui.Frame) -> Result<(),string> {
        unknown := tui.Frame::new(0,0)
        self.screen.apply_region_diff(&frame,&unknown)
        .Ok
    }
    fn overwrite_region(&mut self, frame: &tui.Frame) -> Result<(),string> {
        area := frame.area()
        self.screen.copy_region(&frame,area,area.x,area.y)
        .Ok
    }
    fn draw_cells(&mut self, frame: &tui.Frame, previous: &tui.Frame) -> Result<(),string> {
        self.screen.apply_region_diff(&frame,&previous)
        .Ok
    }
    fn present(&mut self, frame: &tui.Frame, previous: &tui.Frame) -> Result<(),string> {
        self.screen.apply_region_diff(&frame,&previous)
        match frame.cursor_position() {
            .Some(pos) => { self.set_cursor_position(pos.0,pos.1); self.show_cursor() },
            .None => { self.hide_cursor() },
        }
        .Ok
    }
}
