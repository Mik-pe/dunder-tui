import .posix
import .windows
import .input

pub struct Session { unix: posix.State, win: windows.State, alternate: bool }

pub fn session() -> Session { Session { unix: posix.state(), win: windows.state(), alternate:true } }

impl Session {
    pub fn size(&mut self) -> (i32, i32) {
        if target_is("windows") { return windows.size(&mut self.win) } else { return posix.size() }
    }

    pub fn open(&mut self, alternate: bool) -> bool {
        self.alternate = alternate
        if target_is("windows") { return windows.open(&mut self.win,alternate) } else { return posix.open(&mut self.unix) }
    }

    pub fn enter(&self) -> bool {
        if target_is("windows") { return true }
        else if !self.alternate { return posix.write("\x1b[?25l\x1b[0m") }
        else { return posix.write("\x1b[?1049h\x1b[?25l\x1b[0m\x1b[2J") }
    }

    pub fn close(&mut self) {
        if target_is("windows") { windows.restore(&mut self.win) }
        else {
            _ := posix.write(if self.alternate { "\x1b[0m\x1b[?25h\x1b[?1049l" } else { "\x1b[0m\x1b[?25h" })
            posix.restore(&mut self.unix)
        }
    }

    pub fn next(&mut self, wait_ms: i32) -> input.Event {
        if target_is("windows") { return windows.next(&mut self.win, wait_ms) } else { return posix.next(&mut self.unix, wait_ms) }
    }
}
