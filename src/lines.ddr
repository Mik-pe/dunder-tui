pub enum Merge { Replace, Exact, Fuzzy }

fn shape(code: i32) -> i32 {
    if code < 0x2500 || code > 0x257f { return -1 }
    arms: [i32; 128] = [
        0x1010, 0x2020, 0x0101, 0x0202, 0x7070, 0x8080, 0x0707, 0x0808,
        0x9090, 0xa0a0, 0x0909, 0x0a0a, 0x0110, 0x0120, 0x0210, 0x0220,
        0x1100, 0x2100, 0x1200, 0x2200, 0x0011, 0x0021, 0x0012, 0x0022,
        0x1001, 0x2001, 0x1002, 0x2002, 0x0111, 0x0121, 0x0112, 0x0211,
        0x0212, 0x0122, 0x0221, 0x0222, 0x1101, 0x2101, 0x1102, 0x1201,
        0x1202, 0x2102, 0x2201, 0x2202, 0x1110, 0x2110, 0x1120, 0x2120,
        0x1210, 0x2210, 0x1220, 0x2220, 0x1011, 0x2011, 0x1021, 0x2021,
        0x1012, 0x2012, 0x1022, 0x2022, 0x1111, 0x2111, 0x1121, 0x2121,
        0x1112, 0x1211, 0x1212, 0x2112, 0x1122, 0x2211, 0x1221, 0x2122,
        0x2221, 0x2212, 0x1222, 0x2222, 0x5050, 0x6060, 0x0505, 0x0606,
        0x3030, 0x0303, 0x0130, 0x0310, 0x0330, 0x3100, 0x1300, 0x3300,
        0x0031, 0x0013, 0x0033, 0x3001, 0x1003, 0x3003, 0x0131, 0x0313,
        0x0333, 0x3101, 0x1303, 0x3303, 0x3130, 0x1310, 0x3330, 0x3031,
        0x1013, 0x3033, 0x3131, 0x1313, 0x3333, 0x0440, 0x4400, 0x4004,
        0x0044, -1, -1, -1, 0x1000, 0x0001, 0x0010, 0x0100,
        0x2000, 0x0002, 0x0020, 0x0200, 0x1020, 0x0201, 0x2010, 0x0102,
    ]
    arms[code - 0x2500]
}

fn box_code(arms: i32) -> i32 {
    match arms {
        0x1010 => 0x2500, 0x2020 => 0x2501, 0x0101 => 0x2502, 0x0202 => 0x2503, 0x7070 => 0x2504, 0x8080 => 0x2505, 0x0707 => 0x2506, 0x0808 => 0x2507,
        0x9090 => 0x2508, 0xa0a0 => 0x2509, 0x0909 => 0x250a, 0x0a0a => 0x250b, 0x0110 => 0x250c, 0x0120 => 0x250d, 0x0210 => 0x250e, 0x0220 => 0x250f,
        0x1100 => 0x2510, 0x2100 => 0x2511, 0x1200 => 0x2512, 0x2200 => 0x2513, 0x0011 => 0x2514, 0x0021 => 0x2515, 0x0012 => 0x2516, 0x0022 => 0x2517,
        0x1001 => 0x2518, 0x2001 => 0x2519, 0x1002 => 0x251a, 0x2002 => 0x251b, 0x0111 => 0x251c, 0x0121 => 0x251d, 0x0112 => 0x251e, 0x0211 => 0x251f,
        0x0212 => 0x2520, 0x0122 => 0x2521, 0x0221 => 0x2522, 0x0222 => 0x2523, 0x1101 => 0x2524, 0x2101 => 0x2525, 0x1102 => 0x2526, 0x1201 => 0x2527,
        0x1202 => 0x2528, 0x2102 => 0x2529, 0x2201 => 0x252a, 0x2202 => 0x252b, 0x1110 => 0x252c, 0x2110 => 0x252d, 0x1120 => 0x252e, 0x2120 => 0x252f,
        0x1210 => 0x2530, 0x2210 => 0x2531, 0x1220 => 0x2532, 0x2220 => 0x2533, 0x1011 => 0x2534, 0x2011 => 0x2535, 0x1021 => 0x2536, 0x2021 => 0x2537,
        0x1012 => 0x2538, 0x2012 => 0x2539, 0x1022 => 0x253a, 0x2022 => 0x253b, 0x1111 => 0x253c, 0x2111 => 0x253d, 0x1121 => 0x253e, 0x2121 => 0x253f,
        0x1112 => 0x2540, 0x1211 => 0x2541, 0x1212 => 0x2542, 0x2112 => 0x2543, 0x1122 => 0x2544, 0x2211 => 0x2545, 0x1221 => 0x2546, 0x2122 => 0x2547,
        0x2221 => 0x2548, 0x2212 => 0x2549, 0x1222 => 0x254a, 0x2222 => 0x254b, 0x5050 => 0x254c, 0x6060 => 0x254d, 0x0505 => 0x254e, 0x0606 => 0x254f,
        0x3030 => 0x2550, 0x0303 => 0x2551, 0x0130 => 0x2552, 0x0310 => 0x2553, 0x0330 => 0x2554, 0x3100 => 0x2555, 0x1300 => 0x2556, 0x3300 => 0x2557,
        0x0031 => 0x2558, 0x0013 => 0x2559, 0x0033 => 0x255a, 0x3001 => 0x255b, 0x1003 => 0x255c, 0x3003 => 0x255d, 0x0131 => 0x255e, 0x0313 => 0x255f,
        0x0333 => 0x2560, 0x3101 => 0x2561, 0x1303 => 0x2562, 0x3303 => 0x2563, 0x3130 => 0x2564, 0x1310 => 0x2565, 0x3330 => 0x2566, 0x3031 => 0x2567,
        0x1013 => 0x2568, 0x3033 => 0x2569, 0x3131 => 0x256a, 0x1313 => 0x256b, 0x3333 => 0x256c, 0x0440 => 0x256d, 0x4400 => 0x256e, 0x4004 => 0x256f,
        0x0044 => 0x2570, 0x1000 => 0x2574, 0x0001 => 0x2575, 0x0010 => 0x2576, 0x0100 => 0x2577,
        0x2000 => 0x2578, 0x0002 => 0x2579, 0x0020 => 0x257a, 0x0200 => 0x257b, 0x1020 => 0x257c, 0x0201 => 0x257d, 0x2010 => 0x257e, 0x0102 => 0x257f,
        _ => -1,
    }
}

fn transform(arms: i32, from: i32, to: i32) -> i32 {
    mut out := arms
    for i in 0..4 {
        shift := i * 4
        if arms.shr(shift).bit_and(15) == from { out = out.bit_xor((from.bit_xor(to)).shl(shift)) }
    }
    out
}

pub fn merge(previous: i32, next: i32, strategy: Merge) -> i32 {
    if strategy == .Replace { return next }
    overlay := shape(next)
    if overlay < 0 { return next }
    base := shape(previous)
    if base < 0 { return previous }
    mut arms := overlay
    mut double_overlay := false
    for i in 0..4 {
        shift := 4 * i
        a := overlay.shr(shift).bit_and(15)
        if a == 0 { arms = arms.bit_or(base.bit_and(15.shl(shift))) }
        if a == 3 { double_overlay = true }
    }
    if strategy == .Fuzzy {
        n := arms.bit_and(15)
        e := arms.shr(4).bit_and(15)
        s := arms.shr(8).bit_and(15)
        w := arms.shr(12).bit_and(15)
        straight := n == s && e == w && (n == 0 || e == 0)
        corner := (n == e && s == 0 && w == 0) || (s == e && n == 0 && w == 0) ||
            (s == w && n == 0 && e == 0) || (n == w && e == 0 && s == 0)
        if !straight {
            for dashed in 5..11 { arms = transform(arms, dashed, if dashed % 2 == 1 { 1 } else { 2 }) }
        }
        if !corner { arms = transform(arms, 4, 1) }
        if transform(arms, 2, 0) != arms && transform(arms, 3, 0) != arms {
            arms = if double_overlay { transform(arms, 2, 3) } else { transform(arms, 3, 2) }
        }
        if box_code(arms) < 0 {
            arms = if double_overlay { transform(arms, 1, 3) } else { transform(arms, 3, 1) }
        }
    }
    code := box_code(arms)
    if code < 0 { next } else { code }
}
