import .tui
import .text as rich
import .lines
import std.cmp as cmp
import std.json
import .json_format
import .theme_format

@derive(Eq, Hash)
pub enum BorderType {
    Plain, Rounded, Double, Thick, LightDoubleDashed, HeavyDoubleDashed, LightTripleDashed, HeavyTripleDashed,
    LightQuadrupleDashed, HeavyQuadrupleDashed, QuadrantInside, QuadrantOutside, OneEighthWide, OneEighthTall,
    ProportionalWide, ProportionalTall, Full, Empty,
}

impl Default for BorderType { fn default() -> Self { .Plain } }
impl BorderType {
    pub fn parse(name: string) -> Option<Self> {
        match name {
            "Plain" => .Some(.Plain), "Rounded" => .Some(.Rounded), "Double" => .Some(.Double),
            "Thick" => .Some(.Thick), "LightDoubleDashed" => .Some(.LightDoubleDashed), "HeavyDoubleDashed" => .Some(.HeavyDoubleDashed),
            "LightTripleDashed" => .Some(.LightTripleDashed), "HeavyTripleDashed" => .Some(.HeavyTripleDashed), "LightQuadrupleDashed" => .Some(.LightQuadrupleDashed),
            "HeavyQuadrupleDashed" => .Some(.HeavyQuadrupleDashed), "QuadrantInside" => .Some(.QuadrantInside), "QuadrantOutside" => .Some(.QuadrantOutside),
            _ => .None,
        }
    }
}
impl Display for BorderType {
    fn str(&self) -> string {
        match self {
            .Plain => "Plain", .Rounded => "Rounded", .Double => "Double",
            .Thick => "Thick", .LightDoubleDashed => "LightDoubleDashed", .HeavyDoubleDashed => "HeavyDoubleDashed",
            .LightTripleDashed => "LightTripleDashed", .HeavyTripleDashed => "HeavyTripleDashed", .LightQuadrupleDashed => "LightQuadrupleDashed",
            .HeavyQuadrupleDashed => "HeavyQuadrupleDashed", .QuadrantInside => "QuadrantInside", .QuadrantOutside => "QuadrantOutside",
            .OneEighthWide => "OneEighthWide", .OneEighthTall => "OneEighthTall", .ProportionalWide => "ProportionalWide",
            .ProportionalTall => "ProportionalTall", .Full => "Full", .Empty => "Empty",
        }
    }
}
impl json.Encode for BorderType {
    fn encode_json(&self, out: &mut json.Writer) {
        match self {
            .OneEighthWide | .OneEighthTall | .ProportionalWide | .ProportionalTall | .Full | .Empty => {
                json_format.reject(&mut out,"this symbol set has no Ratatui border type")
            },
            _ => { out.string(self.str()) },
        }
    }
}
impl json.Decode for BorderType {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        name := json_format.unit_name(&doc,node)?
        match BorderType::parse(name) {
            .Some(t) => .Ok(t), .None => .Err(json.JsonError::new("unknown border type",doc.node_offset(node))),
        }
    }
}

pub struct BorderSet { tl: rune, tr: rune, bl: rune, br: rune, left: rune, right: rune, top: rune, bottom: rune }

pub struct BorderSymbols { tl: string, tr: string, bl: string, br: string, left: string, right: string, top: string, bottom: string }

trait StrokeSymbol {
    fn stroke(&self, frame: &mut tui.Frame, area: tui.Rect, style: tui.Style, merge: lines.Merge)
}

impl StrokeSymbol for rune {
    fn stroke(&self, frame: &mut tui.Frame, area: tui.Rect, style: tui.Style, merge: lines.Merge) {
        frame.stroke(area,self,style,merge)
    }
}

impl StrokeSymbol for string {
    fn stroke(&self, frame: &mut tui.Frame, area: tui.Rect, style: tui.Style, merge: lines.Merge) {
        frame.stroke_symbol(area,self,style,merge)
    }
}

const BORDER_GLYPHS: [rune; 144] = [
    `┌`, `┐`, `└`, `┘`, `│`, `│`, `─`, `─`,
    `╭`, `╮`, `╰`, `╯`, `│`, `│`, `─`, `─`,
    `╔`, `╗`, `╚`, `╝`, `║`, `║`, `═`, `═`,
    `┏`, `┓`, `┗`, `┛`, `┃`, `┃`, `━`, `━`,
    `┌`, `┐`, `└`, `┘`, `╎`, `╎`, `╌`, `╌`,
    `┏`, `┓`, `┗`, `┛`, `╏`, `╏`, `╍`, `╍`,
    `┌`, `┐`, `└`, `┘`, `┆`, `┆`, `┄`, `┄`,
    `┏`, `┓`, `┗`, `┛`, `┇`, `┇`, `┅`, `┅`,
    `┌`, `┐`, `└`, `┘`, `┊`, `┊`, `┈`, `┈`,
    `┏`, `┓`, `┗`, `┛`, `┋`, `┋`, `┉`, `┉`,
    `▗`, `▖`, `▝`, `▘`, `▐`, `▌`, `▄`, `▀`,
    `▛`, `▜`, `▙`, `▟`, `▌`, `▐`, `▀`, `▄`,
    `▁`, `▁`, `▔`, `▔`, `▏`, `▕`, `▁`, `▔`,
    `▕`, `▏`, `▕`, `▏`, `▕`, `▏`, `▔`, `▁`,
    `▄`, `▄`, `▀`, `▀`, `█`, `█`, `▄`, `▀`,
    `█`, `█`, `█`, `█`, `█`, `█`, `▀`, `▄`,
    `█`, `█`, `█`, `█`, `█`, `█`, `█`, `█`,
    ` `, ` `, ` `, ` `, ` `, ` `, ` `, ` `,
]

impl BorderSet {
    pub fn from_type(kind: BorderType) -> Self {
        row := match kind {
            .Plain => 0, .Rounded => 1, .Double => 2, .Thick => 3,
            .LightDoubleDashed => 4, .HeavyDoubleDashed => 5, .LightTripleDashed => 6, .HeavyTripleDashed => 7,
            .LightQuadrupleDashed => 8, .HeavyQuadrupleDashed => 9, .QuadrantInside => 10, .QuadrantOutside => 11,
            .OneEighthWide => 12, .OneEighthTall => 13, .ProportionalWide => 14, .ProportionalTall => 15,
            .Full => 16, .Empty => 17,
        }
        i := row * 8
        Self { tl: BORDER_GLYPHS[i], tr: BORDER_GLYPHS[i+1], bl: BORDER_GLYPHS[i+2], br: BORDER_GLYPHS[i+3],
            left: BORDER_GLYPHS[i+4], right: BORDER_GLYPHS[i+5], top: BORDER_GLYPHS[i+6], bottom: BORDER_GLYPHS[i+7] }
    }
}

@derive(Eq, Hash)
pub struct BorderMask { bits: u8 }

impl BorderMask {
    pub fn edges(&self) -> Borders {
        Borders { top:self.bits.bit_and(1) != 0, right:self.bits.bit_and(2) != 0,
            bottom:self.bits.bit_and(4) != 0, left:self.bits.bit_and(8) != 0 }
    }
}

const EDGE_NAMES: [string;4] = ["TOP","RIGHT","BOTTOM","LEFT"]
fn edge_name(i: i32) -> string { EDGE_NAMES[i] }
fn edge_flag(name: string) -> Option<i32> {
    if name == "ALL" { return .Some(15) }
    for i in 0..4 { if name == EDGE_NAMES[i] { return .Some(i32(1).shl(i)) } }
    .None
}

impl json.Encode for BorderMask {
    fn encode_json(&self, out: &mut json.Writer) { out.string(theme_format.format_flags(i32(self.bits),4,edge_name)) }
}
impl json.Decode for BorderMask {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        bits := theme_format.read_flag_set(&doc,node,255,edge_flag)?
        .Ok(Self { bits:u8(bits) })
    }
}

@derive(Eq, Hash)
pub struct Borders { left: bool, right: bool, top: bool, bottom: bool }
impl Borders {
    pub fn mask(&self) -> BorderMask {
        mut bits: u8 = 0
        if self.top { bits += 1 }
        if self.right { bits += 2 }
        if self.bottom { bits += 4 }
        if self.left { bits += 8 }
        BorderMask { bits:bits }
    }
    pub fn all() -> Self { Self { left: true, right: true, top: true, bottom: true } }
    pub fn none() -> Self { Self { left: false, right: false, top: false, bottom: false } }
}

impl json.Encode for Borders {
    fn encode_json(&self, out: &mut json.Writer) { self.mask().encode_json(&mut out) }
}
impl json.Decode for Borders {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        mask := BorderMask::decode_json(&doc,node)?
        if mask.bits > 15 { return .Err(json.JsonError::new("use BorderMask to retain unknown bits",doc.node_offset(node))) }
        .Ok(mask.edges())
    }
}

@derive(Eq, Hash)
pub struct Padding { left: i32, right: i32, top: i32, bottom: i32 }
impl json.Encode for Padding {
    fn encode_json(&self, out: &mut json.Writer) {
        for n in [self.left,self.right,self.top,self.bottom] {
            if n < 0 || n > 65535 { json_format.reject(&mut out,"padding exceeds the 16-bit range"); return }
        }
        out.object()
        json.field_value(&mut out,"left",&self.left)
        json.field_value(&mut out,"right",&self.right)
        json.field_value(&mut out,"top",&self.top)
        json.field_value(&mut out,"bottom",&self.bottom)
        out.end()
    }
}
impl json.Decode for Padding {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        f := json_format.fields(&doc,node,&["left","right","top","bottom"],4,4)?
        .Ok(Self { left:i32(u16::decode_json(&doc,f[0])?), right:i32(u16::decode_json(&doc,f[1])?),
            top:i32(u16::decode_json(&doc,f[2])?), bottom:i32(u16::decode_json(&doc,f[3])?) })
    }
}
impl Padding {
    pub fn uniform(amount: i32) -> Self { Padding::axes(amount, amount) }
    pub fn axes(horizontal: i32, vertical: i32) -> Self { Self { left: horizontal, right: horizontal, top: vertical, bottom: vertical } }
}

pub enum ShadowEffect { Overlay, Symbol(rune), Text(string), Dimmed, Custom(fn(&mut tui.Frame, tui.Rect, tui.Rect)) }
pub struct Shadow { effect: ShadowEffect, style: tui.Style, dx: i32, dy: i32 }
impl Shadow {
    pub fn new(move effect: ShadowEffect) -> Self { Self { effect: move effect, style: tui.plain(), dx: 1, dy: 1 } }

    pub fn symbol(move value: string) -> Self { Shadow::new(.Text(move value)) }

    fn paint(&self, frame: &mut tui.Frame, area: tui.Rect) {
        if area.is_empty() { return }
        match self.effect {
            .Symbol(ch) => { frame.paint_cells(area, ch.str(), self.style) },
            .Text(value) => { frame.paint_cells(area, value, self.style) },
            .Dimmed => { frame.dim_cells(area, self.style) },
            _ => { frame.apply_cell_style(area, self.style) },
        }
    }

    pub fn render(&self, frame: &mut tui.Frame, base: tui.Rect) {
        area := base.offset(self.dx,self.dy).intersection(frame.area())
        overlap := area.intersection(base)
        if overlap.is_empty() {
            self.paint(&mut frame, area)
        } else {
            self.paint(&mut frame, tui.Rect { x:area.x, y:area.y, w:area.w, h:overlap.y-area.y })
            self.paint(&mut frame, tui.Rect { x:area.x, y:overlap.y, w:overlap.x-area.x, h:overlap.h })
            self.paint(&mut frame, tui.Rect { x:overlap.right(), y:overlap.y, w:area.right()-overlap.right(), h:overlap.h })
            self.paint(&mut frame, tui.Rect { x:area.x, y:overlap.bottom(), w:area.w, h:area.bottom()-overlap.bottom() })
        }
        match self.effect { .Custom(apply) => { apply(&mut frame, area, base) }, _ => {}, }
    }
}

pub enum Position { Inherit, Top, Bottom }
pub struct Title { line: rich.Line, position: Position }

pub struct Block {
    borders: Borders, symbols: BorderSet, custom_symbols: Option<BorderSymbols>, merge: lines.Merge, padding: Padding,
    style: tui.Style, border_style: tui.Style, title_style: tui.Style, titles: []Title,
    title_position: Position, title_alignment: rich.Alignment, shadow: Option<Shadow>,
}

impl Block {
    pub fn new() -> Self {
        Self { borders: Borders::none(), symbols: BorderSet::from_type(.Plain), custom_symbols:.None, merge: .Replace, padding: Padding::uniform(0),
            style: tui.plain(), border_style: tui.plain(), title_style: tui.plain(), titles: [],
            title_position: .Top, title_alignment: .Left, shadow: .None }
    }

    pub fn bordered() -> Self { mut block := Block::new(); block.borders = Borders::all(); move block }
    pub fn border_type(move self, kind: BorderType) -> Self { mut b := move self; b.symbols = BorderSet::from_type(kind); b.custom_symbols = .None; move b }
    pub fn border_set(move self, move symbols: BorderSymbols) -> Self {
        mut b := move self
        b.custom_symbols = .Some(move symbols)
        move b
    }
    pub fn title(move self, move value: string) -> Self { self.title_at(.Inherit, rich.Line::raw(move value)) }
    pub fn title_at(move self, position: Position, move line: rich.Line) -> Self {
        mut b := move self
        b.titles.push(Title { line: move line, position: position })
        move b
    }

    fn position(&self, title: &Title) -> Position {
        if title.position != .Inherit { return title.position }
        if self.title_position == .Bottom { .Bottom } else { .Top }
    }

    fn alignment(&self, title: &Title) -> rich.Alignment {
        a := title.line.get_alignment()
        if a != .Inherit { return a }
        if self.title_alignment == .Inherit { .Left } else { self.title_alignment }
    }

    fn vertical_borders(&self) -> (bool,bool) {
        mut top := self.borders.top
        mut bottom := self.borders.bottom
        for i in 0..self.titles.len {
            if self.position(&self.titles[i]) == .Bottom { bottom = true } else { top = true }
        }
        (top,bottom)
    }

    fn space(padding: i32, border: bool) -> i32 {
        i32(cmp.min<i64>(65535,i64(cmp.max<i32>(0,padding)) + (if border { 1 } else { 0 })))
    }

    pub fn horizontal_space(&self) -> (i32,i32) {
        (Block::space(self.padding.left,self.borders.left),Block::space(self.padding.right,self.borders.right))
    }

    pub fn vertical_space(&self) -> (i32,i32) {
        (top,bottom) := self.vertical_borders()
        (Block::space(self.padding.top,top),Block::space(self.padding.bottom,bottom))
    }

    pub fn inner(&self, area: tui.Rect) -> tui.Rect {
        (top,bottom) := self.vertical_borders()
        l := i64(cmp.max<i32>(0, self.padding.left))
        t := i64(cmp.max<i32>(0, self.padding.top))
        left_border := if self.borders.left && area.w > 0 { i64(1) } else { i64(0) }
        top_border := if top && area.h > 0 { i64(1) } else { i64(0) }
        w := i64(area.w) - left_border - l - i64(cmp.max<i32>(0, self.padding.right)) - (if self.borders.right { i64(1) } else { i64(0) })
        h := i64(area.h) - top_border - t - i64(cmp.max<i32>(0, self.padding.bottom)) - (if bottom { i64(1) } else { i64(0) })
        tui.Rect { x: i32(cmp.min<i64>(65535, i64(area.x) + left_border + l)), y: i32(cmp.min<i64>(65535, i64(area.y) + top_border + t)),
            w: i32(cmp.max<i64>(0, w)), h: i32(cmp.max<i64>(0, h)) }
    }

    fn draw_titles(&self, frame: &mut tui.Frame, row: tui.Rect, position: Position, alignment: rich.Alignment) {
        mut available := row
        mut offset := 0
        if alignment == .Center {
            mut width: i64 = -1
            for i in 0..self.titles.len {
                title := &self.titles[i]
                if self.position(&title) == position && self.alignment(&title) == alignment { width = cmp.min<i64>(65535, width + i64(title.line.width()) + 1) }
            }
            if width < 0 { return }
            if width <= i64(row.w) { n := (row.w - i32(width)) / 2; available.x += n; available.w -= n }
            else { offset = (i32(width) - row.w) / 2 }
        }
        for j in 0..self.titles.len {
            if available.w <= 0 { break }
            i := if alignment == .Right { self.titles.len - 1 - j } else { j }
            title := &self.titles[i]
            if self.position(&title) != position || self.alignment(&title) != alignment { continue }
            size := cmp.min<i32>(title.line.width(), available.w)
            n := cmp.max<i32>(0, size - offset)
            x := if alignment == .Right { available.x + available.w - n } else { available.x }
            part := tui.Rect { x: x, y: row.y, w: n, h: 1 }
            frame.apply_cell_style(part, self.title_style)
            if alignment == .Center && offset > 0 {
                title.line.render_aligned(&mut frame, part, .Right)
                offset = cmp.max<i32>(0, offset - n - 1)
            } else if alignment == .Center && size < title.line.width() { title.line.render_aligned(&mut frame, part, .Left) }
            else { title.line.render(&mut frame, part) }
            if alignment == .Right { available.w = cmp.max<i32>(0, available.w - n - 1) }
            else { step := cmp.min<i32>(available.w, n + 1); available.x += step; available.w -= step }
        }
    }

    fn draw_borders<S>(&self, frame: &mut tui.Frame, area: tui.Rect, s: &S) {
        b := self.borders
        l := area.x
        r := l + area.w - 1
        t := area.y
        d := t + area.h - 1
        inset := self.merge != .Replace
        y := t + (if inset && b.top { 1 } else { 0 })
        x := l + (if inset && b.left { 1 } else { 0 })
        h := cmp.max<i32>(0,d - (if inset && b.bottom { 1 } else { 0 })) + 1 - y
        w := cmp.max<i32>(0,r - (if inset && b.right { 1 } else { 0 })) + 1 - x
        if b.left { s.left.stroke(&mut frame, tui.Rect { x: l, y: y, w: 1, h: h }, self.border_style, self.merge) }
        if b.top { s.top.stroke(&mut frame, tui.Rect { x: x, y: t, w: w, h: 1 }, self.border_style, self.merge) }
        if b.right { s.right.stroke(&mut frame, tui.Rect { x: r, y: y, w: 1, h: h }, self.border_style, self.merge) }
        if b.bottom { s.bottom.stroke(&mut frame, tui.Rect { x: x, y: d, w: w, h: 1 }, self.border_style, self.merge) }
        if b.right && b.bottom { s.br.stroke(&mut frame, tui.Rect { x: r, y: d, w: 1, h: 1 }, self.border_style, self.merge) }
        if b.right && b.top { s.tr.stroke(&mut frame, tui.Rect { x: r, y: t, w: 1, h: 1 }, self.border_style, self.merge) }
        if b.left && b.bottom { s.bl.stroke(&mut frame, tui.Rect { x: l, y: d, w: 1, h: 1 }, self.border_style, self.merge) }
        if b.left && b.top { s.tl.stroke(&mut frame, tui.Rect { x: l, y: t, w: 1, h: 1 }, self.border_style, self.merge) }
    }

    pub fn render(&self, frame: &mut tui.Frame, bounds: tui.Rect) -> tui.Rect {
        area := bounds.intersection(frame.area())
        if area.w == 0 || area.h == 0 { return self.inner(area) }
        frame.apply_cell_style(area, self.style)
        match &self.custom_symbols {
            .Some(set) => { self.draw_borders(&mut frame,area,&set) },
            .None => { self.draw_borders(&mut frame,area,&self.symbols) },
        }
        if self.titles.len > 0 {
            b := self.borders
            left := area.x + (if b.left { 1 } else { 0 })
            title_w := cmp.max<i32>(0, area.right() - left - (if b.right { 1 } else { 0 }))
            positions: [Position; 2] = [.Top, .Bottom]
            aligns: [rich.Alignment; 3] = [.Left, .Center, .Right]
            for pos in positions {
                row := tui.Rect { x: left, y: if pos == .Top { area.y } else { area.bottom()-1 }, w: title_w, h: 1 }
                for a in aligns { self.draw_titles(&mut frame, row, pos, a) }
            }
        }
        match &self.shadow { .Some(shadow) => { shadow.render(&mut frame, area) }, _ => {}, }
        self.inner(area)
    }
}
