import std.bytes as bytes

pub struct Brush { fg: i32, bg: i32, bold: bool, reverse: bool }

impl Brush {
    pub fn packed(self) -> i64 {
        mut value := i64(self.fg + 1).bit_or(i64(self.bg + 1).shl(26))
        if self.bold { value = value.bit_or(i64(1).shl(52)) }
        if self.reverse { value = value.bit_or(i64(1).shl(53)) }
        value
    }

    pub fn unpack(value: i64) -> Self {
        Self {
            fg: i32(value.bit_and(0x3ffffff)) - 1, bg: i32(value.shr(26).bit_and(0x3ffffff)) - 1,
            bold: value.shr(52).bit_and(1) != 0, reverse: value.shr(53).bit_and(1) != 0
        }
    }
}

pub fn cursor(out: &mut []u8, x: i32, y: i32) {
    bytes.append_utf8(&mut out, "\x1b[")
    bytes.append_decimal(&mut out, i64(y + 1))
    out.push(b';')
    bytes.append_decimal(&mut out, i64(x + 1))
    out.push(b'H')
}

fn color(out: &mut []u8, code: i32, bg: bool) {
    base := if bg { 40 } else { 30 }
    if code < 0 { bytes.append_decimal(&mut out, i64(base + 9)); return }
    if code < 8 { bytes.append_decimal(&mut out, i64(base + code)); return }
    if code < 16 { bytes.append_decimal(&mut out, i64(base + 60 + code - 8)); return }
    bytes.append_decimal(&mut out, i64(base + 8))
    if code < 256 {
        bytes.append_utf8(&mut out, ";5;")
        bytes.append_decimal(&mut out, i64(code))
    } else {
        bytes.append_utf8(&mut out, ";2;")
        bytes.append_decimal(&mut out, i64(code.shr(16).bit_and(255)))
        out.push(b';')
        bytes.append_decimal(&mut out, i64(code.shr(8).bit_and(255)))
        out.push(b';')
        bytes.append_decimal(&mut out, i64(code.bit_and(255)))
    }
}

pub fn transition(out: &mut []u8, old: Brush, next: Brush) {
    bytes.append_utf8(&mut out, "\x1b[")
    start := out.len
    if old.fg != next.fg { color(&mut out, next.fg, false) }
    if old.bg != next.bg {
        if out.len > start { out.push(b';') }
        color(&mut out, next.bg, true)
    }
    if old.bold != next.bold {
        if out.len > start { out.push(b';') }
        bytes.append_utf8(&mut out, if next.bold { "1" } else { "22" })
    }
    if old.reverse != next.reverse {
        if out.len > start { out.push(b';') }
        bytes.append_utf8(&mut out, if next.reverse { "7" } else { "27" })
    }
    out.push(b'm')
}
