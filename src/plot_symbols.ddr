pub fn braille(mask: i32) -> rune {
    left := mask.bit_and(1) + mask.bit_and(4).shr(1) + mask.bit_and(16).shr(2) + mask.bit_and(64)
    right := mask.bit_and(2).shl(2) + mask.bit_and(8).shl(1) + mask.bit_and(32) + mask.bit_and(128)
    rune(0x2800 + left + right)
}

pub fn quadrant(mask: i32) -> rune {
    cells := [` `,`▘`,`▝`,`▀`,`▖`,`▌`,`▞`,`▛`,`▗`,`▚`,`▐`,`▜`,`▄`,`▙`,`▟`,`█`]
    cells[mask]
}

pub fn sextant(mask: i32) -> rune {
    match mask {
        0 => ` `, 21 => `▌`, 42 => `▐`, 63 => `█`,
        _ => rune(0x1fb00 + mask - 1 - (if mask > 21 { 1 } else { 0 }) - (if mask > 42 { 1 } else { 0 })),
    }
}

pub fn octant(mask: i32) -> rune {
    data := r"##C?]K?]NBQ%?W#%9;?W$?W%?W&?W'%9@?W(?W)?W*?W+%9#?W,?W-?W.?W/BRI?W0?W1?W2?W3?W4?W5?W6?W7?W8?W9?W:?W;?W<?W=?W>?W??W@?WA?WBBRJ?WC?WD?WE?WF?WG?WH?WI?WJ?WK?WL?WM?WN?WO?WP?WQ?WR?WS?WT?WU?WV?WW?WXBQ(?]F?WY?WZ?W[?W\?W]?W^?W_?W`?Wa?Wb?X#?X$?X%?X&?X'%99?X(?X)?X*?X+%9/?X,?X-?X.?X/%9A?X0?X1?X2?X3%9>?X4?X5?X6?X7?X8?X9?X:?X;?X<?X=?X>?X??X@?XA?XB?XC?XD?XE?XF?XG?XH?XI?XJ?XK?XL?XM?XN?XO?XP?XQ?XR?XS?]C?XT?XU?XV?XW?XX?XY?XZ?X[?X\?X]?X^?X_?X`?Xa?Xb?Y#?Y$?Y%?Y&?Y'?Y(?Y)?Y*?Y+?Y,?Y-?Y.?Y/?Y0?Y1?Y2%9:?Y3?Y4?Y5?Y6%9=?Y7?Y8?Y9?Y:%93?Y;?Y<?Y=?Y>%9??Y??Y@?YA?YB?YC?YD?YE?YF?YG?YH?YI?YJ?YK?YL?YM?YN%9%?YO?YP?YQ?YR?YS?YT?YU?YV?YW?YX?YY?YZ?Y[?Y\?Y]?Y^?Y_?Y`?Ya?Yb?Z#?Z$?Z%?Z&?Z'?Z(?Z)?Z*?Z+?Z,?Z-?Z.?Z/?Z0?Z1?Z2?Z3?Z4?Z5?Z6?Z7?Z8?Z9?Z:?Z;?Z<?Z=%9'?Z>?Z??Z@?ZA%9<?ZB?ZC?ZD?ZE%9B?ZF%9)?ZG?ZH%9+"
    i := mask*3
    rune((i32(data[i])-35)*4096 + (i32(data[i+1])-35)*64 + i32(data[i+2])-35)
}
