import .width_data
import std.terminal as terminal

const CR: i32 = 1
const LF: i32 = 2
const CONTROL: i32 = 3
const EXTEND: i32 = 4
const ZWJ: i32 = 5
const RI: i32 = 6
const PREPEND: i32 = 7
const SPACING: i32 = 8
const L: i32 = 9
const V: i32 = 10
const T: i32 = 11
const LV: i32 = 12
const LVT: i32 = 13
const EMOJI_PRESENTATION: i32 = 512
const MODIFIER_BASE: i32 = 1024
const VARIATION_BASE: i32 = 2048

fn pair(table: string, i: i32) -> i32 {
    (i32(table[i * 2]) - 35) * 64 + i32(table[i * 2 + 1]) - 35
}

fn property(cp: i32) -> i32 {
    if cp < 256 { return pair(width_data.latin1(), cp) }
    page := pair(width_data.pages(), cp.shr(10))
    group := pair(width_data.groups(), page * 32 + cp.shr(5).bit_and(31))
    state := i32(width_data.states()[group * 32 + cp.bit_and(31)]) - 35
    pair(width_data.values(), state)
}

pub fn columns(cp: i32) -> i32 {
    if cp < 32 || (cp >= 127 && cp < 160) || (cp >= 0xd800 && cp <= 0xdfff) || cp > 0x10ffff { return -1 }
    if cp < 127 || (cp >= 0x2500 && cp <= 0x259f) { return 1 }
    if (cp >= 0x2800 && cp <= 0x28ff) || (cp >= 0x1fb00 && cp <= 0x1fb3b) || (cp >= 0x1cd00 && cp <= 0x1cde5) { return 1 }
    property(cp).shr(7).bit_and(3)
}

pub fn whitespace(cp: i32) -> bool {
    (cp >= 9 && cp <= 13) || cp == 32 || cp == 0x85 || cp == 0xa0 || cp == 0x1680 ||
        (cp >= 0x2000 && cp <= 0x200a) || cp == 0x2028 || cp == 0x2029 || cp == 0x202f || cp == 0x205f || cp == 0x3000
}

pub fn next_visible_byte(value: &str, start: i32) -> i32 {
    mut offset := start
    while offset < value.len {
        first := value[offset]
        if first < 32 || first == 127 { offset += 1 }
        else if first == 194 && value[offset+1] < 160 { offset += 2 }
        else { break }
    }
    offset
}

pub fn encoded(cp: i32) -> i32 {
    if cp < 128 { return 1 }
    if cp < 2048 { return 2 }
    if cp < 65536 { return 3 }
    4
}

fn scalar_at(value: &str, offset: i32) -> i32 {
    first := i32(value[offset])
    if first < 128 { return first }
    assert(first >= 194)
    second := i32(value[offset+1]).bit_and(63)
    if first < 224 { return first.bit_and(31).shl(6) + second }
    third := i32(value[offset+2]).bit_and(63)
    if first < 240 { return first.bit_and(15).shl(12) + second.shl(6) + third }
    first.bit_and(7).shl(18) + second.shl(12) + third.shl(6) + i32(value[offset+3]).bit_and(63)
}

pub struct CellCursor { end: i32, cells: i32, scalar: i32, props: i32 }

impl CellCursor {
    pub fn at(value: &str, start: i32) -> Self {
        cp := scalar_at(value, start)
        Self { end:start, cells:0, scalar:cp, props:property(cp) }
    }
    pub fn advance(&mut self, value: &str) {
        start := self.end
        cp := self.scalar
        self.cells = if cp < 32 || (cp >= 127 && cp < 160) { -1 } else { self.props.shr(7).bit_and(3) }
        self.end += encoded(cp)
        mut state := BreakState::first(self.props)
        mut contextual := false
        while self.end < value.len {
            self.scalar = scalar_at(value, self.end)
            self.props = property(self.scalar)
            joined_emoji := state.emoji_join
            if !state.advance(self.props) { break }
            if self.cells >= 0 { self.cells += self.props.shr(7).bit_and(3) }
            if presentation_change(self.scalar, joined_emoji) || script_candidate(self.scalar) { contextual = true }
            self.end += encoded(self.scalar)
        }
        if contextual || self.cells >= 65535 { self.cells = cell_columns_view(&value[start..self.end]) }
    }
}

pub fn next_cell(value: &str, start: i32, cells: &mut i32) -> i32 {
    mut cursor := CellCursor::at(value, start)
    cursor.advance(value)
    cells = cursor.cells
    cursor.end
}

pub struct Glyph { end: i32, bytes: i32, span: i32, saved: i32 }

fn joining(cp: i32) -> i32 {
    ranges := width_data.joining()
    mut low := 0
    mut high := ranges.len / 9
    while low < high {
        mid := (low + high) / 2
        at := mid * 9
        end := pair_at(ranges, at + 4)
        if cp > end { low = mid + 1 }
        else if cp < pair_at(ranges, at) { high = mid }
        else { return i32(ranges[at + 8]) - 35 }
    }
    0
}

fn pair_at(data: string, at: i32) -> i32 {
    high := (i32(data[at]) - 35) * 64 + i32(data[at + 1]) - 35
    low := (i32(data[at + 2]) - 35) * 64 + i32(data[at + 3]) - 35
    high * 4096 + low
}

fn tifinagh(cp: i32) -> bool { (cp >= 0x2d31 && cp <= 0x2d65) || cp == 0x2d6f }

fn coeng_letter(cp: i32) -> bool {
    if cp < 0x1780 || cp > 0x17af { return false }
    cp <= 0x1782 || (cp >= 0x1784 && cp <= 0x1787) || (cp >= 0x1789 && cp <= 0x178c) ||
    (cp >= 0x178e && cp <= 0x1793) || (cp >= 0x1795 && cp <= 0x1798) || (cp >= 0x179b && cp <= 0x179d) ||
    cp == 0x17a0 || cp == 0x17a2 || cp == 0x17a7 || cp == 0x17ab || cp == 0x17ac || cp == 0x17af
}

pub fn script_candidate(cp: i32) -> bool {
    if cp < 0x05dc { return false }
    (cp <= 0x0882 && (cp == 0x05dc || cp >= 0x0622)) || coeng_letter(cp) || cp == 0x1a10 || tifinagh(cp) ||
    cp == 0xa4fc || cp == 0xa4fd || cp == 0x10c03 || cp == 0x16d67 || cp == 0x16d68
}

enum Suffix { None, Alef, Lamed, Khmer, Buginese, BugineseI, Tifinagh, TifinaghJoiner, Lisu, Turkic, KiratE, KiratAi }

fn suffix(cp: i32) -> Suffix {
    if cp == 0x05dc { return .Lamed }
    if cp >= 0x0622 && cp <= 0x0882 && joining(cp).bit_and(2) != 0 { return .Alef }
    if coeng_letter(cp) { return .Khmer }
    if cp == 0x1a10 { return .Buginese }
    if tifinagh(cp) { return .Tifinagh }
    if cp == 0xa4fc || cp == 0xa4fd { return .Lisu }
    if cp == 0x10c03 { return .Turkic }
    if cp == 0x16d67 { return .KiratE }
    if cp == 0x16d68 { return .KiratAi }
    .None
}

pub fn script_savings(chars: &[]rune, start: i32, end: i32) -> i32 {
    mut at := end
    mut tail := Suffix.None
    mut zwj := false
    mut saved := 0
    while at > start {
        at -= 1
        cp := i32(chars[at])
        if tail != .None {
            if tail == .Alef {
                flags := joining(cp)
                if flags.bit_and(4) != 0 { continue }
                if flags.bit_and(1) != 0 { saved += 1; tail = .None; continue }
            } else if tail == .KiratE || tail == .KiratAi {
                if cp == 0x16d63 || (tail == .KiratE && cp == 0x16d69) { saved += 1; tail = .None; continue }
                if tail == .KiratE && cp == 0x16d67 { saved += 1; tail = .KiratAi; continue }
                if tail == .KiratE && cp == 0x16d68 { continue }
            } else {
                if cp == 0x200d { zwj = true; continue }
                if cp >= 0x034f && joining(cp).bit_and(8) != 0 { continue }
                if tail == .Tifinagh && cp == 0x2d7f { tail = .TifinaghJoiner; continue }
                if tail == .Buginese && cp == 0x1a17 && zwj { tail = .BugineseI; continue }
                current := tail
                match current {
                    .Lamed if zwj && cp == 0x05d0 => { saved += 1 },
                    .Khmer if cp == 0x17d2 => { saved += 1 },
                    .BugineseI if cp == 0x1a15 => { saved += 1 },
                    .Tifinagh if zwj && tifinagh(cp) => { saved += 1 },
                    .TifinaghJoiner if tifinagh(cp) => { saved += 2 },
                    .Lisu if cp >= 0xa4f8 && cp <= 0xa4fb => { saved += 1 },
                    .Turkic if zwj && cp == 0x10c32 => { saved += 1 },
                    _ => { tail = suffix(cp); zwj = false; continue },
                }
                tail = .None
                continue
            }
        }
        tail = suffix(cp)
        zwj = false
    }
    saved
}

fn control(kind: i32) -> bool { kind >= CR && kind <= CONTROL }

fn joins(before: i32, after: i32, indic: i32, emoji_join: bool, regional: i32, props: i32) -> bool {
    if before == CR && after == LF { return true }
    if control(before) || control(after) { return false }
    if before == L && (after == L || after == V || after == LV || after == LVT) { return true }
    if (before == LV || before == V) && (after == V || after == T) { return true }
    if (before == LVT || before == T) && after == T { return true }
    if after == EXTEND || after == ZWJ || after == SPACING || before == PREPEND { return true }
    if indic == 2 && props.shr(4).bit_and(3) == 1 { return true }
    if emoji_join && props.bit_and(64) != 0 { return true }
    before == RI && after == RI && regional.bit_and(1) == 1
}

struct BreakState { kind: i32, indic: i32, emoji_tail: bool, emoji_join: bool, regional: i32 }

impl BreakState {
    fn first(props: i32) -> Self {
        kind := props.bit_and(15)
        Self { kind:kind, indic:if props.shr(4).bit_and(3) == 1 { 1 } else { 0 },
            emoji_tail:props.bit_and(64) != 0, emoji_join:false, regional:if kind == RI { 1 } else { 0 } }
    }
    fn advance(&mut self, props: i32) -> bool {
        after := props.bit_and(15)
        if !joins(self.kind,after,self.indic,self.emoji_join,self.regional,props) { return false }
        incb := props.shr(4).bit_and(3)
        if incb == 1 { self.indic = 1 } else if incb == 3 && self.indic > 0 { self.indic = 2 } else if incb != 2 { self.indic = 0 }
        self.emoji_join = after == ZWJ && self.emoji_tail
        self.emoji_tail = props.bit_and(64) != 0 || (after == EXTEND && self.emoji_tail)
        self.regional = if after == RI { self.regional+1 } else { 0 }
        self.kind = after
        true
    }
}

fn presentation_change(cp: i32, joined_emoji: bool) -> bool {
    cp == 0xfe0f || cp == 0xfe0e || cp == 0xfe01 || skin_tone(cp) || joined_emoji
}

fn skin_tone(cp: i32) -> bool { cp >= 0x1f3fb && cp <= 0x1f3ff }

fn presentation_width(chars: &[]rune, start: i32, end: i32) -> i32 {
    mut total := 0
    mut at := start
    mut previous_emoji := false
    mut joined := false
    while at < end {
        cp := i32(chars[at])
        at += 1
        if cp == 0x200d {
            joined = previous_emoji
            previous_emoji = false
            continue
        }
        props := property(cp)
        mut cells := props.shr(7).bit_and(3)
        mut emoji := props.bit_and(EMOJI_PRESENTATION) != 0 && cells == 2
        if at < end {
            next := i32(chars[at])
            if next == 0xfe0f && props.bit_and(VARIATION_BASE) != 0 {
                cells = 2
                emoji = true
                at += 1
                if at < end && i32(chars[at]) == 0x20e3 && (cp == 35 || cp == 42 || (cp >= 48 && cp <= 57)) { at += 1 }
            } else if next == 0xfe0e && emoji && props.bit_and(VARIATION_BASE) != 0 && (cp < 0x1f200 || cp > 0x1f2ff) {
                cells = 1
                emoji = false
                at += 1
            } else if skin_tone(next) && props.bit_and(MODIFIER_BASE) != 0 {
                cells = 2
                emoji = true
                at += 1
            } else if next == 0xfe01 && (cp == 0x2018 || cp == 0x2019 || cp == 0x201c || cp == 0x201d) {
                cells = 2
                at += 1
            }
        }
        if !joined || !emoji { total += cells }
        previous_emoji = emoji
        joined = false
    }
    total
}

pub fn glyph(chars: &[]rune, start: i32) -> Glyph {
    first := i32(chars[start])
    mut out := Glyph { end: start + 1, bytes: encoded(first), span: columns(first), saved: 0 }
    if out.end == chars.len { return out }
    if first < 127 && first != 13 && i32(chars[out.end]) < 127 { return out }
    mut state := BreakState::first(property(first))
    mut presentation := false
    mut script := false
    while out.end < chars.len {
        cp := i32(chars[out.end])
        next := property(cp)
        joined_emoji := state.emoji_join
        if !state.advance(next) { break }
        if script_candidate(cp) { script = true }
        if presentation_change(cp, joined_emoji) { presentation = true }
        if out.span >= 0 { out.span += next.shr(7).bit_and(3) }
        out.end += 1
        out.bytes += encoded(cp)
    }
    if presentation { out.span = presentation_width(&chars, start, out.end) }
    if script { out.saved = script_savings(&chars, start, out.end); out.span -= out.saved }
    out
}

pub fn measured_columns(value: &str) -> i32 {
    match terminal.columns(value) {
        .Some(n) => { return n },
        .None => {},
    }
    mut total := 0
    mut start := 0
    mut at := 0
    mut previous_cr := false
    for scalar in value.runes() {
        cp := i32(scalar)
        if cp < 32 || (cp >= 127 && cp < 160) {
            if start < at { total += terminal.columns(&value[start..at]).unwrap() }
            if cp != 10 || !previous_cr { total += 1 }
            start = at+encoded(cp)
        }
        previous_cr = cp == 13
        at += encoded(cp)
    }
    if start < at { total += terminal.columns(&value[start..at]).unwrap() }
    total
}

pub fn cell_columns(value: string) -> i32 {
    cell_columns_view(value.as_str())
}

pub fn cell_columns_view(value: &str) -> i32 {
    if value.len == 1 { return 1 }
    measured := measured_columns(value)
    if measured <= 65535 { return measured }
    mut marks := 0
    for cp in value.runes() { if cp == rune(0xff9e) || cp == rune(0xff9f) { marks += 1 } }
    cells := (measured-marks).bit_and(65535) + marks.bit_and(65535)
    if cells >= 65535 { 65535 } else { cells }
}
