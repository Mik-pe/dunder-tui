import .tui
import .block as box
import .repetition
import std.text as strings
import std.text.view as views
import std.bytes as bytes
import std.array as array
import std.cmp as cmp
import .width
import std.hash as hashing
import std.json
import .json_format

@derive(Eq, Hash)
pub enum Alignment { Inherit, Left, Center, Right }

impl Default for Alignment { fn default() -> Self { .Left } }
impl Display for Alignment {
    fn str(&self) -> string {
        match self { .Inherit => "Inherit", .Left => "Left", .Center => "Center", .Right => "Right", }
    }
}
impl Alignment {
    pub fn parse(name: string) -> Option<Self> {
        match name { "Left" => .Some(.Left), "Center" => .Some(.Center), "Right" => .Some(.Right), _ => .None, }
    }
}
impl json.Encode for Alignment {
    fn encode_json(&self, out: &mut json.Writer) {
        if self == .Inherit { json_format.reject(&mut out,"an inherited alignment has no explicit direction"); return }
        out.string(self.str())
    }
}
impl json.Decode for Alignment {
    fn decode_json(doc: &json.Doc, node: i32) -> Result<Self,json.JsonError> {
        name := json_format.unit_name(&doc,node)?
        match Alignment::parse(name) {
            .Some(a) => .Ok(a), .None => .Err(json.JsonError::new("unknown horizontal alignment",doc.node_offset(node))),
        }
    }
}

pub enum Wrap { Clip, Preserve, Trim }
pub enum WideWrap { NextLine, Overhang }

pub fn masked(value: string, mask: rune) -> string {
    mut count := 0
    for i in 0..value.len { if value[i].bit_and(192) != 128 { count += 1 } }
    mut piece := mask.str()
    mut result := ""
    while count > 0 {
        if count.bit_and(1) != 0 { result = result + piece }
        count /= 2
        if count > 0 { piece = piece + piece }
    }
    move result
}

@derive(Eq, Hash)
pub opaque struct Masked { source: string, mask: rune }

impl Default for Masked { fn default() -> Self { Masked::new("",rune(0)) } }
impl Display for Masked { fn str(&self) -> string { self.value() } }

impl Masked {
    pub fn new(move value: string, mask: rune) -> Self { Self { source:move value, mask:mask } }
    pub fn mask_char(&self) -> rune { self.mask }
    pub fn source(&self) -> &str from self { self.source.as_str() }
    pub fn value(&self) -> string { masked(self.source,self.mask) }
}

fn style_hash(colors: i64, attributes: i64) -> u64 { hashing.combine(colors.hash(),attributes.hash()) }

fn store_style<T>(node: &mut T, style: &tui.Style) {
    node.colors = style.packed_colors()
    node.attributes = style.packed_attributes()
}

pub opaque struct Span { glyphs: tui.GlyphRun, colors: i64, attributes: i64 }

pub opaque struct StyledGrapheme { source: &string, start: i32, end: i32, style: tui.Style }

impl Eq for StyledGrapheme {
    fn eq(&self, other: &Self) -> bool { self.symbol() == other.symbol() && self.style == other.style }
}

impl Hash for StyledGrapheme {
    fn hash(&self) -> u64 {
        mut hash := hashing.Hasher::new()
        hash.write_bytes(self.symbol().as_bytes())
        hash.write_u64(self.style.hash())
        hash.finish()
    }
}

impl StyledGrapheme {
    pub fn new(symbol: &string, style: tui.Style) -> Self from symbol {
        Self { source: symbol, start: 0, end: symbol.len, style: style }
    }
    pub fn symbol(&self) -> &str from self { &self.source[self.start..self.end] }
    pub fn get_style(&self) -> &tui.Style from self { &self.style }
    pub fn set_style(&mut self, style: tui.Style) { self.style = style }
    pub fn is_whitespace(&self) -> bool {
        value := self.symbol()
        if value == "\u{200b}" { return true }
        if value == "\u{a0}" { return false }
        for ch in value.runes() { if !width.whitespace(i32(ch)) { return false } }
        true
    }
}

pub opaque struct SpanGraphemes { span: &Span, index: i32, offset: i32, style: tui.Style }

impl Iterator for SpanGraphemes {
    fn next(&mut self) -> Option<StyledGrapheme> from self {
        if self.index == self.span.count() { return .None }
        start := width.next_visible_byte(self.span.content(),self.offset)
        self.offset = start + self.span.glyphs.symbol_bytes_at(self.index)
        self.index += 1
        .Some(StyledGrapheme { source: self.span.glyphs.source_string(), start: start, end: self.offset, style: self.style })
    }
}

impl Eq for Span {
    fn eq(&self, other: &Self) -> bool {
        self.colors == other.colors && self.attributes == other.attributes && self.content() == other.content()
    }
}
impl Hash for Span {
    fn hash(&self) -> u64 {
        hashing.combine(style_hash(self.colors,self.attributes),self.glyphs.source_string().hash())
    }
}
impl Display for Span { fn str(&self) -> string { self.to_string() } }

impl Default for Span { fn default() -> Self { Span::raw("") } }

impl tui.BufferText for Span {
    fn buffer_width(&self) -> i32 { self.width() }
    fn write_buffer(&self, buffer: &mut tui.Buffer, x: i32, y: i32, limit: i32) -> (i32,i32) {
        self.glyphs.write_buffer(&mut buffer, x, y, limit, self.get_style())
    }
}

impl Span {
    pub fn from_display<T: Display>(value: &T) -> Self { Self::raw(value.str()) }
    pub fn raw(move value: string) -> Self { Self { glyphs: tui.GlyphRun::new(move value), colors:0, attributes:0 } }
    pub fn styled(move value: string, style: tui.Style) -> Self { Self { glyphs: tui.GlyphRun::new(move value), colors: style.packed_colors(), attributes: style.packed_attributes() } }
    pub fn width(&self) -> i32 { self.glyphs.text_width() }
    pub fn content(&self) -> &str from self { self.glyphs.content() }
    pub fn set_content(&mut self, move value: string) { self.glyphs = tui.GlyphRun::new(move value) }
    pub fn get_style(&self) -> tui.Style { tui.Style::from_packed(self.colors,self.attributes) }
    pub fn styled_graphemes(&self, base: tui.Style) -> SpanGraphemes from self {
        SpanGraphemes { span: &self, index: 0, offset: 0, style: base.patch(self.get_style()) }
    }
    pub fn visit_graphemes<S>(&self, base: tui.Style, state: &mut S, visit: fn(&mut S,&str,&tui.Style) -> bool) -> bool {
        style := base.patch(self.get_style())
        source := self.content()
        count := self.count()
        if count == source.len {
            for i in 0..count { if !visit(&mut state,&source[i..i+1],&style) { return false } }
            return true
        }
        mut end := 0
        for index in 0..count {
            start := width.next_visible_byte(source,end)
            end = start + self.glyphs.symbol_bytes_at(index)
            if !visit(&mut state,&source[start..end],&style) { return false }
        }
        true
    }
    pub fn set_style(&mut self, style: tui.Style) { store_style(&mut self,&style) }
    pub fn patch_style(&mut self, style: tui.Style) { self.set_style(self.get_style().patch(style)) }
    pub fn reset_style(&mut self) { self.set_style(tui.Style::reset()) }
    fn append_content(&self, out: &mut []u8) {
        source := self.content()
        mut start := 0
        for i in 0..source.len {
            if source[i] != 10 { continue }
            end := if i > start && source[i-1] == 13 { i-1 } else { i }
            if end > start { bytes.extend_range(&mut out, source.as_bytes(),start,end) }
            start = i+1
        }
        if start == 0 { bytes.append_utf8(&mut out,self.glyphs.source_string()) }
        else if start < source.len { bytes.extend_range(&mut out,source.as_bytes(),start,source.len) }
    }
    pub fn to_string(&self) -> string {
        if !views.contains(self.content(),"\n") { return self.glyphs.source_string().clone() }
        mut out: []u8 = []
        self.append_content(&mut out)
        bytes.decode(&out).unwrap()
    }
    fn count(&self) -> i32 { self.glyphs.count() }
}

struct Token { span: i32, start: i32, end: i32, cells: i32, space: bool }

pub opaque struct Line { spans: []Span, columns: i32, colors: i64, attributes: i64, alignment: Alignment }

impl tui.BufferText for Line {
    fn buffer_width(&self) -> i32 { self.width() }
    fn write_buffer(&self, buffer: &mut tui.Buffer, x: i32, y: i32, limit: i32) -> (i32,i32) {
        mut col := x
        base := self.get_style()
        for span in &self.spans {
            left := limit - (col - x)
            if left <= 0 { break }
            (end, _) := span.glyphs.write_buffer(&mut buffer, col, y, left, base.patch(span.get_style()))
            col = end
        }
        (col, y)
    }
}

fn spans_width(spans: &[]Span) -> i32 {
    mut columns := 0
    for span in &spans { columns += span.width() }
    columns
}

pub opaque struct LineGraphemes { spans: &[]Span, index: i32, glyph: i32, offset: i32, base: tui.Style, style: tui.Style }

impl Iterator for LineGraphemes {
    fn next(&mut self) -> Option<StyledGrapheme> from self {
        while self.index < self.spans.len {
            if self.glyph < self.spans[self.index].count() {
                if self.glyph == 0 { self.style = self.base.patch(self.spans[self.index].get_style()) }
                start := width.next_visible_byte(self.spans[self.index].content(),self.offset)
                self.offset = start + self.spans[self.index].glyphs.symbol_bytes_at(self.glyph)
                self.glyph += 1
                return .Some(StyledGrapheme { source: self.spans[self.index].glyphs.source_string(), start: start, end: self.offset, style: self.style })
            }
            self.index += 1
            self.glyph = 0
            self.offset = 0
        }
        .None
    }
}

impl Eq for Line {
    fn eq(&self, other: &Self) -> bool {
        self.colors == other.colors && self.attributes == other.attributes &&
            self.alignment == other.alignment && self.spans == other.spans
    }
}
impl Hash for Line {
    fn hash(&self) -> u64 {
        header := hashing.combine(style_hash(self.colors,self.attributes),self.alignment.hash())
        hashing.combine(header,self.spans.hash())
    }
}
impl Display for Line { fn str(&self) -> string { self.to_string() } }

impl Default for Line { fn default() -> Self { Line::new([]) } }

impl Line {
    pub fn from_display<T: Display>(value: &T) -> Self { Self::raw(value.str()) }
    pub fn repeat(move span: Span, count: i32) -> Self {
        Line::new(repetition.collect(move span,count))
    }

    pub fn strings(move values: []string) -> Self {
        mut spans: []Span = []
        spans.reserve(values.len)
        for value in move values { spans.push(Span::raw(move value)) }
        Line::new(move spans)
    }

    pub fn raw(move value: string) -> Self {
        if value.len == 0 { return Line::new([]) }
        if !views.contains(value.as_str(),"\n") { return Line::new([Span::raw(move value)]) }
        mut spans: []Span = []
        mut rows := strings.lines(value.as_str())
        while rows.advance() { spans.push(Span::raw(rows.current().to_string())) }
        Line::new(move spans)
    }
    pub fn new(move spans: []Span) -> Self {
        columns := spans_width(&spans)
        Self { spans: move spans, columns: columns, colors:0, attributes:0, alignment: .Inherit }
    }
    pub fn styled(move self, style: tui.Style) -> Self { mut line := move self; line.set_style(style); move line }
    pub fn align(move self, alignment: Alignment) -> Self { mut line := move self; line.alignment = alignment; move line }
    pub fn width(&self) -> i32 {
        if self.columns >= 0 { return self.columns }
        spans_width(&self.spans)
    }
    pub fn spans(&self) -> &[]Span from self { &self.spans }
    pub fn spans_mut(&mut self) -> &mut []Span from self {
        self.columns = -1
        &mut self.spans
    }
    pub fn into_spans(move self) -> []Span { move self.spans }
    pub fn replace_spans(&mut self, move spans: []Span) -> []Span {
        self.columns = spans_width(&spans)
        replace(&mut self.spans, move spans)
    }
    pub fn set_alignment(&mut self, alignment: Alignment) { self.alignment = alignment }
    pub fn styled_graphemes(&self, base: tui.Style) -> LineGraphemes from self {
        LineGraphemes { spans: &self.spans, index: 0, glyph: 0, offset: 0, base: base.patch(self.get_style()), style: tui.plain() }
    }
    pub fn visit_graphemes<S>(&self, base: tui.Style, state: &mut S, visit: fn(&mut S,&str,&tui.Style) -> bool) -> bool {
        style := base.patch(self.get_style())
        for span in &self.spans {
            if !span.visit_graphemes(style,&mut state,visit) { return false }
        }
        true
    }
    pub fn span_mut(&mut self, index: i32) -> &mut Span from self {
        self.columns = -1
        &mut self.spans[index]
    }
    pub fn push_span(&mut self, move span: Span) {
        if self.columns >= 0 { self.columns += span.width() }
        self.spans.push(move span)
    }
    pub fn get_style(&self) -> tui.Style { tui.Style::from_packed(self.colors,self.attributes) }
    pub fn set_style(&mut self, style: tui.Style) { store_style(&mut self,&style) }
    pub fn patch_style(&mut self, style: tui.Style) { self.set_style(self.get_style().patch(style)) }
    pub fn reset_style(&mut self) { self.set_style(tui.Style::reset()) }
    fn append_content(&self, out: &mut []u8) {
        for span in &self.spans { span.append_content(&mut out) }
    }
    pub fn into_string(move self) -> string {
        if self.spans.len == 1 { return self.spans[0].glyphs.source_string().clone() }
        mut out: []u8 = []
        for span in &self.spans { bytes.append_utf8(&mut out,span.glyphs.source_string()) }
        bytes.decode(&out).unwrap()
    }
    pub fn to_string(&self) -> string {
        if self.spans.len == 1 { return self.spans[0].to_string() }
        mut out: []u8 = []
        self.append_content(&mut out)
        bytes.decode(&out).unwrap()
    }
}

struct ParagraphLine { content: Line, starts: []i32, ends: []i32, groups: []i32, count: i32 }

impl ParagraphLine {
    fn new(move line: Line) -> Self {
        mut starts: []i32 = []
        mut ends: []i32 = []
        mut groups: []i32 = []
        mut was_space := false
        mut count := 0
        mut columns := 0
        for i in 0..line.spans.len {
            starts.push(count)
            count += line.spans[i].count()
            for j in 0..line.spans[i].count() {
                columns += line.spans[i].glyphs.width_at(j)
                space := line.spans[i].glyphs.space_at(j)
                if ends.len > 0 && space != was_space { groups.push(ends.len) }
                ends.push(if space { -1 - columns } else { columns })
                was_space = space
            }
        }
        groups.push(ends.len)
        Self { content: move line, starts: move starts, ends: move ends, groups: move groups, count: count }
    }

    fn before(&self, at: i32) -> i32 {
        if at == 0 { return 0 }
        value := self.ends[at - 1]
        if value < 0 { -1 - value } else { value }
    }

    fn span_at(&self, at: i32) -> i32 {
        mut first := 0
        mut end := self.content.spans.len
        while first + 1 < end {
            mid := first + (end - first) / 2
            if self.starts[mid] <= at { first = mid } else { end = mid }
        }
        first
    }

    fn token(&self, at: i32) -> Token {
        first := self.span_at(at)
        index := at - self.starts[first]
        span := &self.content.spans[first]
        Token { span: first, start: index, end: index + 1, cells: span.glyphs.width_at(index), space: span.glyphs.space_at(index) }
    }
}

pub opaque struct Text { lines: []Line, columns: i32, colors: i64, attributes: i64, alignment: Alignment }

pub trait IntoText { fn into_text(move self) -> Text }

impl IntoText for Masked { fn into_text(move self) -> Text { Text::raw(self.value()) } }
impl IntoText for string { fn into_text(move self) -> Text { Text::raw(move self) } }
impl IntoText for Span { fn into_text(move self) -> Text { Text::new([Line::new([move self])]) } }
impl IntoText for Line { fn into_text(move self) -> Text { Text::new([move self]) } }
impl IntoText for Text { fn into_text(move self) -> Text { move self } }
impl IntoText for []Line { fn into_text(move self) -> Text { Text::new(move self) } }

fn lines_width(lines: &[]Line) -> i32 {
    mut columns := 0
    for line in &lines { columns = cmp.max<i32>(columns, line.width()) }
    columns
}

impl Eq for Text {
    fn eq(&self, other: &Self) -> bool {
        self.colors == other.colors && self.attributes == other.attributes &&
            self.alignment == other.alignment && self.lines == other.lines
    }
}
impl Hash for Text {
    fn hash(&self) -> u64 {
        header := hashing.combine(style_hash(self.colors,self.attributes),self.alignment.hash())
        hashing.combine(header,self.lines.hash())
    }
}
impl Display for Text { fn str(&self) -> string { self.to_string() } }

impl Default for Text { fn default() -> Self { Text::new([]) } }

impl Text {
    pub fn from_display<T: Display>(value: &T) -> Self { Self::raw(value.str()) }
    pub fn repeat(move line: Line, count: i32) -> Self {
        Text::new(repetition.collect(move line,count))
    }

    pub fn strings(move values: []string) -> Self {
        mut lines: []Line = []
        lines.reserve(values.len)
        for value in move values { lines.push(Line::raw(move value)) }
        Text::new(move lines)
    }

    pub fn new(move lines: []Line) -> Self {
        columns := lines_width(&lines)
        Self { lines: move lines, columns: columns, colors:0, attributes:0, alignment: .Inherit }
    }

    pub fn raw(move value: string) -> Self {
        if value.len == 0 { return Text::new([Line::new([])]) }
        if !views.contains(value.as_str(),"\n") { return Text::new([Line::new([Span::raw(move value)])]) }
        mut lines: []Line = []
        mut rows := strings.lines(value.as_str())
        while rows.advance() {
            row := rows.current()
            if row.len == 0 { lines.push(Line::new([])) }
            else { lines.push(Line::new([Span::raw(row.to_string())])) }
        }
        Text::new(move lines)
    }

    pub fn styled(move self, style: tui.Style) -> Self { mut doc := move self; doc.set_style(style); move doc }
    pub fn align(move self, alignment: Alignment) -> Self { mut doc := move self; doc.alignment = alignment; move doc }
    pub fn width(&self) -> i32 {
        if self.columns >= 0 { return self.columns }
        lines_width(&self.lines)
    }
    pub fn height(&self) -> i32 { self.lines.len }
    pub fn lines(&self) -> &[]Line from self { &self.lines }
    pub fn lines_mut(&mut self) -> &mut []Line from self {
        self.columns = -1
        &mut self.lines
    }
    pub fn into_lines(move self) -> []Line { move self.lines }
    pub fn replace_lines(&mut self, move lines: []Line) -> []Line {
        self.columns = lines_width(&lines)
        replace(&mut self.lines, move lines)
    }
    pub fn set_alignment(&mut self, alignment: Alignment) { self.alignment = alignment }
    pub fn line_mut(&mut self, index: i32) -> &mut Line from self {
        self.columns = -1
        &mut self.lines[index]
    }
    pub fn push_line(&mut self, move line: Line) {
        if self.columns >= 0 { self.columns = cmp.max<i32>(self.columns, line.width()) }
        self.lines.push(move line)
    }
    pub fn append(&mut self, move other: Text) {
        if self.lines.len == 0 {
            self.columns = other.columns
            self.lines = move other.lines
            return
        }
        if other.lines.len == 0 { return }
        if self.columns >= 0 { self.columns = cmp.max<i32>(self.columns, other.width()) }
        array.append_move<Line>(&mut self.lines,move other.lines)
    }
    pub fn push_span(&mut self, move span: Span) {
        if self.lines.len == 0 { self.lines.push(Line::new([])) }
        last := self.lines.len - 1
        self.lines[last].push_span(move span)
        if self.columns >= 0 { self.columns = cmp.max<i32>(self.columns, self.lines[last].width()) }
    }
    pub fn get_alignment(&self) -> Alignment { self.alignment }
    pub fn get_style(&self) -> tui.Style { tui.Style::from_packed(self.colors,self.attributes) }
    pub fn set_style(&mut self, style: tui.Style) { store_style(&mut self,&style) }
    pub fn patch_style(&mut self, style: tui.Style) { self.set_style(self.get_style().patch(style)) }
    pub fn reset_style(&mut self) { self.set_style(tui.Style::reset()) }
    pub fn to_string(&self) -> string {
        if self.lines.len == 1 { return self.lines[0].to_string() }
        mut out: []u8 = []
        for i in 0..self.lines.len {
            if i > 0 { out.push(10) }
            self.lines[i].append_content(&mut out)
        }
        bytes.decode(&out).unwrap()
    }
}

pub opaque struct Paragraph { lines: []ParagraphLine, text_style: tui.Style, style: tui.Style, alignment: Alignment, wrap_mode: Wrap, wide: WideWrap, top: i32, left: i32, panel: Option<box.Block> }

impl Default for Paragraph { fn default() -> Self { Paragraph::new(Text::default()) } }

impl Paragraph {
    pub fn from<T: IntoText>(move value: T) -> Self { Paragraph::new(value.into_text()) }

    pub fn new(move text: Text) -> Self {
        alignment := text.alignment
        text_style := text.get_style()
        mut lines: []ParagraphLine = []
        lines.reserve(text.lines.len)
        for line in move text.lines { lines.push(ParagraphLine::new(move line)) }
        Self { lines: move lines, text_style: text_style, style: tui.plain(), alignment: alignment, wrap_mode: .Clip, wide: .Overhang, top: 0, left: 0, panel: .None }
    }

    pub fn raw(move value: string) -> Self { Paragraph::new(Text::raw(move value)) }
    pub fn styled(move self, style: tui.Style) -> Self { mut p := move self; p.style = style; move p }
    pub fn block(move self, move panel: box.Block) -> Self { mut p := move self; p.panel = .Some(move panel); move p }
    pub fn get_style(&self) -> tui.Style { self.style }
    pub fn wrap(move self, mode: Wrap) -> Self { mut p := move self; p.wrap_mode = mode; move p }
    pub fn wide_wrap(move self, mode: WideWrap) -> Self { mut p := move self; p.wide = mode; move p }
    pub fn align(move self, alignment: Alignment) -> Self { mut p := move self; p.alignment = alignment; move p }
    pub fn left_aligned(move self) -> Self { self.align(.Left) }
    pub fn centered(move self) -> Self { self.align(.Center) }
    pub fn right_aligned(move self) -> Self { self.align(.Right) }
    pub fn scroll(move self, top: i32, left: i32) -> Self { mut p := move self; p.set_scroll(top, left); move p }
    pub fn set_scroll(&mut self, top: i32, left: i32) {
        self.top = cmp.max<i32>(0, top)
        self.left = cmp.max<i32>(0, left)
    }
}

fn aligned(value: Alignment, parent: Alignment) -> Alignment { if value == .Inherit { parent } else { value } }

struct Rows { lines: []i32, offsets: []i32, starts: []i32, runs: []i32 }

impl Rows {
    fn new() -> Self { Rows { lines: [], offsets: [], starts: [], runs: [] } }

    fn begin(&mut self, line: i32) {
        self.lines.push(line)
        self.offsets.push(0)
        self.starts.push(self.runs.len)
    }

    fn add(&mut self, token: Token) {
        if token.cells == 0 { return }
        end := self.runs.len
        if end > self.starts[self.starts.len - 1] && self.runs[end - 4] == token.span && self.runs[end - 2] == token.start {
            self.runs[end - 2] = token.end
            self.runs[end - 1] += token.cells
        } else {
            self.runs.push(token.span)
            self.runs.push(token.start)
            self.runs.push(token.end)
            self.runs.push(token.cells)
        }
    }

    fn add_segment(&mut self, line: &ParagraphLine, first: i32, end: i32) {
        mut at := first
        while at < end {
            span := line.span_at(at)
            base := line.starts[span]
            finish := cmp.min<i32>(end, base + line.content.spans[span].count())
            cells := line.before(finish) - line.before(at)
            self.add(Token { span: span, start: at - base, end: finish - base, cells: cells, space: false })
            at = finish
        }
    }

    fn indent(&mut self, alignment: Alignment, columns: i32, limit: i32) {
        self.offsets[self.offsets.len - 1] = match alignment {
            .Center => cmp.max<i32>(0, limit / 2 - columns / 2), .Right => cmp.max<i32>(0, limit - columns), _ => 0,
        }
    }
}

fn clip_line(rows: &mut Rows, index: i32, line: &ParagraphLine, limit: i32, alignment: Alignment, scroll: i32) {
    rows.begin(index)
    mut skip := if alignment == .Left || alignment == .Inherit { scroll } else { 0 }
    full_width := line.before(line.count)
    if skip == 0 && full_width <= limit {
        rows.add_segment(&line, 0, line.count)
        rows.indent(alignment, full_width, limit)
        return
    }
    mut columns := 0
    for i in 0..line.count {
        token := line.token(i)
        if token.cells > limit { continue }
        if token.cells > limit - columns { break }
        if skip > 0 {
            if token.cells <= skip { skip -= token.cells; continue }
            skip = 0
        }
        rows.add(token)
        columns += token.cells
    }
    rows.indent(alignment, columns, limit)
}

struct Runs { bounds: []i32, head: i32 }

impl Runs {
    fn new() -> Self { Self { bounds: [], head: 0 } }
    fn empty(&self) -> bool { self.head == self.bounds.len }
    fn add(&mut self, first: i32, end: i32) {
        last := self.bounds.len - 1
        if last >= self.head && self.bounds[last] == first { self.bounds[last] = end }
        else { self.bounds.push(first); self.bounds.push(end) }
    }
    fn append(&mut self, other: &Runs) {
        mut i := other.head
        while i < other.bounds.len { self.add(other.bounds[i], other.bounds[i + 1]); i += 2 }
    }
    fn clear(&mut self) { self.bounds.clear(); self.head = 0 }
    fn pop_front(&mut self) {
        self.bounds[self.head] += 1
        if self.bounds[self.head] == self.bounds[self.head + 1] { self.head += 2 }
    }
}

struct Words {
    ready: Runs, spaces: Runs, word: Runs,
    columns: i32, spaces_width: i32, word_width: i32,
}

impl Words {
    fn new() -> Self { Self { ready: Runs::new(), spaces: Runs::new(), word: Runs::new(), columns: 0, spaces_width: 0, word_width: 0 } }

    fn commit(&mut self, trim: bool) {
        if !self.ready.empty() || !trim {
            self.ready.append(&self.spaces)
            self.columns += self.spaces_width
        }
        self.ready.append(&self.word)
        self.columns += self.word_width
        self.word.clear()
        self.spaces.clear()
        self.word_width = 0
        self.spaces_width = 0
    }

    fn emit(&mut self, rows: &mut Rows, index: i32, line: &ParagraphLine, limit: i32, alignment: Alignment, visible: bool) {
        if visible {
            rows.begin(index)
            mut i := self.ready.head
            while i < self.ready.bounds.len {
                rows.add_segment(&line, self.ready.bounds[i], self.ready.bounds[i + 1])
                i += 2
            }
            rows.indent(alignment, self.columns, limit)
        }
        self.ready.clear()
        self.columns = 0
    }
}

fn wrap_line(rows: &mut Rows, index: i32, line: &ParagraphLine, limit: i32, alignment: Alignment, trim: bool, wide: WideWrap,
    skip: &mut i32, height: i32, words: &mut Words) {
    mut last_word := false
    mut emitted := false
    mut group := 0
    mut pos := 0
    while pos < line.count {
        i := pos
        end := line.groups[group]
        space := line.ends[i] < 0
        before := line.before(i)
        chunk := line.before(end) - before
        pending := words.word_width + words.spaces_width
        if words.columns < limit && chunk <= limit - words.columns - pending {
            if last_word && space { words.commit(trim) }
            if space { words.spaces.add(i, end); words.spaces_width += chunk }
            else { words.word.add(i, end); words.word_width += chunk }
            last_word = !space
            pos = end
            group += 1
            continue
        }
        cells := line.before(i + 1) - before
        pos += 1
        if pos == end { group += 1 }
        if cells > limit { continue }
        split := if trim { cmp.max<i32>(words.word_width, words.spaces_width) } else { words.word_width + words.spaces_width }
        if (last_word && space) || (words.ready.empty() && split + cells > limit) { words.commit(trim) }
        used := words.columns + words.word_width + words.spaces_width
        needed := if wide == .Overhang { 1 } else { cells }
        if words.columns >= limit || (cells > 0 && used + needed > limit) {
            mut room := cmp.max<i32>(0, limit - words.columns)
            words.emit(&mut rows, index, &line, limit, alignment, skip == 0)
            emitted = true
            if skip > 0 { skip -= 1 }
            if rows.lines.len >= height { return }
            while !words.spaces.empty() {
                at := words.spaces.bounds[words.spaces.head]
                size := line.before(at + 1) - line.before(at)
                if room < size { break }
                words.spaces.pop_front()
                words.spaces_width -= size
                room -= size
            }
            if space && words.spaces.empty() { continue }
        }
        if space { words.spaces.add(i, i + 1); words.spaces_width += cells }
        else { words.word.add(i, i + 1); words.word_width += cells }
        last_word = !space
    }
    blank := words.ready.empty() && words.word.empty() && !words.spaces.empty() && trim
    words.commit(trim)
    if !words.ready.empty() || !emitted || blank {
        words.emit(&mut rows, index, &line, limit, alignment, skip == 0)
        if skip > 0 { skip -= 1 }
    }
}

impl Paragraph {
    fn layout(&self, rows: &mut Rows, limit: i32, top: i32, height: i32) {
        if limit <= 0 || height <= 0 { return }
        mut skip := top
        start := if self.wrap_mode == .Clip { cmp.min<i32>(top, self.lines.len) } else { 0 }
        mut words := Words::new()
        for i in start..self.lines.len {
            if rows.lines.len >= height { break }
            line := &self.lines[i]
            alignment := aligned(line.content.alignment, self.alignment)
            if self.wrap_mode == .Clip { clip_line(&mut rows, i, &line, limit, alignment, self.left) }
            else { wrap_line(&mut rows, i, &line, limit, alignment, self.wrap_mode == .Trim, self.wide, &mut skip, height, &mut words) }
        }
    }

    fn paint(&self, frame: &mut tui.Frame, area: tui.Rect, rows: &Rows, top: i32) {
        count := cmp.min<i32>(area.h, rows.lines.len - top)
        for y in 0..count {
            row := y + top
            line := &self.lines[rows.lines[row]]
            base := self.text_style.patch(line.content.get_style())
            mut x := rows.offsets[row]
            mut at := rows.starts[row]
            end := if row + 1 < rows.starts.len { rows.starts[row + 1] } else { rows.runs.len }
            while at < end {
                span := &line.content.spans[rows.runs[at]]
                start := rows.runs[at + 1]
                finish := rows.runs[at + 2]
                cells := rows.runs[at + 3]
                target := tui.Rect { x: area.x + x, y: area.y + y, w: cells, h: 1 }
                span.glyphs.render_cells(&mut frame, target, start, finish, base.patch(span.get_style()))
                at += 4
                x += cells
            }
        }
    }

    fn render_block(&self, frame: &mut tui.Frame, area: tui.Rect) -> tui.Rect {
        frame.apply_cell_style(area,self.style)
        match &self.panel {
            .Some(panel) => {
                inner := panel.render(&mut frame,area)
                if panel.style != tui.plain() || panel.shadow.is_some() { frame.apply_cell_style(inner,self.style) }
                inner
            },
            .None => area,
        }
    }

    pub fn inner(&self, area: tui.Rect) -> tui.Rect {
        match &self.panel {
            .Some(panel) => panel.inner(area),
            .None => area,
        }
    }

    fn render_text(&self, frame: &mut tui.Frame, area: tui.Rect) {
        if area.w == 0 || area.h == 0 { return }
        mut rows := Rows::new()
        self.layout(&mut rows,area.w,self.top,area.h)
        self.paint(&mut frame, area, &rows, 0)
    }

    pub fn render(&self, frame: &mut tui.Frame, bounds: tui.Rect) {
        outer := bounds.intersection(frame.area())
        area := self.render_block(&mut frame,outer)
        self.render_text(&mut frame,area)
    }

    pub fn prepare(move self, columns: i32) -> PreparedParagraph {
        inner := self.inner(tui.Rect::new(0,0,columns,1)).w
        mut rows := Rows::new()
        self.layout(&mut rows,inner,0,2147483647)
        PreparedParagraph { paragraph: move self, columns: columns, rows: move rows }
    }
}

pub opaque struct PreparedParagraph { paragraph: Paragraph, columns: i32, rows: Rows }

impl PreparedParagraph {
    pub fn height(&self) -> i32 { self.rows.lines.len }
    pub fn inner(&self, area: tui.Rect) -> tui.Rect { self.paragraph.inner(area) }
    pub fn resize(&mut self, columns: i32) {
        if columns == self.columns { return }
        inner := self.inner(tui.Rect::new(0,0,columns,1)).w
        self.rows.lines.clear()
        self.rows.offsets.clear()
        self.rows.starts.clear()
        self.rows.runs.clear()
        self.paragraph.layout(&mut self.rows,inner,0,2147483647)
        self.columns = columns
    }
    pub fn set_top(&mut self, top: i32) { self.paragraph.top = cmp.max<i32>(0, top) }

    pub fn render(&self, frame: &mut tui.Frame, bounds: tui.Rect) {
        outer := bounds.intersection(frame.area())
        area := self.paragraph.render_block(&mut frame,outer)
        if outer.w != self.columns { self.paragraph.render_text(&mut frame, area); return }
        self.paragraph.paint(&mut frame, area, &self.rows, self.paragraph.top)
    }
}

impl Span {
    fn draw(&self, frame: &mut tui.Frame, area: tui.Rect, skip: i32) -> i32 {
        mut first := 0
        mut x := 0
        if skip > 0 {
            (index, offset) := self.glyphs.suffix_start(self.width() - skip)
            first = index
            x = offset
        }
        style := self.get_style()
        if !self.glyphs.has_zero_width() {
            return x + self.glyphs.write_cells(&mut frame, tui.Rect { x: area.x + x, y: area.y, w: area.w - x, h: 1 }, first, self.count(), style)
        }
        mut previous := -1
        mut prefix := ""
        for n in first..self.count() {
            cells := self.glyphs.width_at(n)
            if cells > area.w - x { break }
            value := self.glyphs.symbol_at(n)
            if cells == 0 {
                if previous < 0 {
                    prefix = prefix + value
                    if x < area.w { _ := frame.set_cell(area.x + x, area.y, prefix, style) }
                } else {
                    old := frame.symbol_at(area.x + previous, area.y).unwrap_or("")
                    if old == "" { frame.split_wide_cell(area.x + previous, area.y) }
                    _ := frame.set_cell(area.x + previous, area.y, old + value, style)
                }
            } else {
                if prefix == "" { _ := frame.set_cell(area.x + x, area.y, value, style) }
                else { _ := frame.set_cell(area.x + x, area.y, prefix + value, style); prefix = "" }
                x += cells
                previous = x - 1
            }
        }
        x
    }

    pub fn write(&self, frame: &mut tui.Frame, bounds: tui.Rect) -> i32 {
        self.glyphs.write_cells(&mut frame, bounds.intersection(frame.area()), 0, self.count(), self.get_style())
    }

    pub fn render(&self, frame: &mut tui.Frame, bounds: tui.Rect) {
        area := bounds.intersection(frame.area())
        if area.w > 0 && area.h > 0 { _ := self.draw(&mut frame, area, 0) }
    }
}

impl Line {
    pub fn get_alignment(&self) -> Alignment { self.alignment }

    pub fn write(&self, frame: &mut tui.Frame, bounds: tui.Rect) -> i32 {
        mut area := bounds.intersection(frame.area())
        mut used := 0
        base := self.get_style()
        for span in &self.spans {
            if area.w <= 0 { break }
            n := span.glyphs.write_cells(&mut frame, area, 0, span.count(), base.patch(span.get_style()))
            used += n
            area.x += n
            area.w -= n
        }
        used
    }

    pub fn render_aligned(&self, frame: &mut tui.Frame, bounds: tui.Rect, alignment: Alignment) {
        self.paint_line(&mut frame, bounds.intersection(frame.area()), alignment, self.colors, self.attributes)
    }

    fn draw(&self, frame: &mut tui.Frame, area: tui.Rect, parent: Alignment) {
        self.paint_line(&mut frame, area, aligned(self.alignment, parent), self.colors, self.attributes)
    }

    pub fn render_patched(&self, frame: &mut tui.Frame, bounds: tui.Rect, overlay: tui.Style) {
        style := self.get_style().patch(overlay)
        self.paint_line(&mut frame, bounds.intersection(frame.area()), aligned(self.alignment,.Left), style.packed_colors(), style.packed_attributes())
    }

    fn paint_line(&self, frame: &mut tui.Frame, area: tui.Rect, alignment: Alignment, colors: i64, attributes: i64) {
        columns := self.width()
        if columns <= 0 || area.w <= 0 || area.h <= 0 { return }
        row := tui.Rect { x: area.x, y: area.y, w: area.w, h: 1 }
        if colors != 0 || attributes != 0 { frame.apply_cell_style(row, tui.Style::from_packed(colors,attributes)) }
        delta := row.w - columns
        shift := match alignment { .Center => delta / 2, .Right => delta, _ => 0, }
        mut x := cmp.max<i32>(0, shift)
        mut skip := cmp.max<i32>(0, -shift)
        mut drawn_until := 0
        for i in 0..self.spans.len {
            span := &self.spans[i]
            span_columns := span.width()
            if skip >= span_columns { skip -= span_columns; continue }
            if x >= row.w { break }
            if x < drawn_until { frame.split_wide_cell(row.x + x, row.y) }
            written := span.draw(&mut frame, tui.Rect { x: row.x + x, y: row.y, w: row.w - x, h: 1 }, skip)
            drawn_until = cmp.max<i32>(drawn_until, x + written)
            x += span_columns - skip
            skip = 0
        }
    }

    pub fn render(&self, frame: &mut tui.Frame, bounds: tui.Rect) {
        self.draw(&mut frame, bounds.intersection(frame.area()), .Left)
    }
}

impl Text {
    pub fn render(&self, frame: &mut tui.Frame, bounds: tui.Rect) {
        area := bounds.intersection(frame.area())
        if area.w <= 0 || area.h <= 0 { return }
        if self.colors != 0 || self.attributes != 0 { frame.apply_cell_style(area, self.get_style()) }
        for i in 0..cmp.min<i32>(area.h, self.lines.len) {
            row := tui.Rect { x: area.x, y: area.y + i, w: area.w, h: 1 }
            self.lines[i].draw(&mut frame, row, self.alignment)
        }
    }
}
