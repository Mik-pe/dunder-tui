import tui
import tui.canvas as c
import .scenes

@test fn each_scene_draws_and_moves() {
    catalog := scenes.all()
    assert(catalog.len == 10)
    for i in 0..catalog.len {
        for j in 0..i { assert(catalog[i].id != catalog[j].id) }
        render := catalog[i].draw
        mut a := c.Canvas::new(72, 40, 0)
        mut b := c.Canvas::new(72, 40, 0)
        render(&mut a, 0.0)
        render(&mut b, 1.75)
        mut changed := 0
        mut colored := 0
        for j in 0..a.pixels.len {
            if a.pixels[j] != b.pixels[j] { changed += 1 }
            if a.pixels[j] != a.pixels[0] { colored += 1 }
        }
        assert(changed > 20 && colored > 100)
        mut previous := tui.Frame::new(a.w,a.h/2)
        mut current := tui.Frame::new(b.w,b.h/2)
        a.render(&mut previous,previous.area())
        b.render(&mut current,current.area())
        positions := current.diff_positions(&previous).unwrap()
        mut changed_cells := 0
        for y in 0..current.area().h {
            for x in 0..b.w {
                top := 2*y*b.w+x
                bottom := top+b.w
                style := current.style_at(x,y).unwrap()
                assert(current.symbol_at(x,y).unwrap() == "▀")
                assert(style.get_foreground() == .Some(tui.rgb(b.pixels[top])))
                assert(style.get_background() == .Some(tui.rgb(b.pixels[bottom])))
                if a.pixels[top] != b.pixels[top] || a.pixels[bottom] != b.pixels[bottom] {
                    assert(changed_cells < positions.len && positions[changed_cells] == (x,y))
                    changed_cells += 1
                }
            }
        }
        assert(positions.len == changed_cells)
        mut tiny := c.Canvas::new(1, 2, 0)
        render(&mut tiny, 20.0)
    }
}
