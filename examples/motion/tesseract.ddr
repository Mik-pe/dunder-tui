import std.math as m
import tui.canvas as c
import .art

pub fn draw(s: &mut c.Canvas, t: f64) {
    mut xs: [i32; 16] = [0; 16]
    mut ys: [i32; 16] = [0; 16]
    mut depths: [f64; 16] = [0.0; 16]
    for y in 0..s.h {
        for x in 0..s.w {
            dx := (f64(x) - f64(s.w) * 0.5) / f64(s.h)
            dy := f64(y) / f64(s.h) - 0.48
            bg := c.mix(0x0c0d20, 0x27243e, art.glow((dx * dx + dy * dy).sqrt(), 0.72))
            s.pixels[y * s.w + x] = art.stars(x, y, t * 0.32, bg, 0x827f9f)
        }
    }
    a := t * 0.31 + 0.5
    b := t * 0.43 + 0.7
    for i in 0..16 {
        x := f64((i.bit_and(1)) * 2 - 1)
        y := f64((i.shr(1).bit_and(1)) * 2 - 1)
        z := f64((i.shr(2).bit_and(1)) * 2 - 1)
        w := f64((i.shr(3).bit_and(1)) * 2 - 1)
        xx := x * m.cos(a) - w * m.sin(a)
        ww := x * m.sin(a) + w * m.cos(a)
        yy := y * m.cos(b) - z * m.sin(b)
        zz := y * m.sin(b) + z * m.cos(b)
        projected := 2.1 / (3.8 - ww)
        bx := (xx * m.cos(b * 0.67) + zz * m.sin(b * 0.67)) * projected
        bz := (-xx * m.sin(b * 0.67) + zz * m.cos(b * 0.67)) * projected
        scale := f64(s.h) * 0.41 / (1.34 - 0.23 * bz)
        xs[i] = s.w / 2 + i32(bx * scale)
        ys[i] = s.h / 2 + i32(yy * projected * scale)
        depths[i] = art.sat(0.5 + bz * 0.45)
    }
    colors: [u32; 4] = [0x64deda, 0xd39aff, 0xff8ca2, 0xf9d683]
    for layer in 0..4 {
        for i in 0..16 {
            for axis in 0..4 {
                other := i.bit_xor(i32(1).shl(axis))
                if other <= i { continue }
                depth := (depths[i] + depths[other]) * 0.5
                if i32(depth * 3.99) != layer { continue }
                s.line(xs[i], ys[i], xs[other], ys[other], c.mix(0x3b315b, colors[axis], 0.28 + 0.72 * depth))
            }
        }
    }
    for i in 0..16 { s.point(xs[i], ys[i], 0xf2ebff) }
}
