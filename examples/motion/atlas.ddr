import std.math as m
import tui.canvas as c
import .art

pub fn draw(s: &mut c.Canvas, t: f64) {
    for y in 0..s.h {
        for x in 0..s.w {
            u := (f64(x) + 0.5) / f64(s.w)
            v := (f64(y) + 0.5) / f64(s.h)
            xx := u * 3.8 + t * 0.070
            yy := v * 2.3 + t * 0.027
            h := 0.41 * m.sin(xx * 2.1 + 1.3 * m.cos(yy * 2.0)) + 0.34 * m.cos(yy * 3.2 + xx) + 0.21 * m.sin(xx * 3.6 - yy * 2.2)
            mut col: u32 = 0
            if h < -0.10 {
                depth := art.sat((-h - 0.1) * 1.3)
                col = c.mix(0x71c9ae, 0x2e4991, depth)
                col = c.mix(col, 0x266f87, art.glow(art.frac(h * 10.0) - 0.5, 0.12) * 0.55)
            } else {
                height := art.sat((h + 0.1) * 1.07)
                col = art.ramp(0xe2e7a9, 0xaaca70, 0x367668, height)
                col = c.mix(col, 0x39776c, art.glow(art.frac(h * 13.0) - 0.5, 0.15) * 0.86)
                col = c.mix(col, 0xfff1c7, art.glow(h + 0.1, 0.07))
            }
            s.pixels[y * s.w + x] = col
        }
    }
}
