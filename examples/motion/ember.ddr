import std.math as m
import tui.canvas as c
import .art

pub fn draw(s: &mut c.Canvas, t: f64) {
    for y in 0..s.h {
        v := 1.0 - (f64(y) + 0.5) / f64(s.h)
        for x in 0..s.w {
            u := (f64(x) + 0.5 - f64(s.w) * 0.5) / f64(s.h)
            dx := u + 0.08 * m.sin(v * 9.0 - t * 2.4) * v + 0.06 * m.sin(v * 17.0 + t * 1.7) * v
            radius := 0.33 * art.sat(1.0 - v / 0.91)
            tongue := 0.12 * m.sin(u * 20.0 - v * 10.0 + t * 2.2) + 0.06 * m.sin(u * 31.0 + v * 19.0 - t * 3.2)
            heat := art.sat((radius - dx.abs()) * 2.6 + tongue * art.sat(1.3 - v))
            mut col := c.mix(0x130e20, 0x63202d, art.glow(dx, 0.67) * art.sat(1.0 - v) * 0.85)
            if heat > 0.025 {
                col = art.ramp(0xb33637, 0xff7835, 0xffe6a1, heat * 1.48)
                if heat > 0.7 { col = c.mix(col, 0xfffae4, (heat - 0.7) * 5.0) }
            }
            if v < 0.10 + 0.03 * m.sin(u * 14.0) && u.abs() < 0.52 {
                col = c.mix(0x20141d, 0xde6438, art.glow(v - 0.055 - 0.02 * m.sin(u * 14.0), 0.026))
            }
            s.pixels[y * s.w + x] = col
        }
    }
    for i in 0..37 {
        seed := art.hash(i, 7)
        life := art.frac(t * (0.16 + seed * 0.19) + art.hash(i, 17))
        u := (seed - 0.5) * (0.4 + life * 0.5) + 0.05 * m.sin(life * 12.0 + seed * 23.0)
        s.point(s.w / 2 + i32(u * f64(s.h)), i32((0.83 - life * 0.82) * f64(s.h)), c.mix(0xffc878, 0x8e3933, life))
    }
}
