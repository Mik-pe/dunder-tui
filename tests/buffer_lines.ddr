capability stdio, filesystem
import ..src.tui
import ..src.testing
import ..src.text as rich
import std.json
import std.bytes
import std.parse
import std.text
import sys

fn dump(b: &tui.Buffer) {
    print(json.to_string(&b.area).unwrap())
    mut i := 0
    while i < b.content.len {
        first := i
        i += 1
        while i < b.content.len && b.content[first] == b.content[i] &&
                b.content[first].symbol.is_none() == b.content[i].symbol.is_none() { i += 1 }
        print(f"{i-first} {json.to_string(&b.content[first]).unwrap()}")
    }
}

fn check<L>(lines: &L) {
    b := tui.Buffer::with_lines(&lines)
    dump(&b)
    backend := testing.TestBackend::with_lines(&lines)
    dump(&backend.buffer().to_buffer())
    backend.assert_buffer_lines(&lines)
}

fn text_rows() {
    cases := ["", " ", "XY", "A\r\n\nB\n", "\rX\tY", "カﾞﾟZ","لا", "界",
        "A\u{301}茶", "🧑🏽‍🚀", "A\u{200d}B", "\u{200b}Z", "❤︎️"]
    for a in &cases {
        for b in &cases {
            check(&[a.clone(),b.clone(), ""])
            check(&[rich.Span::styled(a.clone(),tui.ink(.Red).italic()),rich.Span::raw(b.clone())])
            first := rich.Line::new([rich.Span::styled(a.clone(),tui.ink(.Indexed(45))),rich.Span::raw(b.clone())])
                .styled(tui.plain().background(.Blue).underlined()).align(.Right)
            check(&[first, rich.Line::raw("🦀.")])
        }
    }
}

fn boundaries() {
    for count in [65535,65536,65537,131075] {
        mut ascii: []u8 = []
        ascii.reserve(count)
        for _ in 0..count { ascii.push(b'A') }
        row := bytes.decode(&ascii).unwrap()
        check(&[row, "wxyz"])
        mut rows: []string = []
        rows.reserve(count)
        for _ in 0..count { rows.push("") }
        if count%65536 > 0 {
            rows[0] = "OPEN"
            if count > 65535 { rows[count%65536] = "\u{301}\t" }
            rows[count-1] = "END"
        }
        check(&rows)
    }
    for count in [32767,32768,32769] {
        mut utf8: []u8 = []
        for _ in 0..count { bytes.append_utf8(&mut utf8, "界") }
        check(&[bytes.decode(&utf8).unwrap(),"!"])
    }
}

fn coordinates() {
    for area in [tui.Rect {x:0,y:0,w:0,h:0},tui.Rect {x:5,y:7,w:4,h:3},
            tui.Rect {x:65532,y:65533,w:5,h:4},tui.Rect {x:0,y:0,w:65535,h:65535},
            tui.Rect {x:65535,y:0,w:1,h:3},tui.Rect {x:3,y:8,w:0,h:2}] {
        for count in [0,1,3,16] {
            mut b := tui.Buffer::default()
            b.area = area
            for i in 0..count { b.content.push(tui.RawCell::from_char(rune(65+i))) }
            for x in [0,1,3,4,5,7,8,9,65532,65533,65534,65535] {
                for y in [0,1,5,6,7,8,9,10,65532,65533,65534,65535] {
                    i := b.index_of(x,y).unwrap_or(-1)
                    c := match b.cell(x,y) { .Some(cell) => cell.symbol_text(), .None => "-", }
                    print(f"{i} {c}")
                }
            }
            for i in -1..count+1 {
                match b.position_at(i64(i)) { .Some(pos) => { (x,y) := pos; print(f"{x} {y}") }, .None => print("-"), }
            }
        }
    }
}

fn main() {
    if sys.arg_count() == 3 && sys.arg(1) == "--outside" {
        mut rows: []string = []
        rows.reserve(65537)
        for _ in 0..65537 { rows.push("") }
        rows[1] = " "
        if sys.arg(2) == "buffer" { dump(&tui.Buffer::with_lines(&rows)) }
        else { dump(&testing.TestBackend::with_lines(&rows).buffer().to_buffer()) }
        return
    }
    if sys.arg_count() == 2 && sys.arg(1) == "--bounds" { boundaries(); return }
    if sys.arg_count() > 2 && sys.arg(1) == "--unicode" {
        for arg in 2..sys.arg_count() {
            for row in text.split(sys.read(sys.arg(arg)).unwrap(),"\n") {
                if row.len == 0 { continue }
                mut value := ""
                for cp in text.split(row," ") { value += rune(parse.hex(cp).value).str() }
                check(&[move value])
            }
        }
        return
    }
    text_rows()
    coordinates()
}
