capability stdio
import ..src.tui
import ..src.widgets as ui
import ..src.barchart as chart
import ..src.text as rich
import .raw_cells
import .bar_cells

fn symbols() -> [string;9] { ["","_","é","界","🦊","ab","́","⣿","😶‍🌫️"] }

pub fn live(f: &mut tui.Frame, phase: &mut i32) {
    a := f.area()
    mut data: []ui.Sample = []
    for n in 0..9 { data.push(ui.Sample::new(u64(n))) }
    data.push(ui.Sample::missing())
    mut spark := ui.Sparkline::bars(move data)
    spark.bar_set = .Some([" ","▁","▂","▃","▄","▅","▆","▇","█"])
    spark.missing_text = .Some("◆")
    spark.style = tui.ink(.Indexed(81))
    if phase == 1 { spark.flow = .RightToLeft }
    f.render_widget(&spark,tui.Rect::new(a.x,a.y,10,1))
    mut line := ui.LineGauge::new(if phase == 0 { 0.4 } else { 0.6 })
    line.label = .Some(rich.Line::raw("V"))
    line.set_symbols(if phase == 0 { "界" } else { "=" },"·")
    f.render_widget(&line,tui.Rect::new(a.x,a.y+1,12,1))
    bar_cells.caption(&mut f,a.x+1,a.y+2,phase == 1)
}

fn paint(f: &mut tui.Frame, area: tui.Rect, widget:i32, k:i32) {
    style := if k%3 == 0 { tui.plain() } else { tui.ink(.Yellow).underline_index(13).without(.Bold) }
    bar := tui.plain().background_rgb(0x18324e).italic()
    text := ["","界","é","ab","🦊","--"]
    ratio := f64(k)/5.0
    if widget == 0 {
        mut w := ui.Sparkline::bars([ui.Sample::missing(),ui.Sample::new(0),ui.Sample::new(1),ui.Sample::new(2),
            ui.Sample::new(3),ui.Sample::styled(4,bar),ui.Sample::new(5),ui.Sample::new(6),ui.Sample::new(7),
            ui.Sample::new(8),ui.Sample::new(0xffffffffffffffff)])
        w.style = style
        w.maximum = .Some(if k == 5 { u64(0) } else { u64(8) })
        if k%2 == 1 { w.flow = .RightToLeft }
        w.missing_style = bar
        if k < 2 { w.missing_symbol = `界`; w.symbols[8] = `狐` }
        else { w.missing_text = .Some(text[k].clone()); w.bar_set = .Some(symbols()) }
        f.render_widget(&w,area)
    } else if widget == 1 {
        mut w := ui.LineGauge::new(ratio)
        w.style = style
        w.filled_style = bar
        w.unfilled_style = tui.ink(.Red)
        if k != 5 { w.label = .Some(rich.Line::new([rich.Span::styled(text[k].clone(),tui.ink(.Green)),rich.Span::raw("x")])) }
        if k == 0 { w.filled_symbol = `界`; w.unfilled_symbol = `狐` }
        else { w.set_symbols(text[k].clone(),text[5-k].clone()) }
        f.render_widget(&w,area)
    } else if widget == 2 {
        mut w := ui.Gauge::new(ratio)
        w.style = style
        w.bar_style = bar
        w.fractional = k%2 == 0
        if k != 5 { w.label = .Some(rich.Span::styled(text[k].clone(),tui.ink(.Green))) }
        f.render_widget(&w,area)
    } else {
        mut bars: []chart.Bar = []
        for i in 0..9 {
            mut item := chart.Bar::new(u64(i))
            item.text_value = .Some("")
            if i%2 == 1 { item.style = tui.ink(.Red) }
            bars.push(move item)
        }
        mut w := chart.BarChart::new(move bars)
        w.style = style
        w.bar_style = bar
        w.bar_width = 1 + k%2
        w.bar_gap = 0
        w.maximum = .Some(8)
        if k >= 2 { w.bar_set = .Some(symbols()) } else { w.symbols[0] = `狐`; w.symbols[8] = `界` }
        if widget == 4 { w.direction = .Horizontal }
        f.render_widget(&w,area)
    }
}

fn main() {
    for a in [tui.Rect::new(0,0,13,5),tui.Rect::new(5,3,13,5),tui.Rect::new(65522,65530,13,5)] {
        for (dx,dy,w,h) in [(0,0,13,5),(0,0,13,1),(2,1,9,3),(1,1,1,2),(5,3,6,1),(0,1,0,1)] {
            area := tui.Rect::new(a.x+dx,a.y+dy,w,h)
            for widget in 0..5 { for overlay in [false,true] {
                mut prior := raw_cells.seeded(a)
                for k in 0..6 {
                    mut f := raw_cells.seeded(a)
                    for phase in (if overlay { 0 } else { k })..k+1 { paint(&mut f,area,widget,phase) }
                    raw_cells.compare(&f,&prior)
                    prior = move f
                }
            } }
        }
    }
}
