capability stdio
import ..src.tui
import std.cmp
import std.json

pub fn grid(area: tui.Rect) -> tui.Buffer {
    mut b := tui.Buffer::empty(area)
    for (x,y) in area.positions() {
        _ := b.get_mut(x,y).set_char(rune(65+(x-area.x+3*(y-area.y))%26))
    }
    mut rows := area.iter_rows()
    mut n := 0
    while rows.remaining() > 0 {
        row := if n%2 == 0 { rows.next().unwrap() } else { rows.next_back().unwrap() }
        b.set_style(row,tui.ink(.Indexed(u8(20+n%16))))
        n += 1
    }
    for col in area.iter_columns() {
        b.set_style(col,tui.plain().background(.Indexed(u8(52+(col.x-area.x)%16))))
    }
    move b
}

fn axes(area: tui.Rect, columns: bool, mode: i32) {
    mut it := if columns { area.iter_columns() } else { area.iter_rows() }
    count := cmp.min<i32>(it.remaining()+2,32)
    for n in 0..count {
        back := mode == 1 || (mode == 2 && n%2 == 0) || (mode == 3 && n%3 == 2)
        rect := if back { it.next_back() } else { it.next() }
        match rect {
            .Some(r) => print(f"{r.x} {r.y} {r.w} {r.h} {it.remaining()} {it.size_hint()}"),
            .None => print(f"- {it.remaining()} {it.size_hint()}"),
        }
    }
}

fn points(area: tui.Rect, limit: i32) {
    mut it := area.positions()
    mut checksum: i64 = 0
    print(f"{it.remaining()} {it.size_hint()}")
    for n in 0..limit {
        point := if n%2 == 0 { it.next() } else if it.advance() { .Some((it.x(),it.y())) } else { .None }
        match point {
            .Some((x,y)) => {
                checksum = (checksum*31+i64(x)*65536+i64(y)+it.remaining()+i64(it.size_hint()))%2147483647
                if limit < 80 || n%65535 >= 65533 || n%65535 <= 1 || n >= limit-3 {
                    print(f"{n} {x} {y} {it.remaining()} {it.size_hint()}")
                }
            },
            .None => { print(f"- {it.remaining()} {it.size_hint()}"); assert(it.next().is_none()); break },
        }
    }
    print(checksum)
}

fn main() {
    for x in [0,7,65532,65535] {
        for y in [0,9,65533,65535] {
            for w in [0,1,3,5,65535] {
                for h in [0,1,2,4,65535] {
                    area := tui.Rect { x:x,y:y,w:w,h:h }
                    for mode in 0..4 { axes(area,false,mode); axes(area,true,mode) }
                    points(area,32)
                }
            }
        }
    }
    for area in [tui.Rect::new(0,0,65535,2),tui.Rect::new(0,0,3,65535),
            tui.Rect::new(0,0,65535,65535),tui.Rect {x:65532,y:0,w:65535,h:32768}] {
        points(area,196608)
    }
    for x in [0,17,65531] { for y in [0,13,65532] {
        for w in 0..10 { for h in 0..7 {
            print(json.to_string(&grid(tui.Rect::new(x,y,w,h))).unwrap())
        } }
    } }
}
