capability stdio
import ..src.tui
import sys

pub fn cells(frame: &mut tui.Frame, step: i32) {
    a := frame.area()
    mut strip := tui.Buffer::with_lines(&["ABCDEFG"])
    if step < 2 {
        _ := strip.get_mut(1,0).set_diff_option(.Skip)
        _ := strip.get_mut(2,0).set_diff_option(.AlwaysUpdate)
    } else {
        _ := strip.get_mut(3,0).set_symbol("[X]").set_style(tui.ink(.Yellow)).set_diff_option(.ForcedWidth(3))
    }
    row := strip.to_frame().unwrap()
    frame.copy_cells(&row, row.area(), a.x, a.y)
}

fn render(frame: &mut tui.Frame, step: &i32) {
    cells(&mut frame,step)
    match frame.area().row_at(1) { .Some(row) => { frame.label(row,step.str()) }, .None => {}, }
}

fn update(step: &mut i32, key: tui.Key) -> bool {
    match key { .Char(c) if c == `q` => false, _ => { step += 1; true }, }
}

fn main() -> i32 {
    mut step := 0
    match tui.run(&mut step,render,update) { .Ok => 0, .Err(e) => { _ := sys.eprint(e); 1 }, }
}
