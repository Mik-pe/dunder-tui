import ..src.tui
import ..src.testing as test
import std.bytes as bytes
import sys

fn draw(f: &mut tui.Frame, step: &mut i32) {
    a := f.area()
    for y in a.y..a.bottom() {
        for x in a.x..a.right() {
            v := (3*x+y+step)%5
            if v > 1 {
                style := if v == 3 { tui.ink(.Red).bold() } else { tui.plain() }
                f.styled_rune(x,y,a.right(),rune(65+v),&style)
            }
        }
    }
    if step%2 == 0 { f.set_cursor_position(a.x+1,a.y) }
}

fn cells(out: &mut []u8, f: &tui.Frame) {
    a := f.area()
    for y in a.y..a.bottom() {
        for x in a.x..a.right() {
            bytes.append_utf8(&mut out,f.symbol_at(x,y).unwrap())
            style := f.style_at(x,y).unwrap()
            out.push(if style.get_foreground() == .Some(tui.Color.Red) { b'R' } else { b'-' })
            out.push(if style.has(.Bold) { b'B' } else { b'-' })
        }
    }
}

fn snapshot(t: &tui.Terminal<test.TestBackend>, seed: i32, step: i32) {
    b := t.backend()
    a := t.viewport_area()
    p := b.cursor_position()
    mut out: []u8 = []
    bytes.append_utf8(&mut out,f"{seed} {step} {a.x} {a.y} {a.w} {a.h} {p.0} {p.1} {b.cursor_visible()} {b.scrollback().len()} ")
    cells(&mut out,b.buffer())
    for i in 0..b.scrollback().len() { cells(&mut out,b.scrollback().row(i)) }
    print(bytes.decode(&out).unwrap())
}

fn manual(t: &mut tui.Terminal<test.TestBackend>, seed:i32, stage:i32, w:i32, h:i32) {
    area := t.viewport_area()
    column := area.x+(seed+stage)%area.w
    row := area.y+(seed/3+stage)%area.h
    mark := tui.Rect {x:column,y:row,w:1,h:1}
    brush := tui.ink(.Red).bold()
    match stage {
        0 | 7 => { assert(t.show_cursor().is_ok()) },
        1 | 4 | 11 | 17 => {
            frame := t.get_frame()
            frame.fill(mark,rune(65+stage),brush)
            frame.set_cursor_position(column,row)
        },
        2 | 3 | 5 | 9 | 12 | 18 => { assert(t.flush().is_ok()) },
        6 | 10 | 19 => { t.swap_buffers() },
        8 | 14 | 21 => { t.current_buffer_mut().fill(mark,rune(65+stage),brush) },
        13 => { assert(t.apply_buffer_with_cursor(.Some((column,row))).is_ok()) },
        15 => {
            t.backend_mut().resize(w+2,h+1)
            assert(t.autoresize().is_ok())
        },
        16 => { assert(t.apply_buffer().is_ok()) },
        20 => {
            mut lines := tui.Frame::new(area.w,1)
            lines.label(lines.area(),"log")
            assert(t.insert_before(&lines).is_ok())
        },
        22 => {
            mut n := seed
            assert(t.draw(&mut n,fn(f:&mut tui.Frame,s:&mut i32) { f.label(f.area(),"T") }).is_ok())
        },
        _ => { assert(t.backend_mut().flush().is_ok()) },
    }
    frame := t.get_frame()
    mut out: []u8 = []
    bytes.append_utf8(&mut out,f"{frame.count()} ")
    cells(&mut out,&frame)
    print(bytes.decode(&out).unwrap())
}

fn main() {
    windows := sys.arg_count() == 2 && sys.arg(1) == "--window"
    direct := sys.arg_count() == 2 && sys.arg(1) == "--direct-cursor"
    manual_mode := sys.arg_count() == 2 && sys.arg(1) == "--manual"
    for seed in 0..90 {
        w := 9+seed%3
        h := 5+seed%4
        mut device := test.TestBackend::new(w,h)
        mut backing := tui.Frame::new(w,h)
        for y in 0..h { backing.fill(tui.Rect {x:0,y:y,w:w,h:1},rune(48+y),tui.plain()) }
        assert(device.write_region(&backing).is_ok())
        device.set_cursor_position(seed%w,(seed/2)%h)
        mode := if seed%3 == 0 { tui.Viewport.Fixed(tui.Rect {x:2,y:1,w:w-4,h:h-2}) }
            else if (windows || direct || manual_mode) && seed%3 == 1 { tui.Viewport.Fullscreen }
            else { tui.Viewport.Inline(1+seed%(h+3)) }
        mut t := tui.Terminal<test.TestBackend>::with_viewport(move device,mode).unwrap()
        if manual_mode {
            for stage in 0..24 { manual(&mut t,seed,stage,w,h); snapshot(&t,seed,stage) }
            continue
        }
        snapshot(&t,seed,0)
        for stage in 1..16 {
            mut step := stage
            match stage {
                1 | 6 | 10 if direct => {
                    x := (seed+stage)%w; y := (2*seed+stage)%h
                    assert(t.set_cursor_position(x,y).is_ok())
                    if stage == 6 { assert(t.hide_cursor().is_ok()) } else { assert(t.show_cursor().is_ok()) }
                    assert(t.cursor_position().unwrap() == (x,y))
                },
                2 | 11 if direct => {
                    t.backend_mut().resize(w+stage%3,h+stage%2)
                    assert(t.autoresize().is_ok())
                },
                4 if direct => {
                    t.backend_mut().set_cursor_position(2,1)
                    assert(t.cursor_position().unwrap() == (2,1))
                    assert(t.hide_cursor().is_ok())
                },
                1 | 3 | 5 | 9 if windows => {
                    if stage == 1 { t.backend_mut().resize(w+3,h+2) }
                    if stage == 5 { t.backend_mut().resize(w-1,h-1) }
                    if stage == 9 { t.backend_mut().resize(w,h) }
                    assert(t.autoresize().is_ok())
                },
                2 | 4 | 8 | 10 => {
                    n := (seed+stage)%(2*h+3)
                    mut lines := tui.Frame::new(t.viewport_area().w,n)
                    for y in 0..n {
                        lines.text(tui.Rect {x:0,y:y,w:lines.area().w,h:1},f"L{y}",tui.ink(.Red).bold())
                    }
                    assert(t.insert_before(&lines).is_ok())
                },
                6 => { assert(t.clear().is_ok()) },
                7 => {
                    t.backend_mut().resize(w+2,h+1)
                    assert(t.draw(&mut step,draw).is_ok())
                },
                11 => {
                    if seed%3 != 0 { t.backend_mut().resize(w-2,h-1) }
                    assert(t.draw(&mut step,draw).is_ok())
                },
                13 if seed%3 == 0 => { assert(t.resize(tui.Rect {x:1,y:2,w:w-3,h:2}).is_ok()) },
                14 if seed%3 == 0 => { assert(t.resize(tui.Rect {x:3,y:2,w:3,h:2}).is_ok()) },
                _ => { assert(t.draw(&mut step,draw).is_ok()) },
            }
            if windows {
                m := t.window_size().unwrap()
                (width,height) := t.size()
                print(f"{width} {height} {m.columns} {m.rows} {m.pixel_width} {m.pixel_height}")
            }
            if direct {
                p := t.cursor_position().unwrap()
                print(f"{p.0} {p.1}")
            }
            snapshot(&t,seed,stage)
        }
    }
}
