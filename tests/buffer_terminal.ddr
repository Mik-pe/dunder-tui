capability unsafe, process, stdio
import .terminal_driver as driver
import sys

fn exercise(master:i32, slave:i32, screen:&mut driver.Screen) -> bool {
    unsafe {
        if !driver.wait_for(master,&mut screen,1,"A茶eZ","\x1b[?1049h") || !screen.contains(0,"A CDEFG") { return false }
        if !driver.send(slave,"\x1b[1;2H!!") || !driver.wait_for(master,&mut screen,0,"A!!DEFG","") { return false }
        if !driver.send(master,"n") || !driver.wait_for(master,&mut screen,1,"B海aZ","") || !screen.contains(0,"A!CDEFG") { return false }
        if !driver.send(master,"n") || !driver.wait_for(master,&mut screen,0,"ABC[X]G","") { return false }
        if !driver.send(master,"n") || !driver.wait_for(master,&mut screen,1,"DEFGHIJ","") || !screen.contains(0,"ABCDEFG") { return false }
        if !driver.send(master,"q") || !driver.wait_for(master,&mut screen,0,"","\x1b[?1049l") { return false }
    }
    true
}

fn main() -> i32 {
    if sys.arg_count() != 2 { return 1 }
    unsafe { if driver.test_with_args(sys.arg(1),[],18,6,exercise) { print("External cell writes, forced width and shell restoration passed"); return 0 } }
    1
}
