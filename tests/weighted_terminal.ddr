capability unsafe, stdio, process

import sys
import ..src.tui
import ..src.layout
import ..tools.pty
import ..benchmarks.bands
import .terminal_driver as driver

fn paint(frame: &mut tui.Frame, grid: &mut layout.Layout) {
    regions := grid.arrange(frame.area()).regions()
    for i in 0..regions.areas.len {
        frame.fill(regions.areas[i], rune(65+i), tui.ink(if i%2 == 0 { .Cyan } else { .Magenta }))
    }
}

fn key(_grid: &mut layout.Layout, pressed: tui.Key) -> bool {
    match pressed { .Escape => false, _ => true, }
}

fn exercise(master: i32, slave: i32, screen: &mut driver.Screen) -> bool {
    widths: [i32;4] = [54,80,96,125]
    rows: [string;4] = [
        "   BBBBBBBBBBBBBBBBBBB  DDDDDDDDDD  FFFFFFF  HHH      ",
        "  AAAAAA BBBBBBBBBBBBBBBBBBB  DDDDDDDDDD EE FFFFFFF  HHH IIII JJJJJJ KKKKKK LL  ",
        "  AAAAAA BBBBBBBBBBBBBBBBBBB CCC DDDDDDDDDD EEEEEEEE FFFFFFF GGGG HHH IIII JJJJJJJ KKKKKKKK LL  ",
        "  AAAAAA BBBBBBBBBBBBBBBBBBB CCCCCCCCCCC DDDDDDDDDD EEEEEEEE FFFFFFF GGGGGGGGGGGGGGGGGG HHHHH IIII JJJJJJJJJJ KKKKKKKKKK LL  ",
    ]
    unsafe {
        if !driver.wait_for(master, &mut screen, 1, rows[0], "") { return false }
        for i in [1,2,3,2,1,0] {
            if !pty.resize(slave,u16(widths[i]),8) { return false }
            screen = driver.Screen::new(widths[i],8)
            if !driver.wait_for(master, &mut screen, 1, rows[i], "") { return false }
        }
        return driver.send(master,"\x1b") && driver.wait_for(master,&mut screen,0,"","\x1b[?1049l")
    }
    false
}

fn main() -> i32 {
    if sys.arg_count() == 2 {
        mut grid := bands.weighted_bands()
        return if tui.run_stateful(&mut grid, paint, key).is_ok() { 0 } else { 1 }
    }
    unsafe {
        if driver.test_with_args(sys.arg(0), ["draw"], 54, 8, exercise) {
            print("Weighted panel rows at four widths, six terminal resizes and restoration OK")
            return 0
        }
    }
    1
}
