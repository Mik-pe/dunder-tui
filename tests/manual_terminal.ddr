capability process, unsafe, stdio
import .terminal_driver as driver
import sys

fn check(master:i32, screen:&mut driver.Screen, row:i32, x:i32) -> bool {
    unsafe {
        for step in 0..10 {
            expected := match step { 0 | 1 => "   ", 2 | 3 | 4 => "ED ", 5 => "LO ", 6 | 7 => "UP ", _ => "NOx", }
            if !driver.wait_for(master,&mut screen,row,"","\x1b[6n") { return false }
            for col in 0..3 {
                if i32(screen.cells[row*screen.w+x+col]) != i32(expected[col]) { _ := sys.eprint(f"cell {col} at step {step}"); return false }
            }
            visible := step != 5 && step < 8
            if screen.cursor_visible != visible { _ := sys.eprint(f"visibility at step {step}"); return false }
            if step < 2 && (screen.x != 2 || screen.y != 1) { return false }
            if (step == 6 || step == 7) && (screen.x != 2 || screen.y != 4) { return false }
            if !driver.send(master,f"\x1b[{screen.y+1};{screen.x+1}R") { return false }
        }
        return driver.wait_for(master,&mut screen,row,"","\x1b[?25h")
    }
}

fn full(master:i32, slave:i32, s:&mut driver.Screen) -> bool { check(master,&mut s,0,0) }
fn fixed(master:i32, slave:i32, s:&mut driver.Screen) -> bool { check(master,&mut s,2,4) }

fn main() -> i32 {
    if sys.arg_count() != 2 { return 2 }
    unsafe {
        if !driver.test_with_args(sys.arg(1),["--manual"],18,6,full) ||
            !driver.test_with_args(sys.arg(1),["--manual-fixed"],18,6,fixed) { return 1 }
    }
    print("Manual cell writes, buffer swaps, cursor and terminal restoration passed")
    0
}
