capability stdio
import ..src.layout as lay
import ..src.tui
import std.bytes as bytes
import ..benchmarks.layout_scene
import ..benchmarks.panels
import .widget_cells as cells
import sys

fn rules(kind: i32) -> []lay.Constraint {
    match kind {
        0 => [], 1 => [.Length(4)], 2 => [.Ratio(1, 3)], 3 => [.Min(3)], 4 => [.Percentage(37)],
        5 => [.Fill(3)], 6 => [.Max(8)], 7 => [.Fill(1), .Fill(2), .Fill(3)],
        8 => [.Length(2), .Fill(1), .Length(4)], 9 => [.Percentage(35), .Ratio(1, 4), .Max(9)],
        10 => [.Min(3), .Min(8), .Fill(2)], 11 => [.Length(5), .Length(5), .Length(5)],
        12 => [.Max(1), .Max(7), .Max(2)], 13 => [.Percentage(50), .Percentage(50), .Length(3)],
        14 => [.Ratio(1, 0), .Ratio(0, 0), .Fill(0)], 15 => [.Fill(0), .Fill(3), .Fill(1)],
        16 => [.Min(4), .Max(2), .Length(9), .Ratio(2, 3)], 17 => [.Length(2), .Length(9), .Length(1)],
        18 => [.Ratio(1, 3), .Ratio(1, 3), .Ratio(1, 3)], 19 => [.Length(0), .Percentage(0), .Fill(0)],
        20 => [.Percentage(140), .Min(3)], 21 => [.Min(20), .Min(5), .Min(3)],
        22 => [.Ratio(31, 97), .Fill(2), .Max(7), .Min(1), .Fill(3)],
        _ => [.Fill(1), .Length(5), .Max(3), .Min(2), .Percentage(13), .Ratio(2, 9)],
    }
}
fn triple(r: &lay.Constraint) -> string {
    match r {
        .Length(a) => f"0 {a} 0", .Percentage(a) => f"1 {a} 0", .Ratio(a, b) => f"2 {a} {b}",
        .Min(a) => f"3 {a} 0", .Max(a) => f"4 {a} 0", .Fill(a) => f"5 {a} 0",
    }
}
fn rect(out: &mut []u8, r: tui.Rect) { bytes.append_utf8(&mut out, f" {r.x} {r.y} {r.w} {r.h}") }

fn emit(layout: &mut lay.Layout, area: tui.Rect, prefix: string, spec: &[]lay.Constraint) {
    split := layout.split_with_spacers(area)
    mut row := f"{prefix} {area.x} {area.y} {area.w} {area.h} {spec.len}".bytes()
    for r in spec { bytes.append_utf8(&mut row, " " + triple(&r)) }
    for r in &split.areas { rect(&mut row, r) }
    for r in &split.spacers { rect(&mut row, r) }
    print(bytes.decode(&row).unwrap())
}

fn random(seed: &mut i64, limit: i32) -> i32 {
    seed = (seed * 48271) % 2147483647
    i32(seed % i64(limit))
}

fn mixed() {
    mut seed: i64 = 31
    modes: [lay.Flex; 7] = [.Start, .Center, .End, .SpaceBetween, .SpaceAround, .SpaceEvenly, .Legacy]
    for trial in 0..2000 {
        d := random(&mut seed, 2); m := random(&mut seed, 7); gap := random(&mut seed, 15) - 5
        w := random(&mut seed, 130); h := random(&mut seed, 71)
        mx := random(&mut seed, 4); my := random(&mut seed, 4)
        n := 1 + random(&mut seed, 8)
        mut spec: []lay.Constraint = []
        for _ in 0..n {
            k := random(&mut seed, 6)
            a := u16(random(&mut seed, if k == 1 { 160 } else { 27 }))
            b := u32(random(&mut seed, 19))
            rule: lay.Constraint = match k {
                0 => .Length(a), 1 => .Percentage(a), 2 => .Ratio(u32(a), b), 3 => .Min(a),
                4 => .Max(a), _ => .Fill(a),
            }
            spec.push(rule)
        }
        axis: lay.Direction = if d == 0 { .Horizontal } else { .Vertical }
        mut layout := lay.Layout::new(axis, spec.clone()).flex(modes[m]).spacing(gap).margin(mx, my)
        emit(&mut layout, tui.Rect { x: trial % 7, y: trial % 11, w: w, h: h }, f"{d} {m} {gap} {mx} {my}", &spec)
    }
}

fn limits() {
    modes: [lay.Flex; 7] = [.Start, .Center, .End, .SpaceBetween, .SpaceAround, .SpaceEvenly, .Legacy]
    for k in 0..7 {
        spec: []lay.Constraint = match k {
            0 => [.Ratio(4294967295, 4294967294), .Fill(1)],
            1 => [.Ratio(4294967295, 1), .Max(65535)],
            2 => [.Fill(65535), .Fill(65534), .Length(3)],
            3 => [.Length(9), .Fill(0), .Min(30), .Fill(65535)],
            4 => [.Max(65535), .Percentage(65535)],
            5 => [.Fill(0), .Fill(0), .Fill(0)],
            _ => [.Length(2), .Length(2), .Fill(1)],
        }
        for m in 0..7 {
            for gap in [-32767, -1, 0, 32767, 60000] {
                mut l := lay.Layout::horizontal(spec.clone()).flex(modes[m]).spacing(gap)
                for w in [3, 37, 320, 65535] {
                    emit(&mut l, tui.Rect { x: 0, y: 0, w: w, h: 3 }, f"0 {m} {gap} 0 0", &spec)
                }
            }
        }
    }
}

fn geometry_case(a:tui.Rect, b:tui.Rect, dx:i32, dy:i32, mx:i32, my:i32, ix:i32, pos:i64) {
    mut line := f"{dx} {dy} {mx} {my} {ix} {pos}".bytes()
    for r in [a, b, a.inner(mx, my), a.outer(mx, my), a.offset(dx, dy), a.resize(b.w, b.h), a.union(b), a.intersection(b), a.clamp_to(b)] {
        rect(&mut line, r)
    }
    for part in [a.row_at(ix), a.column_at(ix)] {
        match part { .Some(r) => { rect(&mut line, r) }, .None => { bytes.append_utf8(&mut line, " -1 -1 -1 -1") }, }
    }
    (x, y) := a.position_at(pos).unwrap_or((-1, -1))
    bytes.append_utf8(&mut line, f" {x} {y} {a.right()} {a.bottom()} {a.cell_count()}")
    for flag in [a.is_empty(), a.intersects(b), a.contains(b.x, b.y)] { bytes.append_utf8(&mut line, if flag { " 1" } else { " 0" }) }
    print(bytes.decode(&line).unwrap())
}

fn geometry() {
    mut seed: i64 = 53
    for _ in 0..1200 {
        a := tui.Rect { x: random(&mut seed, 40), y: random(&mut seed, 40), w: random(&mut seed, 60), h: random(&mut seed, 60) }
        b := tui.Rect { x: random(&mut seed, 40), y: random(&mut seed, 40), w: random(&mut seed, 60), h: random(&mut seed, 60) }
        dx := random(&mut seed, 125) - 62; dy := random(&mut seed, 125) - 62
        mx := random(&mut seed, 7); my := random(&mut seed, 7)
        ix := random(&mut seed, 64)
        pos := i64(random(&mut seed, 3700))
        geometry_case(a,b,dx,dy,mx,my,ix,pos)
    }
    areas := [tui.Rect::new(0,0,65535,65535),tui.Rect::new(65527,65530,8,5),tui.Rect::new(65534,65534,2,3),
        tui.Rect::new(65535,0,8,7),tui.Rect::new(0,65535,3,7),tui.Rect::new(30000,40900,45789,32000)]
    for a in areas { for b in areas {
        for d in [-2147483648,-65535,-1,0,1,65535,2147483647] {
            for m in [0,1,32767,32768,65535] {
                geometry_case(a,b,d,d/2,m,65535-m,3,17)
            }
        }
    } }
}

fn large_minimums() {
    modes: [lay.Flex; 7] = [.Start,.Center,.End,.SpaceBetween,.SpaceAround,.SpaceEvenly,.Legacy]
    for d in 0..2 {
        direction: lay.Direction = if d == 0 { .Horizontal } else { .Vertical }
        for m in 0..7 {
            for gap in [-1,0,2] {
                mut layout := lay.Layout::new(direction,[]).flex(modes[m]).spacing(gap)
                for k in 0..6 {
                    for value in [32766,32767,32768,32769,65534,65535] {
                        min := u16(value)
                        rules: []lay.Constraint = match k {
                            0 => [.Min(min),.Length(7)],
                            1 => [.Length(7),.Min(min),.Max(4)],
                            2 => [.Min(min),.Min(8),.Fill(2)],
                            3 => [.Max(16),.Min(min),.Ratio(1,3),.Percentage(25)],
                            4 => [.Min(min),.Min(min),.Length(9)],
                            _ => [.Length(3),.Min(min),.Fill(2),.Max(7),.Percentage(40),.Min(1),.Ratio(1,5),.Fill(1),.Min(min)],
                        }
                        layout.set_constraints(rules.clone())
                        for extent in [13,100,32770,65535] {
                            area := tui.Rect { x:0, y:0, w:if d == 0 { extent } else { 4 }, h:if d == 0 { 4 } else { extent } }
                            emit(&mut layout,area,f"{d} {m} {gap} 0 0",&rules)
                        }
                    }
                }
            }
        }
    }
}

fn many_panels() {
    modes: [lay.Flex; 7] = [.Start, .Center, .End, .SpaceBetween, .SpaceAround, .SpaceEvenly, .Legacy]
    for n in [12, 24] {
        for d in 0..2 {
            direction: lay.Direction = if d == 0 { .Horizontal } else { .Vertical }
            for m in 0..7 {
                for gap in [0, 2] {
                    mut layout := lay.Layout::new(direction, []).flex(modes[m]).spacing(gap)
                    for kind in 0..7 {
                        rule: lay.Constraint = match kind {
                            0 => .Length(6), 1 => .Percentage(12), 2 => .Ratio(1, 9),
                            3 => .Min(7), 4 => .Max(8), _ => .Fill(2),
                        }
                        mut spec := rule.repeat(n)
                        if kind == 6 {
                            for i in 0..n {
                                spec[i] = match i % 6 {
                                    0 => .Length(8), 1 => .Percentage(4), 2 => .Ratio(1, 13),
                                    3 => .Min(3), 4 => .Max(5), _ => .Fill(2),
                                }
                            }
                        }
                        layout.set_constraints(spec.clone())
                        for extent in [17, 79, 191] {
                            area := tui.Rect::new(2, 3, if d == 0 { extent } else { 4 }, if d == 0 { 4 } else { extent })
                            emit(&mut layout, area, f"{d} {m} {gap} 0 0", &spec)
                        }
                    }
                }
            }
        }
    }
    for n in [9, 10, 11, 12] {
        width: lay.Constraint = .Length(8)
        spec := width.repeat(n)
        for gap in [1, 2, 4] {
            mut layout := lay.Layout::horizontal(spec.clone()).flex(.SpaceAround).spacing(gap)
            for boundary in [n * gap, n * (8 + gap), n * (8 + 2 * gap)] {
                for delta in [-1, 0, 1] {
                    area := tui.Rect::new(1, 2, boundary + delta, 3)
                    emit(&mut layout, area, f"0 4 {gap} 0 0", &spec)
                }
            }
        }
    }
}

fn mixed_panels() {
    modes: [lay.Flex; 7] = [.Start, .Center, .End, .SpaceBetween, .SpaceAround, .SpaceEvenly, .Legacy]
    for n in [32, 48] {
        spec := panels.rules(n)
        for m in 0..7 {
            for gap in [-1,0,2] {
                for d in 0..2 {
                    axis: lay.Direction = if d == 0 { .Horizontal } else { .Vertical }
                    mut grid := lay.Layout::new(axis,spec.clone()).flex(modes[m]).spacing(gap).margin(2,1)
                    extent := n * (5+d)
                    area := tui.Rect::new(7,11,if d == 0 { extent } else { 9 },if d == 0 { 11 } else { extent })
                    emit(&mut grid,area,f"{d} {m} {gap} 2 1",&spec)
                }
            }
        }
    }
}

fn minimum_levels() {
    modes: [lay.Flex;3] = [.Start,.Center,.End]
    mut seed: i64 = 197
    for trial in 0..720 {
        n := 3 + random(&mut seed,10)
        mut spec: []lay.Constraint = []
        mut floors := 0
        for _ in 0..n {
            floor := u16(random(&mut seed,18))
            r: lay.Constraint = match random(&mut seed,8) {
                0 => .Length(floor), 1 => .Max(floor), 2 => .Fill(1), 3 => .Fill(if trial%3 == 0 { 2 } else { 1 }),
                4 if trial%5 == 0 => .Min(32768), _ => .Min(floor),
            }
            match &r { .Min(v) if v <= 32767 => { floors += i32(v) }, .Length(v) => { floors += i32(v) }, .Max(v) => { floors += i32(v) }, _ => {}, }
            spec.push(r)
        }
        gap := trial%7-3
        m := trial%3
        d := (trial/3)%2
        axis: lay.Direction = if d == 0 { .Horizontal } else { .Vertical }
        mut grid := lay.Layout::new(axis,spec.clone()).flex(modes[m]).spacing(gap)
        for delta in [-1,0,1,13] {
            size := floors+gap*(n-1)+delta
            extent := if size < 1 { 1 } else { size }
            area := tui.Rect::new(3,2,if d == 0 { extent } else { 7 },if d == 0 { 7 } else { extent })
            emit(&mut grid,area,f"{d} {m} {gap} 0 0",&spec)
        }
    }
}

fn benchmark_panels() {
    for mode in ["minimums","crowded","overlap","weighted","cached"] {
        mut spec := panels.rules(32)
        if mode == "weighted" { spec[10] = .Fill(3) }
        gap := if mode == "overlap" { -1 } else { 1 }
        mut grid := lay.Layout::horizontal(spec.clone()).spacing(gap).margin(2,1).cache_capacity(1)
        for i in 0..3 {
            w := (if mode == "crowded" { 79 } else { 160 }) + (if mode == "cached" { 0 } else { i })
            emit(&mut grid,tui.Rect::new(7,11,w,11),f"0 0 {gap} 2 1",&spec)
        }
    }
}

fn main() {
    if sys.arg_count() == 2 && sys.arg(1) == "--benchmark-panels" { benchmark_panels(); return }
    if sys.arg_count() == 2 && sys.arg(1) == "--minimum-levels" { minimum_levels(); return }
    if sys.arg_count() == 2 && sys.arg(1) == "--mixed-panels" { mixed_panels(); return }
    if sys.arg_count() == 2 && sys.arg(1) == "--rules" { rule_values(); return }
    if sys.arg_count() == 2 && sys.arg(1) == "--many-panels" { many_panels(); return }
    if sys.arg_count() == 2 && sys.arg(1) == "--minimums" { large_minimums(); return }
    if sys.arg_count() == 2 && sys.arg(1) == "--geometry" { geometry(); return }
    if sys.arg_count() == 2 && sys.arg(1) == "--limits" { limits(); return }
    if sys.arg_count() == 2 && sys.arg(1) == "--frames" {
        mut scene := layout_scene.Scene::new()
        for mode in ["idle", "cell", "scroll", "resize", "repaint"] {
            for n in 0..220 {
                mut frame := tui.Frame::new(if mode == "resize" && n % 2 == 0 { 80 } else { 96 }, 24)
                scene.draw(&mut frame, mode, n)
                cells.snapshot(&frame)
            }
        }
        return
    }
    modes: [lay.Flex; 7] = [.Start, .Center, .End, .SpaceBetween, .SpaceAround, .SpaceEvenly, .Legacy]
    for k in 0..24 {
        for m in 0..7 {
            for gap in [-3, 0, 1, 4] {
                spec := rules(k)
                for d in 0..2 {
                    direction: lay.Direction = if d == 0 { .Horizontal } else { .Vertical }
                    hmargin := (k + m) % 3
                    vmargin := (k + 2 * m) % 3
                    mut layout := lay.Layout::new(direction, spec.clone()).flex(modes[m]).spacing(gap).margin(hmargin, vmargin)
                    for size in [0, 1, 2, 4, 7, 13, 21, 77, 120] {
                        w := if d == 0 { size } else { 10 }
                        h := if d == 0 { 10 } else { size }
                        area := tui.Rect { x: 3, y: 5, w: w, h: h }
                        emit(&mut layout, area, f"{d} {m} {gap} {hmargin} {vmargin}", &spec)
                    }
                }
            }
        }
    }
    mixed()
}

fn inspect_rules(rules: &[]lay.Constraint) {
    print(f"{rules.len}")
    mut encoded: []u8 = []
    encoded.reserve(131072)
    for rule in rules {
        print(f"{rule}")
        encoded.clear()
        for extent in 0..65536 {
            result := rule.apply(u16(extent))
            encoded.push(u8(result / 256))
            encoded.push(u8(result % 256))
        }
        print(bytes.hex(&encoded))
    }
}

fn rule_values() {
    values: []u16 = [0, 1, 3, 17, 53, 99, 100, 101, 32768, 65535]
    pairs: [](u32,u32) = [(0,0), (1,0), (0,9), (2,3), (7,11), (16777215,16777217), (4294967294,4294967295), (4294967295,1)]
    inspect_rules(&[lay.Constraint::default()])
    inspect_rules(&lay.Constraint::from_lengths(&[]))
    inspect_rules(&lay.Constraint::from_lengths(&values))
    inspect_rules(&lay.Constraint::from_percentages(&values))
    inspect_rules(&lay.Constraint::from_ratios(&pairs))
    inspect_rules(&lay.Constraint::from_mins(&values))
    inspect_rules(&lay.Constraint::from_maxes(&values))
    inspect_rules(&lay.Constraint::from_fills(&values))
    mut layout := lay.Layout::default()
    mut direction := lay.Direction::default()
    for count in [0, 3, 8] {
        layout.set_constraints(lay.Constraint::from_ratios(&pairs[0..count]))
        for step in 0..4 {
            if step != 0 {
                direction = direction.perpendicular()
                layout.set_direction(direction)
            }
            for area in [tui.Rect::new(2,3,13,7), tui.Rect::new(5,1,11,11), tui.Rect::new(2,3,13,7)] {
                view := layout.arrange(area).regions()
                mut row: []u8 = []
                for r in &view.areas { rect(&mut row,r) }
                for r in &view.spacers { rect(&mut row,r) }
                print(bytes.decode(&row).unwrap())
            }
        }
    }
}
