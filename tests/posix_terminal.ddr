capability unsafe, stdio

import .terminal_driver as driver
import ..src.tui
import ..src.text as rich
import ..src.widgets as ui
import std.bytes as bytes
import std.text as text
import sys
import .cell_widgets

@extern("c", "openpty")
unsafe fn open_pty(master: ptr, slave: ptr, name: ptr, attributes: ptr, size: ptr) -> i32
@extern("c", "dup")
unsafe fn duplicate(fd: i32) -> i32
@extern("c", "dup2")
unsafe fn redirect(fd: i32, target: i32) -> i32
@extern("c", "tcgetattr")
unsafe fn attributes(fd: i32, buf: ptr) -> i32
@c_variadic(2)
@extern("c", "ioctl")
unsafe fn ioctl(fd: i32, request: usize, data: ptr) -> i32

struct Probe { master: i32, slave: i32, step: i32, quit: string, ok: bool, timed: bool, ticks: i32, last: i64 }

fn send(fd: i32, data: string) -> bool {
    buf := data.bytes()
    unsafe { return sys.fd_write(fd, &buf, 0, i64(buf.len)) == i64(buf.len) }
    false
}

struct CursorOutput { fd: i32 }
impl tui.Backend for CursorOutput {
    fn size(&mut self) -> (i32,i32) { (32,7) }
    fn set_cursor_visible(&mut self, visible: bool) -> Result<(),string> {
        if send(self.fd, if visible { "\x1b[?25h" } else { "\x1b[?25l" }) { .Ok } else { .Err("write") }
    }
    fn present(&mut self, frame: &tui.Frame, previous: &tui.Frame) -> Result<(),string> {
        self.set_cursor_visible(frame.cursor_position().is_some())
    }
}

fn use_cursor(master: i32, slave: i32) -> Result<(),string> {
    mut t := tui.Terminal<CursorOutput>::new(CursorOutput { fd:slave })
    t.apply_buffer()?
    assert(output(master) == "\x1b[?25l")
    .Err("leave")
}

fn draw(frame: &mut tui.Frame, state: &Probe) {
    (heading, body) := frame.area().rows(1)
    frame.text(heading, "Rubrik", tui.ink(.LightCyan).italic().underlined().underline_color(.Indexed(199)))
    frame.label(body, f"Steg {state.step} med bredd {body.w}")
    values: []u64 = [0,1,2,3,4,5,6,7,8]
    ui.Sparkline::new(&values).render(&mut frame, tui.Rect { x: 0, y: 2, w: 9, h: 1 })
    cell_widgets.swatch(&mut frame,12,2)
    if frame.area().h >= 6 {
        frame.label(tui.Rect { x: 0, y: 3, w: 10, h: 3 }, if state.step == 0 {
            "😶‍🌫️a\n😶‍🌫b\n👩🏽‍💻c"
        } else { "😶‍🌫️d\n😶‍🌫e\n👩🏽‍💻f" })
    }
    if frame.area().h >= 7 {
        line := rich.Line::new([rich.Span::raw("لا"), rich.Span::raw(if state.step == 0 { "!" } else { "?" })])
        line.render(&mut frame, tui.Rect { x: 12, y: 6, w: 4, h: 1 })
    }
    if state.timed && state.ticks < 2 { return }
    if state.step == 0 { assert(send(state.master, "\x1b[A")) }
    else if state.step == 1 { assert(send(state.master, "\x1b[B")) }
    else { assert(send(state.master, state.quit)) }
}

fn output(fd: i32) -> string {
    mut buf: []u8 = []
    mut pollfd: []u8 = [u8(fd.bit_and(255)), u8(fd.shr(8).bit_and(255)), u8(fd.shr(16).bit_and(255)), u8(fd.shr(24)), 1, 0, 0, 0]
    unsafe {
        while sys.fd_poll(&mut pollfd, 1, 0) == 1 {
            buf.reserve(buf.len + 4096)
            if sys.fd_read(fd, &mut buf, 4096) <= 0 { break }
        }
    }
    bytes.decode(&buf).unwrap()
}

fn resize(fd: i32) -> bool {
    mut size: [u16; 4] = [4, 20, 0, 0]
    unsafe {
        if target_is("macos") { return ioctl(fd, 0x80087467, addr(&size[0])) == 0 }
        else { return ioctl(fd, 0x5414, addr(&size[0])) == 0 }
    }
    false
}

fn resized_screen(output: string) -> bool {
    mut screen := driver.Screen::new(20,4)
    screen.apply(output)
    text.contains(output,"\x1b[2J") && screen.contains(0,"Rubrik") && screen.contains(1,"Steg 2 med bredd 20")
}

fn update(state: &mut Probe, key: tui.Key) -> bool {
    rendered := output(state.master)
    if state.step == 0 {
        mut initial := driver.Screen::new(32,7)
        initial.apply(rendered)
        state.ok = text.contains(rendered, "\x1b[?1049h") && initial.contains(1,"Steg 0 med bredd 32") &&
        text.contains(rendered, "\x1b[96;58;5;199;3;4mRubrik") && text.contains(rendered, "▁▂▃▄▅▆▇█") &&
        text.contains(rendered, "😶‍🌫️\x1b[4;3Ha") && text.contains(rendered, "😶‍🌫b") && text.contains(rendered, "👩🏽‍💻c") &&
        text.contains(rendered, "\x1b[7;13Hل!") && initial.contains(2,"xy  #")
        match key { .Up => {}, _ => { state.ok = false }, }
    } else if state.step == 1 {
        state.ok = rendered == "\x1b[2;6H1\x1b[4;3Hd\x1b[5;4He\x1b[6;3Hf\x1b[7;14H?" && resize(state.slave)
        match key { .Down => {}, _ => { state.ok = false }, }
    } else {
        state.ok = resized_screen(rendered)
        match key { .Char(c) if i32(c) == 113 => {}, _ => { state.ok = false }, }
    }
    state.step += 1
    state.ok && state.step < 3
}

fn tick(state: &mut Probe, elapsed: i64) -> bool {
    assert(elapsed > state.last)
    state.last = elapsed
    state.ticks += 1
    true
}

unsafe fn verify(quit: string, timed: bool) -> bool {
    mut master := -1
    mut slave := -1
    mut size: [u16; 4] = [7, 32, 0, 0]
    if open_pty(addr(&mut master), addr(&mut slave), ptr(0), ptr(0), addr(&size[0])) != 0 { return false }
    defer { _ := sys.fd_close(master); _ := sys.fd_close(slave) }
    if use_cursor(master,slave).is_ok() || output(master) != "\x1b[?25h" { return false }
    in_fd := duplicate(0)
    out_fd := duplicate(1)
    defer {
        _ := redirect(in_fd, 0)
        _ := redirect(out_fd, 1)
        _ := sys.fd_close(in_fd)
        _ := sys.fd_close(out_fd)
    }
    if in_fd < 0 || out_fd < 0 || redirect(slave, 0) < 0 || redirect(slave, 1) < 0 { return false }
    mut before: [u64; 16] = [0; 16]
    mut after: [u64; 16] = [0; 16]
    if attributes(slave, addr(&mut before[0])) != 0 { return false }
    mut state := Probe { master: master, slave: slave, step: 0, quit: quit.clone(), ok: true, timed: timed, ticks: 0, last: 0 }
    result := if timed { tui.animate(&mut state, 60, draw, update, tick) } else { tui.run(&mut state, draw, update) }
    tail := output(master)
    if result.is_err() || !state.ok || !text.contains(tail, "\x1b[?25h\x1b[?1049l") { return false }
    if quit == "q" && state.step != 3 { return false }
    if quit != "q" && (state.step != 2 || !resized_screen(tail)) { return false }
    if attributes(slave, addr(&mut after[0])) != 0 { return false }
    if target_is("macos") {
        before[3] = before[3].bit_and(u64(0x20000000).bit_not())
        after[3] = after[3].bit_and(u64(0x20000000).bit_not())
    }
    for i in 0..16 { if before[i] != after[i] { return false } }
    true
}

fn main() -> i32 {
    if target_is("linux") || target_is("macos") {
        unsafe { if verify("q", false) && verify("\x03", false) && verify("q", true) { print("terminal OK"); return 0 } }
    }
    _ := sys.eprint("POSIX terminal check failed")
    1
}
