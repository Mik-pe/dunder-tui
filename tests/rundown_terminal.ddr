capability unsafe, stdio, process
import .terminal_driver as driver
import sys

fn exercise(master: i32, slave: i32, screen: &mut driver.Screen) -> bool {
    unsafe {
        if !driver.wait_for(master,&mut screen,screen.h-1,"byt pass","\x1b[?1049h") || !screen.contains(1,"› · Öppna entrén") { return false }
        if !driver.send(master,"j") || !driver.wait_for(master,&mut screen,2,"› · Öppna entrén","") || !screen.contains(1,"· Ljudprov") { return false }
        if !driver.send(master," ") || !driver.wait_for(master,&mut screen,2,"› ✓ Öppna entrén","") { return false }
        if !driver.send(master,"\t") || !driver.wait_for(master,&mut screen,0,"Kvällspass","") || !screen.contains(1,"Tänd scenljuset") { return false }
        if !driver.send(master,"\t") || !driver.wait_for(master,&mut screen,0,"Dagpass","") || !screen.contains(2,"✓ Öppna entrén") { return false }
        if !driver.send(master,"q") || !driver.wait_for(master,&mut screen,0,"","\x1b[?1049l") { return false }
    }
    true
}

fn main() -> i32 {
    if sys.arg_count() == 2 && (target_is("macos") || target_is("linux")) {
        unsafe { if driver.test(sys.arg(1),72,8,exercise) { print("Cue order, completion, program exchange and terminal restoration OK"); return 0 } }
    }
    1
}
