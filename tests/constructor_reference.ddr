capability stdio
import std.json
import ..src.tui
import .constructor_scene as scene

fn emit(key: string, shape: string, frame: &tui.Frame) {
    print(key+"\t"+shape+"\t"+json.to_string(&frame).unwrap())
}

fn main() {
    for n in [0,1,3,8] {
        for size in [(0,0),(1,2),(6,4),(19,7),(33,5)] {
            area := tui.Rect::new(2,1,size.0,size.1)
            bounds := tui.Rect::new(0,0,size.0+4,size.1+2)
            for kind in 0..13 {
                item := scene.span(kind,n)
                mut frame := tui.Frame::at(bounds)
                frame.render_widget(&item,area)
                emit(f"S{n}/{kind}",json.to_string(&item.to_string()).unwrap(),&frame)
            }
            for kind in 0..5 {
                line := scene.line(kind,n)
                mut a := tui.Frame::at(bounds)
                a.render_widget(&line,area)
                emit(f"L{n}/{kind}",f"{line.spans().len}/{line.width()} "+json.to_string(&line.to_string()).unwrap(),&a)
                doc := scene.document(kind,n)
                mut b := tui.Frame::at(bounds)
                b.render_widget(&doc,area)
                emit(f"T{n}/{kind}",f"{doc.height()}/{doc.width()} "+json.to_string(&doc.to_string()).unwrap(),&b)
                mut table := scene.grid(kind,n)
                mut c := tui.Frame::at(bounds)
                table.render(&mut c,area)
                emit(f"R{n}/{kind}","",&c)
            }
            mut edited := scene.grid(5,n)
            mut table_frame := tui.Frame::at(bounds)
            edited.render(&mut table_frame,area)
            emit(f"R{n}/5","",&table_frame)
            for kind in 0..4 {
                for vertical in [false,true] {
                    mut layout := scene.layout_for(vertical,kind,n)
                    parts := layout.split_with_spacers(area)
                    mut frame := tui.Frame::at(bounds)
                    for i in 0..parts.areas.len {
                        frame.text(parts.areas[i],f"{i}",tui.ink(.Yellow))
                    }
                    emit(f"A{n}/{kind}/{vertical}",json.to_string(&parts.areas).unwrap()+" "+json.to_string(&parts.spacers).unwrap(),&frame)
                }
            }
        }
    }
}
