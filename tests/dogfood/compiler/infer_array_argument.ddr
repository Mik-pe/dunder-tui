trait Width { fn width(&self) -> i32 }

struct Item { cells: i32 }
impl Width for Item { fn width(&self) -> i32 { self.cells } }

struct Counter {}
impl Counter {
    fn total<T: Width>(&self, items: &[]T) -> i32 {
        mut sum := 0
        for item in items { sum += item.width() }
        sum
    }
}

fn main() {
    counter := Counter {}
    assert(counter.total(&[Item {cells: 2}, Item {cells: 3}]) == 5)
}
