import std.json

fn main() {
    pos := (u16(20),u16(4))
    wire := json.to_string(&pos).unwrap()
    assert(wire == "[20,4]")
    restored := json.from_str<(u16,u16)>(wire).unwrap()
    assert(restored == pos)
    assert(json.from_str<(u16,u16)>("[20]").is_err())
    assert(json.from_str<(u16,u16)>("[20,4,1]").is_err())
    assert(json.from_str<(u16,u16)>("[20,65536]").is_err())
    points: [](i32,i32) = [(3,5),(4,5)]
    encoded := json.to_string(&points).unwrap()
    assert(encoded == "[[3,5],[4,5]]")
    decoded := json.from_str<[](i32,i32)>(encoded).unwrap()
    assert(decoded.len == 2 && decoded[0] == (3,5) && decoded[1] == (4,5))
    assert(json.from_str<[](i32,i32)>("[[3,5],[4]]").is_err())
}
