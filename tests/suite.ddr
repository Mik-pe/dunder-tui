@test fn clipped_spans_keep_zero_width_characters_out_of_alignment_and_scroll() {
    line := rich.Line::new([
        rich.Span::styled("\u{200b}A\u{200b}", tui.ink(.Cyan)),
        rich.Span::raw(""),
        rich.Span::styled("茶\u{200b}B", tui.ink(.Yellow).bold()),
    ])
    mut paragraph := rich.Paragraph::from(move line).align(.Center)
    for width in [4, 5, 8] {
        mut frame := tui.Frame::new(width, 1)
        paragraph.render(&mut frame, frame.area())
        start := width / 2 - 2
        assert(frame.symbol_at(start, 0).unwrap() == "A")
        assert(frame.style_at(start, 0).unwrap().get_foreground() == .Some(tui.Color.Cyan))
        assert(frame.symbol_at(start + 1, 0).unwrap() == "茶")
        assert(frame.symbol_at(start + 3, 0).unwrap() == "B")
        assert(frame.style_at(start + 3, 0).unwrap().has(.Bold))
    }
    paragraph = paragraph.align(.Left)
    paragraph.set_scroll(0, 1)
    mut narrow := tui.Frame::new(3, 1)
    paragraph.render(&mut narrow, narrow.area())
    assert(narrow.symbol_at(0, 0).unwrap() == "茶" && narrow.symbol_at(2, 0).unwrap() == "B")
}

struct Pier { name: string }
impl rich.IntoText for Pier {
    fn into_text(move self) -> rich.Text {
        content := rich.Span::styled(move self.name,tui.ink(.Green))
        content.into_text()
    }
}

@test fn list_items_table_cells_and_paragraphs_accept_owned_text_sources() {
    cell := table.Cell::from(rich.Line::raw("KAJ").styled(tui.ink(.Red)).align(.Right))
    assert(cell.content.lines()[0].get_alignment() == .Right && cell.content.lines()[0].get_style() == tui.ink(.Red))
    item := lists.Item::from(Pier { name:"VIK" })
    assert(item.width() == 3 && item.content.lines()[0].spans()[0].get_style() == tui.ink(.Green))
    lines: []rich.Line = [rich.Line::raw("hamn"),rich.Line::raw("ö")]
    paragraph := rich.Paragraph::from(move lines)
    mut frame := tui.Frame::new(4,2)
    paragraph.render(&mut frame,frame.area())
    assert(frame.line(0) == "hamn" && frame.line(1) == "ö   ")
}

@test fn repeated_styled_text_has_independent_editable_parts() {
    seed := rich.Span::styled("茶",tui.ink(.Cyan).bold())
    mut line := rich.Line::repeat(move seed,3)
    line.span_mut(1).set_content("X")
    assert(line.to_string() == "茶X茶" && line.width() == 5)
    mut doc := rich.Text::repeat(move line,2)
    doc.line_mut(0).span_mut(2).set_content("IS")
    assert(doc.lines()[0].to_string() == "茶XIS" && doc.lines()[1].to_string() == "茶X茶")
    assert(doc.lines()[1].spans()[2].get_style() == tui.ink(.Cyan).bold())
    assert(rich.Span::default().width() == 0 && rich.Line::default().spans().len == 0)
    assert(rich.Text::default().height() == 0 && rich.Text::repeat(rich.Line::raw("x"),0).height() == 0)
    strings := rich.Line::strings(["A\nB","","C"])
    assert(strings.spans().len == 3 && strings.spans()[0].content() == "A\nB" && strings.to_string() == "ABC")
    lines := rich.Text::strings(["A\r\nB","","C"])
    assert(lines.height() == 3 && lines.lines()[0].spans().len == 2)
}

@test fn a_default_table_row_uses_no_screen_line_and_a_zero_cell_row_uses_one() {
    empty := table.Row::default()
    blank := table.Row::repeat(table.Cell::raw(""),0)
    assert(empty.height == 0 && blank.height == 1)
    mut row := table.Row::repeat(table.Cell::raw("茶"),3)
    row.cells[1].content.line_mut(0).span_mut(0).set_content("Ö")
    assert(row.cells[0].content.to_string() == "茶" && row.cells[2].content.to_string() == "茶")
    width: layout.Constraint = .Length(4)
    mut table := table.Table::new([move empty,table.Row::strings(["A"]),move blank,move row],width.repeat(3))
    mut frame := tui.Frame::new(16,4)
    table.render(&mut frame,frame.area())
    assert(frame.symbol_at(0,0).unwrap() == "A" && frame.line(1) == "                ")
    assert(frame.symbol_at(5,2).unwrap() == "Ö" && frame.symbol_at(10,2).unwrap() == "茶")
}

@derive(Encode, Decode)
struct SavedPreferences { name: string, styles: []Option<snapshot.WithoutUnderlineColor<tui.Style>> }

@test fn application_records_can_embed_snapshots_with_standard_json() {
    raw := "{\"name\":\"log\",\"styles\":[null,{\"fg\":\"Yellow\",\"underline_color\":false,\"add_modifier\":\"UNDERLINED\"}]}"
    prefs := json.from_str<SavedPreferences>(raw).unwrap()
    assert(prefs.styles[0].is_none() && prefs.styles[1].unwrap().value == tui.ink(.Yellow).underlined())
    saved := json.to_string(&prefs).unwrap()
    assert(saved == "{\"name\":\"log\",\"styles\":[null,{\"fg\":\"Yellow\",\"add_modifier\":\"UNDERLINED\"}]}")
}

@test fn snapshots_preserve_the_underline_modifier_in_both_formats() {
    mut frame := tui.Frame::new(3,1)
    area := frame.area()
    frame.text(area,"ABC",tui.ink(.Green).underlined().underline_color(.Rgb(208,64,192)))
    empty := tui.Frame::new(0,0)
    formats: [snapshot.Format;2] = [.WithUnderlineColor,.WithoutUnderlineColor]
    for format in formats {
        saved := snapshot.to_string(&frame,format).unwrap()
        restored := snapshot.from_str<tui.Frame>(saved,format).unwrap()
        cell := restored.raw_cell_at(0,0).unwrap()
        assert(cell.modifier.contains(.Underlined) && cell.fg == .Green)
        assert(words.contains(saved,"underline_color") == format.has_underline_color())
        assert((cell.underline_color == .Rgb(208,64,192)) == format.has_underline_color())
        mut output: []u8 = []
        restored.ansi_diff(&empty,&mut output)
        assert(words.contains(bytes.decode(&output).unwrap(),"58;2;208;64;192") == format.has_underline_color())
        if format.has_underline_color() { assert(saved == json.to_string(&frame).unwrap()) }
    }
    assert(frame.raw_cell_at(1,0).unwrap().underline_color == .Rgb(208,64,192))
}

@test fn positional_snapshots_validate_fields_and_ignore_unknown_object_keys() {
    format: snapshot.Format = .WithoutUnderlineColor
    style := snapshot.from_str<tui.Style>("[\"Yellow\",null,\"UNDERLINED\",\"BOLD\"]",format).unwrap()
    assert(style == tui.ink(.Yellow).underlined().without(.Bold))
    rows := "[[\"A\",\"Yellow\",\"Reset\",\"UNDERLINED\",\"None\",false]]"
    cells := snapshot.from_str<[]tui.RawCell>(rows,format).unwrap()
    assert(cells.len == 1 && cells[0].symbol == .Some("A") && cells[0].underline_color == .Default)
    assert(snapshot.from_str<[]tui.RawCell>(rows,.WithUnderlineColor).is_err())
    repeated := "{\"fg\":\"Red\",\"underline_color\":false,\"under\\u006cine_color\":42}"
    assert(snapshot.from_str<tui.Style>(repeated,format).unwrap() == tui.ink(.Red))
    assert(snapshot.from_str<tui.Style>(repeated,.WithUnderlineColor).is_err())
}

@test fn saved_palette_preserves_family_and_custom_shades() {
    mut colors := tailwind.Palette::from_family(.Sky)
    assert(colors.c950 == tailwind.color(.Sky,.C950))
    colors.c500 = .White
    loaded := json.from_str<tailwind.Palette>(json.to_string(&colors).unwrap()).unwrap()
    assert(loaded == colors && loaded.hash() == colors.hash() && loaded.get(.C500) == .Gray)
    assert(loaded.get(.C500) != .Indexed(7))
    variants: [u32;14] = [0x123456;14]
    custom := material.AccentedPalette::from_variants(&variants)
    assert(custom.c900 == tui.rgb(0x123456) && custom.accent(.A100) == custom.get(.C900))
    assert(tui.Color::parse("blacK") == .Some(.Black))
}

@test fn border_masks_roundtrip_extension_bits_and_padding_rejects_overflow() {
    mask := json.from_str<box.BorderMask>("\"ALL | 0xf0\"").unwrap()
    assert(mask.bits == 255 && mask.edges() == box.Borders::all() && mask.edges().mask().bits == 15)
    assert(json.from_str<box.BorderMask>(json.to_string(&mask).unwrap()).unwrap() == mask)
    assert(json.from_str<box.Borders>("\"0xf0\"").is_err())
    assert(json.to_string(&box.Padding::uniform(-1)).is_err())
    assert(json.from_str<box.Padding>("[0,0,65536,0]").is_err())
}

@test fn optional_alignment_represents_inheritance_in_saved_layouts() {
    explicit: rich.Alignment = .Inherit
    inherited: Option<rich.Alignment> = .None
    assert(json.to_string(&explicit).is_err() && json.to_string(&inherited).unwrap() == "null")
    assert(json.from_str<Option<rich.Alignment>>("null").unwrap().is_none())
    assert(rich.Alignment::default() == .Left && layout.VerticalAlignment::default() == .Top)
}

@test fn restored_backend_keeps_the_next_scrolled_line_and_cursor() {
    mut device := saved_backend.open()
    assert(device.scrollback().row(0).line(0) == "LOGG" && device.buffer().line(0) == "KAJ ")
    assert(device.cursor_visible() && device.cursor_position() == (2,1))
    saved_backend.advance(&mut device)
    assert(!device.cursor_visible() && device.cursor_position() == (3,2))
    assert(device.scrollback().row(1).line(0) == "KAJ " && device.buffer().line(0) == "SYD ")
}

@test fn scrollback_at_capacity_reflows_wide_symbols_and_discards_evicted_rows() {
    rows: []rich.Line = [rich.Line::raw("123"),rich.Line::raw("茶Z")]
    mut device := testing.TestBackend::with_lines(&rows)
    device.append_lines(65535)
    device.append_lines(2)
    assert(device.scrollback().len() == 65535 && device.scrollback().row(0).line(0) == "茶Z")
    device.resize(1,2)
    assert(device.scrollback().row(0).symbol_at(0,0).unwrap() == "茶")
    assert(device.scrollback().row(2).line(0) == "Z")
    device.append_lines(65535)
    assert(device.scrollback().row(0).line(0) == " " && device.scrollback().row(65534).line(0) == " ")
}

@test fn clearing_the_tail_of_a_glyph_preserves_the_cell_before_the_cursor() {
    mut device := testing.TestBackend::with_lines(&[rich.Line::raw("A茶B")])
    device.set_cursor_position(2,0)
    device.clear_region(.UntilNewLine)
    assert(device.buffer().symbol_at(1,0).unwrap() == "茶")
    assert(device.buffer().raw_cell_at(2,0).unwrap().symbol.is_none())
    assert(device.buffer().raw_cell_at(3,0).unwrap().symbol.is_none())
}

@test fn scrolling_an_offset_frame_moves_cluster_styles_and_diff_rules_together() {
    mut frame := tui.Frame::at(tui.Rect::new(4,6,5,4))
    _ := frame.set_cell(4,6,"A",tui.ink(.Cyan))
    _ := frame.set_cell(5,7,"👩‍🚀",tui.ink(.Red))
    _ := frame.set_diff_option(5,7,.AlwaysUpdate)
    _ := frame.set_cell(4,8,"é",tui.ink(.Blue))
    _ := frame.set_cell(4,9,"Z",tui.plain())
    frame.scroll_rows(7,10,1)
    assert(frame.raw_cell_at(5,7).unwrap().symbol.is_none())
    assert(frame.cell_at(5,8).unwrap().symbol == "👩‍🚀" && frame.diff_option_at(5,8).unwrap() == .AlwaysUpdate)
    assert(frame.cell_at(4,9).unwrap().symbol == "é" && frame.cell_at(4,6).unwrap().symbol == "A")
    frame.scroll_rows(7,10,-1)
    assert(frame.raw_cell_at(5,7).unwrap().fg == .Red)
    assert(frame.raw_cell_at(4,8).unwrap().fg == .Blue)
    frame.resize(6,5)
    saved := json.from_str<tui.Frame>(json.to_string(&frame).unwrap()).unwrap()
    assert(frame.diff_positions(&saved).unwrap().len == 1)
    frame.scroll_rows(-100,100,-2147483648)
    for y in 6..11 { assert(frame.row_is_blank(y)) }
}

