@test fn moving_text_collections_updates_width_and_preserves_the_outer_style() {
    mut doc := rich.Text::raw("longest\nx").styled(tui.ink(.Cyan)).align(.Right)
    rows := doc.lines_mut()
    rows.swap(0,1)
    removed := rows.remove(1)
    assert(doc.width() == 1 && doc.height() == 1)
    old := doc.line_mut(0).replace_spans(removed.into_spans())
    assert(old.len == 1 && old[0].content() == "x" && doc.width() == 7)
    doc.lines_mut()[0].spans_mut().clear()
    assert(doc.width() == 0 && doc.height() == 1)
    before := doc.replace_lines(rich.Text::raw("秋\na").into_lines())
    assert(before.len == 1 && before[0].spans().len == 0)
    assert(doc.width() == 2 && doc.height() == 2 && doc.get_alignment() == .Right && doc.get_style() == tui.ink(.Cyan))
}

@test fn overhanging_paragraphs_keep_the_visible_symbol_and_the_cell_under_it() {
    p := rich.Paragraph::raw("aaa界").wrap(.Trim).wide_wrap(.Overhang)
    for w in [4,5] {
        mut f := tui.Frame::new(w,2)
        f.fill(f.area(),`.`,tui.ink(.Red))
        _ := f.set_diff_option(w-1,0,.AlwaysUpdate)
        p.render(&mut f,tui.Rect{x:0,y:0,w:4,h:2})
        assert(f.cell_at(3,0).unwrap().symbol == "界")
        assert(f.diff_option_at(w-1,0).unwrap() == .AlwaysUpdate)
        if w == 5 { assert(f.cell_at(4,0).unwrap().symbol == ".") }
        assert(f.cell_at(0,1).unwrap().symbol == ".")
    }
}

@test fn artwork_defaults_preserve_the_surface_and_change_two_eye_cells() {
    area := tui.Rect { x:3, y:2, w:32, h:16 }
    mut frame := tui.Frame::at(area)
    frame.fill(area,`.`,tui.ink(.Green).background(.Blue).italic())
    frame.render_widget(art.RatatuiLogo::default(),area)
    assert(frame.symbol_at(3,2).unwrap() == "▛")
    assert(frame.symbol_at(18,2).unwrap() == ".")
    frame.render_widget(art.RatatuiMascot::default(),area)
    assert(frame.symbol_at(3,2).unwrap() == "▛")
    for x in 24..26 {
        eye := frame.cell_at(x,7).unwrap()
        assert(eye.symbol == "▀" && eye.style.has(.Italic))
        assert(eye.style.get_background().unwrap() == .Indexed(236))
    }
    frame.render_widget(art.RatatuiMascot { eye:.Red },area)
    for x in 24..26 { assert(frame.style_at(x,7).unwrap().get_background().unwrap() == .Indexed(196)) }
}

@test fn styled_graphemes_keep_span_boundaries_and_resolve_each_style() {
    base := tui.ink(.Red).bold().underline_rgb(0x123456)
    row := tui.plain().background(.Blue).italic()
    leaf := tui.ink(.Green).without(.Bold)
    line := rich.Line::new([
        rich.Span::raw("\x00\r\n"),rich.Span::raw("e"),rich.Span::styled("\u{301}\u{85}🇸🇪",leaf),
        rich.Span::raw(""),rich.Span::raw("👩🏽‍💻\u{200b}\u{a0}")
    ]).styled(row)
    mut stream := line.styled_graphemes(base)
    expected := ["e","\u{301}","🇸🇪","👩🏽‍💻","\u{200b}","\u{a0}"]
    for i in 0..expected.len {
        item := stream.next().unwrap()
        assert(item.symbol() == expected[i])
        assert(item.is_whitespace() == (i == 4))
        style := base.patch(row)
        assert(item.get_style() == (if i == 1 || i == 2 { style.patch(leaf) } else { style }))
        twin := rich.StyledGrapheme::new(&expected[i],item.get_style())
        assert(item == twin && item.hash() == twin.hash())
    }
    assert(stream.next().is_none() && stream.next().is_none())
    mut count := 0
    for item in line.spans()[2].styled_graphemes(base) {
        assert(item.symbol() == expected[count+1] && item.get_style() == base.patch(leaf))
        count += 1
    }
    assert(count == 2)
    mut seen := 0
    assert(!line.visit_graphemes(base,&mut seen,fn(count: &mut i32, symbol: &str, style: &tui.Style) -> bool {
        count += 1
        if count == 2 { assert(symbol == "\u{301}" && style.removes(.Bold)); return false }
        true
    }))
    assert(seen == 2)
    for value in ["","\u{a0}","\u{a0} ","\u{200b}","\u{200b} ","\r\n","\u{85}","a"] {
        mut item := rich.StyledGrapheme::new(&value,base)
        item.set_style(leaf)
        assert(item.symbol() == value && item.get_style() == leaf)
        assert(item.is_whitespace() == (value != "\u{a0}" && value != "\u{200b} " && value != "a"))
    }
}

@test fn appending_documents_transfers_lines_and_keeps_the_receivers_style() {
    for cached in [false,true] {
        mut first := rich.Text::new([]).styled(tui.ink(.Red)).align(.Right)
        mut second := rich.Text::raw("a\nbbbb").styled(tui.ink(.Green)).align(.Center)
        second.line_mut(1).set_style(tui.plain().italic())
        if !cached { second.line_mut(1).span_mut(0).set_content("秋秋") }
        first.append(move second)
        assert(first.width() == 4 && first.height() == 2)
        assert(first.get_style() == tui.ink(.Red) && first.get_alignment() == .Right)
        assert(first.lines()[1].get_style().has(.Italic))
        first.line_mut(1).span_mut(0).set_content("x")
        first.append(rich.Text::new([]))
        assert(first.width() == 1)
        first.append(rich.Text::raw("\nabcdef"))
        first.push_span(rich.Span::raw("!"))
        assert(first.width() == 7 && first.height() == 4 && first.to_string() == "a\nx\n\nabcdef!")
    }
}

@test fn row_fill_preserves_backgrounds_attributes_and_underlines() {
    for decorated in [false,true] {
        mut frame := tui.Frame::at(tui.Rect{x:4,y:11,w:97,h:3})
        for x in 4..101 {
            base := if x%2 == 0 { tui.ink(.Green).bold().background_rgb(0x147aa9) } else { tui.ink(.Yellow).inverted().background_index(222) }
            s := if decorated && x%3 == 0 { base.underline_color(.Cyan) } else { base }
            _ := frame.set_cell(x,12,"x",s)
        }
        area := tui.Rect{x:5,y:12,w:93,h:1}
        overlay := tui.ink(.Red).italic().without(.Bold)
        frame.fill(area,`·`,overlay)
        for x in 4..101 {
            s := frame.style_at(x,12).unwrap()
            inside := x >= 5 && x < 98
            assert(frame.symbol_at(x,12).unwrap() == (if inside { "·" } else { "x" }))
            assert(s.get_background() == (if x%2 == 0 { tui.plain().background_rgb(0x147aa9).get_background() } else { tui.plain().background_index(222).get_background() }))
            assert(s.has(.Reversed) == (x%2 == 1) && s.has(.Italic) == inside && s.has(.Bold) == (!inside && x%2 == 0))
            assert(s.get_foreground() == .Some(if inside { tui.Color.Red } else if x%2 == 0 { tui.Color.Green } else { tui.Color.Yellow }))
            assert(s.get_underline_color() == .Some(if decorated && x%3 == 0 { tui.Color.Cyan } else { tui.Color.Default }))
        }
        frame.fill(area,`.`,tui.Style::reset())
        clear := frame.style_at(6,12).unwrap()
        assert(!clear.has(.Italic) && clear.get_background() == .Some(tui.Color.Default) && clear.get_underline_color() == .Some(tui.Color.Default))
        assert(frame.symbol_at(6,11).unwrap() == " " && frame.symbol_at(6,13).unwrap() == " ")
    }
}

@test fn nested_text_edits_update_width_and_preserve_source() {
    mut doc := rich.Text::raw("longest\r\n界\n").align(.Right)
    assert(doc.get_alignment() == .Right && doc.width() == 7)
    doc.line_mut(0).span_mut(0).set_content("a")
    assert(doc.height() == 2 && doc.width() == 2)
    doc.push_span(rich.Span::styled("!", tui.ink(.Yellow)))
    assert(doc.width() == 3)
    doc.line_mut(1).span_mut(1).patch_style(tui.plain().italic())
    last := &doc.lines()[1].spans()[1]
    assert(last.get_style().has(.Italic) && last.get_style().get_foreground() == .Some(tui.Color.Yellow))
    doc.line_mut(1).reset_style()
    assert(doc.lines()[1].get_style().get_background() == .Some(tui.Color.Default))
    doc.patch_style(tui.plain().bold())
    assert(doc.get_style().has(.Bold))
    doc.push_line(rich.Line::new([rich.Span::raw("\r\n終\r")]))
    assert(doc.lines()[2].spans()[0].content() == "\r\n終\r")
    assert(doc.to_string() == "a\n界!\n終\r")
    p := rich.Paragraph::new(move doc).prepare(4)
    mut frame := tui.Frame::new(4, 3)
    p.render(&mut frame, frame.area())
    assert(frame.line(0) == "   a" && frame.symbol_at(1,1).unwrap() == "界")
}

@test fn named_palettes_encode_truecolor_in_terminal_output() {
    mut frame := tui.Frame::new(1, 1)
    style := tui.ink(tailwind.color(.Violet, .C400)).background(material.color(.BlueGray, .C900))
        .underlined().underline_color(material.accent(.Cyan, .A200))
    _ := frame.set_cell(0, 0, "▀", style)
    previous := tui.Frame::new(1, 1)
    mut output: []u8 = []
    frame.ansi_diff(&previous, &mut output)
    ansi := bytes.decode(&output).unwrap()
    assert(words.contains(ansi, "38;2;167;139;250"))
    assert(words.contains(ansi, "48;2;38;50;56"))
    assert(words.contains(ansi, "58;2;24;255;255"))
    assert(words.contains(ansi, "▀"))
}

@test fn layout_clamps_splits_and_padding() {
    area := tui.Rect { x: 3, y: 4, w: 6, h: 4 }
    (top, rest) := area.rows(9)
    assert(top.h == 4 && rest.y == 8 && rest.h == 0)
    (left, right) := area.cols(-2)
    assert(left.w == 0 && right.x == 3 && right.w == 6)
    mid := area.inset(1)
    assert(mid.x == 4 && mid.y == 5 && mid.w == 4 && mid.h == 2)
    assert(area.inset(99).w == 0)
}

@test fn panel_and_list_follow_selection_in_a_small_viewport() {
    mut frame := tui.Frame::new(8, 4)
    body := frame.panel(frame.area(), "Val", tui.ink(.Cyan))
    items: []string = ["Första", "Andra", "Tredje"]
    frame.list(body, &items, 2, tui.plain().inverted())
    assert(frame.line(0) == "┌Val───┐")
    assert(frame.line(1) == "│Andra │")
    assert(frame.line(2) == "│Tredje│")
    assert(frame.line(3) == "└──────┘")
}

@test fn text_clips_by_columns_and_keeps_combining_marks() {
    mut frame := tui.Frame::new(5, 2)
    frame.text(frame.area(), "Åe\u{301}界X\n雪ab雪", tui.plain())
    assert(frame.line(0) == "Åe\u{301}界X")
    assert(frame.line(1) == "雪ab ")
    frame.text(tui.Rect { x: 3, y: 0, w: 1, h: 1 }, "z", tui.plain())
    assert(frame.line(0) == "Åe\u{301} zX")
    frame.text(tui.Rect { x: -1, y: 1, w: 4, h: 1 }, "abcd", tui.plain())
    assert(frame.line(1) == "bcdb ")
    for x in [-5, -1, 0, 2, 7, 2147483647] {
        for w in [1, 4, 9, 2147483647] {
            mut direct := tui.Frame::new(9, 2)
            direct.fill_symbol(direct.area(), "界", tui.ink(.Yellow))
            mut prepared := direct.clone()
            style := tui.plain().italic()
            area := tui.Rect { x: x, y: 0, w: w, h: 2 }
            direct.text(area, "abc\u{301}d☺️xyz\r\n雪123", style)
            mut y := 0
            for line in ["abc\u{301}d☺️xyz", "雪123"] {
                run := tui.GlyphRun::new(line.clone())
                run.render(&mut prepared, tui.Rect { x: x, y: y, w: w, h: 1 }, 0, run.count(), style)
                y += 1
            }
            assert(direct.diff_positions(&prepared).unwrap().len == 0)
        }
    }
    assert(width.columns(0x1f30d) == 2)
}

@test fn control_bytes_never_reach_the_screen() {
    mut frame := tui.Frame::new(4, 1)
    frame.text(frame.area(), "a\u{1b}\u{7}\u{9b}b", tui.plain())
    assert(frame.line(0) == "ab  ")
}

@test fn empty_layouts_and_empty_lists_render() {
    mut frame := tui.Frame::new(1, 1)
    body := frame.panel(frame.area(), "Title", tui.plain())
    items: []string = []
    frame.list(frame.area(), &items, 0, tui.plain())
    frame.text(body, "hidden", tui.plain())
    assert(frame.line(0) == " ")
    assert(frame.line(-1) == "")
    empty := tui.Frame::new(0, 0)
    assert(empty.line(0) == "")
}

@test fn escape_utf8_and_unknown_sequences_preserve_the_next_key() {
    esc: []u8 = [27]
    assert(input.decode(&esc, false).consumed == 0)
    match input.decode(&esc, true).event { .Press(.Escape) => {}, _ => { assert(false) }, }
    prefix: []u8 = [27, 91]
    assert(input.decode(&prefix, false).consumed == 0)
    arrows: []u8 = [27, 91, 65, 113]
    first := input.decode(&arrows, false)
    assert(first.consumed == 3)
    match first.event { .Press(.Up) => {}, _ => { assert(false) }, }
    extra: []u8 = [27, 91, 49, 53, 126, 113]
    assert(input.decode(&extra, false).consumed == 5)
    half: []u8 = [195]
    assert(input.decode(&half, false).consumed == 0)
    full: []u8 = [195, 165]
    match input.decode(&full, false).event { .Press(.Char(c)) => { assert(i32(c) == 229) }, _ => { assert(false) }, }
    invalid: []u8 = [195, 113]
    assert(input.decode(&invalid, false).consumed == 1)
}

@test fn emoji_sequences_occupy_their_visible_columns() {
    mut frame := tui.Frame::new(5, 3)
    frame.label(frame.area(), "👩🏽‍💻🇸🇪!\n❤️1️⃣.\nA界界")
    assert(frame.line(0) == "👩🏽‍💻🇸🇪!")
    assert(frame.line(1) == "❤️1️⃣.")
    frame.label(tui.Rect { x: 1, y: 2, w: 2, h: 1 }, "💻")
    assert(frame.line(2) == "A💻界")
    for (symbol, cells) in [("😶‍🌫️", 2), ("😶‍🌫", 3), ("👩🏾‍⚕️", 2), ("👩🏾‍⚕", 3),
        ("👁️‍🗨️", 2), ("👁‍🗨", 2), ("☀︎", 1), ("“\u{fe01}", 2)] {
        frame.clear()
        span := rich.Span::raw(symbol + "!")
        assert(span.width() == cells + 1)
        span.render(&mut frame, frame.area())
        assert(frame.symbol_at(0, 0).unwrap() == symbol && frame.symbol_at(cells, 0).unwrap() == "!")
    }
}

@test fn diff_tracks_glyph_width_spacing_and_separated_changes() {
    mut old := tui.Frame::new(7, 1)
    mut next := tui.Frame::new(7, 1)
    old.label(old.area(), "a界bcdx")
    next.label(next.area(), "a12bcdy")
    mut out: []u8 = []
    next.ansi_diff(&old, &mut out)
    assert(bytes.decode(&out).unwrap() == "\x1b[1;2H12\x1b[1;7Hy")
    out.clear()
    old.ansi_diff(&next, &mut out)
    assert(bytes.decode(&out).unwrap() == "\x1b[1;2H界\x1b[1;7Hx")
    out.clear()
    old.ansi_diff(&old, &mut out)
    assert(out.len == 0)
}

@test fn diff_preserves_style_only_changes_and_resets_the_terminal() {
    mut old := tui.Frame::new(3, 1)
    mut next := tui.Frame::new(3, 1)
    old.label(old.area(), "abc")
    next.label(next.area(), "abc")
    next.text(tui.Rect { x: 1, y: 0, w: 1, h: 1 }, "b", tui.ink(.Rgb(11, 129, 255)).background(.Indexed(197)).bold())
    mut out: []u8 = []
    next.ansi_diff(&old, &mut out)
    assert(bytes.decode(&out).unwrap() == "\x1b[1;2H\x1b[38;2;11;129;255;48;5;197;1mb\x1b[0m")
}

@test fn half_block_canvas_clips_and_places_top_and_bottom_pixels() {
    mut raster := canvas.Canvas::new(2, 3, 0x00ff00)
    raster.line(-1, 0, 1, 0, 0xff0000)
    mut frame := tui.Frame::new(3, 2)
    raster.render(&mut frame, tui.Rect { x: 1, y: 0, w: 2, h: 2 })
    assert(frame.line(1) == " ▀▀")
    mut out: []u8 = []
    previous := tui.Frame::new(3, 2)
    frame.ansi_diff(&previous, &mut out)
    assert(bytes.decode(&out).unwrap() == "\x1b[1;2H\x1b[38;2;255;0;0;48;2;0;255;0m▀▀\x1b[2;2H\x1b[38;2;0;255;0m▀▀\x1b[0m")
    frame.clear()
    assert(frame.line(0) == "   ")
}

@test fn canvas_clips_extreme_endpoints_before_stepping() {
    mut raster := canvas.Canvas::new(4, 3, 0)
    raster.line(-2147483647, 1, 2147483647, 1, 0xfefefe)
    for x in 0..4 { assert(raster.pixels[4 + x] == 0xfefefe) }
    raster.line(2147483647, 0, 1111111, 2, 0xff00ff)
    assert(raster.pixels[3] == 0)
}

@test fn white_rgb_round_trips_on_both_halves() {
    mut frame := tui.Frame::new(1, 1)
    base := tui.Frame::new(1, 1)
    frame.half_block(0, 0, 0xffffff, 0xffffff)
    mut out: []u8 = []
    frame.ansi_diff(&base, &mut out)
    assert(bytes.decode(&out).unwrap() == "\x1b[1;1H\x1b[38;2;255;255;255;48;2;255;255;255m▀\x1b[0m")
}

@test fn patches_compose_and_preserve_wide_cell_styles() {
    base := tui.ink(.LightBlue).background(.Gray).bold().dim()
    overlay := tui.plain().foreground(.Default).italic().without(.Bold).underline_color(.Indexed(0))
    style := base.patch(overlay)
    assert(style.get_foreground() == .Some(tui.Color.Default) && style.get_background() == .Some(tui.Color.Gray))
    assert(!style.has(.Bold) && style.has(.Dim) && style.has(.Italic))
    assert(style.patch(tui.plain().bold()).has(.Bold))
    mut frame := tui.Frame::new(4, 1)
    frame.text(frame.area(), "界ab", base)
    frame.apply_style(tui.Rect { x: 1, y: 0, w: 1, h: 1 }, overlay)
    for x in 0..2 {
        cell := frame.style_at(x, 0).unwrap()
        assert(cell.get_underline_color() == .Some(tui.Color.Indexed(0)) && cell.has(.Italic) && !cell.has(.Bold))
    }
    assert(frame.style_at(2, 0).unwrap().has(.Bold))
    frame.apply_style(tui.Rect { x: -2147483647, y: 0, w: 1, h: 1 }, tui.Style::reset())
    assert(frame.line(0) == "界ab")
    frame.apply_style(tui.Rect { x: 1, y: 0, w: 2147483647, h: 2147483647 }, tui.Style::reset())
    assert(!frame.style_at(0, 0).unwrap().has(.Italic) && frame.style_at(3, 0).unwrap().get_background() == .Some(tui.Color.Default))
    assert(frame.style_at(4, 0).is_none() && frame.style_at(0, -1).is_none())
}

@test fn underline_diff_compares_colors_across_frame_local_tables() {
    mut old := tui.Frame::new(3, 1)
    mut next := tui.Frame::new(3, 1)
    highlight := tui.plain().underlined().underline_color(.Indexed(9))
    old.text(old.area(), "x", highlight)
    next.text(next.area(), "x", highlight.underline_color(.Rgb(73, 9, 255)))
    mut out: []u8 = []
    next.ansi_diff(&old, &mut out)
    assert(bytes.decode(&out).unwrap() == "\x1b[1;1H\x1b[58;2;73;9;255;4mx\x1b[0m")
    out.clear()
    next.text(next.area(), "x", highlight)
    next.ansi_diff(&old, &mut out)
    assert(out.len == 0)
    next.clear()
    next.label(next.area(), "x")
    next.ansi_diff(&old, &mut out)
    assert(bytes.decode(&out).unwrap() == "\x1b[1;1Hx")
}

@test fn color_models_and_theme_values_round_trip() {
    for n in 0..256 {
        color := tui.Color.Indexed(u8(n))
        assert(tui.Color::parse(color.str()) == .Some(color))
    }
    assert(tui.Color::parse("bright_gray") == .Some(tui.Color.BrightWhite))
    assert(tui.Color::parse("Light-Black") == .Some(tui.Color.DarkGray))
    assert(tui.Color::parse("light RED") == .Some(tui.Color.LightRed))
    assert(tui.Color::parse("#cA0Dff").unwrap().str() == "#CA0DFF")
    assert(tui.Color::parse("256").is_none() && tui.Color::parse("#abc").is_none())
    assert(tui.Color::parse(" 12").is_none() && tui.Color::parse("reset") == .Some(tui.Color.Default))
    assert(tui.Color.Red != tui.Color.Indexed(1))
    assert(tui.Color::from_hsl(-120.0, 2.0, 0.5) == tui.Color.Rgb(0, 0, 255))
    assert(tui.Color::from_hsl(0.0, 0.0, 0.5) == tui.Color.Rgb(128, 128, 128))
    assert(tui.Color::from_hsluv(0.0, 0.0, 50.0) == tui.Color.Rgb(119, 119, 119))
    assert(tui.Color::from_hsluv(12.18, 100.0, 53.2) == tui.Color.Rgb(255, 0, 0))
    assert(tui.Color::from_hsluv(-94.13, 100.0, 32.3) == tui.Color.Rgb(0, 0, 255))
}

@test fn overlapping_text_preserves_unset_style_fields_and_reset_clears_them() {
    mut frame := tui.Frame::new(6, 1)
    base := tui.ink(.Gray).background(.LightRed).bold().underline_color(.Indexed(200))
    frame.apply_style(frame.area(), base)
    frame.label(frame.area(), "a界xyz")
    frame.text(tui.Rect { x: 3, y: 0, w: 2, h: 1 }, "xy", tui.plain().without(.Bold).italic())
    frame.text(tui.Rect { x: 5, y: 0, w: 1, h: 1 }, "z", tui.Style::reset())
    cell := frame.style_at(1, 0).unwrap()
    assert(cell.get_foreground() == .Some(tui.Color.Gray) && cell.get_background() == .Some(tui.Color.LightRed) && cell.has(.Bold))
    cell2 := frame.style_at(4, 0).unwrap()
    assert(cell2.get_underline_color() == .Some(tui.Color.Indexed(200)) && cell2.has(.Italic) && !cell2.has(.Bold))
    cell3 := frame.style_at(5, 0).unwrap()
    assert(cell3.get_foreground() == .Some(tui.Color.Default) && cell3.get_underline_color() == .Some(tui.Color.Default) && !cell3.has(.Bold))
    assert(tui.Color.White == tui.Color.Gray && tui.Color.White.code() == 7 && tui.Color.BrightWhite.code() == 15)
}

@test fn shared_sgr_resets_reapply_the_surviving_attribute() {
    mut frame := tui.Frame::new(3, 1)
    frame.text(frame.area(), "a", tui.plain().bold().dim().with(.SlowBlink).with(.RapidBlink))
    frame.text(tui.Rect { x: 1, y: 0, w: 2, h: 1 }, "b", tui.plain().dim().with(.SlowBlink))
    frame.text(tui.Rect { x: 2, y: 0, w: 1, h: 1 }, "c", tui.plain().with(.RapidBlink))
    old := tui.Frame::new(3, 1)
    mut out: []u8 = []
    frame.ansi_diff(&old, &mut out)
    assert(bytes.decode(&out).unwrap() == "\x1b[1;1H\x1b[1;2;5;6ma\x1b[22;25;2;5mb\x1b[22;25;6mc\x1b[0m")
}

@test fn script_ligatures_measure_spans_and_paint_graphemes() {
    span := rich.Span::styled("لا", tui.ink(.Red))
    assert(span.width() == 1 && rich.Text::raw("لا").width() == 1)
    mut frame := tui.Frame::new(4, 1)
    span.render(&mut frame, frame.area())
    assert(frame.symbol_at(0, 0) == .Some("ل") && frame.symbol_at(1, 0) == .Some("ا"))
    line := rich.Line::new([move span, rich.Span::styled("!", tui.ink(.Blue))])
    assert(line.width() == 2)
    line.render_aligned(&mut frame, frame.area(), .Right)
    assert(frame.symbol_at(2, 0) == .Some("ل") && frame.symbol_at(3, 0) == .Some("!"))
    assert(frame.style_at(3, 0).unwrap().get_foreground() == .Some(tui.Color.Blue))
    split := rich.Line::new([rich.Span::raw("ل"), rich.Span::raw("ا"), rich.Span::raw("!")])
    assert(split.width() == 3)
    split.render_aligned(&mut frame, frame.area(), .Right)
    assert(frame.symbol_at(1, 0) == .Some("ل") && frame.symbol_at(2, 0) == .Some("ا"))
}

@test fn unicode17_grapheme_breaks() {
    mut count := 0
    for row in words.split(cases.unicode17(), "\n") {
        mut chars: []rune = []
        mut ends: []i32 = []
        for token in words.split(row, " ") {
            if token == "/" {
                if chars.len > 0 { ends.push(chars.len) }
            } else { chars.push(rune(parse.hex(token).value)) }
        }
        mut pos := 0
        for expected in ends {
            next := width.glyph(&chars, pos)
            assert(next.end == expected)
            pos = next.end
        }
        count += 1
    }
    assert(count == 766)
}

@test fn wrapped_words_and_scroll() {
    mut frame := tui.Frame::new(5, 3)
    p := rich.Paragraph::raw("one two three four").wrap(.Trim).scroll(1, 0)
    p.render(&mut frame, frame.area())
    assert(frame.line(0) == "two  " && frame.line(1) == "three" && frame.line(2) == "four ")
}

@test fn wide_word_wrap_stays_inside_panel_and_prepared_matches_immediate() {
    area := tui.Rect { x: 1, y: 1, w: 4, h: 2 }
    mut frame := tui.Frame::new(6, 4)
    frame.label(frame.area(), "------\n|    |\n|    |\n------")
    p := rich.Paragraph::raw("aaa界").wrap(.Trim)
    p.render(&mut frame, area)
    assert(frame.line(0) == "------" && frame.line(1) == "|aaa |")
    assert(frame.line(2) == "|界  |" && frame.line(3) == "------")
    mut prepared := rich.Paragraph::raw("aaa界").wrap(.Trim).prepare(4)
    assert(prepared.height() == 2)
    for w in [4, 3, 0, 1, 6] {
        for top in [0, 1, 2, 2147483647] {
            mut a := tui.Frame::new(w, 3)
            mut b := tui.Frame::new(w, 3)
            prepared.set_top(top)
            prepared.render(&mut a, a.area())
            immediate := rich.Paragraph::raw("aaa界").wrap(.Trim).scroll(top, 0)
            immediate.render(&mut b, b.area())
            for y in 0..3 { assert(a.line(y) == b.line(y)) }
            prepared.resize(w)
            a.clear()
            prepared.render(&mut a, a.area())
            for y in 0..3 { assert(a.line(y) == b.line(y)) }
        }
    }
}

@test fn text_builders_measure_lines_mask_scalars_and_inherit_alignment() {
    assert(rich.masked("a👩🏽‍💻", `•`) == "•••••")
    assert(rich.Text::raw("").height() == 1 && rich.Text::raw("a\r\n\nb\n").height() == 3)
    text := rich.Text::new([
        rich.Line::new([rich.Span::styled("K", tui.ink(.Cyan)), rich.Span::raw("oi")]).styled(tui.plain().bold()),
        rich.Line::raw("界").align(.Right),
    ]).align(.Center).styled(tui.plain().background(.Blue))
    assert(text.width() == 3 && text.height() == 2)
    mut frame := tui.Frame::new(7, 3)
    text.render(&mut frame, frame.area())
    assert(frame.line(0) == "  Koi  " && frame.line(1) == "     界")
    assert(frame.style_at(2, 0).unwrap().get_foreground() == .Some(tui.Color.Cyan))
    assert(frame.style_at(6, 0).unwrap().has(.Bold))
    assert(frame.style_at(6, 2).unwrap().get_background() == .Some(tui.Color.Blue))
    rich.Line::raw("abcdefghijkl").align(.Center).render(&mut frame, frame.area())
    assert(frame.line(0) == "cdefghi")
}

@test fn frame_keeps_long_clusters_atomic_in_diffs_and_overlap() {
    mut old := tui.Frame::new(6, 1)
    assert(old.set_cell(1, 0, "ｶﾞ", tui.ink(.Cyan)))
    assert(old.symbol_at(1, 0).unwrap() == "ｶﾞ" && old.symbol_at(2, 0).unwrap() == "" && old.symbol_at(3, 0).unwrap() == "")
    assert(!old.set_cell(4, 0, "ｶﾞ", tui.plain()) && !old.set_cell(0, 0, "\x1b", tui.plain()))
    assert(!old.set_cell(0, 0, "abc", tui.plain()))
    old.apply_style(tui.Rect { x: 3, y: 0, w: 1, h: 1 }, tui.plain().bold())
    for x in 1..4 { assert(old.style_at(x, 0).unwrap().has(.Bold)) }
    mut next := tui.Frame::new(6, 1)
    next.label(next.area(), " abcd")
    mut data: []u8 = []
    next.ansi_diff(&old, &mut data)
    assert(bytes.decode(&data).unwrap() == "\x1b[1;2Habcd")
    old.label(tui.Rect { x: 2, y: 0, w: 1, h: 1 }, "!")
    assert(old.line(0) == "  !   ")
    next.clear()
    old.clear()
    assert(next.set_cell(0, 0, "\u{301}", tui.plain()))
    assert(next.set_cell(1, 0, "z", tui.plain()))
    assert(next.symbol_at(0, 0).unwrap() == "\u{301}")
    data.clear()
    next.ansi_diff(&old, &mut data)
    assert(bytes.decode(&data).unwrap() == "\x1b[1;1H \u{301}z")
}

@test fn fill_and_clear_preserve_wide_graphemes_and_remove_explicit_spaces() {
    mut f := tui.Frame::new(8, 2)
    f.fill(f.area(), `#`, tui.ink(.Cyan))
    f.fill_symbol(tui.Rect { x: -1, y: 0, w: 7, h: 1 }, "👩🏽‍💻", tui.plain().bold())
    assert(f.line(0) == "#👩🏽‍💻👩🏽‍💻###")
    f.clear_area(tui.Rect { x: 2, y: 0, w: 1, h: 1 })
    assert(f.line(0) == "#  👩🏽‍💻###" && f.style_at(2, 0).unwrap().get_foreground() == .Some(tui.Color.Default))
    f.fill_symbol(f.area(), "ab", tui.plain())
    assert(width.columns(0xd800) == -1)
    f.fill(f.area(), rune(0), tui.plain())
    assert(f.line(1) == "########")
    f.clear()
    f.label(f.area(), " x")
    f.stroke(tui.Rect { x: 0, y: 0, w: 8, h: 1 }, `─`, tui.ink(.Red), .Exact)
    assert(f.line(0) == " x──────")
    f.clear_area(tui.Rect { x: 0, y: 0, w: 1, h: 1 })
    f.stroke(tui.Rect { x: 0, y: 0, w: 1, h: 1 }, `│`, tui.plain(), .Exact)
    assert(f.line(0) == "│x──────")
    f.clear()
    f.fill(f.area(), ` `, tui.plain())
    mut out: []u8 = []
    blank := tui.Frame::new(8, 2)
    f.ansi_diff(&blank, &mut out)
    assert(out.len == 0)
}

@test fn blocks_merge_shared_edges_and_apply_custom_shadow() {
    mut f := tui.Frame::new(7, 4)
    mut block := box.Block::bordered()
    block.merge = .Fuzzy
    _ := block.render(&mut f, tui.Rect { x: 0, y: 0, w: 4, h: 3 })
    _ := block.render(&mut f, tui.Rect { x: 3, y: 0, w: 4, h: 3 })
    assert(f.line(0) == "┌──┬──┐" && f.line(2) == "└──┴──┘")
    assert(borders.merge(0x2500, 0x2551, .Fuzzy) == 0x256b)
    shadow := box.Shadow::new(.Custom(fn(frame: &mut tui.Frame, area: tui.Rect, base: tui.Rect) {
        assert(base.w == 4)
        frame.fill(tui.Rect { x: area.x, y: area.y + area.h - 1, w: area.w, h: 1 }, `·`, tui.plain())
    }))
    shadow.render(&mut f, tui.Rect { x: 0, y: 0, w: 4, h: 3 })
    assert(f.line(3) == " ····  ")
}

@test fn block_shadows_preserve_cells_across_wide_symbols_and_coordinate_limits() {
    a := tui.Rect::new(65529,65531,6,4)
    mut f := tui.Frame::at(a)
    assert(f.set_cell(a.x+1,a.y,"界",tui.ink(.Red)))
    mut shadow := box.Shadow::symbol("ab")
    shadow.dx = 1
    shadow.dy = 0
    shadow.style = tui.plain().bold()
    f.render_widget(&shadow,tui.Rect::new(a.x+1,a.y,1,1))
    head := f.cell_at(a.x+1,a.y).unwrap()
    tail := f.cell_at(a.x+2,a.y).unwrap()
    assert(head.symbol == "界" && !head.style.has(.Bold))
    assert(tail.symbol == "ab" && tail.style.has(.Bold))
    shadow.dx = 2147483647
    f.render_widget(&shadow,tui.Rect::new(a.x,a.y+1,2,2))
    assert(f.cell_at(65534,a.y+2).unwrap().symbol == "ab")
    mut b := box.Block::bordered()
    b.padding = box.Padding::uniform(65535)
    assert(b.inner(a) == tui.Rect::new(65535,65535,0,0))
    assert(b.horizontal_space() == (65535,65535) && b.vertical_space() == (65535,65535))
}

@test fn meters_keep_symbols_in_each_raw_cell_and_labels_leave_the_left_cell_alone() {
    mut frame := tui.Frame::new(7,2)
    assert(frame.set_cell(0,0,"界",tui.ink(.Red)))
    mut line := widgets.LineGauge::new(0.5)
    line.label = .Some(rich.Line::raw("V"))
    line.set_symbols("ab","")
    frame.render_widget(&line,tui.Rect::new(1,0,6,1))
    assert(frame.cell_at(0,0).unwrap().symbol == "界" && frame.cell_at(1,0).unwrap().symbol == "V")
    assert(frame.cell_at(3,0).unwrap().symbol == "ab" && frame.cell_at(6,0).unwrap().symbol == "")
    mut s := widgets.Sparkline::bars([widgets.Sample::missing(),widgets.Sample::new(8)])
    s.missing_text = .Some("é")
    s.symbols[8] = `界`
    frame.render_widget(&s,tui.Rect::new(5,1,2,1))
    assert(frame.cell_at(5,1).unwrap().symbol == "é" && frame.cell_at(6,1).unwrap().symbol == "界")
}

@test fn gauges_sparkline_and_scroll_state_cover_extreme_values() {
    max: u64 = 0xffffffffffffffff
    assert(widgets.bar_ticks(max - 1, max, 32768) == 32767)
    assert(widgets.bar_ticks(max / 2, max, 32767) == 16383)
    assert(widgets.bar_ticks(9, 3, 8) == 8 && widgets.bar_ticks(3, 0, 8) == 0)
    mut state := widgets.ScrollState::new(0)
    state.next()
    assert(state.position == 0)
    state.length = 2147483647
    state.last(); state.next()
    assert(state.position == 2147483646)
    state.first(); state.prev()
    assert(state.position == 0)
    mut t := widgets.Tabs::new([])
    assert(t.selected.is_none() && t.width() == 0)
    t.set_titles([rich.Line::raw("a"), rich.Line::raw("界")])
    assert(t.width() == 8 && t.selected == .Some(0))
    t.selected = .Some(999)
    t.set_titles([rich.Line::raw("z")])
    assert(t.selected == .Some(0))
    mut f := tui.Frame::new(7, 2)
    mut spark := widgets.Sparkline::bars([widgets.Sample::missing(), widgets.Sample::new(max - 1)])
    spark.maximum = .Some(max); spark.flow = .RightToLeft; spark.missing_symbol = `·`
    spark.render(&mut f, f.area())
    assert(f.line(0) == "     ▇·" && f.line(1) == "     █·")
}

@test fn horizontal_chart_clips_labels_and_splits_values_at_graphemes() {
    mut f := tui.Frame::new(8, 3)
    f.fill(f.area(), `#`, tui.plain())
    mut b := chart.Bar::named("abc", 1)
    b.text_value = .Some("界X")
    mut graph := chart.BarChart::new([move b])
    graph.direction = .Horizontal
    graph.maximum = .Some(3)
    graph.value_style = tui.ink(.Cyan)
    graph.render(&mut f, tui.Rect { x: 1, y: 1, w: 1, h: 1 })
    assert(f.line(1) == "#a######")
    graph.render(&mut f, tui.Rect { x: 1, y: 1, w: 7, h: 1 })
    assert(f.line(1) == "#abc#界X")
    assert(f.style_at(5, 1).unwrap().get_foreground() == .Some(tui.Color.Cyan))
    assert(f.line(2) == "########")
}

@test fn list_navigation_clamps_on_render_and_preserves_selection_when_hidden() {
    mut view := lists.List::new([lists.Item::raw("a"), lists.Item::raw("b\nc"), lists.Item::raw("d"), lists.Item::raw("e")])
    mut frame := tui.Frame::new(4, 3)
    mut state := lists.ListState::new()
    state.previous()
    view.render_stateful(&mut frame, frame.area(), &mut state)
    assert(state.selected == .Some(3) && state.offset == 2)
    assert(frame.line(0) == "d   " && frame.line(1) == "e   ")
    state.scroll_up_by(2)
    view.render_stateful(&mut frame, frame.area(), &mut state)
    assert(state.selected == .Some(1) && state.offset == 1)
    view.set_items([])
    view.render_stateful(&mut frame, frame.area().inset(4), &mut state)
    assert(state.selected == .Some(1))
    view.render_stateful(&mut frame, frame.area(), &mut state)
    assert(state.selected.is_none() && state.offset == 0)
    state.next()
    assert(state.selected == .Some(0))
    state.last()
    state.next()
    assert(state.selected == .Some(2147483647))
    state.scroll_up_by(2147483647)
    assert(state.selected == .Some(0))
}

@test fn list_clips_the_marker_and_keeps_multiline_items_together() {
    mut view := lists.List::new([lists.Item::raw("a\nb"), lists.Item::raw("界"), lists.Item::new(rich.Text::new([]))])
    assert(view.len() == 3 && !view.is_empty())
    view.marker = rich.Line::raw("界:")
    view.repeat_marker = true
    view.direction = .BottomToTop
    view.highlight = tui.plain().inverted()
    view.scroll_padding = 2147483647
    mut frame := tui.Frame::new(6, 4)
    frame.fill(frame.area(), `.`, tui.plain())
    mut state := lists.ListState::new()
    state.first()
    view.render_stateful(&mut frame, tui.Rect { x: 1, y: 1, w: 2, h: 2 }, &mut state)
    assert(frame.line(1) == ".界..." && frame.line(2) == ".界...")
    assert(frame.style_at(1, 1).unwrap().has(.Reversed))
    view.spacing = .Never
    view.render(&mut frame, tui.Rect { x: 1, y: 0, w: 1, h: 1 })
    assert(frame.line(0) == "......")
}

@test fn list_scroll_padding_tracks_rows_when_items_have_different_heights() {
    mut view := lists.List::new([lists.Item::raw("a"), lists.Item::raw("b"), lists.Item::raw("c\nC"),
        lists.Item::raw("d"), lists.Item::raw("e"), lists.Item::raw("f")])
    view.scroll_padding = 1
    mut frame := tui.Frame::new(2, 4)
    mut state := lists.ListState::new()
    state.select(.Some(2))
    view.render_stateful(&mut frame, frame.area(), &mut state)
    assert(state.offset == 1 && frame.line(3) == "d ")
    state.select(.None)
    state.offset = 3
    frame.clear()
    view.render_stateful(&mut frame, frame.area(), &mut state)
    assert(state.offset == 3 && frame.line(0) == "d ")
}

@test fn numeric_constraints_keep_their_order_and_rotate_in_place() {
    sizes: []u16 = [2, 5, 3]
    mut grid := layout.Layout::default()
    grid.set_constraints(layout.Constraint::from_lengths(&sizes))
    square := tui.Rect::new(1, 2, 12, 12)
    assert(grid.arrange(square).regions().areas[1] == tui.Rect::new(1, 4, 12, 5))
    grid.set_direction(layout.Direction::default().perpendicular())
    assert(grid.arrange(square).regions().areas[1] == tui.Rect::new(3, 2, 5, 12))
    ratio: layout.Constraint = .Ratio(7, 11)
    assert(ratio.apply(9) == 5 && f"{ratio}" == "Ratio(7, 11)")
    assert(layout.Constraint::default().apply(65535) == 65535)
}

@test fn tightly_spaced_columns_share_space_across_panel_counts() {
    width: layout.Constraint = .Length(8)
    for n in [10, 11] {
        mut grid := layout.Layout::horizontal(width.repeat(n)).flex(.SpaceAround).spacing(2)
        parts := grid.arrange(tui.Rect::new(0, 0, n * 10, 1)).regions()
        outer := if n == 10 { 2 } else { 1 }
        assert(parts.spacers[0].w == outer && parts.spacers[n].w == outer)
        assert(parts.areas[0].w == 10 - 2 * outer)
    }
}

@test fn constraint_layout_caches_sizes_and_reprojects_all_edges() {
    area := tui.Rect { x: 2, y: 3, w: 18, h: 8 }
    mut l := layout.Layout::horizontal([.Length(4), .Fill(1), .Fill(2)]).spacing(1).margin(0,1).cache_capacity(2)
    mut split := layout.Split::new()
    for dx in [0, 3, 0, 4] {
        moved := area.offset(dx, dx)
        l.split_into(moved, &mut split)
        assert(split.areas.len == 3 && split.spacers.len == 4)
        assert(split.areas[0].w == 4 && split.areas[1].w == 4 && split.areas[2].w == 8)
        assert(split.areas[2].x == moved.x+10 && split.areas[2].y == moved.y+1)
        assert(split.spacers[1].w == 1 && split.spacers[3].w == 0)
        assert(l.part(moved,1).unwrap() == l.split(moved)[1])
        assert(l.arrange(moved).regions().areas[2] == split.areas[2])
        assert(l.arrange(moved).regions().spacers[1] == split.spacers[1])
    }
    l.set_constraints([.Ratio(1,2)])
    assert(l.part(area,0).unwrap().w == 9 && l.part(area,1).is_none())
    assert(l.arrange(area).regions().areas.len == 1)
    l = l.margin(2,0)
    assert(l.arrange(area).regions().areas[0].w == 7)
    l = l.margin(0,1)
    l = l.flex(.End).cache_capacity(0)
    assert(l.part(area,0).unwrap().x == 11)
    assert(layout.centered(area,.Length(4),.Length(2)) == tui.Rect { x:9, y:6, w:4, h:2 })
    mut high := layout.Layout::horizontal([.Min(65535), .Length(7)])
    assert(high.part(area.resize(100,3),0).unwrap().w == 93)
    mut many: []layout.Constraint = []
    for _ in 0..1024 { many.push(.Fill(0)) }
    l = l.spacing(0)
    l.set_constraints(move many)
    parts := l.split(area.resize(2048,8))
    assert(parts.len == 1024 && parts[1023].w == 2)
    mut lengths: []layout.Constraint = []
    for _ in 0..1024 { lengths.push(.Length(5)) }
    l.set_constraints(move lengths)
    assert(l.arrange(area.resize(2048,8)).regions().areas[1023].w == 2)
    l = l.flex(.SpaceEvenly).spacing(3)
    regions := l.arrange(area.resize(1025,8)).regions()
    assert(regions.areas[1000].w == 0 && regions.spacers[1000].w == 1)
}

@test fn rect_translation_growth_and_clipping_preserve_bounds() {
    a := tui.Rect { x: 4, y: 6, w: 12, h: 3 }
    assert(a.cell_count() == 36 && !a.is_empty() && a.contains(15,8) && !a.contains(16,8))
    assert(a.inner(2,1).outer(2,1) == a && a.inner(7,0).is_empty())
    b := a.offset(-8,1)
    assert(b.x == 0 && a.intersects(b) && a.intersection(b).cell_count() == 16)
    assert(a.union(b) == tui.Rect { x:0, y:6, w:16, h:4 })
    assert(a.resize(40,6).clamp_to(b) == b)
    e := a.offset(2147483647,2147483647)
    assert(e.right() == 65535 && e.bottom() == 65535 && e.resize(30,20) == e)
    outside := tui.Rect { x:-2, y:-3, w:6, h:8 }
    assert(outside.resize(6,8) == outside && outside.inner(0,0) == outside)
}

@test fn table_selection_survives_an_empty_view_and_tracks_replaced_data() {
    mut tall := table.Row::strings(["long"])
    tall.height = 2
    tall.top_margin = 1
    mut view := table.Table::new([table.Row::strings(["1","a"]), move tall, table.Row::strings(["3","c"])], [])
    mut state := table.TableState::new()
    state.last()
    state.last_column()
    mut frame := tui.Frame::new(8, 3)
    view.render_stateful(&mut frame, frame.area().resize(0,0), &mut state)
    assert(state.selected.unwrap() > 2)
    view.render_stateful(&mut frame, frame.area(), &mut state)
    cell := state.selected_cell().unwrap()
    assert(cell.0 == 2 && cell.1 == 1 && state.offset == 2)
    view.set_rows([table.Row::strings(["only"])])
    view.set_widths([.Fill(1)])
    assert(view.set_cell(0,0,table.Cell::raw("changed")))
    assert(!view.set_cell(0,1,table.Cell::raw("bad")) && !view.set_cell(-1,0,table.Cell::raw("bad")))
    frame.clear()
    view.render_stateful(&mut frame,frame.area(),&mut state)
    assert(state.selected == .Some(0) && state.selected_column == .Some(0) && state.offset == 0)
    assert(frame.line(0) == "changed ")
    view.set_rows([])
    view.render_stateful(&mut frame,frame.area(),&mut state)
    assert(state.selected.is_none() && state.selected_column.is_none() && state.offset == 0)
}

@test fn table_spans_and_cell_highlights_respect_neighboring_glyphs() {
    mut view := table.Table::new([table.Row::new([table.Cell::raw("hidden").spanning(0),
        table.Cell::raw("a界z").spanning(65535)])],[.Length(2),.Length(2)])
    view.column_spacing = 0
    view.row_highlight = tui.plain().bold()
    view.column_highlight = tui.ink(.Green)
    view.cell_highlight = tui.ink(.Cyan).underlined()
    mut state := table.TableState::new()
    state.select_cell(.Some((0,1)))
    mut frame := tui.Frame::new(6,2)
    frame.fill(frame.area(), `.`, tui.plain())
    view.render_stateful(&mut frame,tui.Rect { x:1, y:0, w:4, h:1 },&mut state)
    assert(frame.line(0) == ".a界z." && frame.line(1) == "......")
    assert(frame.style_at(2,0).unwrap().has(.Bold) && !frame.style_at(2,0).unwrap().has(.Underlined))
    target := frame.style_at(4,0).unwrap()
    assert(target.get_foreground() == .Some(tui.Color.Cyan) && target.has(.Underlined) && target.has(.Bold))
    tail := frame.raw_cell_at(3,0).unwrap()
    assert(tail.symbol.is_none() && tail.fg == .Cyan && tail.modifier.contains(.Underlined))
}

@test fn indexed_widget_states_round_trip_and_reject_out_of_range_indices() {
    assert(lists.Direction::default() == .TopToBottom && lists.HighlightSpacing::default() == .WhenSelected)
    assert(widgets.Edge::default() == .Right && widgets.Flow::default() == .LeftToRight && widgets.ScrollDirection::default() == .Forward)
    assert(table.TableState::default() == table.TableState::new())
    assert(widgets.SavedScrollState::default() == widgets.SavedScrollState::new(0))
    selection := json.from_str<lists.ListState>("[12,null]").unwrap()
    assert(selection.offset == 12 && selection.selected.is_none())
    assert(json.to_string(&selection).unwrap() == "{\"offset\":12,\"selected\":null}")
    assert(json.from_str<lists.ListState>("{\"offset\":9}").unwrap().selected.is_none())
    assert(json.from_str<lists.ListState>("[0,2147483648]").is_err())
    mut cells := json.from_str<table.TableState>("[1,2,3]").unwrap()
    assert(cells.selected_cell() == .Some((2,3)))
    twin := json.from_str<table.TableState>(json.to_string(&cells).unwrap()).unwrap()
    assert(cells == twin && cells.hash() == twin.hash())
    assert(json.to_string(&cells).unwrap() == "{\"offset\":1,\"selected\":2,\"selected_column\":3}")
    cells.offset = -1
    assert(json.to_string(&cells).is_err())
    assert(json.from_str<table.TableState>("[0,null,18446744073709551615]").is_err())
    mut rail := json.from_str<widgets.ScrollState>("[13,11,3]").unwrap()
    rail.scroll(.Forward)
    assert(json.to_string(&rail).unwrap() == "{\"content_length\":13,\"position\":12,\"viewport_content_length\":3}")
    assert(json.from_str<widgets.ScrollState>("[1,4294967296,1]").is_err())
    rail.viewport = -1
    assert(json.to_string(&rail).is_err())
}

@test fn saved_selections_use_all_64_bits_and_reset_when_data_disappears() {
    mut rows := lists.SavedState::new()
    rows.previous()
    rows.scroll_up_by(1)
    assert(json.to_string(&rows).unwrap() == "{\"offset\":0,\"selected\":18446744073709551614}")
    rows.scroll_down_by(65535)
    rows.next()
    assert(rows.selected == .Some(0xffffffffffffffff))
    mut cells := table.SavedState::new()
    cells.last()
    cells.previous_column()
    assert(cells.selected_cell() == .Some((0xffffffffffffffff,0xffffffffffffffff)))
    mut empty := tui.Frame::new(3,1)
    menu := lists.List::new([])
    mut grid := table.Table::new([],[])
    empty.render_stateful_widget(&menu,empty.area(),&mut rows)
    empty.render_stateful_widget(&mut grid,empty.area(),&mut cells)
    assert(rows.selected.is_none() && rows.offset == 0 && cells.selected_cell().is_none() && cells.offset == 0)
    cells.select_cell(.Some((5,7)))
    cells.offset = 12
    cells.select_cell(.None)
    assert(cells.selected_column.is_none() && cells.offset == 0)
}

@test fn overlapping_symbols_keep_cross_row_diffs_after_copy_and_resize() {
    mut next := tui.Frame::new(4,3)
    mut cell := tui.RawCell::empty()
    cell.symbol = .Some("abc")
    assert(next.set_raw_cell(3,0,&cell))
    old := next.clone()
    next.text(tui.Rect::new(0,1,4,1),"ABCD",tui.plain())
    mut copy := tui.Frame::new(4,3)
    copy.copy_region(&next,next.area(),0,0)
    changes := copy.diff_positions(&old).unwrap()
    assert(changes.len == 2 && changes[0] == (2,1) && changes[1] == (3,1))
    copy.resize(0,0)
    copy.resize(4,3)
    copy.text(copy.area(),"new",tui.plain())
    next.copy_region(&copy,copy.area(),0,0)
    assert(next.line(0) == "new ")
}

@test fn plot_coordinates_layers_and_labels_survive_resizing() {
    mut frame := tui.Frame::new(5,3)
    frame.fill(frame.area(), `.`,tui.ink(.Yellow).background(.Black).bold())
    mut view := plot.Plot::new([-1.0,1.0],[-1.0,1.0])
    view.marker = .HalfBlock
    view.background = .Blue
    p := view.begin(&mut frame,tui.Rect {x:1,y:1,w:3,h:1})
    top := p.get_point(-1.0,1.0).unwrap()
    bottom := p.get_point(1.0,-1.0).unwrap()
    assert(top.0 == 0 && top.1 == 0 && bottom.0 == 2 && bottom.1 == 1)
    assert(p.get_point(1.01,0.0).is_none() && p.get_point(f64.from_bits(0x7ff8000000000000),0.0).is_none())
    p.paint(0,0,.Cyan); p.paint(0,1,.Red); p.layer()
    p.paint(0,1,.Green); p.paint(3,0,.Magenta); p.paint(-1,-1,.Magenta)
    p.label(0.0,0.0,rich.Line::raw("x"))
    p.set_marker(.Custom(`界`)); p.point(1.0,1.0,.Cyan)
    view.finish(&mut frame)
    assert(frame.line(1) == ".▄x.." && frame.line(0) == "....." && frame.line(2) == ".....")
    style := frame.style_at(1,1).unwrap()
    assert(style.get_foreground() == .Some(tui.Color.Green) && style.get_background() == .Some(tui.Color.Red) && style.has(.Bold))
    frame.clear()
    p2 := view.begin(&mut frame,frame.area())
    p2.set_marker(.Octant)
    p2.paint(0,0,.Default)
    view.finish(&mut frame)
    assert(frame.symbol_at(0,0).unwrap() == "𜺨" && frame.line(1) == "     ")
}

@test fn chart_reuses_state_and_clips_axes_to_its_rectangle() {
    mut frame := tui.Frame::new(10,6)
    mut view := graphs.Chart::new([])
    view.x_axis = graphs.Axis::new([0.0,1.0]); view.y_axis = graphs.Axis::new([0.0,1.0])
    view.x_axis.labels = [rich.Line::raw("start"),rich.Line::raw("end")]
    view.x_axis.alignment = .Right
    frame.fill(frame.area(),`.`,tui.plain())
    area := tui.Rect {x:1,y:1,w:8,h:4}
    view.render(&mut frame,area)
    assert(frame.line(4)[0] == b'.' && frame.line(4)[9] == b'.')
    mut d := graphs.Dataset::new([(0.0,0.0),(1.0,1.0)])
    d.graph_type = .Area; d.name = .Some(rich.Line::raw("A")); view.datasets.push(move d)
    view.legend_position = .None
    view.render(&mut frame,area)
    assert(frame.symbol_at(8,1).unwrap() == "•")
    view.datasets.clear()
    frame.clear()
    view.render(&mut frame,area)
    assert(frame.symbol_at(8,1).unwrap() == " ")
}

@test fn chart_centers_a_full_height_legend_inside_an_offset_viewport() {
    mut series := graphs.Dataset::new([])
    series.name = .Some(rich.Line::raw("ABC"))
    mut view := graphs.Chart::new([move series])
