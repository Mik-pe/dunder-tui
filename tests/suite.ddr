    assert(frame.line(2) == ".....┌───┐.." && frame.line(3) == ".....│ABC│..")
    assert(frame.line(4) == ".....└───┘.." && frame.line(5) == "............")
}

@test fn wide_custom_plot_markers_follow_layer_order_and_preserve_underline() {
    mut frame := tui.Frame::new(5,1)
    frame.fill(frame.area(),`.`,tui.plain().underline_color(.Red).underlined())
    mut view := plot.Plot::new([0.0,4.0],[0.0,1.0])
    p := view.begin(&mut frame,frame.area())
    p.set_marker(.Custom(`界`))
    p.paint(1,0,.Red); p.paint(0,0,.Blue)
    p.set_marker(.Custom(`!`)); p.paint(2,0,.Green); p.paint(4,0,.Magenta)
    p.set_marker(.Custom(`界`)); p.paint(1,0,.Yellow)
    view.finish(&mut frame)
    assert(frame.line(0) == " 界.!" && frame.style_at(1,0).unwrap().get_foreground() == .Some(tui.Color.Yellow))
    s := frame.style_at(4,0).unwrap()
    assert(s.get_foreground() == .Some(tui.Color.Magenta) && s.get_underline_color() == .Some(tui.Color.Red) && s.has(.Underlined))
}
struct FailingTerminal { device: testing.TestBackend, fail: bool, writes: i32 }

struct LargeScreen { width:i32, height:i32, appended:i32, writes:i32 }

impl tui.Backend for LargeScreen {
    fn size(&mut self) -> (i32,i32) { (self.width,self.height) }
    fn read_cursor(&mut self) -> Result<(i32,i32),string> { .Ok((0,0)) }
    fn extend_lines(&mut self, rows:i32) -> Result<(),string> { self.appended += rows; .Ok }
    fn present(&mut self, frame:&tui.Frame, previous:&tui.Frame) -> Result<(),string> { self.writes += 1; .Ok }
}

@test fn a_large_screen_only_reserves_cells_for_its_viewport_and_can_retry_after_a_rejected_resize() {
    enormous := LargeScreen { width:65535, height:65535, appended:0, writes:0 }
    mut fixed := tui.Terminal<LargeScreen>::with_viewport(enormous,.Fixed(tui.Rect::new(65000,65000,9,2))).unwrap()
    assert(fixed.viewport_area() == tui.Rect::new(65000,65000,9,2))
    mut count := 2
    assert(fixed.draw(&mut count,draw_number).is_ok() && fixed.completed().symbol_at(65000,65000) == .Some("2"))
    short := LargeScreen { width:4, height:2, appended:0, writes:0 }
    inline := tui.Terminal<LargeScreen>::with_viewport(short,.Inline(65535)).unwrap()
    assert(inline.viewport_area() == tui.Rect::new(0,0,4,2) && inline.backend().appended == 65534)
    mut term := tui.Terminal<LargeScreen>::new(LargeScreen { width:10,height:2,appended:0,writes:0 })
    assert(term.draw(&mut count,draw_number).is_ok())
    term.current_buffer_mut().label(tui.Rect::new(0,0,3,1),"old")
    term.backend_mut().width = 65535
    term.backend_mut().height = 65535
    assert(term.autoresize().is_err() && term.viewport_area() == tui.Rect::new(0,0,10,2))
    assert(term.current_buffer_mut().line(0) == "old       " && term.backend().writes == 1)
    term.backend_mut().width = 7000
    term.backend_mut().height = 2
    assert(term.draw(&mut count,draw_number).is_ok() && term.completed().area().w == 7000)
}

impl tui.Backend for FailingTerminal {
    fn size(&mut self) -> (i32,i32) { self.device.size() }
    fn present(&mut self, frame: &tui.Frame, previous: &tui.Frame) -> Result<(),string> {
        self.writes += 1
        self.device.present(&frame,&previous)?
        if self.fail { return .Err("write interrupted") }
        .Ok
    }
}

fn draw_number(frame: &mut tui.Frame, n: &mut i32) {
    frame.label(frame.area(),n.str())
    if n != 0 { frame.set_cursor_position(1,0) }
}

@test fn window_metrics_report_the_backend_independently_of_the_viewport() {
    area := tui.Rect { x:1, y:2, w:5, h:3 }
    mut t := tui.Terminal<testing.TestBackend>::with_viewport(testing.TestBackend::new(20,10),.Fixed(area)).unwrap()
    expected := tui.WindowSize { columns:20, rows:10, pixel_width:640, pixel_height:480 }
    assert(t.window_size().unwrap() == expected)
    t.backend_mut().resize(0,0)
    assert(t.autoresize().is_ok() && t.viewport_area() == area)
    (w,h) := t.size()
    m := t.window_size().unwrap()
    assert(w == 0 && h == 0 && m.columns == 0 && m.rows == 0 && m.pixel_width == 640 && m.pixel_height == 480)
    mut custom := tui.Terminal<FailingTerminal>::new(FailingTerminal {device:testing.TestBackend::new(6,2),fail:false,writes:0})
    custom_size := custom.window_size().unwrap()
    assert(custom_size == tui.WindowSize { columns:6, rows:2, pixel_width:0, pixel_height:0 })
    assert(custom.autoresize().is_ok() && custom.viewport_area().w == 6 && custom.backend().writes == 0)
    custom.backend_mut().device.resize(8,4)
    assert(custom.autoresize().is_ok() && custom.viewport_area().w == 8 && custom.backend().writes == 1)
    assert(custom.autoresize().is_ok() && custom.backend().writes == 1)
}

fn reject_number(frame: &mut tui.Frame, n: &mut i32) -> Result<(),string> {
    draw_number(&mut frame,&mut n)
    .Err("rejected")
}

@resource(dispose)
struct CursorRecorder { events: string }
impl CursorRecorder {
    fn dispose(&self) { assert(self.events == "hide show ") }
}
impl tui.Backend for CursorRecorder {
    fn size(&mut self) -> (i32,i32) { (4,1) }
    fn set_cursor_visible(&mut self, visible:bool) -> Result<(),string> {
        self.events = self.events + if visible { "show " } else { "hide " }
        .Ok
    }
    fn present(&mut self, frame:&tui.Frame, previous:&tui.Frame) -> Result<(),string> {
        self.set_cursor_visible(frame.cursor_position().is_some())
    }
}

@test fn a_terminal_restores_the_cursor_before_releasing_its_backend() {
    mut t := tui.Terminal<CursorRecorder>::new(CursorRecorder { events:"" })
    assert(t.apply_buffer().is_ok() && t.backend().events == "hide ")
}

struct CursorFailure { output: []u8 }
impl tui.Backend for CursorFailure {
    fn size(&mut self) -> (i32,i32) { (12,5) }
    fn present(&mut self, frame:&tui.Frame, previous:&tui.Frame) -> Result<(),string> {
        self.output.clear()
        frame.ansi_diff(&previous,&mut self.output)
        .Ok
    }
    fn move_to(&mut self, x:i32, y:i32) -> Result<(),string> {
        bytes.append_utf8(&mut self.output,f"\x1b[{y+1};{x+1}H")
        .Err("interrupted")
    }
}

@test fn failed_cursor_write_is_repaired_without_repainting_committed_cells() {
    mut terminal := tui.Terminal<CursorFailure>::new(CursorFailure { output:[] })
    mut number := 1
    assert(terminal.draw(&mut number,draw_number).is_ok() && terminal.draw(&mut number,draw_number).is_ok())
    assert(terminal.backend().output.len == 0)
    assert(terminal.set_cursor_position(5,3).unwrap_err() == "interrupted")
    assert(terminal.try_draw(&mut number,reject_number).is_err())
    assert(terminal.completed().cursor_position() == .Some((1,0)) && terminal.completed().count() == 1)
    assert(terminal.draw(&mut number,draw_number).is_ok())
    assert(bytes.decode(&terminal.backend().output).unwrap() == "\x1b[1;2H\x1b[?25h")
    assert(terminal.draw(&mut number,draw_number).is_ok() && terminal.backend().output.len == 0)
    assert(terminal.show_cursor().is_err() && terminal.hide_cursor().is_err() && terminal.cursor_position().is_err())
}

@test fn direct_cursor_moves_are_absolute_and_bounded_and_do_not_change_frame_requests() {
    mut t := tui.Terminal<testing.TestBackend>::new(testing.TestBackend::new(12,5))
    mut number := 1
    assert(t.draw(&mut number,draw_number).is_ok() && t.hide_cursor().is_ok())
    assert(t.set_cursor_position(-3,70000).is_ok() && t.cursor_position().unwrap() == (0,65535))
    assert(!t.backend().cursor_visible() && t.completed().cursor_position() == .Some((1,0)))
    assert(t.show_cursor().is_ok() && t.backend().cursor_visible() && t.cursor_position().unwrap() == (0,65535))
    t.backend_mut().set_cursor_position(6,2)
    assert(t.cursor_position().unwrap() == (6,2))
    assert(t.draw(&mut number,draw_number).is_ok() && t.cursor_position().unwrap() == (1,0))
}

@test fn failed_render_and_partial_write_keep_the_last_committed_frame() {
    mut t := tui.Terminal<FailingTerminal>::new(FailingTerminal { device: testing.TestBackend::new(3,2), fail: false, writes: 0 })
    mut n := 0
    assert(t.draw(&mut n,draw_number).is_ok())
    n = 1
    assert(t.try_draw(&mut n,reject_number).unwrap_err() == "rejected")
    assert(t.backend().writes == 1 && t.completed().line(0) == "0  ")
    t.backend_mut().fail = true
    assert(t.draw(&mut n,draw_number).unwrap_err() == "write interrupted")
    assert(t.backend().device.buffer().line(0) == "1  " && t.backend().device.cursor_visible())
    assert(t.completed().count() == 0 && t.completed().line(0) == "0  ")
    t.backend_mut().fail = false
    n = 0
    assert(t.draw(&mut n,draw_number).is_ok())
    assert(t.completed().count() == 1 && t.backend().device.buffer().line(0) == "0  " && !t.backend().device.cursor_visible())
    t.backend_mut().device.clear_region(.All)
    t.invalidate()
    assert(t.draw(&mut n,draw_number).is_ok() && t.backend().device.buffer().line(0) == "0  ")
    count := t.completed().count()
    t.backend_mut().device.resize(6,1)
    t.backend_mut().fail = true
    assert(t.draw(&mut n,draw_number).is_err() && t.completed().count() == count)
    t.backend_mut().fail = false
    n = 4
    assert(t.draw(&mut n,draw_number).is_ok() && t.completed().count() == count+1)
    assert(t.backend().device.buffer().line(0) == "4     ")
}

@test fn cell_transfers_preserve_clusters_and_decoration_keys() {
    mut src := tui.Frame::new(6,2)
    brush := tui.ink(.LightCyan).background(.Blue).underlined().underline_color(.Indexed(172))
    src.text(src.area(),"A界éZ",brush)
    mut dest := tui.Frame::new(6,3)
    dest.copy_region(&src,tui.Rect {x:1,y:0,w:4,h:1},1,1)
    assert(dest.line(1) == " 界éZ ")
    assert(dest.symbol_at(2,1).unwrap() == "" && dest.style_at(1,1).unwrap().get_underline_color() == .Some(.Indexed(172)))
    dest.resize(3,6)
    assert(dest.line(2) == " 界" && dest.symbol_at(0,3).unwrap() == "é")
    dest.erase(tui.Rect {x:2,y:2,w:1,h:1})
    assert(dest.line(2) == "   " && dest.style_at(1,2).unwrap().get_foreground() == .Some(.Default))
    dest.resize(0,0)
    assert(dest.area().is_empty())
}

@test fn cursor_transitions_have_no_output_on_idle_and_restore_after_cell_writes() {
    mut a := tui.Frame::new(5,2); mut b := tui.Frame::new(5,2)
    mut out: []u8 = [b'#']
    b.set_cursor_position(2,1)
    b.ansi_diff(&a,&mut out)
    assert(bytes.decode(&out).unwrap() == "#\x1b[2;3H\x1b[?25h")
    a.set_cursor_position(2,1); out.clear(); out.push(b'#')
    b.ansi_diff(&a,&mut out)
    assert(out.len == 1)
    b.label(b.area(),"X"); b.ansi_diff(&a,&mut out)
    assert(bytes.decode(&out).unwrap() == "#\x1b[1;1HX\x1b[2;3H")
    a.label(a.area(),"X"); b.hide_cursor(); out.clear()
    b.ansi_diff(&a,&mut out)
    assert(bytes.decode(&out).unwrap() == "\x1b[?25l")
}

@test fn scrollback_evicts_the_oldest_rows_and_retains_newest_content() {
    mut t := tui.Terminal<testing.TestBackend>::new(testing.TestBackend::new(2,1))
    mut n := 7
    assert(t.draw(&mut n,draw_number).is_ok())
    t.backend_mut().scroll_up(0,1,65535)
    assert(t.backend().scrollback().len() == 65535 && t.backend().scrollback().row(0).line(0) == "7 ")
    n = 8
    assert(t.draw(&mut n,draw_number).is_ok())
    t.backend_mut().append_lines(1)
    assert(t.backend().scrollback().len() == 65535 && t.backend().scrollback().row(0).line(0) == "  ")
    assert(t.backend().scrollback().row(65534).line(0) == "8 ")
}
@test fn offset_frames_use_absolute_coordinates_for_widgets_glyphs_styles_and_diffs() {
    a := tui.Rect {x:60000,y:40000,w:12,h:5}
    mut f := tui.Frame::at(a)
    assert(f.area() == a && f.line(0) == "" && f.symbol_at(a.x-1,a.y).is_none())
    brush := tui.ink(.Red).underline_color(.Blue)
    body := f.panel(a,"N",tui.ink(.Cyan))
    f.fill_symbol(body,".",tui.plain())
    f.text(body,"界é",brush)
    run := tui.GlyphRun::new("🌍abc")
    run.render(&mut f,body.offset(0,1),0,run.count(),brush)
    f.half_block(body.x+8,body.y+2,0xff22aa,0x66ccff)
    f.apply_style(tui.Rect {x:body.x+1,y:body.y,w:1,h:1},tui.plain().bold())
    assert(f.line(a.y) == "┌N─────────┐")
    assert(f.line(body.y) == "│界é.......│" && f.line(body.y+1) == "│🌍abc.....│")
    assert(f.style_at(body.x,body.y).unwrap().has(.Bold) && f.symbol_at(body.x+8,body.y+2).unwrap() == "▀")
    mut other := tui.Frame::at(tui.Rect {x:77,y:55,w:9,h:2})
    other.copy_region(&f,body,77,55)
    assert(other.line(55) == "界é......" && other.style_at(79,55).unwrap().get_underline_color() == .Some(.Blue))
    other.resize(6,3)
    assert(other.area().x == 77 && other.line(55) == "界é...")
    other.erase(tui.Rect {x:78,y:55,w:1,h:1})
    assert(other.line(55) == "  é...")
    f.clear_area(body)
    f.stroke(body,`─`,brush,.Replace)
    assert(f.line(body.y) == "│──────────│")
    blank := tui.Frame::at(a)
    mut changed := tui.Frame::at(a)
    assert(changed.set_cell(a.x+2,a.y+1,"界",tui.plain()))
    mut out: []u8 = []
    changed.ansi_diff(&blank,&mut out)
    assert(bytes.decode(&out).unwrap() == "\x1b[40002;60003H界")
}

@test fn invalid_viewports_report_errors_before_presentation() {
    bad := tui.Terminal<testing.TestBackend>::with_viewport(testing.TestBackend::new(4,3),.Fixed(tui.Rect {x:-1,y:0,w:1,h:1}))
    assert(bad.is_err())
    assert(tui.Terminal<testing.TestBackend>::with_viewport(testing.TestBackend::new(2,2),.Inline(0)).is_err())
    mut t := tui.Terminal<testing.TestBackend>::with_viewport(testing.TestBackend::new(4,3),.Inline(3)).unwrap()
    bad_width := tui.Frame::new(3,1)
    assert(t.insert_before(&bad_width).is_err() && t.backend().scrollback().len() == 0)
}
@test fn calendar_dates_validate_and_cross_leap_and_era_boundaries() {
    assert(cal.Date::new(1900,2,29).is_none() && cal.Date::new(2100,2,29).is_none())
    assert(cal.Date::new(2000,2,29).is_some() && cal.Date::new(0,2,29).is_some())
    assert(cal.Date::new(2024,4,31).is_none() && cal.Date::new(2024,0,1).is_none())
    jan := cal.Date::new(2024,1,31).unwrap()
    feb := cal.Date::new(2024,2,29).unwrap()
    assert(jan.add_months(1) == .Some(feb) && feb.weekday() == 4)
    assert(cal.Date::new(0,1,1).unwrap().add_days(-1) == cal.Date::new(-1,12,31))
    for d in [cal.Date::new(-9999,1,1).unwrap(),cal.Date::new(9999,12,31).unwrap()] {
        edge := if d.year() < 0 { -1 } else { 1 }
        assert(d.add_days(edge).is_none() && d.add_months(edge).is_none())
        mut month := cal.Monthly::new(d)
        month.surrounding = .Some(tui.plain().dim())
        mut frame := tui.Frame::at(tui.Rect {x:40,y:51,w:21,h:8})
        frame.render_widget(&month,frame.area())
        assert(frame.line(51).len == 21)
    }
}

@test fn calendar_events_replace_styles_and_preserve_their_date() {
    d := cal.Date::new(2024,2,29).unwrap()
    mut events := cal.EventStore::new()
    events.add(d,tui.ink(.Red).italic())
    events.add(d,tui.plain().background(.Blue))
    style := events.style_for(d)
    assert(style.get_foreground().is_none() && !style.has(.Italic))
    assert(style.get_background() == .Some(.Blue) && events.contains(d))
    assert(events.remove(d) && !events.remove(d) && !events.contains(d))
    current := cal.Date::today()
    marked := cal.EventStore::today(tui.plain().inverted())
    assert(marked.contains(current) || marked.contains(cal.Date::today()))
}

struct VisitCount { calls:i32 }

impl VisitCount {
    pub fn render_stateful(&mut self, frame: &mut tui.Frame, area:tui.Rect, visits: &mut i32) {
        self.calls += 1
        visits += 10
        frame.label(area,f"{self.calls}/{visits}")
    }
}

@test fn custom_widgets_keep_caller_state_and_render_at_absolute_coordinates() {
    mut frame := tui.Frame::at(tui.Rect {x:15,y:70,w:9,h:2})
    label := rich.Line::raw("Antal")
    frame.render_widget(&label,frame.area())
    mut meter := VisitCount {calls:0}
    mut visits := 0
    row := frame.area().row_at(1).unwrap()
    frame.render_stateful_widget(&mut meter,row,&mut visits)
    frame.render_stateful_widget(&mut meter,row,&mut visits)
    assert(frame.line(70) == "Antal    " && frame.line(71) == "2/20     ")
    assert(meter.calls == 2 && visits == 20)
    mut list := lists.List::new([lists.Item::raw("A"),lists.Item::raw("B")])
    mut selection := lists.ListState::new()
    selection.last()
    frame.render_stateful_widget(&list,row,&mut selection)
    assert(selection.offset == 1 && frame.line(71)[0] == b'B')
    bar := widgets.Scrollbar::new(.Bottom)
    mut scroll := widgets.ScrollState::new(15)
    scroll.last()
    frame.render_stateful_widget(&bar,row,&mut scroll)
    assert(scroll.position == 14)
    assert(frame.symbol_at(row.x,row.y) == .Some("◄") && frame.symbol_at(row.right()-1,row.y) == .Some("►"))
}

@test fn buffer_diffs_validate_shared_coordinates_and_use_the_common_height() {
    mut first := tui.Frame::at(tui.Rect {x:3,y:7,w:4,h:1})
    mut next := tui.Frame::at(tui.Rect {x:3,y:7,w:4,h:3})
    first.label(first.area(),"ABCD")
    next.label(next.area(),"A1CD\nWXYZ")
    result := next.diff_positions(&first).unwrap()
    assert(result.len == 1 && result[0] == (4,7))
    assert(first.diff_positions(&next).unwrap()[0] == (4,7))
    next.label(next.area(),"1234")
    mut visits := 0
    assert(next.visit_changes(&first,&mut visits,fn(n: &mut i32,x:i32,y:i32) -> bool {
        n += 1; assert(x == 3 && y == 7); false
    }).is_ok() && visits == 1)
    shifted := tui.Frame::at(tui.Rect {x:4,y:7,w:4,h:1})
    assert(first.diff_positions(&shifted).is_err())
    narrow := tui.Frame::at(tui.Rect {x:3,y:7,w:3,h:1})
    assert(first.diff_positions(&narrow).is_err())
    assert(!next.set_diff_option(3,7,.ForcedWidth(0)) && !next.set_diff_option(3,7,.ForcedWidth(65536)))
    assert(!next.set_diff_option(2,7,.Skip) && next.diff_option_at(7,7).is_none())
}

@test fn headless_updates_preserve_skipped_cells_and_repair_external_writes() {
    mut old := tui.Frame::new(5,1)
    old.label(old.area(),"ABCDE")
    assert(old.set_diff_option(1,0,.Skip) && old.set_diff_option(2,0,.AlwaysUpdate))
    mut screen := tui.Frame::new(5,1)
    screen.label(screen.area(),"-----")
    unknown := tui.Frame::new(0,0)
    screen.apply_region_diff(&old,&unknown)
    assert(screen.line(0) == "A-CDE")
    screen.label(tui.Rect{x:1,y:0,w:2,h:1},"!!")
    screen.apply_region_diff(&old,&old)
    assert(screen.line(0) == "A!CDE")
    mut next := tui.Frame::new(5,1)
    next.label(next.area(),"ABCDE")
    screen.apply_diff(&next,&old)
    assert(screen.line(0) == "ABCDE")
    assert(next.set_cell_with_width(1,0,"[x]",3,tui.ink(.Cyan)))
    clear := tui.Frame::new(5,1)
    assert(next.diff_positions(&clear).unwrap().len == 3)
    next.clear()
    assert(next.diff_positions(&clear).unwrap().len == 0)
}

@test fn merging_preserves_cut_glyphs_and_rejects_unrepresentable_bounds_atomically() {
    mut a := tui.Frame::at(tui.Rect{x:12,y:7,w:4,h:1})
    a.label(a.area(),"界ab")
    a.set_cursor_position(14,7)
    b := tui.Frame::at(tui.Rect{x:13,y:7,w:1,h:1})
    assert(a.merge(&b).is_ok() && a.cell_at(12,7).unwrap().symbol == "界" && a.cell_at(13,7).unwrap().symbol == " ")
    assert(a.cursor_position() == .Some((14,7)))
    far := tui.Frame::at(tui.Rect{x:7000,y:7,w:1,h:1})
    assert(a.merge(&far).is_ok() && a.area().w == 6989 && a.cell_at(12,7).unwrap().symbol == "界")
    corner := tui.Frame::at(tui.Rect::new(65534,65534,1,1))
    assert(a.merge(&corner).is_err() && a.area().w == 6989 && a.cell_at(12,7).unwrap().symbol == "界")
    assert(a.try_resize(tui.Rect::new(0,0,65535,65535)).is_err() && a.area().w == 6989)
    assert(tui.Frame::try_at(tui.Rect::new(0,0,32000,32000)).is_err())
}

@test fn resizing_retains_raw_wide_symbols_when_their_trailing_column_changes_row() {
    mut f := tui.Frame::at(tui.Rect::new(10,20,7,1))
    f.label(f.area(),"a界  ❤️")
    _ := f.set_diff_option(12,20,.Skip)
    assert(f.try_resize(tui.Rect::new(50000,30000,2,4)).is_ok())
    assert(f.cell_at(50001,30000).unwrap().symbol == "界")
    assert(f.cell_at(50000,30001).unwrap().diff_option == .Skip)
    assert(f.cell_at(50001,30002).unwrap().symbol == "❤️")
    assert(f.try_resize(tui.Rect::new(0,0,2,1)).is_ok() && f.cell_at(1,0).unwrap().symbol == "界")
    assert(f.index_of(1,0) == .Some(1) && f.position_at(1) == .Some((1,0)))
    assert(f.index_of(2,0).is_none() && f.position_at(2).is_none())
}

@test fn the_last_column_of_a_long_grapheme_can_be_split_or_overwritten() {
    for width in [4096,4097,8193,65535] {
        mut text: []u8 = []
        for _ in 1..width { bytes.append_utf8(&mut text,"\u{600}") }
        text.push(b'a')
        symbol := bytes.decode(&text).unwrap()
        mut f := tui.Frame::new(width,1)
        assert(f.set_cell(0,0,symbol,tui.ink(.Cyan)))
        assert(f.symbol_at(width-1,0) == .Some(""))
        f.paint_cells(tui.Rect::new(width-1,0,1,1),"Z",tui.ink(.Red))
        assert(f.cell_at(0,0).unwrap().symbol == symbol && f.cell_at(width-1,0).unwrap().symbol == "Z")
        assert(f.set_cell(0,0,symbol,tui.ink(.Cyan)))
        f.label(tui.Rect::new(width-1,0,1,1),"Q")
        assert(f.cell_at(0,0).unwrap().symbol == " " && f.cell_at(width-1,0).unwrap().symbol == "Q")
    }
}


@test fn merged_raw_symbols_keep_their_display_width_across_a_row_boundary() {
    mut raw := tui.Frame::new(4,2)
    assert(raw.set_cell_with_width(3,0,"abc",3,tui.plain()))
    assert(raw.set_diff_option(3,0,.None))
    mut old := tui.Frame::new(4,2)
    mut next := tui.Frame::new(4,2)
    assert(old.merge(&raw).is_ok() && next.merge(&raw).is_ok())
    next.label(tui.Rect{x:0,y:1,w:4,h:1},"XYZ")
    positions := next.diff_positions(&old).unwrap()
    assert(positions.len == 1 && positions[0] == (2,1))
}
struct BufferedOutput {
    device: testing.TestBackend, pending: []u8, sent: []u8, writes: i32, flushes: i32, fail_write: bool, fail_flush: bool,
}
impl tui.Backend for BufferedOutput {
    fn size(&mut self) -> (i32,i32) { (4,2) }
    fn draw_cells(&mut self, f:&tui.Frame, previous:&tui.Frame) -> Result<(),string> {
        self.writes += 1
        f.ansi_cells(&previous,&mut self.pending)
        self.device.draw_cells(&f,&previous)?
        if self.fail_write { return .Err("cell write") }
        .Ok
    }
    fn present(&mut self, f:&tui.Frame, previous:&tui.Frame) -> Result<(),string> {
        self.writes += 1
        f.ansi_diff(&previous,&mut self.pending)
        self.device.present(&f,&previous)
    }
    fn flush(&mut self) -> Result<(),string> {
        self.flushes += 1
        if self.fail_flush { return .Err("backend flush") }
        bytes.extend_range(&mut self.sent,&self.pending,0,self.pending.len)
        self.pending.clear()
        .Ok
    }
}

@test fn manual_cell_flush_retains_the_staging_buffer_and_backend_output_until_requested() {
    mut t := tui.Terminal<BufferedOutput>::new(BufferedOutput { device:testing.TestBackend::new(4,2), pending:[], sent:[],
        writes:0, flushes:0, fail_write:false, fail_flush:false })
    a := t.viewport_area()
    f := t.get_frame()
    f.label(a,"AC")
    f.set_cursor_position(3,1)
    assert(t.get_frame().cursor_position().is_none() && t.current_buffer_mut().line(0) == "AC  ")
    t.backend_mut().device.show_cursor()
    assert(t.flush().is_ok() && t.flush().is_ok())
    assert(t.backend().device.cursor_visible() && t.backend().device.cursor_position() == (0,0))
    assert(bytes.decode(&t.backend().pending).unwrap() == "\x1b[1;1HAC\x1b[1;1HAC")
    assert(t.backend().sent.len == 0 && t.backend().writes == 2 && t.backend().flushes == 0)
    t.swap_buffers()
    assert(t.get_frame().count() == 0 && t.current_buffer_mut().line(0) == "    " && t.completed().line(0) == "AC  ")
    assert(t.backend_mut().flush().is_ok() && t.backend().flushes == 1 && t.backend().pending.len == 0)
    t.current_buffer_mut().label(a,"SZ")
    assert(t.apply_buffer_with_cursor(.Some((3,1))).is_ok())
    assert(t.backend().device.buffer().line(0) == "SZ  " && t.backend().device.cursor_position() == (3,1))
    assert(t.backend().flushes == 2 && t.get_frame().count() == 1)
    t.current_buffer_mut().label(a,"keep")
    t.backend_mut().fail_write = true
    assert(t.flush().unwrap_err() == "cell write" && t.backend().flushes == 2)
    t.backend_mut().fail_write = false
    assert(t.flush().is_ok() && t.completed().line(0) == "SZ  ")
    t.backend_mut().fail_flush = true
    assert(t.apply_buffer().unwrap_err() == "backend flush" && t.completed().line(0) == "SZ  ")
    assert(t.get_frame().count() == 1 && t.current_buffer_mut().line(0) == "    ")
    t.backend_mut().fail_flush = false
    t.current_buffer_mut().label(a,"next")
    assert(t.apply_buffer().is_ok() && t.completed().line(0) == "next" && t.get_frame().count() == 2)
    assert(!t.backend().device.cursor_visible())
}

@test fn a_backend_can_support_full_frames_without_supporting_manual_cell_writes() {
    mut t := tui.Terminal<CursorFailure>::new(CursorFailure { output:[] })
    t.get_frame().label(tui.Rect{x:0,y:0,w:4,h:1},"test")
    assert(t.flush().is_err())
    assert(t.apply_buffer().is_ok() && t.completed().line(0) == "test        ")
}

@test fn paths_preserve_isolated_vertices_nonfinite_gaps_and_wide_marker_order() {
    nan := f64.from_bits(0x7ff8000000000000)
    inf := f64.from_bits(0x7ff0000000000000)
    points: [](f64,f64) = [(0.0,0.0),(nan,1.0),(3.0,0.0),(inf,-3.0),(-7.0,4.0),(5.0,-2.0),
        (1.0,1.0),(1.0,1.0),(0.0,1.0),(-1.0,1.0)]
    for mode in 0..3 {
        mut expected := tui.Frame::new(11,7)
        mut got := tui.Frame::new(11,7)
        area := tui.Rect{x:1,y:1,w:8,h:5}
        for run in 0..2 {
            mut view := plot.Plot::new([-4.0,4.0],[-3.0,3.0])
            view.marker = .Custom(`界`)
            mut frame := tui.Frame::new(11,7)
            frame.fill(frame.area(),`.`,tui.ink(.Green).background(.Blue).italic())
            p := view.begin(&mut frame,area)
            baseline := if mode == 1 { 7.0 } else { nan }
            if run == 0 {
                p.points(&points,.Yellow)
                for i in 1..points.len {
                    a := &points[i-1]; b := &points[i]
                    if mode == 0 { p.line(a.0,a.1,b.0,b.1,.Yellow) }
                    else { p.filled_line(a.0,a.1,b.0,b.1,baseline,.Yellow) }
                }
                p.layer()
            } else {
                if mode == 0 { p.polyline(&points,.Yellow) }
                else { p.filled_polyline(&points,baseline,.Yellow) }
                p.finish(&mut frame)
            }
            p.set_marker(.HalfBlock)
            p.point(2.0,0.0,.Red)
            view.finish(&mut frame)
            if run == 0 { expected = move frame } else { got = move frame }
        }
        for y in 0..7 {
            assert(got.line(y) == expected.line(y))
            for x in 0..11 {
                actual := got.style_at(x,y).unwrap()
                want := expected.style_at(x,y).unwrap()
                assert(actual.get_foreground() == want.get_foreground() && actual.get_background() == want.get_background())
                assert(actual.has(.Italic) == want.has(.Italic))
            }
        }
    }
}

@test fn cell_widgets_keep_raw_symbols_styles_and_diff_options_within_their_area() {
    a := tui.Rect{x:8,y:2,w:5,h:1}
    mut frame := tui.Frame::at(a)
    _ := frame.set_cell(8,2,"界",tui.ink(.Red))
    _ := frame.set_cell(11,2,"界",tui.ink(.Green))
    _ := frame.set_diff_option(9,2,.AlwaysUpdate)
    mut fill := widgets.Fill::new("xy")
    fill.style = tui.plain().background(.Blue)
    frame.render_widget(&fill,tui.Rect{x:9,y:2,w:3,h:1})
    assert(frame.cell_at(8,2).unwrap().symbol == "界" && frame.cell_at(12,2).unwrap().symbol == " ")
    painted := frame.cell_at(9,2).unwrap()
    assert(painted.symbol == "xy" && painted.style.get_background() == .Some(.Blue))
    assert(match painted.diff_option { .AlwaysUpdate => true, _ => false, })
    mut copy := tui.Frame::at(a)
    copy.copy_region(&frame,a,8,2)
    assert(copy.cell_at(9,2).unwrap().symbol == "xy" && copy.diff_positions(&frame).unwrap().len == 0)
    frame.render_widget(widgets.Clear{},tui.Rect{x:9,y:2,w:1,h:1})
    cleared := frame.cell_at(9,2).unwrap()
    assert(cleared.symbol == " " && cleared.style.get_background() == .Some(.Default))
    assert(match cleared.diff_option { .None => true, _ => false, })
    mut one := tui.Frame::new(1,1)
    one.render_widget(&fill,one.area())
    blank := tui.Frame::new(1,1)
    assert(blank.diff_positions(&one).unwrap() == [(0,0)])
    one.render_widget(widgets.Fill::new(""),one.area())
    assert(one.cell_at(0,0).unwrap().symbol == "")
    one.resize(2,1)
    assert(one.cell_at(0,0).unwrap().symbol == "")
}

@test fn contextual_width_handles_truncated_emoji_controls_and_cell_overflow() {
    value := "🏻‍🫲🏼"
    assert(width.cell_columns(value) == 2 && rich.Span::raw(value.clone()).width() == 2)
    assert(width.cell_columns(value + "\r\nx") == 4)
    assert(width.cell_columns("\u{85}x\r\r\n") == 4)
    mut raw: []u8 = []
    for _i in 0..65536 { raw.push(97) }
    line := bytes.decode(&raw).unwrap()
    assert(width.cell_columns(line) == 0)
    assert(width.cell_columns(line + "ﾞ") == 2)
    assert(width.cell_columns(line[1..line.len] + "ﾞ") == 1)
    assert(width.cell_columns(line[2..line.len] + "ﾞ") == 65535)
    assert(rich.Span::raw(move line).width() == 65536)
}

@test fn a_block_uses_raw_cells_and_named_border_types_replace_custom_symbols() {
    mut f := tui.Frame::new(4,1)
    _ := f.set_cell(0,0,"界",tui.ink(.Red))
    mut b := box.Block::new().border_set(box.BorderSymbols{
        tl:"",tr:"",bl:"",br:"",left:"狐",right:"ab",top:"é",bottom:"·" })
    b.borders.left = true
    b.borders.right = true
    b.merge = .Fuzzy
    area := tui.Rect::new(1,0,3,1)
    f.render_widget(&b,area)
    assert(f.cell_at(0,0).unwrap().symbol == "界" && f.cell_at(1,0).unwrap().symbol == "狐")
    assert(f.cell_at(3,0).unwrap().symbol == "ab")
    b = b.border_type(.Double)
    b.merge = .Replace
    f.render_widget(&b,area)
    assert(f.cell_at(1,0).unwrap().symbol == "║" && f.cell_at(3,0).unwrap().symbol == "║")
}

@test fn saved_themes_survive_composition_copy_resize_and_cell_diff() {
    raw := "{\"add_modifier\":\"BOLD | 0x8200\",\"sub_modifier\":\"BOLD | 0x200\"}"
    style := json.from_str<tui.Style>(raw).unwrap()
    mut painted := tui.Frame::new(3, 1)
    area := painted.area()
    painted.fill(area, rune(120), tui.ink(.Blue).bold())
    painted.fill(area, rune(120), style)
    expected := json.from_str<tui.Style>("{\"fg\":\"Blue\",\"bg\":\"Reset\",\"underline_color\":\"Reset\",\"add_modifier\":\"0x8000\"}").unwrap()
    assert(painted.style_at(2, 0).unwrap() == expected)

    mut copy := tui.Frame::new(3, 1)
    copy.copy_region(&painted, area, 0, 0)
    copy.resize(4, 1)
    assert(copy.style_at(2, 0).unwrap() == expected)
    copy.resize(3, 1)
    assert(copy.diff_positions(&painted).unwrap().len == 0)

    mut visible := tui.Frame::new(3, 1)
    visible.fill(area, rune(120), tui.ink(.Blue))
    assert(copy.diff_positions(&visible).unwrap().len == 3)
    empty := tui.Frame::new(0, 0)
    mut first: []u8 = []
    mut second: []u8 = []
    copy.ansi_diff(&empty, &mut first)
    visible.ansi_diff(&empty, &mut second)
    assert(bytes.decode(&first).unwrap() == bytes.decode(&second).unwrap())
    remove := json.from_str<tui.Style>("{\"sub_modifier\":\"0x8000\"}").unwrap()
    copy.apply_cell_style(area, remove)
    assert(copy.diff_positions(&visible).unwrap().len == 0)
}

@test fn serialized_layout_keeps_spacing_and_excludes_cached_regions() {
    mut original := layout.Layout::horizontal([.Length(4),.Fill(1)]).margin(1,0).with_spacing(.Space(65535))
    area := tui.Rect::new(3,7,18,4)
    encoded := json.to_string(&original).unwrap()
    assert(words.find(encoded, "\"spacing\":{\"Space\":65535}").is_some())
    mut loaded := json.from_str<layout.Layout>(encoded).unwrap()
    expected := original.split(area)
    actual := loaded.split(area)
    assert(actual.len == 2 && expected[0] == actual[0] && expected[1] == actual[1])
    assert(actual[1].x == actual[0].right()-1 && json.to_string(&loaded).unwrap() == encoded)
    twice := loaded.with_spacing(.Overlap(0))
    assert(words.find(json.to_string(&twice).unwrap(), "\"Overlap\":0").is_some())
}

@test fn rectangle_json_preserves_raw_fields_and_rejects_unrepresentable_values() {
    input := "[65534,65533,7,8]"
    rect := json.from_str<tui.Rect>(input).unwrap()
    assert(rect.w == 7 && rect.h == 8 && rect.right() == 65535 && rect.bottom() == 65535)
    assert(rect.inner(0,0) == rect && rect.row_at(0).unwrap().w == 1)
    assert(json.to_string(&rect).unwrap() == "{\"x\":65534,\"y\":65533,\"width\":7,\"height\":8}")
    bad := tui.Rect { x:-3, y:0, w:7, h:8 }
    values: []tui.Rect = [rect, bad]
    assert(json.to_string(&values).is_err())
    mut invalid := json.Writer::new()
    invalid.end()
    message := invalid.finish().unwrap_err().message
    bad.encode_json(&mut invalid)
    assert(invalid.finish_bytes().unwrap_err().message == message)
}

@test fn saved_cells_keep_empty_symbols_and_independent_wide_neighbors() {
    mut frame := tui.Frame::at(tui.Rect::new(4,7,5,1))
    frame.text(frame.area(),"界 ",tui.ink(.Green))
    assert(frame.raw_cell_at(4,7).unwrap().symbol == .Some("界"))
    assert(frame.raw_cell_at(5,7).unwrap().symbol.is_none())
    assert(frame.raw_cell_at(6,7).unwrap().symbol == .Some(" "))
    mut cell := tui.RawCell::empty()
    cell.symbol = .Some("")
    cell.modifier = tui.Modifiers { bits:0x8001 }
    assert(frame.set_raw_cell(5,7,&cell))
    cell.symbol = .Some("Z")
    cell.skip = true
    cell.diff_option = .AlwaysUpdate
    assert(frame.set_raw_cell(7,7,&cell))
    assert(!frame.set_raw_cell(9,7,&cell))
    saved := json.to_string(&frame).unwrap()
    mut loaded := json.from_str<tui.Frame>(saved).unwrap()
    assert(loaded.raw_cell_at(4,7).unwrap().symbol == .Some("界"))
    tail := loaded.raw_cell_at(5,7).unwrap()
    assert(tail.symbol == .Some("") && tail.modifier.contains(.Bold) && tail.modifier.bits == 0x8001)
    assert(loaded.diff_positions(&frame).unwrap().len == 1)
    assert(loaded.set_diff_option(7,7,.None))
    assert(loaded.raw_cell_at(7,7).unwrap().skip && loaded.diff_positions(&frame).unwrap().len == 0)
    assert(loaded.set_diff_option(7,7,.ForcedWidth(2)))
    assert(loaded.raw_cell_at(7,7).unwrap().skip && loaded.diff_positions(&frame).unwrap().len == 1)
    before := json.to_string(&loaded).unwrap()
    mut bad := tui.RawCell::empty()
    bad.diff_option = .ForcedWidth(0)
    assert(!loaded.set_raw_cell(7,7,&bad) && json.to_string(&bad).is_err())
    assert(json.to_string(&loaded).unwrap() == before)
}

@test fn serialized_buffer_validates_shape_before_allocating_a_frame() {
    invalid := "{\"area\":[0,0,65535,65535],\"content\":[]}"
    raw := json.from_str<tui.Buffer>(invalid).unwrap()
    assert(raw.area.cell_count() == 4294836225 && raw.content.len == 0)
    assert(raw.to_frame().is_err() && json.from_str<tui.Frame>(invalid).is_err())
    assert(json.from_str<tui.Frame>("{\"area\":[65535,65535,0,0],\"content\":[]}").is_ok())
}

@test fn imported_symbols_compare_equal_across_cell_writers() {
    for symbol in ["\u{301}","\u{301}\u{302}","\u{200b}"," ","","界","e\u{301}","x","abc"] {
        for mode in 0..4 {
            mut frame := tui.Frame::new(5,1)
            if mode == 0 { if !frame.set_cell(0,0,symbol,tui.plain()) { continue } }
            else if mode == 1 { frame.paint_cells(tui.Rect::new(0,0,1,1),symbol,tui.plain()) }
            else if mode == 2 { assert(frame.set_cell_with_width(0,0,symbol,1,tui.plain())) }
            else { frame.text(frame.area(),symbol,tui.plain()) }
            loaded := json.from_str<tui.Frame>(json.to_string(&frame).unwrap()).unwrap()
            assert(loaded.diff_positions(&frame).unwrap().len == 0)
            assert(frame.diff_positions(&loaded).unwrap().len == 0)
            if mode == 0 {
                previous := tui.Frame::new(0,0)
                mut before: []u8 = []
                mut after: []u8 = []
                frame.ansi_diff(&previous,&mut before)
                loaded.ansi_diff(&previous,&mut after)
                assert(bytes.decode(&before).unwrap() == bytes.decode(&after).unwrap())
            }
        }
    }
}
