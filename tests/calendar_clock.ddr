import ..src.calendar as cal
import std.parse as parse
import std.time as time
import sys

fn main() -> i32 {
    if sys.arg_count() == 1 {
        d := cal.Date::today()
        print(f"{d.year()} {d.month()} {d.day()}")
        return 0
    }
    compare := sys.arg(1) == "--compare"
    for i in (if compare { 2 } else { 1 })..sys.arg_count() {
        n := parse.integer(sys.arg(i))
        if !n.ok { return 1 }
        if compare {
            toolkit := match cal.local_date(n.value) { .Some(d) => f"{d.year()}-{d.month()}-{d.day()}", .None => "none", }
            library := match time.local_from_unix(n.value) { .Some(d) => f"{d.year}-{d.month}-{d.day}", .None => "none", }
            print(f"{n.value} {toolkit} {library}")
            continue
        }
        match cal.local_date(n.value) {
            .Some(d) => { print(f"{d.year()} {d.month()} {d.day()}") },
            .None => { return 2 },
        }
    }
    0
}
