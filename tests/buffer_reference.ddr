import ..src.tui
import std.bytes as bytes

fn edits(frame: &mut tui.Frame, content: i32, flags: i32) {
    a := frame.area()
    frame.label(a,"abcd1234\nqRSTUvwx")
    ink := if content%2 == 0 { tui.plain() } else { tui.ink(.Red).background(.Blue).underlined() }
    x := a.x+1
    match content {
        0 => {},
        1 | 2 => { _ := frame.set_cell(x,a.y,"界",ink) },
        3 | 4 => { _ := frame.set_cell(x,a.y,"❤️",ink) },
        5 => { frame.clear_area(tui.Rect {x:x,y:a.y,w:3,h:1}); _ := frame.set_cell(x,a.y,"z",ink) },
        6 => { _ := frame.set_cell(x,a.y,"é",ink) },
        7 => { frame.fill(a,` `,ink) },
        8 => { _ := frame.set_cell_with_width(x,a.y,"[ok]",4,ink) },
        _ => { _ := frame.set_cell(a.x+2,a.y,"界",ink); _ := frame.set_cell(a.x+3,a.y+1,"☀️",ink) },
    }
    match flags {
        0 => {},
        1 => { _ := frame.set_diff_option(x,a.y,.Skip) },
        2 => { _ := frame.set_diff_option(x,a.y,.AlwaysUpdate) },
        3 | 4 | 5 => { _ := frame.set_diff_option(x,a.y,.ForcedWidth(flags-2)) },
        6 => { _ := frame.set_diff_option(x+1,a.y,.Skip); _ := frame.set_diff_option(x+2,a.y,.AlwaysUpdate) },
        7 => { _ := frame.set_diff_option(a.x+6,a.y,.ForcedWidth(5)); _ := frame.set_diff_option(x,a.y+1,.AlwaysUpdate) },
        8 => { _ := frame.set_diff_option(a.x+6,a.y,.ForcedWidth(65535)) },
        _ => { _ := frame.set_diff_option(x,a.y,.Skip); _ := frame.set_diff_option(x+1,a.y,.AlwaysUpdate) },
    }
}

fn main() {
    a := tui.Rect {x:7,y:4,w:8,h:2}
    for old in 0..10 { for old_flags in 0..10 {
        mut prev := tui.Frame::at(a)
        edits(&mut prev,old,old_flags)
        for new in 0..10 { for flags in 0..10 {
            mut curr := tui.Frame::at(a)
            edits(&mut curr,new,flags)
            mut output: []u8 = []
            for pos in curr.diff_positions(&prev).unwrap() {
                bytes.append_decimal(&mut output,i64(pos.0)); output.push(b',')
                bytes.append_decimal(&mut output,i64(pos.1)); output.push(b' ')
            }
            print(bytes.decode(&output).unwrap())
            output.clear()
            curr.ansi_diff(&prev,&mut output)
            print(bytes.decode(&output).unwrap())
        } }
    } }
}
