capability unsafe, stdio, process
import sys
import .saved_backend
import .terminal_driver as driver
import ..src.tui

fn child() -> i32 {
    mut terminal := tui.open(.Fullscreen).unwrap()
    mut view := saved_backend.open()
    if terminal.draw(&mut view,saved_backend.paint).is_err() { return 1 }
    match terminal.backend_mut().next(3000) { .Press(.Down) => { saved_backend.advance(&mut view) }, _ => { return 1 }, }
    if terminal.draw(&mut view,saved_backend.paint).is_err() { return 1 }
    match terminal.backend_mut().next(3000) { .Press(.Char(c)) if c == rune(126) => { return 0 }, _ => { return 1 }, }
}

fn exercise(master: i32, slave: i32, screen: &mut driver.Screen) -> bool {
    unsafe {
        if !driver.wait_for(master,&mut screen,0,"LOGG","") || !screen.contains(1,"KAJ") || !screen.contains(2,"SYD") { return false }
        if !driver.send(master,"\x1b[B") || !driver.wait_for(master,&mut screen,0,"KAJ","") || !screen.contains(1,"SYD") { return false }
        return driver.send(master,"~") && driver.wait_for(master,&mut screen,0,"","\x1b[?1049l")
    }
    false
}

fn main() -> i32 {
    if sys.arg_count() > 1 { return child() }
    unsafe {
        if driver.test_with_args(sys.arg(0),["draw"],8,5,exercise) {
            print("Restored screen, scrollback, Down key and terminal modes OK")
            return 0
        }
    }
    1
}
