capability unsafe, stdio, process
import .terminal_driver as driver
import ..tools.pty
import sys

fn exercise(master: i32, slave: i32, screen: &mut driver.Screen) -> bool {
    unsafe {
        if !driver.wait_for(master, &mut screen, 1, "Ta med ut till fyren.", "\x1b[?1049h") { return false }
        if !driver.send(master,"e") || !driver.wait_for(master,&mut screen,6,"Ta med ut till fyren.","\x1b[?25h") { return false }
        if !screen.cursor_visible || screen.x != 21 || screen.y != 6 { return false }
        if !driver.send(master,"\x1b[H") || !driver.wait_for(master,&mut screen,6,"Ta med","\x1b[7;1H") { return false }
        if !driver.send(master,"界") || !driver.wait_for(master,&mut screen,6,"界","\x1b[7;3H") { return false }
        if !driver.send(master,"é") || !driver.wait_for(master,&mut screen,6,"","\x1b[7;4H") { return false }
        if !driver.send(master,"\x7f") || !driver.wait_for(master,&mut screen,6,"","\x1b[7;3H") { return false }
        if !driver.send(master,"\r") || !driver.wait_for(master,&mut screen,1,"界Ta med ut till fyren.","\x1b[?25l") { return false }
        if screen.cursor_visible { return false }
        if !driver.send(master, "\x1b[B") || !driver.wait_for(master, &mut screen, 1, "Läs kapitel tre igen.", "") { return false }
        if !driver.send(master, "\x1b[F") || !driver.wait_for(master, &mut screen, 1, "Slå upp pärlemormoln.", "") { return false }
        if !pty.resize(slave, 31, 6) { return false }
        screen = driver.Screen::new(31, 6)
        if !driver.wait_for(master, &mut screen, 1, "▸ Molnatlas", "") { return false }
        if !driver.send(master, "\x1b[H") || !driver.wait_for(master, &mut screen, 1, "▸ Fåglar vid kusten", "") { return false }
        if !driver.send(master, "q") || !driver.wait_for(master, &mut screen, 1, "", "\x1b[?1049l") { return false }
    }
    true
}

fn main() -> i32 {
    if sys.arg_count() == 2 && (target_is("macos") || target_is("linux")) {
        unsafe { if driver.test(sys.arg(1),66,8,exercise) { print("bokhylla terminal OK"); return 0 } }
    }
    _ := sys.eprint("Run on macOS or Linux with the bokhylla executable as argument.")
    1
}
