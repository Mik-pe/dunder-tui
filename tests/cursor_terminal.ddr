capability unsafe, process, stdio
import .terminal_driver as driver
import ..tools.pty
import sys

fn failure(stage: string, screen: &driver.Screen) -> bool {
    _ := sys.eprint(f"{stage}: cursor {screen.x},{screen.y} visible={screen.cursor_visible}")
    false
}

fn exercise(master: i32, slave: i32, screen: &mut driver.Screen) -> bool {
    unsafe {
        if !driver.wait_state(master,&mut screen,0,"ABC","\x1b[2;2H",1,1,1) { return failure("first frame",&screen) }
        if !driver.send(master,"n") || !driver.wait_state(master,&mut screen,0,"ABC","\x1b[3;8H",7,2,1) { return failure("cursor-only frame",&screen) }
        if !driver.send(master,"nn") || !driver.wait_state(master,&mut screen,0,"XYZ","\x1b[3;8H",7,2,1) { return failure("repaint",&screen) }
        if !driver.send(master,"n") || !driver.wait_state(master,&mut screen,0,"XYZ","\x1b[?25l",-1,-1,0) { return failure("hidden cursor",&screen) }
        if !driver.send(master,"n") || !driver.wait_state(master,&mut screen,0,"XYZ","\x1b[6;18H",17,5,1) { return failure("last cell",&screen) }
        if !pty.resize(slave,9,4) { return failure("resize setup",&screen) }
        screen = driver.Screen::new(9,4)
        if !driver.wait_state(master,&mut screen,0,"XYZ","\x1b[4;9H",8,3,1) { return failure("resized frame",&screen) }
        if !driver.send(master,"q") || !driver.wait_for(master,&mut screen,0,"","\x1b[?1049l") { return failure("exit",&screen) }
    }
    true
}
fn main() -> i32 {
    if sys.arg_count() == 2 || sys.arg_count() == 3 {
        mut args: []string = []
        if sys.arg_count() == 3 { args.push(sys.arg(2)) }
        unsafe { if driver.test_with_args(sys.arg(1),move args,18,6,exercise) { print("cursor PTY OK"); return 0 } }
    }
    1
}
