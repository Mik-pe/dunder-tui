capability unsafe, stdio, process
import ..tools.pty
import std.bytes as bytes
import std.text as text
import std.time as clock
import sys

@extern("c", "tcgetattr")
unsafe fn attributes(fd: i32, buf: ptr) -> i32

pub struct Screen { w: i32, h: i32, x: i32, y: i32, cells: []rune }

impl Screen {
    pub fn new(w: i32, h: i32) -> Self {
        mut cells: []rune = []
        cells.reserve(w * h)
        for _ in 0..(w * h) { cells.push(` `) }
        Self { w: w, h: h, x: 0, y: 0, cells: move cells }
    }
    pub fn contains(&self, row: i32, value: string) -> bool {
        mut line: []u8 = []
        for x in 0..self.w { bytes.append_utf8(&mut line, self.cells[row*self.w+x].str()) }
        text.contains(bytes.decode(&line).unwrap(), value)
    }
    fn apply(&mut self, batch: string) {
        chars := batch.runes()
        mut i := 0
        while i < chars.len {
            c := chars[i]
            i += 1
            if i32(c) == 27 && i < chars.len && chars[i] == `[` {
                i += 1
                mut previous := 0
                mut number := 0
                while i < chars.len {
                    v := chars[i]
                    i += 1
                    if v >= `0` && v <= `9` { number = number * 10 + i32(v) - 48; continue }
                    if v == `;` { previous = number; number = 0; continue }
                    if v == `?` { continue }
                    if v == `H` {
                        self.y = if previous > 0 { previous - 1 } else { 0 }
                        self.x = if number > 0 { number - 1 } else { 0 }
                    } else if v == `J` && number == 2 {
                        for n in 0..self.cells.len { self.cells[n] = ` ` }
                    }
                    break
                }
            } else if i32(c) >= 32 {
                if self.y >= 0 && self.y < self.h && self.x >= 0 && self.x < self.w { self.cells[self.y*self.w + self.x] = c }
                self.x += 1
            }
        }
    }
}

pub unsafe fn wait_for(master: i32, screen: &mut Screen, row: i32, expected: string, control: string) -> bool {
    mut fd: []u8 = [u8(master), u8(master.shr(8)), u8(master.shr(16)), u8(master.shr(24)), 1, 0, 0, 0]
    deadline := clock.monotonic_ns() + 3000000000
    mut pending: []u8 = []
    mut control_seen := control.len == 0
    while clock.monotonic_ns() < deadline {
        if sys.fd_poll(&mut fd, 1, 100) <= 0 { continue }
        pending.reserve(pending.len + 8192)
        if sys.fd_read(master, &mut pending, 8192) <= 0 { return false }
        decoded := bytes.decode(&pending)
        if decoded.is_err() { continue }
        batch := decoded.unwrap()
        mut in_escape := false
        for byte in &pending {
            if byte == 27 { in_escape = true }
            else if byte >= 64 && byte <= 126 && byte != 91 { in_escape = false }
        }
        if in_escape { continue }
        screen.apply(batch)
        if !control_seen { control_seen = text.contains(batch, control) }
        pending.clear()
        if control_seen && screen.contains(row, expected) { return true }
    }
    _ := sys.eprint(f"missing {expected} in row {row}")
    false
}

pub unsafe fn send(master: i32, key: string) -> bool {
    data := key.bytes()
    sys.fd_write(master, &data, 0, i64(data.len)) == i64(data.len)
}

pub unsafe fn test(program: string,w:i32,h:i32,exercise: fn(i32,i32,&mut Screen)->bool) -> bool {
    mut master := -1
    mut slave := -1
    if !pty.open(&mut master, &mut slave, u16(w), u16(h)) { return false }
    defer { _ := sys.fd_close(master); _ := sys.fd_close(slave) }
    mut before: [u64; 16] = [0; 16]
    mut after: [u64; 16] = [0; 16]
    if attributes(slave, addr(&mut before[0])) != 0 { return false }
    result := pty.launch(program, [], slave, false)
    if result.is_err() { return false }
    mut child := result.unwrap()
    mut finished := false
    defer { if !finished { _ := child.kill(); _ := child.wait(1000) } }
    mut screen := Screen::new(w,h)
    if !exercise(master,slave,&mut screen) { return false }
    exit := child.wait(2000)
    finished = exit.exited
    if !exit.ok || !exit.exited || exit.code != 0 || exit.signal != 0 { return false }
    if attributes(slave, addr(&mut after[0])) != 0 { return false }
    if target_is("macos") {
        before[3] = before[3].bit_and(u64(0x20000000).bit_not())
        after[3] = after[3].bit_and(u64(0x20000000).bit_not())
    }
    for i in 0..16 { if before[i] != after[i] { return false } }
    true
}
