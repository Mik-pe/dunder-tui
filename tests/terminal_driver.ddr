capability unsafe, stdio, process
import ..tools.pty
import ..src.width
import std.bytes as bytes
import std.text as text
import std.time as clock
import sys

@extern("c", "tcgetattr")
unsafe fn attributes(fd: i32, buf: ptr) -> i32

pub struct Screen { w: i32, h: i32, x: i32, y: i32, cursor_visible: bool, alternate: bool, saved_x: i32, saved_y: i32, top: i32, bottom: i32, cells: []rune }

impl Screen {
    pub fn new(w: i32, h: i32) -> Self {
        mut cells: []rune = []
        cells.reserve(w * h)
        for _ in 0..(w * h) { cells.push(` `) }
        Self { w: w, h: h, x: 0, y: 0, cursor_visible: true, alternate:false, saved_x:0, saved_y:0, top:0, bottom:h, cells: move cells }
    }
    pub fn contains(&self, row: i32, value: string) -> bool {
        mut line: []u8 = []
        for x in 0..self.w {
            c := self.cells[row*self.w+x]
            if i32(c) != 0 { bytes.append_utf8(&mut line,c.str()) }
        }
        text.contains(bytes.decode(&line).unwrap(), value)
    }
    fn scroll(&mut self, delta: i32) {
        for row in 0..(self.bottom-self.top) {
            y := if delta < 0 { self.top+row } else { self.bottom-1-row }
            from := y-delta
            for x in 0..self.w {
                self.cells[y*self.w+x] = if from >= self.top && from < self.bottom { self.cells[from*self.w+x] } else { ` ` }
            }
        }
    }

    fn apply(&mut self, batch: string) {
        chars := batch.runes()
        mut i := 0
        while i < chars.len {
            c := chars[i]
            i += 1
            if i32(c) == 27 && i < chars.len && (chars[i] == `7` || chars[i] == `8`) {
                if chars[i] == `7` { self.saved_x = self.x; self.saved_y = self.y }
                else { self.x = self.saved_x; self.y = self.saved_y }
                i += 1
            } else if i32(c) == 27 && i < chars.len && chars[i] == `[` {
                i += 1
                mut private_mode := false
                mut previous := 0
                mut number := 0
                while i < chars.len {
                    v := chars[i]
                    i += 1
                    if v >= `0` && v <= `9` { number = number * 10 + i32(v) - 48; continue }
                    if v == `;` { previous = number; number = 0; continue }
                    if v == `?` { private_mode = true; continue }
                    if private_mode && number == 25 && (v == `h` || v == `l`) { self.cursor_visible = v == `h` }
                    if private_mode && number == 1049 { self.alternate = v == `h` }
                    if v == `r` {
                        self.top = if previous > 0 { previous-1 } else { 0 }
                        self.bottom = if number > 0 && number <= self.h { number } else { self.h }
                        self.x = 0; self.y = 0
                    } else if v == `S` || v == `T` {
                        count := if number > 0 { number } else { 1 }
                        self.scroll(if v == `S` { -count } else { count })
                    } else if v == `K` && number == 2 && self.y < self.h {
                        for col in 0..self.w { self.cells[self.y*self.w+col] = ` ` }
                    } else if v == `H` {
                        self.y = if previous > 0 { previous - 1 } else { 0 }
                        self.x = if number > 0 { number - 1 } else { 0 }
                    } else if v == `J` && number == 2 {
                        for n in 0..self.cells.len { self.cells[n] = ` ` }
                    }
                    break
                }
            } else if i32(c) == 13 { self.x = 0 }
            else if i32(c) == 10 {
                if self.y+1 == self.bottom { self.scroll(-1) }
                else if self.y+1 < self.h { self.y += 1 }
            } else if i32(c) >= 32 {
                cols := width.columns(i32(c))
                if cols <= 0 { continue }
                if self.y >= 0 && self.y < self.h && self.x >= 0 && self.x+cols <= self.w {
                    self.cells[self.y*self.w+self.x] = c
                    for dx in 1..cols { self.cells[self.y*self.w+self.x+dx] = rune(0) }
                }
                self.x += cols
            }
        }
    }
}

pub unsafe fn wait_for(master: i32, screen: &mut Screen, row: i32, expected: string, control: string) -> bool {
    wait_state(master,&mut screen,row,expected,control,-1,-1,-1)
}

pub unsafe fn wait_state(master: i32, screen: &mut Screen, row: i32, expected: string, control: string, x: i32, y: i32, visible: i32) -> bool {
    mut fd: []u8 = [u8(master), u8(master.shr(8)), u8(master.shr(16)), u8(master.shr(24)), 1, 0, 0, 0]
    deadline := clock.monotonic_ns() + 3000000000
    mut pending: []u8 = []
    mut control_seen := control.len == 0
    while clock.monotonic_ns() < deadline {
        if sys.fd_poll(&mut fd, 1, 100) <= 0 { continue }
        pending.reserve(pending.len + 8192)
        if sys.fd_read(master, &mut pending, 8192) <= 0 { return false }
        decoded := bytes.decode(&pending)
        if decoded.is_err() { continue }
        batch := decoded.unwrap()
        mut in_escape := false
        for byte in &pending {
            if byte == 27 { in_escape = true }
            else if byte >= 64 && byte <= 126 && byte != 91 { in_escape = false }
        }
        if in_escape { continue }
        screen.apply(batch)
        if !control_seen { control_seen = text.contains(batch, control) }
        pending.clear()
        if control_seen && screen.contains(row, expected) && (x < 0 || (screen.x == x && screen.y == y)) &&
            (visible < 0 || screen.cursor_visible == (visible == 1)) { return true }
    }
    _ := sys.eprint(f"missing {expected} in row {row}")
    false
}

pub unsafe fn send(master: i32, key: string) -> bool {
    data := key.bytes()
    sys.fd_write(master, &data, 0, i64(data.len)) == i64(data.len)
}

pub unsafe fn test(program: string,w:i32,h:i32,exercise: fn(i32,i32,&mut Screen)->bool) -> bool {
    test_with_args(program,[],w,h,exercise)
}

pub unsafe fn test_with_args(program: string, move args: []string,w:i32,h:i32,exercise: fn(i32,i32,&mut Screen)->bool) -> bool {
    mut master := -1
    mut slave := -1
    if !pty.open(&mut master, &mut slave, u16(w), u16(h)) { return false }
    defer { _ := sys.fd_close(master); _ := sys.fd_close(slave) }
    mut before: [u64; 16] = [0; 16]
    mut after: [u64; 16] = [0; 16]
    if attributes(slave, addr(&mut before[0])) != 0 { return false }
    result := pty.launch(program,move args,slave,false)
    if result.is_err() { return false }
    mut child := result.unwrap()
    mut finished := false
    defer { if !finished { _ := child.kill(); _ := child.wait(1000) } }
    mut screen := Screen::new(w,h)
    if !exercise(master,slave,&mut screen) { return false }
    exit := child.wait(2000)
    finished = exit.exited
    if !exit.ok || !exit.exited || exit.code != 0 || exit.signal != 0 { return false }
    if attributes(slave, addr(&mut after[0])) != 0 { return false }
    if target_is("macos") {
        before[3] = before[3].bit_and(u64(0x20000000).bit_not())
        after[3] = after[3].bit_and(u64(0x20000000).bit_not())
    }
    for i in 0..16 { if before[i] != after[i] { return false } }
    true
}
