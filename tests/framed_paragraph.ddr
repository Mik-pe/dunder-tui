capability stdio
import ..src.tui
import ..src.text as rich
import ..src.block as box
import .styled_grid
import std.json

fn article(k:i32, align:i32, wrap:rich.Wrap) -> rich.Paragraph {
    first := rich.Line::new([rich.Span::styled(" Natt",tui.ink(.Yellow).bold()),rich.Span::raw(" över 界")])
    last := rich.Line::raw("aaa界").align(.Right).styled(tui.ink(.Green))
    lines := rich.Text::new([move first,rich.Line::raw(""),rich.Line::raw("Drift 🌙"),move last]).styled(tui.plain().italic())
    mut p := rich.Paragraph::new(move lines).wrap(wrap).styled(tui.ink(.Cyan).background(.Blue).without(.Bold))
    p = match align { 0 => p.left_aligned(), 1 => p.centered(), _ => p.right_aligned(), }
    if k == 0 { return move p }
    if k == 4 {
        panel := box.Block::bordered().border_set(box.BorderSymbols { tl:"╭",tr:"╮",bl:"╰",br:"╯",left:"界",right:"👩🏽‍💻",top:"─",bottom:"─" })
        return p.block(panel.title("秋"))
    }
    mut b := box.Block::new()
    if k == 2 {
        b = box.Block::bordered().border_type(.Rounded).title("N")
        b.padding = box.Padding { left:1,right:2,top:0,bottom:1 }
    } else if k == 3 {
        b.borders = box.Borders { left:true,right:false,top:true,bottom:false }
        b = b.title_at(.Bottom,rich.Line::raw("S").align(.Right))
        b.padding = box.Padding { left:0,right:1,top:1,bottom:0 }
    }
    b.style = tui.ink(.Red).background(.Magenta).underlined()
    b.title_style = tui.ink(.Green)
    b.border_style = tui.ink(.Yellow)
    p.block(move b)
}

fn main() {
    for a in [tui.Rect::new(0,0,16,9),tui.Rect::new(5,3,16,9)] {
        for flags in [false,true] { for wrap in [rich.Wrap.Clip,.Trim,.Preserve] {
            for k in 0..5 { for align in 0..3 {
                mut live := article(k,align,wrap)
                mut cache := article(k,align,wrap).prepare(1)
                mut direct := styled_grid.seed(a,flags)
                mut prepared := styled_grid.seed(a,flags)
                mut step := 0
                for (dx,dy,w,h) in [(1,1,13,7),(3,2,4,5),(3,2,4,5),(1,1,0,4),
                        (2,1,10,0),(0,0,1,1),(12,2,10,5),(1,1,13,7)] {
                    area := tui.Rect::new(a.x+dx,a.y+dy,w,h)
                    assert(live.inner(area) == cache.inner(area))
                    if step%2 == 0 { cache.resize(w) }
                    top := step%3
                    live.set_scroll(top,0)
                    cache.set_top(top)
                    direct.render_widget(&live,area)
                    prepared.render_widget(&cache,area)
                    actual := json.to_string(&direct).unwrap()
                    assert(actual == json.to_string(&prepared).unwrap())
                    print(actual)
                    step += 1
                }
            } }
        } }
    }
}
