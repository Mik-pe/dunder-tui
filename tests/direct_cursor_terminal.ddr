capability unsafe, process, stdio
import .terminal_driver as driver
import sys

fn exercise(master:i32, slave:i32, screen:&mut driver.Screen) -> bool {
    unsafe {
        for step in 0..13 {
            pos := match step { 2 | 3 => (5,3), 5 | 6 => (6,2), 11 | 12 => (8,5), _ => (2,1), }
            visible := match step { 1 | 2 | 5 | 6 | 8 | 10 | 11 => 0, _ => 1, }
            if !driver.wait_state(master,&mut screen,0,"D","\x1b[6n",pos.0,pos.1,visible) {
                _ := sys.eprint(f"step {step}, cursor {screen.x},{screen.y} visible={screen.cursor_visible}")
                return false
            }
            if screen.contains(0,"BAD") { return false }
            if step == 12 && !driver.send(master,"k") { return false }
            if !driver.send(master,f"\x1b[{pos.1+1};") || !driver.send(master,f"{pos.0+1}R") { return false }
        }
        if !driver.wait_for(master,&mut screen,0,"","\x1b[?25h") { return false }
    }
    true
}

fn feed_paste(master:i32, screen:&mut driver.Screen, retry:bool) -> bool {
    unsafe {
        if !driver.wait_for(master,&mut screen,0,"","\x1b[6n") { return false }
        mut packet: []u8 = []
        packet.reserve(65537)
        count := if retry { 65536 } else { 65530 }
        for index in 0..count { packet.push(u8(97+index%26)) }
        if !retry {
            for b in "\x1b[2;3R!".as_bytes() { packet.push(b) }
        }
        mut sent: i64 = 0
        while sent < i64(packet.len) {
            count := sys.fd_write(master,&packet,sent,i64(packet.len)-sent)
            if count == -4 { continue }
            if count <= 0 { return false }
            sent += count
        }
        if retry {
            if !driver.wait_for(master,&mut screen,0,"","\x1b[6n") || !driver.send(master,"\x1b[2;3R!") { return false }
        }
        return driver.wait_for(master,&mut screen,0,"","\x1b[?25h")
    }
}

fn queued_reply(master:i32, slave:i32, screen:&mut driver.Screen) -> bool { feed_paste(master,&mut screen,false) }
fn queued_retry(master:i32, slave:i32, screen:&mut driver.Screen) -> bool { feed_paste(master,&mut screen,true) }

fn main() -> i32 {
    if sys.arg_count() == 3 && sys.arg(2) == "--queued-reply" {
        unsafe {
            if driver.test_with_args(sys.arg(1),["--queued-reply"],18,6,queued_reply) &&
                driver.test_with_args(sys.arg(1),["--queued-retry"],18,6,queued_retry) { return 0 }
        }
        return 1
    }
    if sys.arg_count() != 2 { return 2 }
    for mode in ["--direct-live","--direct-fixed"] {
        unsafe { if !driver.test_with_args(sys.arg(1),[mode],18,6,exercise) { return 1 } }
    }
    print("Direct cursor, failed draw, unchanged frame, clipped viewport, queued input and restoration passed")
    0
}
