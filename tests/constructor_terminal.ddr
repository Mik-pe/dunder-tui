capability unsafe, stdio, process
import sys
import ..src.tui
import ..benchmarks.manifest_scene
import .terminal_driver as driver

fn child() -> i32 {
    mut terminal := tui.open(.Fullscreen).unwrap()
    mut scene := manifest_scene.Scene::new()
    for i in 0..2 {
        scene.draw(&mut terminal.get_frame(),"scroll",i)
        if terminal.apply_buffer().is_err() { return 1 }
        match terminal.backend_mut().next(3000) { .Press(_) => {}, _ => { return 1 }, }
    }
    0
}

fn exercise(master: i32, slave: i32, screen: &mut driver.Screen) -> bool {
    unsafe {
        if !driver.wait_for(master,&mut screen,1,"000  SKÄRGÅRD","") || !screen.contains(0,"TRAFIK -") { return false }
        if !screen.contains(5,"ÖPPEN") || !driver.send(master,"n") { return false }
        if !driver.wait_for(master,&mut screen,1,"001  SKÄRGÅRD","") || !screen.contains(4,"004  SKÄRGÅRD") { return false }
        return driver.send(master,"q") && driver.wait_for(master,&mut screen,0,"","\x1b[?1049l")
    }
    false
}

fn main() -> i32 {
    if sys.arg_count() == 2 { return child() }
    unsafe {
        if driver.test_with_args(sys.arg(0),["draw"],32,6,exercise) {
            print("Repeated rows, scrolling, footer and terminal restoration OK")
            return 0
        }
    }
    1
}
