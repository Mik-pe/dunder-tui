struct Probe { step: i32, failure: i32, width: i32, input: ptr, started: bool }

unsafe fn push_key(handle: ptr, vk: i32, unit: i32) -> bool {
    mut record: [u16; 10] = [0; 10]
    record[0] = 1
    record[2] = 1
    record[4] = 1
    record[5] = u16(vk)
    record[7] = u16(unit)
    mut n: u32 = 0
    enqueue(handle, addr(&record[0]), 1, addr(&mut n)) != 0 && n == 1
}

fn tick(probe: &mut Probe, elapsed: i64) -> bool {
    if probe.started || elapsed < 25 { return false }
    unsafe {
        assert(push_key(probe.input, 38, 0) && push_key(probe.input, 0, 0xd83c) &&
            push_key(probe.input, 0, 0xdf0d) && push_key(probe.input, 27, 27))
    }
    probe.started = true
    true
}

fn draw(frame: &mut tui.Frame, probe: &Probe) {
    if !probe.started { return }
    if probe.step != 1 { frame.set_cursor_position(1,1); frame.set_cursor_position(3+probe.step,2) }
    frame.text(frame.area(), "Å" + probe.step.str(), tui.ink(.Rgb(0, 255, 255)).background(.LightBlue).underlined())
    mut gauge := ui.LineGauge::new(0.5)
    gauge.label = .Some(rich.Line::raw("OK"))
    gauge.filled_symbol = `=`
    gauge.unfilled_symbol = `.`
    mut rows := layout.Layout::vertical([.Length(1), .Length(1), .Length(2), .Fill(1)])
    parts := rows.split(frame.area())
    gauge.render(&mut frame, parts[1].cols(10).0)
    mut items := lists.List::new([lists.Item::raw("first"), lists.Item::raw("row A\nrow B")])
    items.marker = rich.Line::raw("> ")
    items.repeat_marker = true
    mut state := lists.ListState::new()
    state.last()
    items.render_stateful(&mut frame, parts[2].cols(8).0, &mut state)
    assert(state.offset == 1 && state.selected == .Some(1))
    mut grid := table.Table::new([table.Row::strings(["A","01"]),table.Row::strings(["B","02"])],[.Length(3),.Fill(1)])
    grid.marker = rich.Text::raw(">")
    grid.cell_highlight = tui.ink(.LightCyan).background(.Blue)
    mut cursor := table.TableState::new()
    cursor.select_cell(.Some((1,1)))
    grid.render_stateful(&mut frame,parts[3].resize(12,2),&mut cursor)
    assert(cursor.selected == .Some(1) && cursor.selected_column == .Some(1))
    mut coast := plot.Plot::new([0.0,1.0],[0.0,1.0])
    coast.marker = .HalfBlock
    p := coast.begin(&mut frame,tui.Rect {x:0,y:6,w:3,h:1})
    upper: [](f64,f64) = [(0.0,1.0)]
    lower: [](f64,f64) = [(0.0,0.0)]
    p.draw(&plot.Points::new(&upper,.LightCyan))
    p.draw(&plot.Points::new(&lower,.Blue))
    coast.finish(&mut frame)
    mut d := graphs.Dataset::new([(0.0,0.0),(1.0,1.0)])
    d.graph_type = .Line; d.marker = .Custom(`*`); d.style = tui.ink(.Yellow)
    mut diagram := graphs.Chart::new([move d])
    diagram.x_axis = graphs.Axis::new([0.0,1.0]); diagram.y_axis = graphs.Axis::new([0.0,1.0])
    frame.render_widget(&mut diagram,tui.Rect {x:3,y:6,w:3,h:2})
    cell_widgets.swatch(&mut frame,12,2)
    chart_cells.axis_edge(&mut frame,9,5,probe.step == 1)
}

fn update(probe: &mut Probe, key: tui.Key) -> bool {
    mut chars: [u16; 2] = [0; 2]
    mut n: u32 = 0
    mut bounds: [i16; 11] = [0; 11]
    unsafe {
        mut device: [u16; 8] = [67, 79, 78, 79, 85, 84, 36, 0]
        out := open_file(addr(&device[0]), 0xc0000000, 3, ptr(0), 3, 0, ptr(0))
        defer { _ := close_handle(out) }
        if info(out, addr(&mut bounds[0])) == 0 { probe.failure = 20; return false }
        mut cursor: [u32;2] = [0;2]
        if cursor_info(out,addr(&mut cursor[0])) == 0 || (cursor[1] != 0) != (probe.step != 1) { probe.failure = 44; return false }
        if probe.step != 1 && (i32(bounds[2]) != 3+probe.step || bounds[3] != 2) { probe.failure = 45; return false }
        if probe.step == 1 && i32(bounds[7]) - i32(bounds[5]) + 1 != probe.width { probe.failure = 30; return false }
        coord := u32(bounds[5]).bit_or(u32(bounds[6]).shl(16))
        if read_text(out, addr(&mut chars[0]), 2, coord, addr(&mut n)) == 0 || n != 2 ||
        chars[0] != 197 || i32(chars[1]) != 48 + probe.step {
            _ := sys.eprint(f"screen step={probe.step} read={n} expected=Å{probe.step} units={chars[0]},{chars[1]}")
            probe.failure = 21 + probe.step; return false
        }
        mut meter: [u16; 10] = [0; 10]
        gauge_coord := u32(bounds[5]).bit_or(u32(i32(bounds[6]) + 1).shl(16))
        if read_text(out, addr(&mut meter[0]), 10, gauge_coord, addr(&mut n)) == 0 || n != 10 { probe.failure = 34; return false }
        expected := "OK ===...."
        for i in 0..10 { if meter[i] != u16(expected[i]) { probe.failure = 35; return false } }
        for j in 0..2 {
            mut row: [u16; 7] = [0; 7]
            coords := u32(bounds[5]).bit_or(u32(i32(bounds[6]) + 2 + j).shl(16))
            if read_text(out, addr(&mut row[0]), 7, coords, addr(&mut n)) == 0 || n != 7 { probe.failure = 36; return false }
            line := if j == 0 { "> row A" } else { "> row B" }
            for i in 0..7 { if row[i] != u16(line[i]) { probe.failure = 37; return false } }
        }
        mut attr: u16 = 0
        if read_attr(out, addr(&mut attr), 1, coord, addr(&mut n)) == 0 || attr.bit_and(7) != 3 || attr.shr(4).bit_and(15) != 9 { probe.failure = 31; return false }
        table_row := u32(bounds[5]).bit_or(u32(i32(bounds[6])+5).shl(16))
        if read_text(out,addr(&mut meter[0]),7,table_row,addr(&mut n)) == 0 || n != 7 { probe.failure = 38; return false }
        table_line := ">B   02"
        for i in 0..7 { if meter[i] != u16(table_line[i]) { probe.failure = 39; return false } }
        if read_attr(out,addr(&mut attr),1,table_row+5,addr(&mut n)) == 0 || attr.bit_and(255) != 27 { probe.failure = 40; return false }
        plot_row := u32(bounds[5]).bit_or(u32(i32(bounds[6])+6).shl(16))
        if read_text(out,addr(&mut meter[0]),1,plot_row,addr(&mut n)) == 0 || meter[0] != 0x2580 { probe.failure = 41; return false }
        if read_attr(out,addr(&mut attr),1,plot_row,addr(&mut n)) == 0 || attr.bit_and(255) != 27 { probe.failure = 42; return false }
        if read_text(out,addr(&mut meter[0]),1,plot_row+5,addr(&mut n)) == 0 || meter[0] != 42 { probe.failure = 43; return false }
        edge := if probe.step == 1 { "..ABCD..XY." } else { ".ABCDE..XY." }
        for i in 0..edge.len {
            if unit_at(out,i32(bounds[5])+7+i,i32(bounds[6])+7) != i32(edge[i]) { probe.failure = 96; return false }
        }
        for i in 0..5 {
            if unit_at(out,i32(bounds[5])+12+i,i32(bounds[6])+2) != i32("xy  #"[i]) { probe.failure = 118; return false }
        }
        if probe.step == 0 {
            mut rect: [i16; 4] = [bounds[5], bounds[6], i16(i32(bounds[7]) - 1), bounds[8]]
            if set_window(out, 1, addr(&rect[0])) == 0 { probe.failure = 32; return false }
            probe.width = i32(rect[2]) - i32(rect[0]) + 1
        }
    }
    if probe.step == 0 {
        match key { .Up => {}, _ => { probe.failure = 24 + probe.step }, }
    } else if probe.step == 1 {
        match key { .Char(c) if i32(c) == 0x1f30d => {}, _ => { probe.failure = 24 + probe.step }, }
    } else {
        match key { .Escape => {}, _ => { probe.failure = 24 + probe.step }, }
    }
    probe.step += 1
    probe.failure == 0 && probe.step < 3
}

@extern("kernel32.dll","SetConsoleCursorPosition")
unsafe fn position(handle: ptr, coord: u32) -> i32
@extern("kernel32.dll","SetConsoleCursorInfo")
unsafe fn set_cursor_info(handle: ptr, info: ptr) -> i32

struct CursorOutput { handle: ptr }
impl tui.Backend for CursorOutput {
    fn size(&mut self) -> (i32,i32) { (3,2) }
    fn set_cursor_visible(&mut self, visible: bool) -> Result<(),string> {
        unsafe {
            mut shape: [u32;2] = [0;2]
            if cursor_info(self.handle,addr(&mut shape[0])) == 0 { return .Err("read cursor") }
            shape[1] = if visible { 1 } else { 0 }
            if set_cursor_info(self.handle,addr(&shape[0])) == 0 { return .Err("write cursor") }
        }
        .Ok
    }
    fn present(&mut self, frame: &tui.Frame, previous: &tui.Frame) -> Result<(),string> {
        self.set_cursor_visible(frame.cursor_position().is_some())
    }
}

unsafe fn hide_until_return(out: ptr) -> bool {
    mut t := tui.Terminal<CursorOutput>::new(CursorOutput { handle:out })
    mut shape: [u32;2] = [0;2]
    t.apply_buffer().is_ok() && cursor_info(out,addr(&mut shape[0])) != 0 && shape[1] == 0
}

fn embedded_frame(frame: &mut tui.Frame, state: &mut i32) {
    frame.label(frame.area(),"VIEW")
    frame.set_cursor_position(frame.area().x+1,frame.area().y)
}

unsafe fn unit_at(h: ptr, x: i32, y: i32) -> i32 {
    mut unit: u16 = 0
    mut count: u32 = 0
    if read_text(h,addr(&mut unit),1,u32(x).bit_or(u32(y).shl(16)),addr(&mut count)) == 0 || count != 1 { return -1 }
    i32(unit)
}

fn month_frame(frame: &mut tui.Frame, month: &mut cal.Monthly) {
    frame.render_widget(&month,frame.area())
}

@extern("kernel32.dll","GetLocalTime")
unsafe fn get_local_time(output: ptr)

unsafe fn system_date() -> cal.Date {
    mut t: [u16;8] = [0;8]
    get_local_time(addr(&mut t[0]))
    cal.Date::new(i32(t[0]),i32(t[1]),i32(t[3])).unwrap()
}

unsafe fn calendar_screen(out: ptr, x: i32, y: i32) -> i32 {
    before := system_date()
    today := cal.Date::today()
    if today != before && today != system_date() { return 57 }
    leap := cal.Date::new(2024,2,29).unwrap()
    mut month := cal.Monthly::new(leap)
    month.events.add(leap,tui.ink(.Yellow).background(.Blue))
    mut term: tui.Terminal<tui.LiveBackend> = tui.open(.Fixed(tui.Rect {x:2,y:2,w:21,h:6})).unwrap()
    defer { term.backend_mut().close() }
    if term.draw(&mut month,month_frame).is_err() { return 58 }
    if unit_at(out,x+15,y+6) != 50 || unit_at(out,x+16,y+6) != 57 || unit_at(out,0,0) != 35 { return 59 }
    mut attr: u16 = 0
    mut n: u32 = 0
    if read_attr(out,addr(&mut attr),1,u32(x+16).bit_or(u32(y+6).shl(16)),addr(&mut n)) == 0 || n != 1 || attr.bit_and(255) != 22 { return 60 }
    0
}

fn shared_cells(frame: &mut tui.Frame, step: &mut i32) { buffer_app.cells(&mut frame,step) }

unsafe fn shared_screen(out: ptr, x: i32, y: i32) -> i32 {
    mut term: tui.Terminal<tui.LiveBackend> = tui.open(.Fixed(tui.Rect {x:2,y:2,w:7,h:2})).unwrap()
    defer { term.backend_mut().close() }
    mut step := 0
    mut pair: [u16;2] = [33,33]
    mut n: u32 = 0
    coord := u32(x+3).bit_or(u32(y+2).shl(16))
    if stamp(out,addr(&pair[0]),2,coord,addr(&mut n)) == 0 || n != 2 { return 61 }
    if term.draw(&mut step,shared_cells).is_err() || unit_at(out,x+3,y+2) != 33 || unit_at(out,x+4,y+2) != 67 { return 62 }
    if unit_at(out,x+2,y+3) != 65 || unit_at(out,x+3,y+3) != 0x8336 { return 62 }
    if stamp(out,addr(&pair[0]),2,coord,addr(&mut n)) == 0 || n != 2 { return 63 }
    step = 1
    if term.draw(&mut step,shared_cells).is_err() || unit_at(out,x+3,y+2) != 33 || unit_at(out,x+4,y+2) != 67 { return 64 }
    if unit_at(out,x+2,y+3) != 66 || unit_at(out,x+3,y+3) != 0x6d77 { return 64 }
    step = 2
    if term.draw(&mut step,shared_cells).is_err() { return 65 }
    expected := "ABC[X]G"
    for i in 0..7 { if unit_at(out,x+2+i,y+2) != i32(expected[i]) { return 66 } }
    step = 3
    if term.draw(&mut step,shared_cells).is_err() { return 66 }
    for row in 0..2 { for col in 0..7 {
        if unit_at(out,x+2+col,y+2+row) != 65+col+3*row { return 66 }
    } }
    0
}

unsafe fn shadow_and_meter_screen(out: ptr, x: i32, y: i32) -> i32 {
    mut term := tui.open(.Fixed(tui.Rect::new(2,2,12,5))).unwrap()
    defer { term.backend_mut().close() }
    mut phase := 0
    if term.draw(&mut phase,shadow_cells.moving).is_err() { return 163 }
    if unit_at(out,x+5,y+5) != 0x2591 || unit_at(out,x+9,y+4) != 0x2591 || unit_at(out,x+4,y+3) != 61 { return 164 }
    phase = 1
    if term.draw(&mut phase,shadow_cells.moving).is_err() { return 165 }
    if unit_at(out,x+3,y+2) != 0x2593 || unit_at(out,x+3,y+3) != 0x2593 || unit_at(out,x+5,y+5) != 46 { return 166 }
    phase = 0
    if term.draw(&mut phase,meter_cells.live).is_err() { return 167 }
    if unit_at(out,x+11,y+2) != 0x25c6 || unit_at(out,x+4,y+3) != 0x754c || unit_at(out,x+8,y+3) != 0xb7 { return 168 }
    phase = 1
    if term.draw(&mut phase,meter_cells.live).is_err() { return 169 }
    if unit_at(out,x+2,y+2) != 0x25c6 || unit_at(out,x+4,y+3) != 61 || unit_at(out,x+10,y+3) != 0xb7 { return 170 }
    phase = 0
    if term.draw(&mut phase,border_cells.joined).is_err() { return 171 }
    if unit_at(out,x+3,y+2) != 0x25c8 || unit_at(out,x+9,y+2) != 0x25c6 || unit_at(out,x+3,y+3) != 0x253c { return 172 }
    phase = 1
    if term.draw(&mut phase,border_cells.joined).is_err() { return 173 }
    if unit_at(out,x+3,y+2) != 0x256d || unit_at(out,x+9,y+5) != 0x256f { return 174 }
    mut layouts := saved_layout.panels()
    if term.draw(&mut layouts[0], saved_layout.paint).is_err() { return 175 }
    if unit_at(out,x+4,y+3) != 65 || unit_at(out,x+5,y+3) != 32 || unit_at(out,x+7,y+3) != 66 { return 176 }
    if term.draw(&mut layouts[1], saved_layout.paint).is_err() { return 177 }
    if unit_at(out,x+2,y+2) != 65 || unit_at(out,x+2,y+3) != 66 || unit_at(out,x+13,y+3) != 66 { return 178 }
    mut channels := saved_layout.channels()
    if term.draw(&mut channels,saved_layout.paint_channels).is_err() { return 203 }
    if unit_at(out,x+2,y+2) != 65 || unit_at(out,x+13,y+2) != 76 { return 204 }
    channels.set_direction(.Vertical)
    if term.draw(&mut channels,saved_layout.paint_channels).is_err() { return 205 }
    if unit_at(out,x+13,y+2) != 66 || unit_at(out,x+13,y+6) != 75 { return 206 }
    mut frames := saved_buffer.snapshots()
    if term.draw(&mut frames[0], saved_buffer.paint).is_err() || unit_at(out,x+10,y+3) != 49 { return 179 }
    if term.draw(&mut frames[1], saved_buffer.paint).is_err() || unit_at(out,x+10,y+3) != 50 { return 180 }
    if unit_at(out,x+6,y+3) != 69 { return 181 }
    mut session := saved_widgets.Session::open()
    if term.draw(&mut session,saved_widgets.paint).is_err() { return 182 }
    if unit_at(out,x+3,y+2) != 84 || unit_at(out,x+9,y+2) != 84 || unit_at(out,x+12,y+4) != 35 { return 183 }
    session.up()
    if term.draw(&mut session,saved_widgets.paint).is_err() { return 184 }
    if unit_at(out,x+3,y+2) != 73 || unit_at(out,x+9,y+2) != 73 || unit_at(out,x+3,y+4) != 35 { return 185 }
    mut replay := saved_backend.open()
    if term.draw(&mut replay,saved_backend.paint).is_err() { return 186 }
    if unit_at(out,x+2,y+2) != 76 || unit_at(out,x+2,y+3) != 75 || unit_at(out,x+2,y+4) != 83 { return 187 }
    saved_backend.advance(&mut replay)
    if term.draw(&mut replay,saved_backend.paint).is_err() { return 188 }
    if unit_at(out,x+2,y+2) != 75 || unit_at(out,x+2,y+3) != 83 { return 189 }
    mut views := saved_palette.views()
    mut attr: u16 = 0
    mut count: u32 = 0
    if term.draw(&mut views[0],saved_palette.paint).is_err() { return 190 }
    if unit_at(out,x+2,y+2) != 0x256d || unit_at(out,x+3,y+3) != 73 { return 191 }
    first := u32(x+3).bit_or(u32(y+3).shl(16))
    if read_attr(out,addr(&mut attr),1,first,addr(&mut count)) == 0 || count != 1 || attr.bit_and(15) != 6 { return 192 }
    if term.draw(&mut views[1],saved_palette.paint).is_err() { return 193 }
    if unit_at(out,x+2,y+2) != 0x2554 || unit_at(out,x+3,y+3) != 32 || unit_at(out,x+10,y+5) != 75 { return 194 }
    last := u32(x+10).bit_or(u32(y+5).shl(16))
    if read_attr(out,addr(&mut attr),1,last,addr(&mut count)) == 0 || count != 1 || attr.bit_and(15) != 3 { return 195 }
    mut basic := saved_buffer.underlined(.WithoutUnderlineColor)
    if term.draw(&mut basic,saved_buffer.paint).is_err() { return 196 }
    if unit_at(out,x+3,y+3) != 66 || unit_at(out,x+7,y+3) != 67 { return 197 }
    if read_attr(out,addr(&mut attr),1,first,addr(&mut count)) == 0 || count != 1 || attr.bit_and(15) != 2 { return 198 }
    mut manifest := manifest_scene.Scene::new()
    for i in 0..2 {
        manifest.draw(&mut term.get_frame(),"scroll",i)
        if term.apply_buffer().is_err() { return 199 }
        if unit_at(out,x+2,y+2) != 84 || unit_at(out,x+4,y+3) != 48+i { return 200 }
        if unit_at(out,x+2,y+6) != 0x00d6 { return 201 }
    }
    0
}

unsafe fn embedded(out: ptr) -> i32 {
    mut bounds: [i16;11] = [0;11]
    if info(out,addr(&mut bounds[0])) == 0 { return 50 }
    x := i32(bounds[5])
    y := i32(bounds[6])
    {
        mut wide: tui.Terminal<tui.LiveBackend> = tui.open(.Fixed(tui.Rect::new(2,2,65533,1))).unwrap()
        a := wide.viewport_area()
        if a.right() != 65535 { return 160 }
        f := wide.get_frame()
        f.label(a,"WIDE")
        f.label(tui.Rect::new(65532,2,3,1),"END")
        if wide.apply_buffer().is_err() || unit_at(out,x+2,y+2) != 87 { return 161 }
        if wide.completed().symbol_at(65534,2) != .Some("D") { return 162 }
        wide.backend_mut().close()
    }
    shadow := shadow_and_meter_screen(out,x,y)
    if shadow != 0 { return shadow }
    shared := shared_screen(out,x,y)
    if shared != 0 { return shared }
    result := calendar_screen(out,x,y)
    if result != 0 { return result }
    mut count := 0
    mut fixed: tui.Terminal<tui.LiveBackend> = tui.open(.Fixed(tui.Rect {x:4,y:2,w:8,h:2})).unwrap()
    (columns,rows) := fixed.size()
    if columns != i32(bounds[7])-x+1 || rows != i32(bounds[8])-y+1 { return 98 }
    if !fixed.window_size().is_err() || !tui.window_size().is_err() || fixed.autoresize().is_err() { return 99 }
    if fixed.draw(&mut count,embedded_frame).is_err() || unit_at(out,x+4,y+2) != 86 || unit_at(out,0,0) != 35 { return 51 }
    mut shape: [u32;2] = [47,1]
    if set_cursor_info(out,addr(&shape[0])) == 0 || fixed.hide_cursor().is_err() { return 100 }
    if fixed.set_cursor_position(2,1).is_err() || fixed.cursor_position().unwrap() != (2,1) { return 101 }
    if cursor_info(out,addr(&mut shape[0])) == 0 || shape[0] != 47 || shape[1] != 0 { return 102 }
    if fixed.show_cursor().is_err() || cursor_info(out,addr(&mut shape[0])) == 0 || shape[0] != 47 || shape[1] == 0 { return 103 }
    if fixed.draw(&mut count,embedded_frame).is_err() || fixed.cursor_position().unwrap() != (5,2) { return 104 }
    if fixed.backend_mut().set_cursor_visible(false).is_err() || fixed.backend_mut().move_to(3,2).is_err() { return 105 }
    if fixed.cursor_position().unwrap() != (3,2) || fixed.draw(&mut count,embedded_frame).is_err() { return 106 }
    if info(out,addr(&mut bounds[0])) == 0 || i32(bounds[2]) != x+5 || i32(bounds[3]) != y+2 { return 107 }
    if cursor_info(out,addr(&mut shape[0])) == 0 || shape[0] != 47 || shape[1] == 0 { return 108 }
    area := fixed.viewport_area()
    f := fixed.get_frame()
    f.label(area,"STAGE")
    f.set_cursor_position(0,0)
    if unit_at(out,x+4,y+2) != 86 || fixed.flush().is_err() || unit_at(out,x+4,y+2) != 83 { return 110 }
    if cursor_info(out,addr(&mut shape[0])) == 0 || shape[0] != 47 || shape[1] == 0 { return 111 }
    fixed.swap_buffers()
    if fixed.current_buffer_mut().symbol_at(area.x,area.y).unwrap() != " " || fixed.backend_mut().flush().is_err() { return 112 }
    fixed.current_buffer_mut().label(area,"NEXT")
    if fixed.apply_buffer_with_cursor(.Some((6,2))).is_err() || fixed.cursor_position().unwrap() != (6,2) { return 113 }
    if unit_at(out,x+4,y+2) != 78 || fixed.apply_buffer().is_err() || unit_at(out,x+4,y+2) != 32 { return 114 }
    if cursor_info(out,addr(&mut shape[0])) == 0 || shape[1] != 0 { return 115 }
    fixed.backend_mut().close()
    if fixed.cursor_position().is_ok() || fixed.set_cursor_position(0,0).is_ok() || fixed.show_cursor().is_ok() || fixed.hide_cursor().is_ok() { return 109 }
    if position(out,u32(x).bit_or(u32(y+1).shl(16))) == 0 { return 52 }
    mut embedded: tui.Terminal<tui.LiveBackend> = tui.open(.Inline(2)).unwrap()
    if embedded.viewport_area().y != 1 || embedded.draw(&mut count,embedded_frame).is_err() { return 53 }
    mut line := tui.Frame::new(embedded.viewport_area().w,1)
    line.label(line.area(),"LOG")
    if embedded.insert_before(&line).is_err() || unit_at(out,x,y+1) != 76 || unit_at(out,x,y+2) != 86 { return 54 }
    embedded.backend_mut().close()
    if info(out,addr(&mut bounds[0])) == 0 || i32(bounds[3]) != y+4 || unit_at(out,0,0) != 35 { return 55 }
    if position(out,u32(x).bit_or(u32(y+1).shl(16))) == 0 { return 163 }
    mut feeds := tui.open(.Inline(2)).unwrap()
    feeds.backend_mut().set_scrolling_regions(false)
    if feeds.draw(&mut count,embedded_frame).is_err() || feeds.insert_before(&line).is_err() { return 164 }
    if unit_at(out,x,y+1) != 76 || unit_at(out,x,y+2) != 32 || feeds.viewport_area().y != 2 { return 165 }
    if feeds.draw(&mut count,embedded_frame).is_err() || unit_at(out,x,y+2) != 86 { return 166 }
    if feeds.insert_before(&line).is_err() { return 168 }
    feeds.backend_mut().close()
    if unit_at(out,0,0) != 35 || info(out,addr(&mut bounds[0])) == 0 || i32(bounds[3]) != y+5 { return 167 }
    0
}

unsafe fn wait_for_row(child: ptr, offset: i32, expected: string) -> bool {
    device := wide.path("CONOUT$")
    for _ in 0..250 {
        if wait_process(child,20) != 258 { return false }
        screen := open_file(addr(&device[0]),0xc0000000,3,ptr(0),3,0,ptr(0))
        if usize(screen) == usize(0xffffffffffffffff) { continue }
        mut bounds: [i16;11] = [0;11]
        mut units: [u16;128] = [0;128]
        mut read := u32(0)
        mut found := false
        if info(screen,addr(&mut bounds[0])) != 0 {
            row := if offset < 0 { i32(bounds[8]) } else { i32(bounds[6])+offset }
            at := u32(bounds[5]).bit_or(u32(row).shl(16))
            count := i32(bounds[7])-i32(bounds[5])+1
            if read_text(screen,addr(&mut units[0]),u32(if count < 128 { count } else { 128 }),at,addr(&mut read)) != 0 {
                found = strings.contains(wide.text(addr(&units[0]),i32(read)),expected)
            }
        }
        _ := close_handle(screen)
        if found { return true }
    }
    false
}

unsafe fn wait_for_mascot_eye(child: ptr, previous: i32) -> i32 {
    device := wide.path("CONOUT$")
    for _ in 0..250 {
        if wait_process(child,20) != 258 { break }
        screen := open_file(addr(&device[0]),0xc0000000,3,ptr(0),3,0,ptr(0))
        if usize(screen) == usize(0xffffffffffffffff) { continue }
        mut bounds: [i16;11] = [0;11]
        mut background := -1
        if info(screen,addr(&mut bounds[0])) != 0 {
            w := i32(bounds[7])-i32(bounds[5])+1
            h := i32(bounds[8])-i32(bounds[6])+1
            x := i32(bounds[5]) + (if w > 32 { (w-32)/2 } else { 0 }) + 21
            y := i32(bounds[6]) + (if h > 19 { (h-19)/2 } else { 0 }) + 7
            at := u32(x).bit_or(u32(y).shl(16))
            mut attr := u16(0)
            mut n := u32(0)
            if unit_at(screen,x,y) == 0x2580 && read_attr(screen,addr(&mut attr),1,at,addr(&mut n)) != 0 && n == 1 {
                background = i32(attr).shr(4).bit_and(15)
            }
        }
        _ := close_handle(screen)
        if background >= 0 && background != previous { return background }
    }
    -1
}

unsafe fn exercise_app(program: string, input: ptr, mode: string) -> i32 {
    path := wide.path(program)
    mut command := wide.path("\"" + program + "\"")
    mut startup: [u64;13] = [0;13]
    startup[0] = 104
    mut process: [u64;3] = [0;3]
    if start_process(addr(&path[0]),addr(&mut command[0]),ptr(0),ptr(0),0,0,ptr(0),ptr(0),addr(&startup[0]),addr(&mut process[0])) == 0 { return 120 }
    child := ptr(usize(process[0]))
    _ := close_handle(ptr(usize(process[1])))
    defer {
        if wait_process(child,0) == 258 { _ := stop_process(child,124); _ := wait_process(child,5000) }
        _ := close_handle(child)
    }
    if mode == "--mascot" {
        if !wait_for_row(child,-1,"mellanslag") || !wait_for_row(child,0,"█▀▀▄ ▄▀▀▄") { return 141 }
        normal := wait_for_mascot_eye(child,-1)
        if normal < 0 || !push_key(input,32,32) { return 142 }
        red := wait_for_mascot_eye(child,normal)
        if red < 0 || !push_key(input,32,32) || wait_for_mascot_eye(child,red) != normal { return 143 }
        if !push_key(input,84,116) || !wait_for_row(child,0,"▛▚▗▀▖") { return 144 }
    } else if mode == "--rundown" {
        if !wait_for_row(child,-1,"byt pass") || !wait_for_row(child,1,"› · Öppna entrén") { return 151 }
        if !push_key(input,74,106) || !wait_for_row(child,2,"› · Öppna entrén") || !wait_for_row(child,1,"· Ljudprov") { return 152 }
        if !push_key(input,32,32) || !wait_for_row(child,2,"› ✓ Öppna entrén") { return 153 }
        if !push_key(input,9,9) || !wait_for_row(child,0,"Kvällspass") || !wait_for_row(child,1,"Tänd scenljuset") { return 154 }
        if !push_key(input,9,9) || !wait_for_row(child,0,"Dagpass") || !wait_for_row(child,2,"✓ Öppna entrén") { return 155 }
    } else {
        titles := ["Polarnatt","Prisma","Koidammen","Händelsehorisont","Harmonograf","Efterglöd","Medusa","Tesserakt","Glödbädd","Drivande atlas"]
        if !wait_for_row(child,0,titles[0]) { return 121 }
        if !push_key(input,32,32) || !wait_for_row(child,-1,"spela") { return 122 }
        for i in 1..titles.len {
            if !push_key(input,39,0) || !wait_for_row(child,0,titles[i]) { return 130+i }
        }
        if !push_key(input,39,0) || !wait_for_row(child,0,titles[0]) { return 123 }
        if !push_key(input,32,32) || !wait_for_row(child,-1,"pausa") { return 124 }
    }
    if !push_key(input,81,113) || wait_process(child,5000) != 0 { return 125 }
    mut code := u32(0)
    if exit_code(child,addr(&mut code)) == 0 || code != 0 { return 126 }
    0
}

fn verify() -> i32 {
    unsafe {
        _ := detach()
        if allocate() == 0 { return 11 }
        mut device_in: [u16; 7] = [67, 79, 78, 73, 78, 36, 0]
        mut device_out: [u16; 8] = [67, 79, 78, 79, 85, 84, 36, 0]
        stdin := open_file(addr(&device_in[0]), 0xc0000000, 3, ptr(0), 3, 0, ptr(0))
        stdout := open_file(addr(&device_out[0]), 0xc0000000, 3, ptr(0), 3, 0, ptr(0))
        if use_handle(-10, stdin) == 0 || use_handle(-11, stdout) == 0 { return 12 }
        mut old_in: u32 = 0
        mut old_out: u32 = 0
        if mode(stdin, addr(&mut old_in)) == 0 || mode(stdout, addr(&mut old_out)) == 0 { return 13 }
        mut saved: [u32;2] = [0;2]; mut original: [i16;11] = [0;11]
        if cursor_info(stdout,addr(&mut saved[0])) == 0 || info(stdout,addr(&mut original[0])) == 0 { return 46 }
        mut sentinel: u16 = 35
        mut n: u32 = 0
        if stamp(stdout, addr(&sentinel), 1, 0, addr(&mut n)) == 0 || n != 1 { return 19 }
        if sys.arg_count() == 2 || (sys.arg_count() == 3 && (sys.arg(2) == "--mascot" || sys.arg(2) == "--rundown")) {
            gallery := exercise_app(sys.arg(1),stdin,if sys.arg_count() == 3 { sys.arg(2) } else { "gallery" })
            if gallery != 0 { return gallery }
        } else {
            mut probe := Probe { step: 0, failure: 0, width: 0, input: stdin, started: false }
            result := tui.animate(&mut probe, 60, draw, update, tick)
            if result.is_err() { return 15 }
            if probe.failure != 0 { return probe.failure }
            if probe.step != 3 { return 16 }
        }
        mut new_in: u32 = 0
        mut new_out: u32 = 0
        if mode(stdin, addr(&mut new_in)) == 0 || mode(stdout, addr(&mut new_out)) == 0 { return 17 }
        if old_in != new_in || old_out != new_out { return 18 }
        active := open_file(addr(&device_out[0]), 0xc0000000, 3, ptr(0), 3, 0, ptr(0))
        mut restored: u16 = 0
        if read_text(active, addr(&mut restored), 1, 0, addr(&mut n)) == 0 || restored != sentinel { return 33 }
        mut after: [u32;2] = [0;2]; mut restored_info: [i16;11] = [0;11]
        if cursor_info(active,addr(&mut after[0])) == 0 || info(active,addr(&mut restored_info[0])) == 0 { return 47 }
        if saved[0] != after[0] || saved[1] != after[1] || original[2] != restored_info[2] || original[3] != restored_info[3] { return 48 }
        if !hide_until_return(active) || cursor_info(active,addr(&mut after[0])) == 0 ||
            after[0] != saved[0] || after[1] == 0 { return 116 }
        if set_cursor_info(active,addr(&saved[0])) == 0 { return 117 }
        probe_code := embedded(active)
        if probe_code != 0 { return probe_code }
        if mode(stdin,addr(&mut new_in)) == 0 || mode(stdout,addr(&mut new_out)) == 0 || old_in != new_in || old_out != new_out { return 56 }
        _ := close_handle(active)
    }
    0
}

fn main() -> i32 {
    if target_is("windows") { return verify() }
    _ := sys.eprint("Run this console test on Windows.")
    1
}
