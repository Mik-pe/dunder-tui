capability unsafe, stdio

import ..src.tui
import ..src.table
import ..src.plot
import ..src.chart as graphs
import ..src.layout
import ..src.list as lists
import ..src.widgets as ui
import ..src.text as rich
import sys

@extern("kernel32.dll", "FreeConsole")
unsafe fn detach() -> i32
@extern("kernel32.dll", "AllocConsole")
unsafe fn allocate() -> i32
@extern("kernel32.dll", "CreateFileW")
unsafe fn open_file(name: ptr, access: u32, share: u32, security: ptr, creation: u32, flags: u32, template: ptr) -> ptr
@extern("kernel32.dll", "SetStdHandle")
unsafe fn use_handle(channel: i32, handle: ptr) -> i32
@extern("kernel32.dll", "GetConsoleMode")
unsafe fn mode(handle: ptr, out: ptr) -> i32
@extern("kernel32.dll", "WriteConsoleInputW")
unsafe fn enqueue(handle: ptr, records: ptr, count: u32, written: ptr) -> i32
@extern("kernel32.dll", "ReadConsoleOutputCharacterW")
unsafe fn read_text(handle: ptr, data: ptr, count: u32, coord: u32, read: ptr) -> i32
@extern("kernel32.dll", "GetConsoleCursorInfo")
unsafe fn cursor_info(handle: ptr, out: ptr) -> i32
@extern("kernel32.dll", "GetConsoleScreenBufferInfo")
unsafe fn info(handle: ptr, out: ptr) -> i32
@extern("kernel32.dll", "CloseHandle")
unsafe fn close_handle(h: ptr) -> i32

@extern("kernel32.dll", "ReadConsoleOutputAttribute")
unsafe fn read_attr(handle: ptr, data: ptr, count: u32, coord: u32, read: ptr) -> i32
@extern("kernel32.dll", "SetConsoleWindowInfo")
unsafe fn set_window(handle: ptr, absolute: i32, rect: ptr) -> i32
@extern("kernel32.dll", "WriteConsoleOutputCharacterW")
unsafe fn stamp(handle: ptr, data: ptr, count: u32, coord: u32, written: ptr) -> i32

struct Probe { step: i32, failure: i32, width: i32, input: ptr, started: bool }

unsafe fn push_key(handle: ptr, vk: i32, unit: i32) -> bool {
    mut record: [u16; 10] = [0; 10]
    record[0] = 1
    record[2] = 1
    record[4] = 1
    record[5] = u16(vk)
    record[7] = u16(unit)
    mut n: u32 = 0
    enqueue(handle, addr(&record[0]), 1, addr(&mut n)) != 0 && n == 1
}

fn tick(probe: &mut Probe, elapsed: i64) -> bool {
    if probe.started || elapsed < 25 { return false }
    unsafe {
        assert(push_key(probe.input, 38, 0) && push_key(probe.input, 0, 0xd83c) &&
            push_key(probe.input, 0, 0xdf0d) && push_key(probe.input, 27, 27))
    }
    probe.started = true
    true
}

fn draw(frame: &mut tui.Frame, probe: &Probe) {
    if !probe.started { return }
    if probe.step != 1 { frame.set_cursor_position(1,1); frame.set_cursor_position(3+probe.step,2) }
    frame.text(frame.area(), "Å" + probe.step.str(), tui.ink(.Rgb(0, 255, 255)).background(.LightBlue).underlined())
    mut gauge := ui.LineGauge::new(0.5)
    gauge.label = .Some(rich.Line::raw("OK"))
    gauge.filled_symbol = `=`
    gauge.unfilled_symbol = `.`
    mut rows := layout.Layout::vertical([.Length(1), .Length(1), .Length(2), .Fill(1)])
    parts := rows.split(frame.area())
    gauge.render(&mut frame, parts[1].cols(10).0)
    mut items := lists.List::new([lists.Item::raw("first"), lists.Item::raw("row A\nrow B")])
    items.marker = rich.Line::raw("> ")
    items.repeat_marker = true
    mut state := lists.ListState::new()
    state.last()
    items.render_stateful(&mut frame, parts[2].cols(8).0, &mut state)
    assert(state.offset == 1 && state.selected == .Some(1))
    mut grid := table.Table::new([table.Row::strings(["A","01"]),table.Row::strings(["B","02"])],[.Length(3),.Fill(1)])
    grid.marker = rich.Text::raw(">")
    grid.cell_highlight = tui.ink(.LightCyan).background(.Blue)
    mut cursor := table.TableState::new()
    cursor.select_cell(.Some((1,1)))
    grid.render_stateful(&mut frame,parts[3].resize(12,2),&mut cursor)
    assert(cursor.selected == .Some(1) && cursor.selected_column == .Some(1))
    mut coast := plot.Plot::new([0.0,1.0],[0.0,1.0])
    coast.marker = .HalfBlock
    p := coast.begin(&mut frame,tui.Rect {x:0,y:6,w:3,h:1})
    p.paint(0,0,.LightCyan); p.paint(0,1,.Blue)
    coast.finish(&mut frame)
    mut d := graphs.Dataset::new([(0.0,0.0),(1.0,1.0)])
    d.graph_type = .Line; d.marker = .Custom(`*`); d.style = tui.ink(.Yellow)
    mut diagram := graphs.Chart::new([move d])
    diagram.x_axis = graphs.Axis::new([0.0,1.0]); diagram.y_axis = graphs.Axis::new([0.0,1.0])
    diagram.render(&mut frame,tui.Rect {x:3,y:6,w:3,h:2})

}

fn update(probe: &mut Probe, key: tui.Key) -> bool {
    mut chars: [u16; 2] = [0; 2]
    mut n: u32 = 0
    mut bounds: [i16; 11] = [0; 11]
    unsafe {
        mut device: [u16; 8] = [67, 79, 78, 79, 85, 84, 36, 0]
        out := open_file(addr(&device[0]), 0xc0000000, 3, ptr(0), 3, 0, ptr(0))
        defer { _ := close_handle(out) }
        if info(out, addr(&mut bounds[0])) == 0 { probe.failure = 20; return false }
        mut cursor: [u32;2] = [0;2]
        if cursor_info(out,addr(&mut cursor[0])) == 0 || (cursor[1] != 0) != (probe.step != 1) { probe.failure = 44; return false }
        if probe.step != 1 && (i32(bounds[2]) != 3+probe.step || bounds[3] != 2) { probe.failure = 45; return false }
        if probe.step == 1 && i32(bounds[7]) - i32(bounds[5]) + 1 != probe.width { probe.failure = 30; return false }
        coord := u32(bounds[5]).bit_or(u32(bounds[6]).shl(16))
        if read_text(out, addr(&mut chars[0]), 2, coord, addr(&mut n)) == 0 || n != 2 ||
        chars[0] != 197 || i32(chars[1]) != 48 + probe.step {
            _ := sys.eprint(f"screen step={probe.step} read={n} expected=Å{probe.step} units={chars[0]},{chars[1]}")
            probe.failure = 21 + probe.step; return false
        }
        mut meter: [u16; 10] = [0; 10]
        gauge_coord := u32(bounds[5]).bit_or(u32(i32(bounds[6]) + 1).shl(16))
        if read_text(out, addr(&mut meter[0]), 10, gauge_coord, addr(&mut n)) == 0 || n != 10 { probe.failure = 34; return false }
        expected := "OK ===...."
        for i in 0..10 { if meter[i] != u16(expected[i]) { probe.failure = 35; return false } }
        for j in 0..2 {
            mut row: [u16; 7] = [0; 7]
            coords := u32(bounds[5]).bit_or(u32(i32(bounds[6]) + 2 + j).shl(16))
            if read_text(out, addr(&mut row[0]), 7, coords, addr(&mut n)) == 0 || n != 7 { probe.failure = 36; return false }
            line := if j == 0 { "> row A" } else { "> row B" }
            for i in 0..7 { if row[i] != u16(line[i]) { probe.failure = 37; return false } }
        }
        mut attr: u16 = 0
        if read_attr(out, addr(&mut attr), 1, coord, addr(&mut n)) == 0 || attr.bit_and(7) != 3 || attr.shr(4).bit_and(15) != 9 { probe.failure = 31; return false }
        table_row := u32(bounds[5]).bit_or(u32(i32(bounds[6])+5).shl(16))
        if read_text(out,addr(&mut meter[0]),7,table_row,addr(&mut n)) == 0 || n != 7 { probe.failure = 38; return false }
        table_line := ">B   02"
        for i in 0..7 { if meter[i] != u16(table_line[i]) { probe.failure = 39; return false } }
        if read_attr(out,addr(&mut attr),1,table_row+5,addr(&mut n)) == 0 || attr.bit_and(255) != 27 { probe.failure = 40; return false }
        plot_row := u32(bounds[5]).bit_or(u32(i32(bounds[6])+6).shl(16))
        if read_text(out,addr(&mut meter[0]),1,plot_row,addr(&mut n)) == 0 || meter[0] != 0x2580 { probe.failure = 41; return false }
        if read_attr(out,addr(&mut attr),1,plot_row,addr(&mut n)) == 0 || attr.bit_and(255) != 27 { probe.failure = 42; return false }
        if read_text(out,addr(&mut meter[0]),1,plot_row+5,addr(&mut n)) == 0 || meter[0] != 42 { probe.failure = 43; return false }
        if probe.step == 0 {
            mut rect: [i16; 4] = [bounds[5], bounds[6], i16(i32(bounds[7]) - 1), bounds[8]]
            if set_window(out, 1, addr(&rect[0])) == 0 { probe.failure = 32; return false }
            probe.width = i32(rect[2]) - i32(rect[0]) + 1
        }
    }
    if probe.step == 0 {
        match key { .Up => {}, _ => { probe.failure = 24 + probe.step }, }
    } else if probe.step == 1 {
        match key { .Char(c) if i32(c) == 0x1f30d => {}, _ => { probe.failure = 24 + probe.step }, }
    } else {
        match key { .Escape => {}, _ => { probe.failure = 24 + probe.step }, }
    }
    probe.step += 1
    probe.failure == 0 && probe.step < 3
}

@extern("kernel32.dll","SetConsoleCursorPosition")
unsafe fn position(handle: ptr, coord: u32) -> i32

fn embedded_frame(frame: &mut tui.Frame, state: &mut i32) {
    frame.label(frame.area(),"VIEW")
    frame.set_cursor_position(frame.area().x+1,frame.area().y)
}

unsafe fn unit_at(h: ptr, x: i32, y: i32) -> i32 {
    mut unit: u16 = 0
    mut count: u32 = 0
    if read_text(h,addr(&mut unit),1,u32(x).bit_or(u32(y).shl(16)),addr(&mut count)) == 0 || count != 1 { return -1 }
    i32(unit)
}

unsafe fn embedded(out: ptr) -> i32 {
    mut bounds: [i16;11] = [0;11]
    if info(out,addr(&mut bounds[0])) == 0 { return 50 }
    x := i32(bounds[5])
    y := i32(bounds[6])
    mut count := 0
    mut fixed: tui.Terminal<tui.LiveBackend> = tui.open(.Fixed(tui.Rect {x:4,y:2,w:8,h:2})).unwrap()
    if fixed.draw(&mut count,embedded_frame).is_err() || unit_at(out,x+4,y+2) != 86 || unit_at(out,0,0) != 35 { return 51 }
    fixed.backend_mut().close()
    if position(out,u32(x).bit_or(u32(y+1).shl(16))) == 0 { return 52 }
    mut embedded: tui.Terminal<tui.LiveBackend> = tui.open(.Inline(2)).unwrap()
    if embedded.viewport_area().y != 1 || embedded.draw(&mut count,embedded_frame).is_err() { return 53 }
    mut line := tui.Frame::new(embedded.viewport_area().w,1)
    line.label(line.area(),"LOG")
    if embedded.insert_before(&line).is_err() || unit_at(out,x,y+1) != 76 || unit_at(out,x,y+2) != 86 { return 54 }
    embedded.backend_mut().close()
    if info(out,addr(&mut bounds[0])) == 0 || i32(bounds[3]) != y+4 || unit_at(out,0,0) != 35 { return 55 }
    0
}

fn verify() -> i32 {
    unsafe {
        _ := detach()
        if allocate() == 0 { return 11 }
        mut device_in: [u16; 7] = [67, 79, 78, 73, 78, 36, 0]
        mut device_out: [u16; 8] = [67, 79, 78, 79, 85, 84, 36, 0]
        stdin := open_file(addr(&device_in[0]), 0xc0000000, 3, ptr(0), 3, 0, ptr(0))
        stdout := open_file(addr(&device_out[0]), 0xc0000000, 3, ptr(0), 3, 0, ptr(0))
        if use_handle(-10, stdin) == 0 || use_handle(-11, stdout) == 0 { return 12 }
        mut old_in: u32 = 0
        mut old_out: u32 = 0
        if mode(stdin, addr(&mut old_in)) == 0 || mode(stdout, addr(&mut old_out)) == 0 { return 13 }
        mut saved: [u32;2] = [0;2]; mut original: [i16;11] = [0;11]
        if cursor_info(stdout,addr(&mut saved[0])) == 0 || info(stdout,addr(&mut original[0])) == 0 { return 46 }
        mut sentinel: u16 = 35
        mut n: u32 = 0
        if stamp(stdout, addr(&sentinel), 1, 0, addr(&mut n)) == 0 || n != 1 { return 19 }
        mut probe := Probe { step: 0, failure: 0, width: 0, input: stdin, started: false }
        result := tui.animate(&mut probe, 60, draw, update, tick)
        if result.is_err() { return 15 }
        if probe.failure != 0 { return probe.failure }
        if probe.step != 3 { return 16 }
        mut new_in: u32 = 0
        mut new_out: u32 = 0
        if mode(stdin, addr(&mut new_in)) == 0 || mode(stdout, addr(&mut new_out)) == 0 { return 17 }
        if old_in != new_in || old_out != new_out { return 18 }
        active := open_file(addr(&device_out[0]), 0xc0000000, 3, ptr(0), 3, 0, ptr(0))
        mut restored: u16 = 0
        if read_text(active, addr(&mut restored), 1, 0, addr(&mut n)) == 0 || restored != sentinel { return 33 }
        mut after: [u32;2] = [0;2]; mut restored_info: [i16;11] = [0;11]
        if cursor_info(active,addr(&mut after[0])) == 0 || info(active,addr(&mut restored_info[0])) == 0 { return 47 }
        if saved[0] != after[0] || saved[1] != after[1] || original[2] != restored_info[2] || original[3] != restored_info[3] { return 48 }
        probe_code := embedded(active)
        if probe_code != 0 { return probe_code }
        if mode(stdin,addr(&mut new_in)) == 0 || mode(stdout,addr(&mut new_out)) == 0 || old_in != new_in || old_out != new_out { return 56 }
        _ := close_handle(active)
    }
    0
}

fn main() -> i32 {
    if target_is("windows") { return verify() }
    _ := sys.eprint("Run this console test on Windows.")
    1
}
