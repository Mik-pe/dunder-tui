capability unsafe, stdio, process
import sys
import ..src.tui
import .text_values
import .terminal_driver as driver

fn app() -> i32 {
    mut term := tui.open(.Fullscreen).unwrap()
    for step in 0..2 {
        mut phase := step
        if term.draw(&mut phase,text_values.live).is_err() { return 1 }
        match term.backend_mut().next(3000) { .Press(_) => {}, _ => { return 1 }, }
    }
    0
}

fn exercise(master:i32, slave:i32, screen:&mut driver.Screen) -> bool {
    unsafe {
        if !driver.wait_for(master,&mut screen,2,"****","38;5;81") || !screen.contains(0,"Gate 42") || !screen.contains(1,"東") { return false }
        if !driver.send(master,"n") || !driver.wait_for(master,&mut screen,2,"++++","") ||
            !screen.contains(0,"Gate 17") { return false }
        return driver.send(master,"q") && driver.wait_for(master,&mut screen,0,"","\x1b[?1049l")
    }
    false
}

fn main() -> i32 {
    if sys.arg_count() == 2 { return app() }
    unsafe { if driver.test_with_args(sys.arg(0),["draw"],12,5,exercise) {
        print("Formatted label, masked table cell and terminal restoration OK")
        return 0
    } }
    1
}
