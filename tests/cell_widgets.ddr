import ..src.tui
import ..src.widgets
import std.bytes as bytes

pub fn swatch(frame: &mut tui.Frame, x: i32, y: i32) {
    frame.fill(tui.Rect{x:x,y:y,w:5,h:1},`#`,tui.plain())
    frame.render_widget(widgets.Fill::new("xy"),tui.Rect{x:x,y:y,w:4,h:1})
    frame.render_widget(widgets.Clear{},tui.Rect{x:x+2,y:y,w:2,h:1})
}

fn seeded(a: tui.Rect, decorated: bool) -> tui.Frame {
    mut frame := tui.Frame::at(a)
    frame.fill(a,`.`,tui.ink(.Green).background(.Blue).bold())
    for y in a.y..a.bottom() {
        _ := frame.set_cell(a.x+1,y,"界",tui.ink(.Red))
        _ := frame.set_cell(a.x+5,y,"❤️",tui.plain().italic())
        if decorated {
            _ := frame.set_diff_option(a.x+2,y,.Skip)
            _ := frame.set_diff_option(a.x+3,y,.AlwaysUpdate)
            _ := frame.set_diff_option(a.x+6,y,.ForcedWidth(3))
        }
    }
    move frame
}

fn region(a: tui.Rect, n: i32) -> tui.Rect {
    match n {
        0 => a,
        1 => tui.Rect {x:a.x+2,y:a.y,w:4,h:1},
        2 => tui.Rect {x:0,y:0,w:a.x+2,h:a.y+1},
        3 => tui.Rect {x:a.right()-1,y:a.bottom()-1,w:10,h:5},
        4 => tui.Rect {x:a.right(),y:a.y,w:3,h:3},
        _ => tui.Rect {x:a.x,y:a.y,w:0,h:1},
    }
}

fn snapshot(frame: &tui.Frame) {
    a := frame.area()
    mut line: []u8 = []
    for y in a.y..a.bottom() { for x in a.x..a.right() {
        cell := frame.cell_at(x,y).unwrap()
        fg := cell.style.get_foreground().unwrap().code()
        bg := cell.style.get_background().unwrap().code()
        bits := (if cell.style.has(.Bold) { 1 } else { 0 }) + (if cell.style.has(.Italic) { 2 } else { 0 })
        opt := match cell.diff_option { .None => 0, .Skip => -1, .AlwaysUpdate => -2, .ForcedWidth(w) => w, }
        bytes.append_utf8(&mut line,f"{fg}/{bg}/{bits}/{opt}:{cell.symbol}|")
    } }
    print(bytes.decode(&line).unwrap())
}

fn compare(curr: &tui.Frame, prev: &tui.Frame) {
    snapshot(&curr)
    mut pos: []u8 = []
    changes := curr.diff_positions(&prev).unwrap()
    for (x,y) in &changes { bytes.append_utf8(&mut pos,f"{x},{y} ") }
    print(bytes.decode(&pos).unwrap())
}

fn main() {
    for a in [tui.Rect {x:0,y:0,w:8,h:3},tui.Rect {x:7,y:4,w:8,h:3},tui.Rect {x:2,y:1,w:0,h:1}] {
        for flags in [false,true] {
            initial := seeded(a,flags)
            for symbol in [""," ",".","x","é","界","xy","é","لَا","😶‍🌫️","゛","ｶﾞ","\u{301}","👩🏾‍⚕️"] {
                mut widget := widgets.Fill::new("initial")
                widget.symbol = symbol.clone()
                widget.style = tui.ink(.Red).italic().without(.Bold)
                for n in 0..6 {
                    area := region(a,n)
                    mut painted := seeded(a,flags)
                    painted.render_widget(&widget,area)
                    compare(&painted,&initial)
                    mut overlay := seeded(a,flags)
                    overlay.render_widget(&widget,area)
                    overlay.render_widget(widgets.Clear{},region(a,(n+1)%6))
                    compare(&overlay,&painted)
                    compare(&initial,&overlay)
                }
            }
        }
    }
}
