capability stdio, process
import ..src.tui
import ..src.text as rich
import ..src.posix
import ..src.testing
import ..src.widgets
import ..tests.widget_cells as cells
import .chart_scene
import std.bytes as bytes
import std.array as array
import std.time as clock
import std.process as proc
import sys

struct Output { width: i32, data: []u8 }
impl tui.Backend for Output {
    fn size(&mut self) -> (i32,i32) { (self.width,24) }
    fn clear_screen(&mut self, area: tui.Rect) -> Result<(),string> {
        bytes.append_utf8(&mut self.data,"\x1b[2J")
        .Ok
    }
    fn present(&mut self, frame: &tui.Frame, previous: &tui.Frame) -> Result<(),string> {
        frame.ansi_diff(&previous,&mut self.data)
        .Ok
    }
}

struct State<S> { scene: S, mode: string, step: i32, shared: bool }

struct EmojiLog {}
struct ScriptLog { lines: []rich.Line, fill: widgets.Fill }
impl ScriptLog {
    fn new() -> Self {
        mut lines: []rich.Line = []
        for sample in ["لَا  لا", "א‍ל  א‍ל", "ᨕᨗ‍ᨐ  ᨕᨗ‍ᨐ", "ꓹꓼ  ꓺꓽ", "𐰲‍𐰃  𐰲‍𐰃", "ល្ង  ង", "ⵏ‍ⴾ  ⵏ‍ⴾ"] {
            lines.push(rich.Line::new([rich.Span::raw("Prov    "), rich.Span::styled(sample.clone(), tui.ink(.Red).bold()), rich.Span::raw("    ✓")]).align(.Center))
        }
        Self { lines: move lines, fill: widgets.Fill::new(".") }
    }

    fn draw(&mut self, frame: &mut tui.Frame, mode: string, step: i32) {
        mut area := frame.area()
        offset := if mode == "scroll" { step } else { 0 }
        style := if mode == "repaint" && step % 2 == 1 { tui.ink(.Yellow).background(.Blue) } else { tui.ink(.Cyan) }
        self.fill.style = style
        for y in 0..23 {
            row := area.take_rows(1)
            frame.render_widget(&self.fill,row)
            self.lines[(y + offset) % self.lines.len].render(&mut frame, row)
        }
        frame.label(area, if mode == "cell" && step % 2 == 1 { "+" } else { "-" })
    }
}

impl EmojiLog {
    fn draw(&mut self, frame: &mut tui.Frame, mode: string, step: i32) {
        mut area := frame.area()
        offset := if mode == "scroll" { step } else { 0 }
        style := if mode == "repaint" && step % 2 == 1 { tui.ink(.Yellow).background(.Blue) } else { tui.ink(.Cyan) }
        for y in 0..23 {
            line := match (y + offset) % 4 {
                0 => "08.32   😶‍🌫️  Dimma vid kusten. Ny rapport efter nästa mätning.    📡  Station 7  🇸🇪",
                1 => "08.46   👩🏾‍⚕️  Jouren har lämnat kajen. Beräknad ankomst 09.10.    🛟  På väg    ✅",
                2 => "09.10   😶‍🌫  Sikten förbättras i väster. Nästa observation 09.40.    ☀︎  Väst     🧭",
                _ => "09.40   👩🏽‍💻  Mätserie mottagen. Loggen innehåller samtliga värden.  🔬  Klart    1️⃣",
            }
            row := area.take_rows(1)
            frame.fill(row, `.`, style)
            frame.text(row, line, style)
        }
        frame.label(area, if mode == "cell" && step % 2 == 1 { "+" } else { "-" })
    }
}

fn render<S>(frame: &mut tui.Frame, s: &mut State<S>) {
    s.scene.draw(&mut frame,s.mode,s.step)
    if s.shared {
        frame.label(tui.Rect{x:4,y:23,w:24,h:1},"external    +   >")
        for x in 4..12 { _ := frame.set_diff_option(x,23,.Skip) }
        _ := frame.set_diff_option(16,23,.AlwaysUpdate)
        _ := frame.set_diff_option(20,23,.ForcedWidth(4))
    }
    frame.set_cursor_position(0,23)
}

fn main() {
    scene := proc.env("TUI_BENCH_SCENE")
    if scene == .Some("ligatures") { benchmark(ScriptLog::new()) }
    else if scene == .Some("emoji") { benchmark(EmojiLog {}) }
    else { benchmark(chart_scene.Scene::new()) }
}

pub fn benchmark<S>(move scene: S) {
    timed := sys.arg_count() < 2 || sys.arg(1) != "--allocations"
    physical := sys.arg_count() == 2 && sys.arg(1) == "--terminal"
    console := sys.arg_count() == 2 && sys.arg(1) == "--win-console"
    idle_only := sys.arg_count() == 2 && sys.arg(1) == "--idle"
    mut written := i64(0)
    mut state := State<S> { scene: move scene, mode: "", step: 0, shared:proc.env("TUI_BENCH_DIFF_OPTIONS") == .Some("1") }
    if sys.arg_count() == 2 && sys.arg(1) == "--verify" {
        for mode in ["idle","cell","scroll","resize","repaint"] {
            mut t := tui.Terminal<testing.TestBackend>::new(testing.TestBackend::new(96,24))
            state.mode = mode
            for step in 0..220 {
                state.step = step
                columns := if state.mode == "resize" && step%2 == 0 { 80 } else { 96 }
                t.backend_mut().resize(columns,24)
                assert(t.draw(&mut state,render<S>).is_ok())
                assert(t.completed().count() == u64(step) && t.backend().cursor_visible() && t.backend().cursor_position() == (0,23))
                cells.snapshot(&t.backend().buffer())
            }
        }
        return
    }
    for mode in ["idle","cell","scroll","resize","repaint"] {
        if idle_only && mode != "idle" { continue }
        mut t := tui.Terminal<Output>::new(Output { width: 96, data: [] })
        mut samples: []i64 = []
        mut total := i64(0)
        state.mode = mode.clone()
        for step in 0..220 {
            state.step = step
            t.backend_mut().width = if mode == "resize" && step%2 == 0 { 80 } else { 96 }
            start := if timed { clock.monotonic_ns() } else { i64(0) }
            t.backend_mut().data.clear()
            assert(t.draw(&mut state,render<S>).is_ok())
            batch := &t.backend().data
            if physical || console { assert(posix.write_bytes(&batch)) }
            if console { written += i64(batch.len) }
            if step >= 20 {
                if timed { samples.push(clock.monotonic_ns()-start) }
                total += i64(batch.len)
            }
        }
        if timed {
            array.sort<i64>(&mut samples)
            _ := sys.eprint(f"{mode} {samples[99]} {samples[189]} {total/200}")
        } else { _ := sys.eprint(f"{total}") }
    }
    if console { _ := sys.eprint(f"written {written}") }
}
