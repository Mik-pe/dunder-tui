capability stdio
import ..src.tui
import .chart_scene
import .frames

fn draw(scene: &mut chart_scene.Scene, frame: &mut tui.Frame, mode: string, n: i32) { scene.draw(&mut frame, mode, n) }

fn main() {
    mut scene := chart_scene.Scene::new()
    cases: []string = ["idle", "cell", "scroll", "resize", "repaint"]
    frames.run(&mut scene, &cases, draw)
}
