import ..src.tui
import ..src.list
import ..src.text as rich

pub struct Scene { view: list.List, state: list.ListState }

impl Scene {
    pub fn new(count: i32) -> Self {
        mut entries: []list.Item = []
        entries.reserve(count)
        for i in 0..count {
            mut lines: []rich.Line = [rich.Line::raw(f"Track {i}")]
            if i % 3 == 0 {
                lines.push(rich.Line::raw("  茶 / é").styled(tui.ink(.Cyan)))
            }
            entries.push(list.Item::new(rich.Text::new(move lines)))
        }
        mut view := list.List::new(move entries)
        view.marker = rich.Line::raw("› ")
        view.highlight = tui.plain().background(.Blue).bold()
        view.scroll_padding = 2
        Scene { view: move view, state: list.ListState::new() }
    }

    pub fn draw(&mut self, f: &mut tui.Frame, mode: string, n: i32) {
        if n == 0 { self.state = list.ListState::new() }
        selected := if mode == "scroll" { 40 + n } else if mode == "jump" && n % 2 == 1 { self.view.len() - 6 } else { 40 }
        self.state.select(.Some(selected))
        mut area := f.area()
        bounds := area.take_rows(area.h - 1)
        style := if mode == "repaint" && n % 2 == 1 { tui.plain().background(.Magenta) } else { tui.plain().background(.Black) }
        f.apply_style(bounds, style)
        self.view.render_stateful(&mut f, bounds, &mut self.state)
        symbol := if mode == "cell" && n % 2 == 1 { `+` } else { `-` }
        f.fill(area.take_cols(1), symbol, tui.plain())
    }
}
