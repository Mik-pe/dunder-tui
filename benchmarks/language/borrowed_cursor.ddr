capability stdio
import sys

struct Screen { rows:i32 }
struct Pair { old:&Screen, current:&Screen }
struct Cursor { pair:&Pair, at:i32, end:i32 }

impl Pair {
    fn cursor(&self) -> Cursor from self { Cursor { pair:&self, at:0, end:self.current.rows } }
    fn forwarded(&self) -> Cursor from self { self.cursor() }
}

impl Cursor {
    fn step(&mut self) -> i32 {
        self.at += 1
        self.at+self.end+self.pair.old.rows
    }
}

fn main() {
    old := Screen { rows:16 }
    new := Screen { rows:19 }
    p := Pair { old:&old, current:&new }
    mode := sys.arg(1)
    mut sum := 0
    if mode == "direct" {
        for _ in 0..8192 {
            mut i := Cursor { pair:&p, at:0, end:new.rows }
            first := i.step()
            sum += first+i.step()
        }
    } else if mode == "method" {
        for _ in 0..8192 {
            mut i := p.cursor()
            first := i.step()
            sum += first+i.step()
        }
    } else if mode == "forward" {
        for _ in 0..8192 {
            mut i := p.forwarded()
            first := i.step()
            sum += first+i.step()
        }
    }
    assert(sum == 598016)
    print(sum)
}
