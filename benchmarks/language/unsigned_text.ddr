capability stdio
import std.bytes
import std.json
import sys

fn main() -> i32 {
    if sys.arg_count() != 2 { return 2 }
    mode := sys.arg(1)
    if mode != "string" && mode != "buffer" { return 2 }
    direct := mode == "buffer"
    values: [u64;7] = [0,9,10,999999999,0x7fffffffffffffff,0x8000000000000000,0xffffffffffffffff]
    expected := ["#0","#9","#10","#999999999","#9223372036854775807","#9223372036854775808","#18446744073709551615"]
    mut out: []u8 = []
    out.reserve(24)
    mut sum := i64(0)
    for _ in 0..1000 {
        for i in 0..7 {
            out.clear()
            out.push(b'#')
            if direct { json.write_u64(&mut out,values[i]) }
            else { bytes.append_utf8(&mut out,values[i].str()) }
            assert(out.len == expected[i].len)
            for j in 0..out.len { assert(out[j] == expected[i][j]); sum += i64(out[j]) }
        }
    }
    assert(sum == 4008000)
    print(sum)
    0
}
