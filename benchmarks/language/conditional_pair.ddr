capability stdio
import sys

fn position(value: i32) -> (i32,i32) { (value / 2, value % 3) }

fn paired(value: i32, skip: bool) -> i32 {
    start := if skip { position(value) } else { (0,0) }
    start.0 + start.1
}

fn scalar(value: i32, skip: bool) -> i32 {
    mut first := 0
    mut offset := 0
    if skip {
        (index, padding) := position(value)
        first = index
        offset = padding
    }
    first + offset
}

fn main() -> i32 {
    if sys.arg_count() != 2 { return 2 }
    mode := sys.arg(1)
    if mode != "paired" && mode != "scalar" { return 2 }
    mut sum := i64(0)
    for i in 0..65536 {
        skip := i%16 == 0
        sum += i64(if mode == "paired" { paired(i,skip) } else { scalar(i,skip) })
    }
    assert(sum == 67096575)
    print(sum)
    0
}
