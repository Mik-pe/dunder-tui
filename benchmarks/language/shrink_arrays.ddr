capability stdio
import std.array as array
import std.time as clock
import sys

fn measure<T: Clone + Storable + Eq>(seed: &[]T, fill: &T, library: bool) -> (i64,i64) {
    mut samples: []i64 = []
    for trial in 0..65 {
        mut values := seed.clone()
        started := clock.monotonic_ns()
        if library { array.resize<T>(&mut values,16,&fill) } else { values.truncate(16) }
        elapsed := clock.monotonic_ns()-started
        assert(values.len == 16 && values[15] == seed[15] && values.cap() >= seed.len)
        values.push(fill.clone())
        assert(values[16] == fill && seed.len == 65536)
        if trial >= 5 { samples.push(elapsed) }
    }
    array.sort<i64>(&mut samples)
    (samples[29],samples[56])
}

fn main() -> i32 {
    if sys.arg_count() != 3 { return 2 }
    mode := sys.arg(1)
    kind := sys.arg(2)
    if mode != "resize" && mode != "truncate" { return 2 }
    library := mode == "resize"
    mut result := (i64(0),i64(0))
    if kind == "i32" {
        mut seed: []i32 = []
        for i in 0..65536 { seed.push(i) }
        fill := -1
        result = measure<i32>(&seed,&fill,library)
    } else if kind == "string" {
        mut seed: []string = []
        for i in 0..65536 { seed.push(i.str()) }
        fill := "new"
        result = measure<string>(&seed,&fill,library)
    } else { return 2 }
    (p50,p95) := result
    print(f"{kind} {mode} {p50} {p95}")
    0
}
