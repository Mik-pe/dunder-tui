capability stdio
import sys

fn copied(points:&[](f64,f64)) -> f64 {
    mut sum := 0.0
    for i in 1..points.len {
        a := points[i-1]
        b := points[i]
        sum += b.0-a.0+a.1+b.1
    }
    sum
}

fn borrowed(points:&[](f64,f64)) -> f64 {
    mut sum := 0.0
    for i in 1..points.len {
        a := &points[i-1]
        b := &points[i]
        sum += b.0-a.0+a.1+b.1
    }
    sum
}

fn main() -> i32 {
    if sys.arg_count() != 2 { return 2 }
    mode := sys.arg(1)
    mut points: [](f64,f64) = []
    for i in 0..96 { points.push((f64(i),f64(i%8))) }
    mut sum := 0.0
    for _ in 0..1100 {
        if mode == "copied" { sum += copied(&points) }
        else if mode == "borrowed" { sum += borrowed(&points) }
        else { return 2 }
    }
    assert(sum == 836000.0)
    print(i64(sum))
    0
}
