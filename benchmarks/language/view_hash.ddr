capability stdio
import std.hash
import sys

fn digest(s: &str) -> u64 {
    mut state := hash.Hasher::new()
    state.write_bytes(s.as_bytes())
    state.finish()
}

fn main() -> i32 {
    if sys.arg_count() != 2 { return 2 }
    method := sys.arg(1)
    if method != "owned" && method != "view" { return 2 }
    text := "xö東🦊!"
    expected := ["","ö","東","🦊","ö東🦊"]
    bounds: [i32;6] = [1,1,3,6,10,10]
    mut sum := u64(0)
    for i in 0..8192 {
        k := i%5
        start := if k == 4 { 1 } else { bounds[k] }
        end := bounds[k+1]
        s := &text[start..end]
        got := if method == "owned" { s.to_string().hash() } else { digest(s) }
        assert(got == expected[k].hash())
        sum = sum.wrapping_add(got)
    }
    print(sum)
    0
}
