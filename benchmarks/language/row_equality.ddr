capability unsafe, stdio
import std.array as array
import std.bytes as bytes
import std.time as clock
import sys

enum Comparison { Array, Operator, Memory }

fn matches(a:&[]i64,b:&[]i64,first:i32,end:i32,mode:Comparison) -> bool {
    if mode == .Memory {
        unsafe { return bytes.equal_memory(addr(&a[first]),addr(&b[first]),usize(end-first)*size_of(i64)) }
    }
    if mode == .Operator { return (&a[first..end]) == (&b[first..end]) }
    left := &a[first..end]
    right := &b[first..end]
    array.equal<i64>(&left,&right)
}

fn main() -> i32 {
    if sys.arg_count() != 2 { return 2 }
    mode := sys.arg(1)
    comparison := match mode { "array" => Comparison.Array, "eq" => Comparison.Operator, "memory" => Comparison.Memory, _ => { return 2 }, }
    timer := clock.MonotonicClock.Raw
    mut a: []i64 = []
    for i in 0..2304 { a.push(i64(i)) }
    mut b := a.clone()
    mut samples: []i64 = []
    mut sum := 0
    for batch in 0..220 {
        start := timer.now_ns()
        for frame in 0..64 {
            index := 96*((batch+frame)%24)+95
            if frame%2 == 0 { b[index] += 1 }
            for row in 0..24 { if matches(&a,&b,96*row,96*(row+1),comparison) { sum += 1 } }
            b[index] = a[index]
        }
        elapsed := timer.now_ns()-start
        if batch >= 20 { samples.push(elapsed/64) }
    }
    assert(sum == 220*32*47)
    array.sort<i64>(&mut samples)
    print(f"{mode} {samples[99]} {samples[189]} {sum}")
    0
}
