capability stdio
import ..src.layout as lay
import ..src.tui
import std.time
import std.array
import sys

pub fn rules(n: i32) -> []lay.Constraint {
    mut spec: []lay.Constraint = []
    spec.reserve(n)
    for i in 0..n {
        spec.push(match i % 6 {
            0 => .Length(u16(1+i%5)), 1 => .Percentage(1), 2 => .Ratio(1,96),
            3 => .Max(u16(2+i%4)), 4 => .Fill(1), _ => .Min(u16(2+i%3)),
        })
    }
    spec[n/2] = .Min(19)
    spec[n-1] = .Min(12)
    move spec
}

fn main() -> i32 {
    if sys.arg_count() < 2 || sys.arg_count() > 3 { return 2 }
    mode := sys.arg(1)
    if mode != "minimums" && mode != "crowded" && mode != "overlap" && mode != "weighted" && mode != "cached" { return 2 }
    mut spec := rules(32)
    if mode == "weighted" { spec[10] = .Fill(3) }
    mut grid := lay.Layout::horizontal(move spec).spacing(if mode == "overlap" { -1 } else { 1 }).margin(2,1).cache_capacity(1)
    mut samples: []i64 = []
    samples.reserve(25)
    mut sum: i64 = 0
    if sys.arg_count() == 3 && sys.arg(2) != "setup" { return 2 }
    count := if sys.arg_count() == 3 { 0 } else { 30 }
    clock := time.MonotonicClock.Raw
    for i in 0..count {
        w := (if mode == "crowded" { 79 } else { 160 }) + (if mode == "cached" { 0 } else { i % 3 })
        start := clock.now_ns()
        out := grid.arrange(tui.Rect::new(7,11,w,11)).regions()
        for r in &out.areas { sum += i64(r.x + 3*r.w) }
        for r in &out.spacers { sum += i64(r.x + 3*r.w) }
        elapsed := clock.now_ns()-start
        if i >= 5 { samples.push(elapsed) }
    }
    if count > 0 {
        array.sort<i64>(&mut samples)
        print(f"{mode} {samples[12]} {samples[23]} {sum}")
    }
    0
}
