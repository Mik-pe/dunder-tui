capability filesystem, process, stdio
import std.array as array
import std.parse as parse
import std.process as proc
import std.text as text
import sys

struct Samples { p50: []i64, p95: []i64, bytes: i64 }

fn record(rows: &mut []Samples, cases: &mut []string, output: string, keep: bool) {
    lines := text.split(text.trim(output), "\n")
    first := cases.len == 0
    assert(first || lines.len == cases.len)
    for i in 0..lines.len {
        fields := text.split(text.trim(lines[i]), " ")
        assert(fields.len == 4)
        if first { cases.push(fields[0].clone()) }
        assert(fields[0] == cases[i])
        if rows.len == i { rows.push(Samples { p50: [], p95: [], bytes: 0 }) }
        median := parse.integer(fields[1])
        tail := parse.integer(fields[2])
        size := parse.integer(fields[3])
        assert(median.ok && tail.ok && size.ok && median.value <= tail.value)
        if keep {
            row := &mut rows[i]
            assert(row.p50.len == 0 || row.bytes == size.value)
            row.p50.push(median.value)
            row.p95.push(tail.value)
            row.bytes = size.value
        }
    }
}

fn main() -> i32 {
    total := sys.arg_count()
    mut args := total
    for i in 1..total { if sys.arg(i) == "--" { args = i; break } }
    labeled := args >= 6 && sys.arg(args-3) == "--labels"
    positional := if labeled { args-3 } else { args }
    recorded := args >= 3 && sys.arg(1) == "--recorded"
    if (positional != 3 && positional != 4) || (recorded && args != total) {
        _ := sys.eprint("Usage: measure FIRST SECOND [PTY_DRIVER] [--labels FIRST_NAME SECOND_NAME] [-- BENCHMARK_ARGS...]")
        _ := sys.eprint("       measure --recorded DIRECTORY [console]")
        return 1
    }
    programs := [sys.arg(1), sys.arg(2)]
    names := if labeled { [sys.arg(args-2),sys.arg(args-1)] } else { ["dunder","ratatui"] }
    modes := if positional == 4 { 2 } else { 1 }
    mut cases: []string = []
    for mode in 0..modes {
        label := if mode == 0 { "memory" } else if recorded { "console" } else { "pty" }
        mut rows: [ []Samples; 2 ] = [[], []]
        mut physical: [i64; 2] = [-1, -1]
        for run in 0..9 {
            for pos in 0..2 {
                which := (run + pos) % 2
                if recorded {
                    path := f"{sys.arg(2)}/{label}-{names[which]}-{run}"
                    record(&mut rows[which], &mut cases, sys.read(path + ".stats").unwrap(), run >= 2)
                    if mode == 1 {
                        size := parse.integer(text.trim(sys.read(path + ".bytes").unwrap()))
                        assert(size.ok && size.value > 0 && (physical[which] < 0 || size.value == physical[which]))
                        physical[which] = size.value
                    }
                    continue
                }
                program := programs[which].clone()
                mut child_args: []string = []
                if mode == 1 {
                    child_args.push(program.clone())
                    if args < total { child_args.push("--") }
                }
                for i in args+1..total { child_args.push(sys.arg(i)) }
                command := proc.Command::new(if mode == 1 { sys.arg(3) } else { program.clone() },move child_args)
                out := command.exec()
                if !out.succeeded() {
                    _ := sys.eprint(f"{program} exit={out.code} signal={out.signal} error={out.error}")
                    _ := sys.eprint(out.stderr_text())
                    return 1
                }
                if mode == 1 {
                    size := parse.integer(text.trim(out.stdout_text()))
                    assert(size.ok && size.value > 0)
                    assert(physical[which] < 0 || size.value == physical[which])
                    physical[which] = size.value
                }
                record(&mut rows[which], &mut cases, out.stderr_text(), run >= 2)
            }
        }
        for which in 0..2 {
            for i in 0..cases.len {
                row := &mut rows[which][i]
                array.sort<i64>(&mut row.p50)
                array.sort<i64>(&mut row.p95)
                print(f"{label} {names[which]} {cases[i]} {row.p50[3]} {row.p95[3]} {row.bytes} {row.p50[0]} {row.p50[6]} {row.p95[0]} {row.p95[6]}")
            }
            if mode == 1 { _ := sys.eprint(f"{names[which]} {label} bytes {physical[which]}") }
        }
    }
    0
}
