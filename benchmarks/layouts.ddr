capability stdio
import ..src.tui
import .layout_scene
import .frames
import ..src.layout
import std.time as clock
import std.array as array
import sys

fn draw(scene: &mut layout_scene.Scene, frame: &mut tui.Frame, mode: string, n: i32) { scene.draw(&mut frame, mode, n) }

fn splits() {
    for mode in ["cached", "changing", "constrained", "overlap"] {
        rules: []layout.Constraint = if mode == "constrained" { [.Min(30), .Fill(2), .Length(8)] }
        else if mode == "overlap" { [.Min(20), .Fill(2), .Length(23), .Min(13)] }
        else { [.Length(8), .Percentage(20), .Fill(1), .Fill(2)] }
        mut l := layout.Layout::horizontal(move rules).spacing(1).cache_capacity(1)
        if mode == "overlap" { l = l.flex(.SpaceAround).spacing(-2) }
        mut samples: []i64 = []
        mut checksum: i64 = 0
        for batch in 0..35 {
            start := clock.monotonic_ns()
            for i in 0..64 {
                w := if mode == "cached" { 48 } else { 40 + (i + batch) % 24 }
                out := l.arrange(tui.Rect { x: 0, y: 0, w: w, h: 8 }).regions()
                for r in &out.areas { checksum += i64(r.x + 3 * r.w) }
                for r in &out.spacers { checksum += i64(r.x + 3 * r.w) }
            }
            elapsed := (clock.monotonic_ns() - start) / 64
            if batch >= 5 { samples.push(elapsed) }
        }
        array.sort<i64>(&mut samples)
        print(f"{mode} {samples[14]} {samples[28]} {checksum}")
    }
}

fn main() {
    if sys.arg_count() == 2 && sys.arg(1) == "--splits" { splits(); return }
    mut scene := layout_scene.Scene::new()
    cases: []string = ["idle", "cell", "scroll", "resize", "repaint"]
    frames.run(&mut scene, &cases, draw)
}
