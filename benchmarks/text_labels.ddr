capability stdio
import std.array
import std.io
import std.time
import sys
import ..src.text as rich
import ..src.tui

pub fn label(i: i32, plain: bool) -> rich.Text {
    if plain { return rich.Text::raw(f"Gate {i}") }
    rich.Text::new([rich.Line::new([rich.Span::styled(f"Gate {i}\r\n東",tui.ink(.Cyan)),
        rich.Span::raw(" 👩🏽‍💻")]), rich.Line::raw("café\n終")])
}

pub fn measure<S>(mode: string, state: &S, run: fn(&S)->i32) {
    mut samples: []i64 = []
    mut checksum := 0
    for trial in 0..65 {
        start := time.monotonic_ns()
        sum := run(&state)
        elapsed := time.monotonic_ns()-start
        if trial > 0 { assert(checksum == sum) }
        checksum = sum
        if trial >= 5 { samples.push(elapsed) }
    }
    array.sort<i64>(&mut samples)
    print(f"{mode} {samples[29]} {samples[56]} {checksum}")
    if sys.arg(sys.arg_count()-1) == "--resident" {
        mut input := io.stdin()
        mut signal: []u8 = []
        _ := input.read(&mut signal,1).unwrap()
        assert(run(&state) == checksum)
    }
}

fn format_labels(docs: &[]rich.Text) -> i32 {
    mut sum := 0
    for doc in &docs { sum += doc.to_string().len }
    sum
}

fn mask_fields(fields: &[]string) -> i32 {
    mut sum := 0
    for field in &fields { sum += rich.masked(field,`●`).len }
    sum
}

fn main() -> i32 {
    if sys.arg_count() != 2 && !(sys.arg_count() == 3 && sys.arg(2) == "--resident") { return 2 }
    mode := sys.arg(1)
    if mode == "mask" {
        mut fields: []string = []
        for i in 0..128 { fields.push(f"🚦Gate {i} 👩🏽‍💻") }
        measure(mode,&fields,mask_fields)
    } else if mode == "short" || mode == "mixed" {
        mut docs: []rich.Text = []
        for i in 0..128 { docs.push(label(i,mode == "short")) }
        measure(mode,&docs,format_labels)
    } else { return 2 }
    0
}
